{
  "_doc": "Which models /oc may use (agent/oc_pick.py). The owner edits this file; nothing auto-merges it. A model id is provider/model. Each provider names the repository secret its step reads (.github/workflows/opencode.yml has one step per provider, each holding only that secret) and the environment variable opencode reads it from (models.dev provider env). paid: true for pools that hold money (router/engines.py PAID and the Anthropic key); 'unless_listed' for OpenRouter: only ids in its free_models list count as free (blind review 45512119627: a ':free' suffix is not proof; the account holds credit); unknown is treated as paid. Paid runs only while allow_paid is true. Set spend limits at each provider: this file cannot cap spend.",
  "default": "free",
  "allow_paid": true,
  "aliases": {
    "free": "opencode/deepseek-v4.1-flash-free",
    "pickle": "opencode/big-pickle",
    "mimo": "opencode/mimo-v2.6-flash-free",
    "opus": "anthropic/claude-opus-5-5",
    "sonnet": "anthropic/claude-sonnet-5-5",
    "haiku": "anthropic/claude-haiku-5-5",
    "fable": "anthropic/claude-fable-5-2"
  },
  "providers": {
    "opencode": {
      "secret": null,
      "free_models": [
        "deepseek-v4.1-flash-free",
        "big-pickle",
        "mimo-v2.6-flash-free",
        "hy4-flash-free"
      ],
      "paid_secret": "OPENCODE_API_KEY",
      "env": "OPENCODE_API_KEY"
    },
    "anthropic": {
      "secret": "CLAUDE_API_KEY",
      "env": "ANTHROPIC_API_KEY",
      "paid": true
    },
    "google": {
      "secret": "GEMINI_API_KEY",
      "env": "GEMINI_API_KEY",
      "paid": true
    },
    "openrouter": {
      "secret": "OPENROUTER_API_KEY",
      "env": "OPENROUTER_API_KEY",
      "paid": "unless_listed",
      "free_models": []
    },
    "groq": {
      "secret": "GROQ_API_KEY",
      "env": "GROQ_API_KEY",
      "paid": false
    },
    "nvidia": {
      "secret": "NVIDIA_API_KEY",
      "env": "NVIDIA_API_KEY",
      "paid": false
    },
    "cerebras": {
      "secret": "CEREBRAS_API_KEY",
      "env": "CEREBRAS_API_KEY",
      "paid": true
    },
    "xai": {
      "secret": "XAI_API_KEY",
      "env": "XAI_API_KEY",
      "paid": true
    },
    "mistral": {
      "secret": "MISTRAL_API_KEY",
      "env": "MISTRAL_API_KEY",
      "paid": true
    },
    "deepinfra": {
      "secret": "DEEPINFRA_API_KEY",
      "env": "DEEPINFRA_API_KEY",
      "paid": true
    },
    "fireworks-ai": {
      "secret": "FIREWORKS_API_KEY",
      "env": "FIREWORKS_API_KEY",
      "paid": true
    },
    "huggingface": {
      "secret": "HUGGINGFACE_API_KEY",
      "env": "HF_TOKEN",
      "paid": true
    }
  }
}
