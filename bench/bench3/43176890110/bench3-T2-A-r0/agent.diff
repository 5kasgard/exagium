+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that an orphan's entries_b64 matches the attested range in pred.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "range: missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    if not isinstance(from_seq, int) or not isinstance(to_seq, int) or from_seq > to_seq:
+        return "range: invalid predicate range"
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    if not isinstance(head_sha256, str) or not HEX64.fullmatch(head_sha256):
+        return "head: invalid head_sha256 in predicate"
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"chain: entries_b64[{i}] is not valid base64"
+        # Check the entry's prev field matches the expected previous hash
+        try:
+            entry = parse_json(entry_raw, f"entries_b64[{i}]")
+        except R.Bad as e:
+            return f"chain: entries_b64[{i}] is not valid JSON ({e})"
+        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"chain: entries_b64[{i}] must have exactly seq, prev, kind, written_at, body"
+        if entry["prev"] != prev_hash:
+            return f"chain: entries_b64[{i}].prev doesn't link (expected {prev_hash!r}, got {entry['prev']!r})"
+        prev_hash = hashlib.sha256(entry_raw).hexdigest()
+    if prev_hash != head_sha256:
+        return f"head: last entry's sha256 ({prev_hash}) doesn't match head_sha256 ({head_sha256})"
+    return None
+
+
