diff --git a/record/test_record.py b/record/test_record.py
index 9e3084a..7bdfa41 100644
--- a/record/test_record.py
+++ b/record/test_record.py
@@ -222,6 +222,37 @@ class Ledger(unittest.TestCase):
         self.assertEqual(rc, 1)
         self.assertIn("never attested by the writer", err)
 
+    def test_check_anchors_reports_a_deleted_open_timestamp_proof(self):
+        # the writer stamps every range head; deleting its proof must not be silently accepted.
+        self._two_entries()
+        anchors = os.path.join(self.d, "anchors")
+        os.makedirs(anchors)
+        for n in (1, 2):
+            open(os.path.join(anchors, f"{n:06d}.sigstore.json"), "w").write("{}")
+            open(os.path.join(anchors, f"{n:06d}.ots"), "w").write("{}")
+
+        def stub_sigstore(bundle, digest, repo, workflow, ref):
+            hi = int(os.path.basename(bundle)[:6])
+            return 0, R.range_predicate(R.load_chain(self.d)[0], hi, hi), "c0ffee"
+
+        self._anchor_checks(stub_sigstore)
+        rc, out, err = self.run_cmd("check-anchors")
+        self.assertEqual(rc, 0, err)
+        self.assertEqual(json.loads(out)["wrong"], [])
+
+        os.remove(os.path.join(anchors, "000002.ots"))
+        rc, out, err = self.run_cmd("check-anchors")
+        self.assertEqual(rc, 1)
+        self.assertIn("000002.ots is missing", err)
+        self.assertEqual(json.loads(out)["wrong"], ["anchors/000002.ots is missing"])
+        self.assertNotIn("000001.ots is missing", err)  # only the head that was deleted
+
+    def _anchor_checks(self, stub_sigstore, stub_ots=lambda proof, raw, explorers: 1700000000):
+        """check-anchors is offline-unfriendly (Sigstore, Bitcoin): stand in at those two boundaries only."""
+        for name, stub in (("check_sigstore", stub_sigstore), ("check_ots", stub_ots)):
+            self.addCleanup(setattr, R, name, getattr(R, name))
+            setattr(R, name, stub)
+
     def test_unknown_files_and_fields_are_refused(self):
         self._two_entries()
         open(os.path.join(self.d, "entries", "notes.txt"), "w").write("x")
