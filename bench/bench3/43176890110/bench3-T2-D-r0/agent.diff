+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that orphan.body.entries_b64 matches the attested range from pred.
+    
+    Returns None if valid, otherwise a problem string containing:
+    - 'range' for wrong count
+    - 'chain' for broken prev links
+    - 'head' for mismatched head hash
+    """
+    body = orphan.get("body", {})
+    entries_b64 = body.get("entries_b64", [])
+    
+    # Count check
+    expected_count = pred.get("to_seq", 0) - pred.get("from_seq", 0) + 1
+    if not isinstance(entries_b64, list) or len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    # Decode entries
+    entries = []
+    for i, b64 in enumerate(entries_b64):
+        try:
+            entries.append(base64.b64decode(b64, validate=True))
+        except Exception:
+            return f"range: entry {i+1} is not valid base64"
+    
+    # Chain validation
+    prev = pred.get("prev_sha256")
+    for i, entry_bytes in enumerate(entries):
+        try:
+            entry = parse_canonical(entry_bytes, f"orphan.entries_b64[{i}]")
+        except Bad:
+            return f"range: entry {i+1} is not canonical"
+        if entry.get("prev") != prev:
+            return f"chain: entry {i+1} prev doesn't match expected {prev}"
+        # Next entry should chain from this entry's sha256
+        prev = hashlib.sha256(entry_bytes).hexdigest()
+    
+    # Head validation
+    last_hash = hashlib.sha256(entries[-1]).hexdigest()
+    if last_hash != pred.get("head_sha256"):
+        return f"head: last entry hash {last_hash} != attested head {pred.get('head_sha256')}"
+    
+    return None
 
 
