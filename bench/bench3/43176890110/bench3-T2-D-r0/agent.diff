+#!/usr/bin/env python3
+"""Quick test for _orphan_entries_problem function."""
+import json
+import base64
+import record as R
+import tempfile
+import os
+
+def test_orphan_entries_problem():
+    with tempfile.TemporaryDirectory() as d:
+        os.makedirs(os.path.join(d, "entries"))
+        # Create a simple chain: entry1 (plan), entry2 (plan), entry3 (verdict)
+        # We'll manually write entries to get known hashes
+        # entry1: plan
+        e1 = {
+            "seq": 1,
+            "prev": None,
+            "kind": "plan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "proposer",
+                "claim": "test",
+                "test": "test",
+                "decision_rule": "rule",
+                "baseline": "baseline",
+                "inputs": [],
+                "verdict_due": "9999-12-31",
+                "notes": ""
+            }
+        }
+        raw1 = R.canonical(e1)
+        # entry2: plan
+        e2 = {
+            "seq": 2,
+            "prev": R.hashlib.sha256(raw1).hexdigest(),
+            "kind": "plan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "proposer",
+                "claim": "test2",
+                "test": "test2",
+                "decision_rule": "rule2",
+                "baseline": "baseline2",
+                "inputs": [],
+                "verdict_due": "9999-12-31",
+                "notes": ""
+            }
+        }
+        raw2 = R.canonical(e2)
+        # entry3: verdict
+        e3 = {
+            "seq": 3,
+            "prev": R.hashlib.sha256(raw2).hexdigest(),
+            "kind": "verdict",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "verifier",
+                "plan": {"seq": 1, "sha256": R.hashlib.sha256(raw1).hexdigest()},
+                "outcome": "pass",
+                "evidence": [],
+                "notes": ""
+            }
+        }
+        raw3 = R.canonical(e3)
+        # Write to disk
+        with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
+            f.write(raw1)
+        with open(os.path.join(d, "entries", "000002.json"), "wb") as f:
+            f.write(raw2)
+        with open(os.path.join(d, "entries", "000003.json"), "wb") as f:
+            f.write(raw3)
+        
+        # Load chain to get head hash
+        chain, _ = R.load_chain(d)
+        head_hash = chain[-1][1]  # entry3's sha256
+        
+        # Create an orphan with entries_b64 that match the attested range 2-3
+        # We'll write a dummy orphan with entries_b64
+        orphan = {
+            "seq": 4,
+            "prev": chain[-1][1],
+            "kind": "orphan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "owner",
+                "log_index": 12345,
+                "reason": "run failed after attesting",
+                "statement_b64": base64.b64encode(json.dumps({
+                    "predicate": {
+                        "from_seq": 2,
+                        "to_seq": 3,
+                        "prev_sha256": chain[0][1],  # entry1's sha256
+                        "head_sha256": head_hash
+                    }
+                }).encode()).decode(),
+                "entries_b64": [
+                    base64.b64encode(raw2).decode(),
+                    base64.b64encode(raw3).decode()
+                ]
+            }
+        }
+        
+        # Test the function
+        pred = {"from_seq": 2, "to_seq": 3, "prev_sha256": chain[0][1], "head_sha256": head_hash}
+        problem = R._orphan_entries_problem(orphan, pred)
+        assert problem is None, f"Expected None, got {problem}"
+        print("PASS: valid orphan entries")
+        
+        # Test with wrong count (only one entry)
+        orphan2 = orphan.copy()
+        orphan2["body"] = orphan["body"].copy()
+        orphan2["body"]["entries_b64"] = [base64.b64encode(raw2).decode()]
+        problem = R._orphan_entries_problem(orphan2, pred)
+        assert problem is not None and "range" in problem, f"Expected range problem, got {problem}"
+        print(f"PASS: wrong count - {problem}")
+        
+        # Test with broken chain (wrong prev)
+        orphan3 = orphan.copy()
+        orphan3["body"] = orphan["body"].copy()
+        # tamper with second entry's prev in the entry (not the chain)
+        e3_tampered = json.loads(raw3.decode())
+        e3_tampered["prev"] = "bad"
+        raw3_tampered = R.canonical(e3_tampered)
+        orphan3["body"]["entries_b64"] = [
+            base64.b64encode(raw2).decode(),
+            base64.b64encode(raw3_tampered).decode()
+        ]
+        problem = R._orphan_entries_problem(orphan3, pred)
+        assert problem is not None and "chain" in problem, f"Expected chain problem, got {problem}"
+        print(f"PASS: broken chain - {problem}")
+        
+        # Test with wrong head hash
+        orphan4 = orphan.copy()
+        orphan4["body"] = orphan["body"].copy()
+        # change head hash in pred
+        pred_wrong = pred.copy()
+        pred_wrong["head_sha256"] = "0" * 64
+        problem = R._orphan_entries_problem(orphan4, pred_wrong)
+        assert problem is not None and "head" in problem, f"Expected head problem, got {problem}"
+        print(f"PASS: wrong head - {problem}")
+        
+        # Test with missing entries_b64 (should return None? Actually entries_b64 empty list)
+        orphan5 = orphan.copy()
+        orphan5["body"] = orphan["body"].copy()
+        orphan5["body"]["entries_b64"] = []
+        problem = R._orphan_entries_problem(orphan5, pred)
+        # Since expected count is 2, empty list -> wrong count, so problem with "range"
+        assert problem is not None and "range" in problem, f"Expected range problem for missing entries, got {problem}"
+        print(f"PASS: missing entries - {problem}")
+        
+        print("All tests passed")
+
+if __name__ == "__main__":
+    test_orphan_entries_problem()
