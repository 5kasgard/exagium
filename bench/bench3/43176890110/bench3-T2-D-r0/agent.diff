+#!/usr/bin/env python3
+"""Test orphan entries checking integration."""
+import json
+import base64
+import tempfile
+import os
+import sys
+sys.path.insert(0, '.')
+
+import record as R
+
+def test_orphan_entries_in_monitor():
+    """Simulate the monitor's orphan checking with entries_b64."""
+    with tempfile.TemporaryDirectory() as d:
+        os.makedirs(os.path.join(d, "entries"))
+        
+        # Create a simple chain: entry1 (plan), entry2 (plan), entry3 (verdict)
+        e1 = {
+            "seq": 1,
+            "prev": None,
+            "kind": "plan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "proposer",
+                "claim": "test",
+                "test": "test",
+                "decision_rule": "rule",
+                "baseline": "baseline",
+                "inputs": [],
+                "verdict_due": "9999-12-31",
+                "notes": ""
+            }
+        }
+        raw1 = R.canonical(e1)
+        
+        e2 = {
+            "seq": 2,
+            "prev": R.hashlib.sha256(raw1).hexdigest(),
+            "kind": "plan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "proposer",
+                "claim": "test2",
+                "test": "test2",
+                "decision_rule": "rule2",
+                "baseline": "baseline2",
+                "inputs": [],
+                "verdict_due": "9999-12-31",
+                "notes": ""
+            }
+        }
+        raw2 = R.canonical(e2)
+        
+        e3 = {
+            "seq": 3,
+            "prev": R.hashlib.sha256(raw2).hexdigest(),
+            "kind": "verdict",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "verifier",
+                "plan": {"seq": 1, "sha256": R.hashlib.sha256(raw1).hexdigest()},
+                "outcome": "pass",
+                "evidence": [],
+                "notes": ""
+            }
+        }
+        raw3 = R.canonical(e3)
+        
+        # Write to disk
+        with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
+            f.write(raw1)
+        with open(os.path.join(d, "entries", "000002.json"), "wb") as f:
+            f.write(raw2)
+        with open(os.path.join(d, "entries", "000003.json"), "wb") as f:
+            f.write(raw3)
+        
+        chain, _ = R.load_chain(d)
+        head_hash = chain[-1][1]
+        
+        # Simulate monitor by calling _orphan_entries_problem directly
+        # This mimics what cmd_monitor does
+        orphan = {
+            "seq": 4,
+            "prev": chain[-1][1],
+            "kind": "orphan",
+            "written_at": "2024-01-01T00:00:00Z",
+            "body": {
+                "by": "owner",
+                "log_index": 12345,
+                "reason": "run failed after attesting",
+                "statement_b64": base64.b64encode(json.dumps({
+                    "predicate": {
+                        "from_seq": 2,
+                        "to_seq": 3,
+                        "prev_sha256": chain[0][1],
+                        "head_sha256": head_hash
+                    }
+                }).encode()).decode(),
+                "entries_b64": [
+                    base64.b64encode(raw2).decode(),
+                    base64.b64encode(raw3).decode()
+                ]
+            }
+        }
+        
+        pred = {"from_seq": 2, "to_seq": 3, "prev_sha256": chain[0][1], "head_sha256": head_hash}
+        problem = R._orphan_entries_problem(orphan, pred)
+        assert problem is None, f"Expected None, got {problem}"
+        
+        # Now test with a bad orphan (wrong entries)
+        orphan_bad = orphan.copy()
+        orphan_bad["body"] = orphan["body"].copy()
+        # Tamper with entry2's body (change claim)
+        e2_tampered = json.loads(raw2.decode())
+        e2_tampered["body"]["claim"] = "tampered"
+        raw2_tampered = R.canonical(e2_tampered)
+        orphan_bad["body"]["entries_b64"][0] = base64.b64encode(raw2_tampered).decode()
+        
+        problem = R._orphan_entries_problem(orphan_bad, pred)
+        # The prev of entry2 in the tampered entry will be wrong (the prev chain will be different)
+        # So it should be a "chain" problem
+        assert problem is not None and "chain" in problem, f"Expected chain problem, got {problem}"
+        
+        print("All integration tests passed")
+
+if __name__ == "__main__":
+    test_orphan_entries_in_monitor()
