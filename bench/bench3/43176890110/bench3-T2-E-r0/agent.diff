+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """None if the orphan's entries_b64 are exactly the range pred attests, else a short reason they can't hide it.
+
+    An orphan's statement alone hides whatever the attested range held, such as a failing verdict. The count must be
+    to_seq-from_seq+1, the first entry must chain from prev_sha256, each next one from the previous entry's sha256,
+    and the last entry's sha256 must be head_sha256."""
+    body = orphan.get("body") if isinstance(orphan, dict) else None
+    entries = body.get("entries_b64") if isinstance(body, dict) else None
+    p = pred if isinstance(pred, dict) else {}
+    lo, hi = p.get("from_seq"), p.get("to_seq")
+    if not isinstance(entries, list):
+        return f"no entries_b64, so the attested range {lo}-{hi} is hidden"
+    if not all(isinstance(x, int) and not isinstance(x, bool) for x in (lo, hi)):
+        return f"the attested range {lo}-{hi} isn't two integers, so it can't be checked"
+    want = hi - lo + 1
+    if len(entries) != want:
+        return f"{len(entries)} entries, not the {want} in the attested range {lo}-{hi}"
+    raw = []
+    for i, b in enumerate(entries):
+        if not isinstance(b, str):
+            return f"entries_b64[{i}] isn't base64, so the attested range {lo}-{hi} can't be checked"
+        try:
+            raw.append(base64.b64decode(b, validate=True))
+        except (TypeError, ValueError):
+            return f"entries_b64[{i}] isn't base64, so the attested range {lo}-{hi} can't be checked"
+    es = []
+    for i, b in enumerate(raw):
+        try:
+            e = parse_canonical(b, f"entries_b64[{i}]")
+        except Bad:
+            return f"entries_b64[{i}] isn't a canonical entry, so the attested range {lo}-{hi} can't be checked"
+        if not isinstance(e, dict) or "prev" not in e:
+            return f"entries_b64[{i}] isn't an entry, so the attested range {lo}-{hi} can't be checked"
+        es.append((e, hashlib.sha256(b).hexdigest()))
+    if es[0][0]["prev"] != p.get("prev_sha256"):
+        return f"entry 1 doesn't chain from prev_sha256 {p.get('prev_sha256')}"
+    for i in range(1, len(es)):
+        if es[i][0]["prev"] != es[i - 1][1]:
+            return f"entry {i + 1} doesn't chain from entry {i}'s sha256"
+    if es[-1][1] != p.get("head_sha256"):
+        return f"the last entry hashes to {es[-1][1]}, not the attested head {p.get('head_sha256')}"
+    return None
+
