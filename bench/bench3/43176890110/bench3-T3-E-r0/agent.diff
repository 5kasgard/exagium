@@ -243,6 +243,37 @@ class Ledger(unittest.TestCase):
             for k, f in saved.items():
                 setattr(R, k, f)
 
+    def test_check_anchors_flags_a_long_pending_proof(self):
+        # A scheduled job that completes pending proofs can fail silently: nothing noticed for five days because a
+        # pending proof is acceptable. --max-pending-hours makes a stale pending proof wrong; without it, it isn't.
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        open(os.path.join(self.d, "anchors", "000002.ots"), "wb").write(b"stub")
+        pred = R.range_predicate(chain, 1, 2)
+        stubs = {"check_ots": lambda *a: None,
+                 "check_sigstore": lambda *a: (R.now_ts() - 5 * 3600, pred, "c0ffee")}
+        saved = {k: getattr(R, k) for k in stubs}
+        try:
+            for k, f in stubs.items():
+                setattr(R, k, f)
+            self.assertEqual(self.run_cmd("check-anchors")[0], 0)  # pending is acceptable without the option
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "72")[0], 0)
+            stubs["check_sigstore"] = lambda *a: (R.now_ts() - 73 * 3600, pred, "c0ffee")
+            setattr(R, "check_sigstore", stubs["check_sigstore"])
+            rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "72")
+            self.assertEqual(rc, 1)
+            self.assertIn("still pending 73 h", err)
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "100")[0], 0)
+            self.assertEqual(self.run_cmd("check-anchors")[0], 0)  # and still accepted without the option
+            stubs["check_ots"] = lambda *a: R.now_ts()  # once confirmed, no limit can be too small
+            setattr(R, "check_ots", stubs["check_ots"])
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "1")[0], 0)
+        finally:
+            for k, f in saved.items():
+                setattr(R, k, f)
+
     def test_unknown_files_and_fields_are_refused(self):
         self._two_entries()
         open(os.path.join(self.d, "entries", "notes.txt"), "w").write("x")
