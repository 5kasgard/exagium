+    def test_a_stuck_pending_proof_is_only_flagged_when_asked(self):
+        # the scheduled job that completes proofs can stall for days; check-anchors must stay silent unless asked
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        open(os.path.join(self.d, "anchors", "000002.ots"), "wb").write(b"stub")
+        attested = datetime.datetime.now(datetime.timezone.utc).timestamp() - 72 * 3600
+        stubs = {"check_sigstore": lambda *a: (attested, R.range_predicate(chain, 1, 2), "c0ffee"),
+                 "check_ots": lambda *a: None}
+        saved = {k: getattr(R, k) for k in stubs}
+        try:
+            for k, f in stubs.items():
+                setattr(R, k, f)
+            self.assertEqual(self.run_cmd("check-anchors")[0], 0)
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "-1")[0], 1)
+            rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "24")
+            self.assertEqual(rc, 1)
+            self.assertIn("still pending 72 h", err)
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "96")[0], 0)
+            setattr(R, "check_ots", lambda *a: 1)  # confirmed in a block: no longer pending
+            self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "24")[0], 0)
+        finally:
+            for k, f in saved.items():
+                setattr(R, k, f)
+
     def test_unknown_files_and_fields_are_refused(self):
         self._two_entries()
         open(os.path.join(self.d, "entries", "notes.txt"), "w").write("x")
