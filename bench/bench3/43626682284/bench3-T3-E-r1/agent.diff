 """Tests for record.py's ledger rules (offline; anchors are tested in CI)."""
+import datetime
 import io, json, os, shutil, tempfile, unittest, contextlib, hashlib
 import record as R
 
@@ -243,6 +244,32 @@ class Ledger(unittest.TestCase):
             for k, f in saved.items():
