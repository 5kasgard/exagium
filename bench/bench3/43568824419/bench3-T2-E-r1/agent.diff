+def _statement_predicate(orphan, where="statement"):
+    """The predicate the orphan's statement carries, or {} if it isn't a JSON object with a predicate."""
+    try:
+        st = parse_json(base64.b64decode(orphan["body"]["statement_b64"], validate=True), where)
+        pred = st.get("predicate") if isinstance(st, dict) else None
+    except (Bad, ValueError, KeyError, TypeError):
+        return {}
+    return pred if isinstance(pred, dict) else {}
+
+
+def _is_range(pred):
+    return isinstance(pred, dict) and all(isinstance(pred.get(k), int) and not isinstance(pred.get(k), bool)
+                                          for k in ("from_seq", "to_seq"))
+
+
+def _orphan_entries_problem(orphan, pred):
+    """Why the entries an orphan hid don't account for the range its statement attests, or None if they do.
+
+    The hidden entries are the only evidence the orphan offers for an attestation the ledger never held: they must
+    be exactly the attested range, chained on both ends, or the orphan could explain away an attested entry."""
+    if not _is_range(pred):  # fail closed: a statement that attests no range proves nothing about hidden entries
+        return f"range: the statement isn't a predicate with integer from_seq and to_seq ({pred!r})"
+    lo, hi = pred["from_seq"], pred["to_seq"]
+    body = orphan.get("body") if isinstance(orphan, dict) else None
+    listed = body.get("entries_b64") if isinstance(body, dict) else None
+    if not isinstance(listed, list) or not listed:
+        return f"range: no hidden entries are published for the attested range {lo}-{hi}"
+    entries = []
+    for i, x in enumerate(listed):
+        try:
+            entries.append(base64.b64decode(x, validate=True))
+        except (ValueError, TypeError):
+            return f"range: hidden entry {lo + i} isn't base64-encoded entry bytes"
+    if len(entries) != hi - lo + 1:
+        return f"range: {len(entries)} hidden entries for an attested range of {hi - lo + 1} ({lo}-{hi})"
+    prev = pred.get("prev_sha256")
+    for i, raw in enumerate(entries):
+        try:
+            e = parse_canonical(raw, f"hidden entry {lo + i}")
+        except Bad as ex:
+            return f"chain: hidden entry {lo + i} isn't an entry in canonical form ({ex})"
+        if not isinstance(e, dict) or e.get("prev") != prev:
+            return f"chain: hidden entry {lo + i} doesn't chain from {prev}"
+        prev = hashlib.sha256(canonical(e)).hexdigest()
+    if prev != pred.get("head_sha256"):
+        return f"head: the hidden entries end at {prev}, not the attested head {pred.get('head_sha256')}"
+    return None
+
+
+def _orphan_problem(orphan):
+    """Why an orphan entry is wrong, or None. A statement that attests no range is only wrong to the monitor, which
+    can weigh it against the writer's attestations; one that attests a range is wrong wherever the orphan is read, so
+    the ledger's own commands refuse it too."""
+    pred = _statement_predicate(orphan, "orphan statement")
+    return _orphan_entries_problem(orphan, pred) if _is_range(pred) else None
+
