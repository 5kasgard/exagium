+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that an orphan hides exactly the entries attested by pred.
+    
+    Returns None if valid, otherwise a problem string with 'range', 'chain', or 'head'.
+    """
+    if "entries_b64" not in orphan["body"]:
+        return "missing entries_b64"
+    
+    # Decode entries
+    try:
+        entries = [base64.b64decode(b64) for b64 in orphan["body"]["entries_b64"]]
+    except Exception:
+        return "invalid entries_b64"
+    
+    # Check count
+    expected_count = pred.get("to_seq", 0) - pred.get("from_seq", 0) + 1
+    if expected_count < 0:
+        return "invalid predicate"
+    
+    if len(entries) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries)}"
+    
+    # Check chain
+    prev_hash = pred.get("prev_sha256")
+    for i, entry_bytes in enumerate(entries):
+        entry = parse_canonical(entry_bytes, f"orphan entries[{i}]")
+        if i == 0:
+            if entry.get("prev") != prev_hash:
+                return "chain: first entry's prev doesn't match"
+        else:
+            prev_entry_bytes = entries[i - 1]
+            expected_prev = hashlib.sha256(prev_entry_bytes).hexdigest()
+            if entry.get("prev") != expected_prev:
+                return f"chain: entry {i} prev doesn't match previous entry's sha256"
+    
+    # Check head
+    last_entry_bytes = entries[-1]
+    last_hash = hashlib.sha256(last_entry_bytes).hexdigest()
+    if last_hash != pred.get("head_sha256"):
+        return f"head: last entry's hash {last_hash} doesn't match head_sha256 {pred.get('head_sha256')}"
+    
+    return None
 
 
