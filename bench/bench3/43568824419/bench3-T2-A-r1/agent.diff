+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that the orphan's entries_b64 matches the attested range exactly.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+
+    if from_seq is None or to_seq is None or head_sha256 is None:
+        return "predicate missing required fields"
+
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count mismatch: expected {expected_count}, got {len(entries_b64)}"
+
+    prev = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        entry_raw = base64.b64decode(entry_b64)
+        entry = parse_json(entry_raw, f"entries_b64[{i}]")
+        if entry.get("prev") != prev:
+            return f"chain break at index {i}: entry prev {entry.get('prev')} != expected {prev}"
+        prev = hashlib.sha256(entry_raw).hexdigest()
+
+    if prev != head_sha256:
+        return f"head mismatch: computed {prev} != attested {head_sha256}"
+
+    return None
+
