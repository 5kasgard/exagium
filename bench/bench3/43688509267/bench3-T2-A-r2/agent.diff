+# ---------- orphan entries validation ----------
+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that an orphan's hidden entries match the attested range.
+    
+    Returns None if the entries are valid, otherwise returns a problem string
+    containing 'range', 'chain', or 'head' indicating the issue.
+    """
+    entries_b64 = orphan["body"].get("entries_b64")
+    if not isinstance(entries_b64, list):
+        return "range: entries_b64 must be a list"
+    
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    if not isinstance(from_seq, int) or not isinstance(to_seq, int):
+        return "range: predicate missing from_seq or to_seq"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"chain: entry {i} is not valid base64"
+        
+        entry = parse_json(entry_raw, f"orphan entry {i}")
+        if entry is None:
+            return f"chain: entry {i} is not valid JSON"
+        
+        if not isinstance(entry, dict) or "prev" not in entry:
+            return f"chain: entry {i} missing prev field"
+        
+        if entry["prev"] != prev_hash:
+            return f"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev_hash!r}"
+        
+        prev_hash = hashlib.sha256(entry_raw).hexdigest()
+    
+    if prev_hash != head_sha256:
+        return f"head: last entry hash {prev_hash!r} doesn't match head_sha256 {head_sha256!r}"
+    
+    return None
+
+
