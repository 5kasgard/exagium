+    def test_orphan_must_publish_the_entries_it_hid(self):
+        # review: an orphan explained only by its statement could hide an attested entry, e.g. a failing verdict
+        prev = "a" * 64
+        e1 = self._verdict_entry(1, prev)
+        h1 = hashlib.sha256(R.canonical(e1)).hexdigest()
+        e2 = self._verdict_entry(2, h1)
+        h2 = hashlib.sha256(R.canonical(e2)).hexdigest()
+        pred = {"from_seq": 1, "to_seq": 2, "prev_sha256": prev, "head_sha256": h2}
+        orphan = {"seq": 9, "body": self._hidden(e1, e2)}
+        self.assertIsNone(R._orphan_entries_problem(orphan, pred))
+        # a missing entry changes the count
+        self.assertIn("range", R._orphan_entries_problem({"seq": 9, "body": self._hidden(e1)}, pred))
+        # a broken link is caught before the head check can hide it
