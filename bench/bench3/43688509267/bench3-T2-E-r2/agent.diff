+def _orphan_entries_problem(orphan, pred):
+    """None if the orphan's entries are exactly the attested range, else a short problem (range/chain/head).
+
+    The orphan's entries_b64 are the hidden range's canonical bytes, in order; they are the only record of what
+    the failed run published, so they must be that many entries, chain to each other and end at the attested head."""
+    try:
+        raw = [base64.b64decode(x, validate=True) for x in (orphan.get("body") or {}).get("entries_b64")]
+    except (AttributeError, TypeError, ValueError):
+        return "range: the orphan publishes no entries for the attested range"
+    if not isinstance(pred, dict) or not isinstance(pred.get("from_seq"), int) or isinstance(pred.get("from_seq"), bool) \
+            or not isinstance(pred.get("to_seq"), int) or isinstance(pred.get("to_seq"), bool) or pred["from_seq"] > pred["to_seq"]:
+        return "range: the statement has no from_seq and to_seq"
+    entries = [parse_canonical(b, f"orphan {orphan.get('seq')}: entry {i + 1}") for i, b in enumerate(raw)]
+    from_seq, to_seq = pred["from_seq"], pred["to_seq"]
+    if len(entries) != to_seq - from_seq + 1:
+        return f"range: holds {len(entries)} entries, not the {to_seq - from_seq + 1} of {from_seq}-{to_seq}"
+    prev = pred.get("prev_sha256")
+    for e in entries:
+        if not isinstance(e, dict) or e.get("prev") != prev:
+            return "chain: an entry's prev isn't the previous entry's sha256"
+        prev = hashlib.sha256(canonical(e)).hexdigest()
+    if prev != pred.get("head_sha256"):
+        return f"head: the last entry's sha256 isn't the attested head {pred.get('head_sha256')}"
+    return None
+
