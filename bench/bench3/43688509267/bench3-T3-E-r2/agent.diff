+    def _stuck_proof(self, attested_hours_ago):
+        """A chain of two entries, one range attested now minus that many hours, with a pending OTS proof."""
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        with open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w") as f:
+            f.write("{}")
+        with open(os.path.join(self.d, "anchors", "000002.ots"), "wb") as f:
+            f.write(b"stub")
+        t = int(datetime.datetime.now(datetime.timezone.utc).timestamp()) - attested_hours_ago * 3600 - 600
+        stubs = {"check_sigstore": lambda *a: (t, R.range_predicate(chain, 1, 2), "c0ffee"), "check_ots": lambda *a: None}
+        saved = {k: getattr(R, k) for k in stubs}
+        for k, f in stubs.items():
+            setattr(R, k, f)
+        self.addCleanup(lambda: [setattr(R, k, f) for k, f in saved.items()])
+
+    def test_a_stuck_pending_proof_is_accepted_by_default(self):
+        # a pending proof is not wrong by itself: without the option it stays accepted, however old it is
+        self._stuck_proof(72)
+        self.assertEqual(self.run_cmd("check-anchors")[0], 0)
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "100")[0], 0)
+
+    def test_a_pending_proof_younger_than_the_limit_is_fine(self):
+        self._stuck_proof(5)
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "24")[0], 0)
+
+    def test_a_stuck_pending_proof_exits_1_with_max_pending_hours(self):
+        # the five-day silence: a proof pending far longer than the writer needs is a completion that failed
+        self._stuck_proof(72)
+        rc, out, err = self.run_cmd("check-anchors", "--max-pending-hours", "24")
+        self.assertEqual(rc, 1)
+        self.assertIn("still pending 72 h", err)
+        rep = json.loads(out)
+        self.assertEqual([(p["anchor"], p["attested_by"], p["still_pending_hours"]) for p in rep["still_pending"]],
+                         [("000002.ots", rep["anchors"][-1]["existed_by"], 72)])
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "72")[0], 0)  # exactly H hours is fine
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "0")[0], 1)
+
