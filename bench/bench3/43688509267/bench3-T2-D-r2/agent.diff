+# ---------- orphan entry validation ----------
+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check if an orphan hides exactly the entries it attested to be hidden.
+    
+    Returns None if the orphan is valid (the hidden entries match the attested range),
+    otherwise returns a problem string containing 'range', 'chain', or 'head'.
+    """
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    if from_seq is None or to_seq is None or prev_sha256 is None or head_sha256 is None:
+        return "range"  # predicate missing required fields
+    
+    # Get the entries from the orphan
+    entries_b64 = orphan.get("body", {}).get("entries_b64", [])
+    if not isinstance(entries_b64, list):
+        return "range"
+    
+    # Check count
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return "range"
+    
+    # Decode all entries
+    decoded_entries = []
+    for enc in entries_b64:
+        try:
+            decoded_entries.append(base64.b64decode(enc, validate=True))
+        except (ValueError, TypeError):
+            return "range"
+    
+    # Parse first entry
+    try:
+        first_entry = json.loads(decoded_entries[0].decode("utf-8"))
+    except (json.JSONDecodeError, UnicodeDecodeError):
+        return "range"
+    
+    # Check first entry's prev matches pred["prev_sha256"]
+    if first_entry.get("prev") != prev_sha256:
+        return "chain"
+    
+    # Check chain links and head hash
+    current_prev = first_entry.get("prev")
+    for i, entry_bytes in enumerate(decoded_entries):
+        try:
+            entry = json.loads(entry_bytes.decode("utf-8"))
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            return "range"
+        
+        if i == 0:
+            # Already checked first entry
+            pass
+        else:
+            # Check that each entry chains from the previous one's sha256
+            if entry.get("prev") != hashlib.sha256(decoded_entries[i-1]).hexdigest():
+                return "chain"
+        
+        # Check last entry's sha256 matches pred["head_sha256"]
+        if i == len(decoded_entries) - 1:
+            if hashlib.sha256(entry_bytes).hexdigest() != head_sha256:
+                return "head"
+    
+    # All checks passed
+    return None
