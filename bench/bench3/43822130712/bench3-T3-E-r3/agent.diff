+    def _anchored(self):
+        """A two-entry chain with the range-head (entry 2) anchor pair, checked with stubbed anchor checks."""
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        open(os.path.join(self.d, "anchors", "000002.ots"), "wb").write(b"stub")
+        return chain
+
+    def _stub_anchors(self, chain, attested_hours_ago, confirmed):
+        now = datetime.datetime.now(datetime.timezone.utc).timestamp()
+        stubs = {"check_sigstore": lambda *a: (int(now - attested_hours_ago * 3600),
+                                               R.range_predicate(chain, 1, 2), "c0ffee"),
+                 "check_ots": lambda *a: None if not confirmed else int(now - 60)}
+        self._patch(stubs)
+
+    def _patch(self, stubs):
+        saved = {k: getattr(R, k) for k in stubs}
+        self.addCleanup(lambda: [setattr(R, k, f) for k, f in saved.items()])
+        for k, f in stubs.items():
+            setattr(R, k, f)
+
+    def test_a_stuck_pending_proof_is_caught_with_max_pending_hours(self):
+        # a pending proof is normal for hours; the daily run that completes them can fail silently for days,
+        # and nothing noticed because check-anchors accepted a pending proof. Now --max-pending-hours names a limit.
+        chain = self._anchored()
+        self._stub_anchors(chain, 72, confirmed=False)
+        self.assertEqual(self.run_cmd("check-anchors")[0], 0)  # opt-in: unchanged by default
+        rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "24")
+        self.assertEqual(rc, 1)
+        self.assertIn("still pending 72 h", err)
+
+    def test_a_young_pending_proof_and_a_confirmed_proof_pass_with_max_pending_hours(self):
+        chain = self._anchored()
+        self._stub_anchors(chain, 1, confirmed=False)
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "24")[0], 0)
+        self._stub_anchors(chain, 1000, confirmed=True)
+        self.assertEqual(self.run_cmd("check-anchors", "--max-pending-hours", "24")[0], 0)
+
+    def test_only_a_stale_pending_range_head_is_wrong(self):
+        # a pending proof for an entry the writer never attested isn't the writer's promise; only a range head's is
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        for n in ("000001.ots", "000002.ots"):
+            open(os.path.join(self.d, "anchors", n), "wb").write(b"stub")
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        old = int(datetime.datetime.now(datetime.timezone.utc).timestamp() - 1000 * 3600)
+        # entry 1's Sigstore attestation is ancient and its proof pending, but the head's is fresh
+        self._patch({"check_sigstore": lambda *a: (old if len(a) and "000001" in str(a) else int(
+            datetime.datetime.now(datetime.timezone.utc).timestamp() - 3600), R.range_predicate(chain, 1, 2), "c0ffee"),
+            "check_ots": lambda *a: None})
+        rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "24")
+        self.assertEqual(rc, 0, err)
