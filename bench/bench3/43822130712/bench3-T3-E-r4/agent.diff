+        stubs = {"check_sigstore": lambda *a: (attested_at, R.range_predicate(chain, 1, 2), "c0ffee"),
+                 "check_ots": lambda *a: None}
+        saved = {k: getattr(R, k) for k in stubs}
+        self.addCleanup(lambda: [setattr(R, k, f) for k, f in saved.items()])
