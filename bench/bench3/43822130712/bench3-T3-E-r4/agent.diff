+    def test_pending_proof_is_accepted_without_max_pending_hours(self):
+        self._stuck_range_head()
+        rc, out, err = self.run_cmd("check-anchors")
+        self.assertEqual(rc, 0)
+        self.assertNotIn("pending", err)
+        self.assertIn('"existed_by": "pending"', out)
+
+    def test_a_stuck_pending_proof_fails_with_max_pending_hours(self):
+        # a scheduled job completes pending proofs; for five days it failed silently, and pending read as acceptable
