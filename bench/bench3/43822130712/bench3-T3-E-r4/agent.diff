     return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else None
 
 
+def pending_problem(attested_at, max_pending_hours, now=None):
+    """A range head still pending H hours after the writer attested it: the job that completes proofs is stuck,
+    which used to be silent because pending counted as acceptable. Returns the message, or None."""
+    if max_pending_hours is None or attested_at is None:
+        return None
+    now = now or datetime.datetime.now(datetime.timezone.utc).timestamp()
+    age = int((now - attested_at) // 3600)  # whole hours, so a proof pending 71h59m still reads 71 h
+    return f"still pending {age} h (attested {iso(attested_at)})" if age > max_pending_hours else None
+
