+    # ---- an orphan must publish the entries its statement attests ----
+    def _attested(self, n):
+        """The predicate of a run that added entries 1..n, and their bytes."""
+        chain, _ = R.load_chain(self.d)
+        raws = []
+        for i in range(1, n + 1):
+            with open(self.entry(i), "rb") as f:
+                raws.append(f.read())
+        return R.range_predicate(chain, 1, n), raws
+
+    def _statement(self, pred):
+        return R.canonical({"_type": "https://in-toto.io/Statement/v1", "predicateType": "exagium/record-range",
+                            "predicate": pred, "subject": []})
+
+    def _orphan_body(self, pred, raws):
+        return {"by": "owner", "log_index": 12345, "reason": "run failed after attesting",
+                "statement_b64": base64.b64encode(self._statement(pred)).decode(),
+                "entries_b64": [base64.b64encode(r).decode() for r in raws]}
+
+    def _refused(self, body):
+        """Ingest the orphan, then run monitor with Rekor stubbed: exit 1 with the problem, or 0 if accepted."""
+        self.propose("o.json", "orphan", body)
+        rc, _, err = self.run_cmd("ingest")
+        self.assertEqual(rc, 0, f"the orphan proposal was refused at ingest: {err}")
+        return self.run_cmd("monitor", "--only-ref", "refs/heads/main")[0::2]
+
+    def _stub_monitor(self, pred):
+        """Answer Rekor with a DSSE entry whose payload is exactly this orphan's statement, and no git history."""
+        stmt = self._statement(pred)
+        def get(url, data=None, timeout=20, headers=False):
+            if "index/retrieve" in url:
+                return json.dumps(["u"]).encode()
+            if url.endswith("/log/entries/u"):
+                v = {"logIndex": 12345, "integratedTime": 1770000000,
+                     "body": base64.b64encode(R.canonical({"kind": "dsse", "spec": {
+                         "payloadHash": {"value": hashlib.sha256(stmt).hexdigest()}}})).decode()}
+                return json.dumps({"u": v}).encode()
+            return (b"[]", {}) if headers else b"[]"
+        saved = (R._get, R._published_entry_hashes)
+        R._get = get
+        R._published_entry_hashes = lambda a, rev: set()
+        self.addCleanup(lambda: setattr(R, "_get", saved[0]))
+        self.addCleanup(lambda: setattr(R, "_published_entry_hashes", saved[1]))
+
+    def _orphan_no_entries(self, pred):
+        return {"by": "owner", "log_index": 12345, "reason": "run failed after attesting",
+                "statement_b64": base64.b64encode(self._statement(pred)).decode()}
+
+    def test_orphan_without_entries_is_refused(self):
+        self._two_entries()
+        pred, _ = self._attested(2)
+        self._stub_monitor(pred)
+        rc, err = self._refused(self._orphan_no_entries(pred))
+        self.assertEqual(rc, 1)
+        self.assertIn("entries_b64", err)
+
+    def test_orphan_hiding_an_attested_entry_is_refused(self):
+        # an orphan explained by its statement alone could hide an attested entry, e.g. a fail verdict
+        self._two_entries()
+        pred, raws = self._attested(2)
+        self._stub_monitor(pred)
+        rc, err = self._refused(self._orphan_body(pred, raws[:1]))
+        self.assertEqual(rc, 1)
+        self.assertIn("range", err)
+
+    def test_orphan_with_a_broken_chain_is_refused(self):
+        self._two_entries()
+        pred, raws = self._attested(2)
+        self._stub_monitor(pred)
+        e2 = json.loads(raws[1])
+        e2["prev"] = "0" * 64
+        rc, err = self._refused(self._orphan_body(pred, [raws[0], R.canonical(e2)]))
+        self.assertEqual(rc, 1)
+        self.assertIn("chain", err)
+
+    def test_orphan_with_a_wrong_head_is_refused(self):
+        self._two_entries()
+        pred, raws = self._attested(2)
+        self._stub_monitor(pred)
+        e2 = json.loads(raws[1])
+        e2["body"]["claim"] = "edited"  # still chains, but isn't the attested head
+        rc, err = self._refused(self._orphan_body(pred, [raws[0], R.canonical(e2)]))
+        self.assertEqual(rc, 1)
+        self.assertIn("head", err)
+
+    def test_orphan_with_the_attested_entries_is_accepted(self):
+        self._two_entries()
+        pred, raws = self._attested(2)
+        self._stub_monitor(pred)
+        self.assertEqual(self._refused(self._orphan_body(pred, raws))[0], 0)
+
+    def test_orphan_entries_problem_accepts_only_the_exact_range(self):
+        self._two_entries()
+        pred, raws = self._attested(2)
+        enc = lambda rs: {"body": {"entries_b64": [base64.b64encode(r).decode() for r in rs]}}
+        self.assertIsNone(R._orphan_entries_problem(enc(raws), pred))
+        self.assertIn("range", R._orphan_entries_problem(enc(raws[:1]), pred))
+        self.assertIn("range", R._orphan_entries_problem(enc(raws + raws[:1]), pred))
+        self.assertIn("chain", R._orphan_entries_problem(enc([raws[1], raws[0]]), pred))
+        self.assertIn("chain", R._orphan_entries_problem(enc([raws[1]] * 2), pred))
+        e2 = json.loads(raws[1]); e2["body"]["claim"] = "edited"
+        self.assertIn("head", R._orphan_entries_problem(enc([raws[0], R.canonical(e2)]), pred))
+        # wrong data, not a crash: a statement with no usable predicate
+        self.assertIsNotNone(R._orphan_entries_problem(enc(raws), {}))
+        self.assertIsNotNone(R._orphan_entries_problem(enc(raws), {"from_seq": 1, "to_seq": 0,
+                                                                  "prev_sha256": None, "head_sha256": "0" * 64}))
 
