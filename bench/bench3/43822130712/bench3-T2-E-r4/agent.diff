+def _orphan_entries_problem(orphan, pred):
+    """None if the orphan publishes exactly the attested range as its entries_b64, else a short problem string.
+
+    The entries must be canonical entry bytes, from_seq..to_seq of them, each chaining from the previous one's
+    sha256 (the first from pred["prev_sha256"]) and the last hashing to pred["head_sha256"]. An orphan that
+    hides fewer, more, or different entries than it attests is refused: its statement alone explains nothing."""
+    try:
+        raws = [base64.b64decode(x, validate=True) for x in orphan["body"]["entries_b64"]]
+    except (KeyError, TypeError, ValueError):
+        return "orphan doesn't publish its attested entries (entries_b64)"
+    if not isinstance(pred, dict):
+        return "the statement has no predicate to check the entries against"
+    lo, hi = pred.get("from_seq"), pred.get("to_seq")
+    if not isinstance(lo, int) or isinstance(lo, bool) or not isinstance(hi, int) or isinstance(hi, bool) \
+            or lo < 1 or hi < lo:
+        return f"statement has no usable seq bounds (from_seq {lo!r}, to_seq {hi!r})"
+    want = hi - lo + 1
+    if len(raws) != want:
+        return f"entries cover {len(raws)} in the range, attested range {lo}-{hi} has {want}"
+    prev = pred.get("prev_sha256")
+    for i, raw in enumerate(raws):
+        try:
+            e = parse_canonical(raw, f"orphan entry {i + 1}")
+        except Bad as ex:
+            return f"entry {i + 1} isn't a canonical entry ({ex})"
+        if e.get("prev") != prev:
+            return f"entry {i + 1} doesn't chain from the previous one (prev {e.get('prev')!r} != {prev!r})"
+        prev = hashlib.sha256(raw).hexdigest()
+    if prev != pred.get("head_sha256"):
+        return f"head hash {prev} doesn't match head_sha256 {pred.get('head_sha256')!r}"
+    return None
+
