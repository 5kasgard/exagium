+    def test_check_anchors_requires_an_ots_proof_for_each_range_head(self):
+        # an outside verifier deleted a range head's proof; coverage alone (Sigstore) must not pass.
+        # No sigstore/ots libraries here, so stub their verification to keep this test offline.
+        orig, orig_ots = R.check_sigstore, R.check_ots
+        R.check_sigstore = lambda p, d, r, w, f: (0, R.range_predicate(R.load_chain(self.d)[0],
+                                                                       int(os.path.basename(p)[:6]),
+                                                                       int(os.path.basename(p)[:6])), "commit")
+        R.check_ots = lambda p, raw, explorers: 0
+        self.addCleanup(lambda: setattr(R, "check_sigstore", orig))
+        self.addCleanup(lambda: setattr(R, "check_ots", orig_ots))
+        self._two_entries()
+        os.makedirs(os.path.join(self.d, "anchors"))
+        for n in ("000001", "000002"):
+            with open(os.path.join(self.d, "anchors", f"{n}.sigstore.json"), "w") as f:
+                f.write("{}")
+            with open(os.path.join(self.d, "anchors", f"{n}.ots"), "w") as f:
+                f.write("{}")
+        # present: the command is unchanged (exit 0)
+        self.assertEqual(self.run_cmd("check-anchors")[0], 0)
+        # deleted proof: wrong data, exit 1, message on stderr
+        os.remove(os.path.join(self.d, "anchors", "000002.ots"))
+        rc, _, err = self.run_cmd("check-anchors")
+        self.assertEqual(rc, 1)
+        self.assertIn("000002.ots is missing", err)
+        self.assertNotIn("000001.ots is missing", err)  # a present proof isn't called missing
+        # two deleted proofs: both are reported, not just the first
+        os.remove(os.path.join(self.d, "anchors", "000001.ots"))
+        rc, _, err = self.run_cmd("check-anchors")
+        self.assertEqual(rc, 1)
+        self.assertIn("000001.ots is missing", err)
+        self.assertIn("000002.ots is missing", err)
+
     def test_unknown_files_and_fields_are_refused(self):
