+# ---------- orphan validation ----------
+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check if an orphan entry's hidden entries match the attested range exactly.
+    
+    Returns:
+        None if the orphan entries match the predicate exactly
+        "range" if the count doesn't match (to_seq - from_seq + 1)
+        "chain" if any entry's prev doesn't chain from previous entry or first entry doesn't start from pred["prev_sha256"]
+        "head" if the last entry's sha256 doesn't match pred["head_sha256"]
+    """
+    entries_b64 = orphan["body"].get("entries_b64", [])
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    # Expected number of entries
+    expected_count = to_seq - from_seq + 1 if from_seq is not None and to_seq is not None else 0
+    
+    if len(entries_b64) != expected_count:
+        return "range"
+    
+    decoded_entries = []
+    for entry_b64 in entries_b64:
+        try:
+            entry_bytes = base64.b64decode(entry_b64)
+            decoded = json.loads(entry_bytes)
+            decoded_entries.append(decoded)
+        except (base64.binascii.Error, json.JSONDecodeError):
+            return "range"  # Invalid base64 or JSON
+    
+    if not decoded_entries:
+        return "range"
+    
+    # Check first entry chains from prev_sha256
+    first_entry = decoded_entries[0]
+    if first_entry.get("prev") != prev_sha256:
+        return "chain"
+    
+    # Check each entry chains from previous
+    for i in range(1, len(decoded_entries)):
+        curr_entry = decoded_entries[i]
+        prev_entry = decoded_entries[i-1]
+        curr_sha256 = hashlib.sha256(canonical(prev_entry)).hexdigest()
+        if curr_entry.get("prev") != curr_sha256:
+            return "chain"
+    
+    # Check last entry's sha256 equals head_sha256
+    last_entry = decoded_entries[-1]
+    last_sha256 = hashlib.sha256(canonical(last_entry)).hexdigest()
+    if last_sha256 != head_sha256:
+        return "head"
+    
+    return None
 
 
