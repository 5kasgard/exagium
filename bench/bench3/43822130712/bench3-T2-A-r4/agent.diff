+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that the orphan's entries_b64 matches the attested range.
+    
+    Returns None if valid, otherwise a short problem string containing:
+    - 'range' when count is wrong
+    - 'chain' when an entry's prev doesn't link
+    - 'head' when the last hash doesn't match head_sha256
+    """
+    if "entries_b64" not in orphan["body"]:
+        return "orphan missing entries_b64"
+    
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    if from_seq is None or to_seq is None or head_sha256 is None:
+        return "predicate missing required fields"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count mismatch: expected {expected_count}, got {len(entries_b64)}"
+    
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        entry_bytes = base64.b64decode(entry_b64)
+        entry = parse_json(entry_bytes, f"entries_b64[{i}]")
+        
+        # Check seq is correct
+        expected_seq = from_seq + i
+        if entry.get("seq") != expected_seq:
+            return f"chain seq mismatch at index {i}: expected {expected_seq}, got {entry.get('seq')}"
+        
+        # Check prev links correctly
+        if entry.get("prev") != prev_hash:
+            return f"chain prev mismatch at index {i}: expected {prev_hash}, got {entry.get('prev')}"
+        
+        # Update prev_hash for next iteration
+        prev_hash = hashlib.sha256(entry_bytes).hexdigest()
+    
+    # Check the head hash matches
+    if prev_hash != head_sha256:
+        return f"head hash mismatch: expected {head_sha256}, got {prev_hash}"
+    
+    return None
+
+
