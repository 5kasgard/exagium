+# ---------- an orphan's hidden entries ----------
+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Does an orphan publish the entries its attestation covers? Returns None if they are exactly the attested
+    range: to_seq - from_seq + 1 of them, chained from prev_sha256 through head_sha256. Otherwise a short problem.
+    Without this, an orphan whose statement alone is good can hide the entries it says it holds (e.g. a fail)."""
+    body = orphan.get("body") if isinstance(orphan, dict) else None
+    lst = body.get("entries_b64") if isinstance(body, dict) else None
+    if not isinstance(lst, list):
+        return "range: entries_b64 is missing, so the orphan doesn't publish the entries its attestation covers"
+    lo, hi = pred.get("from_seq"), pred.get("to_seq")
+    if not isinstance(lo, int) or isinstance(lo, bool) or not isinstance(hi, int) or isinstance(hi, bool) or hi < lo:
+        return f"range: attested range {lo}-{hi} isn't a range"
+    if len(lst) != hi - lo + 1:
+        return f"range: {len(lst)} entries for attested range {lo}-{hi} (want {hi - lo + 1})"
+    prev, head = pred.get("prev_sha256"), pred.get("head_sha256")
+    for k, v in (("prev_sha256", prev), ("head_sha256", head)):
+        if v is not None and (not isinstance(v, str) or not HEX64.fullmatch(v)):
+            return f"range: attested {k} {v!r} isn't a sha256"
+    prev_hash = prev
+    for i, b in enumerate(lst, start=1):
+        try:
+            raw = base64.b64decode(b, validate=True)
+            e = parse_canonical(raw, f"orphan entry {orphan.get('seq')} entries_b64[{i}]")
+        except (Bad, ValueError, TypeError) as ex:  # bad base64, non-canonical bytes or unparsable: not an entry
+            return f"chain: entries_b64[{i}] isn't an entry ({ex})"
+        if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"chain: entries_b64[{i}] isn't an entry (must have seq, prev, kind, written_at, body)"
+        if e["prev"] != prev_hash:
+            return f"chain: entries_b64[{i}] prev {e['prev']!r} doesn't link to {prev_hash!r}"
+        prev_hash = hashlib.sha256(raw).hexdigest()
+    if prev_hash != head:
+        return f"head: last entry hashes to {prev_hash}, not the attested head {head}"
+    return None
+
+
