+    def test_an_orphan_that_hides_its_attested_entries_is_refused(self):
+        # A failing verdict the ledger doesn't hold is exactly what an orphan must publish, not hide.
+        self.propose("a.json", "plan", PLAN)
+        self.propose("b.json", "verdict", self.verdict(1, outcome="fail"))
+        self.run_cmd("ingest")
+        entries = [open(self.entry(n), "rb").read() for n in (1, 2)]
+        pred = json.loads(self.run_cmd("range", "1", "2")[1])
+        stmt = R.canonical({"_type": "https://in-toto.io/Statement/v1", "subject": [{"digest": {"sha256": pred["head_sha256"]}}],
+                            "predicateType": identity("o/r", ".github/workflows/record.yml", "refs/heads/main"),
+                            "predicate": pred})
+        good = {"by": "owner", "log_index": 1, "reason": "run failed after attesting", "statement_b64": base64.b64encode(stmt).decode(),
+                "entries_b64": [base64.b64encode(e).decode() for e in entries]}
+        self.assertEqual(R._orphan_entries_problem({"seq": 3, "body": good}, pred), None)
+        self.assertIn("range", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=[])}, pred))
+        self.assertIn("range", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=entries[:1])}, pred))
+        self.assertIn("range", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=entries * 2)}, pred))
+        self.assertIn("chain", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=[entries[1], entries[0]])}, pred))
+        self.assertIn("chain", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=[entries[0], "bm90IGFuIGVudHJ5"])}, pred))
+        self.assertIn("chain", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=["!!", entries[1]])}, pred))
+        moved = dict(json.loads(entries[1]), prev="0" * 64)
+        self.assertIn("chain", R._orphan_entries_problem({"seq": 3, "body": dict(good, entries_b64=[entries[0], base64.b64encode(R.canonical(moved)).decode()])}, pred))
+        swapped = dict(json.loads(entries[1]), body=dict(json.loads(entries[1])["body"], outcome="pass"))
