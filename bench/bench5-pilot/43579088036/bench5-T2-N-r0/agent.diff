+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that an orphan's entries_b64 matches the attested range.
+    
+    Returns None if the entries are exactly the attested range, otherwise
+    returns a short problem string containing 'range', 'chain', or 'head'.
+    """
+    entries_b64 = orphan["body"].get("entries_b64")
+    if not entries_b64:
+        return "range: missing entries_b64"
+    
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    if from_seq is None or to_seq is None:
+        return "range: missing from_seq or to_seq in predicate"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    # Decode and verify chain
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"chain: entry {i} is not valid base64"
+        
+        # Verify it's canonical
+        try:
+            entry = parse_json(entry_raw, f"orphan entry {i}")
+        except Bad as e:
+            return f"chain: entry {i} invalid ({e})"
+        
+        # Check seq matches expected
+        if entry.get("seq") != from_seq + i:
+            return f"chain: entry {i} seq {entry.get('seq')} != expected {from_seq + i}"
+        
+        # Check prev matches expected
+        if entry.get("prev") != prev_hash:
+            return f"chain: entry {i} prev {entry.get('prev')} != expected {prev_hash}"
+        
+        # Update prev_hash to this entry's hash
+        prev_hash = hashlib.sha256(entry_raw).hexdigest()
+    
+    # Check final hash matches head_sha256
+    if prev_hash != head_sha256:
+        return f"head: last entry hash {prev_hash} != attested head {head_sha256}"
+    
+    return None
+
