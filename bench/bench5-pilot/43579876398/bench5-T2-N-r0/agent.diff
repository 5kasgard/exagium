+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that the orphan's entries_b64 matches the attested range in pred.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    # Check that predicate has required fields
+    if from_seq is None or to_seq is None or head_sha256 is None:
+        return "predicate missing required fields"
+    
+    # Check count
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count {len(entries_b64)} != {expected_count}"
+    
+    # Check each entry
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"entry {i} invalid base64"
+        
+        # Verify canonical form
+        try:
+            entry = parse_canonical(entry_raw, f"orphan entry {i}")
+        except Bad as ex:
+            return f"entry {i} not canonical: {ex}"
+        
+        # Verify the entry's prev field matches
+        expected_prev = prev_sha256 if i == 0 else hashlib.sha256(base64.b64decode(entries_b64[i-1], validate=True)).hexdigest()
+        if entry.get("prev") != expected_prev:
+            return f"entry {i} chain mismatch: prev {entry.get('prev')!r} != {expected_prev!r}"
+        
+        # Verify the entry's canonical bytes hash
+        entry_sha256 = hashlib.sha256(entry_raw).hexdigest()
+        
+        # For the last entry, verify it matches head_sha256
+        if i == len(entries_b64) - 1:
+            if entry_sha256 != head_sha256:
+                return f"head mismatch: last entry sha256 {entry_sha256} != {head_sha256}"
+    
+    return None
+
