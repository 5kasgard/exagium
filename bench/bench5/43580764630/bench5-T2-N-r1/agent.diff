+def _orphan_entries_problem(orphan, pred):
+    """Validate that the entries hidden by an orphan match its attestation predicate.
+    orphan["body"]["entries_b64"] is a list of base64-encoded canonical entry bytes.
+    pred is the writer's predicate with from_seq, to_seq, prev_sha256, head_sha256.
+    Returns None if entries match the attested range, else a short problem string containing
+    'range', 'chain', or 'head' indicating the mismatch.
+    Returns None if entries_b64 is not provided (validation skipped)."""
+    entries_b64 = orphan.get("body", {}).get("entries_b64")
+    if not isinstance(entries_b64, list):
+        return None  # no entries provided, skip validation
+    expected_count = pred.get("to_seq", 0) - pred.get("from_seq", 1) + 1
+    if len(entries_b64) != expected_count:
+        return "range"
+    prev_expected = pred.get("prev_sha256")
+    last_hash = prev_expected  # for empty range, head should equal prev
+    for i, b64 in enumerate(entries_b64):
+        try:
+            raw = base64.b64decode(b64, validate=True)
+        except ValueError:
+            return "chain"
+        # parse to check prev field
+        try:
+            entry = parse_json(raw, f"orphan entry {i}")
+        except Bad:
+            return "chain"
+        if not isinstance(entry, dict) or "prev" not in entry:
+            return "chain"
+        if entry["prev"] != prev_expected:
+            return "chain"
+        prev_expected = hashlib.sha256(raw).hexdigest()
+        last_hash = prev_expected
+    if last_hash != pred.get("head_sha256"):
+        return "head"
+    return None
+
+
