+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that orphan["body"]["entries_b64"] decodes to exactly the attested range.
+    Returns None if valid; otherwise returns a short problem string:
+    - containing 'range' when the count is wrong
+    - containing 'chain' when an entry's prev doesn't link
+    - containing 'head' when the last hash doesn't match head_sha256"""
+    if "entries_b64" not in orphan["body"]:
+        return None  # no entries provided, can't check
+    
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    # Validate the predicate has all required fields
+    if from_seq is None or to_seq is None or head_sha256 is None:
+        return "predicate missing required fields"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_bytes = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"entry {i}: invalid base64"
+        
+        # Parse the entry to check its structure
+        try:
+            entry = parse_canonical(entry_bytes, f"orphan entry {i}")
+        except R.Bad as e:
+            return f"entry {i}: {e}"
+        
+        # Check the prev field chains correctly
+        if entry.get("prev") != prev_hash:
+            return f"chain: entry {i} prev {entry.get('prev')!r} != expected {prev_hash!r}"
+        
+        # Update prev_hash for next iteration
+        prev_hash = hashlib.sha256(entry_bytes).hexdigest()
+    
+    # Check the final hash matches head_sha256
+    if prev_hash != head_sha256:
+        return f"head: computed {prev_hash} != attested {head_sha256}"
+    
+    return None
+
+
