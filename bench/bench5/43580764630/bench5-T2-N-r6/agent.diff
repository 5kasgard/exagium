+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that the orphan's entries_b64 matches the attested range in pred.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "orphan missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+
+    if from_seq is None or to_seq is None or prev_sha256 is None or head_sha256 is None:
+        return "predicate missing required fields"
+
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count {len(entries_b64)} != expected {expected_count}"
+
+    prev_hash = prev_sha256
+    last_hash = None
+    for i, b64 in enumerate(entries_b64):
+        raw = base64.b64decode(b64)
+        entry = parse_json(raw, f"orphan entries_b64[{i}]")
+        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"chain: entry {i} has invalid structure"
+        if entry["prev"] != prev_hash:
+            return f"chain: entry {i} prev {entry['prev']!r} != expected {prev_hash!r}"
+        last_hash = hashlib.sha256(raw).hexdigest()
+        prev_hash = last_hash
+
+    if last_hash != head_sha256:
+        return f"head: last hash {last_hash!r} != predicate head_sha256 {head_sha256!r}"
+
+    return None
+
+
