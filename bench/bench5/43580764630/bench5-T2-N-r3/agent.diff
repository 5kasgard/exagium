+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that the orphan's hidden entries match the attested range.
+    
+    orphan["body"]["entries_b64"] is a list of base64-encoded canonical entry bytes.
+    pred has from_seq, to_seq, prev_sha256, head_sha256.
+    
+    Returns None if valid, otherwise a short problem string containing:
+    - "range" when the count is wrong
+    - "chain" when an entry's prev doesn't link
+    - "head" when the last hash doesn't match head_sha256
+    """
+    entries_b64 = orphan["body"].get("entries_b64", [])
+    if not isinstance(entries_b64, list):
+        return "range: entries_b64 must be a list"
+    
+    expected_count = pred.get("to_seq", 0) - pred.get("from_seq", 0) + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    prev_sha256 = pred.get("prev_sha256")
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"chain: entry {i} is not valid base64"
+        
+        entry = parse_json(entry_raw, f"orphan entry {i}")
+        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"chain: entry {i} is not a valid entry"
+        
+        if entry["prev"] != prev_sha256:
+            return f"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev_sha256!r}"
+        
+        entry_sha256 = hashlib.sha256(entry_raw).hexdigest()
+        prev_sha256 = entry_sha256
+    
+    if prev_sha256 != pred.get("head_sha256"):
+        return f"head: last entry hash {prev_sha256!r} doesn't match head_sha256 {pred.get('head_sha256')!r}"
+    
+    return None
+
+
