+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that the orphan's entries_b64 matches the attested range.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    # Check count
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+    
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        entry_bytes = base64.b64decode(entry_b64)
+        entry = parse_json(entry_bytes, f"orphan entry {i}")
+        if entry.get("prev") != prev_hash:
+            return f"chain: entry {i} prev {entry.get('prev')!r} doesn't link from {prev_hash!r}"
+        prev_hash = hashlib.sha256(entry_bytes).hexdigest()
+    
+    if prev_hash != head_sha256:
+        return f"head: final hash {prev_hash!r} doesn't match head_sha256 {head_sha256!r}"
+    
+    return None
+
