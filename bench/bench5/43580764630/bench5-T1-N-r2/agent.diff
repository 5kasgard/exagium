+    def test_check_anchors_detects_missing_ots_proof(self):
+        # A Sigstore attestation for a range head requires the corresponding .ots proof to exist.
+        # Create two entries and mock both check_sigstore and check_ots to test the logic.
+        self._two_entries()
+        anchors_dir = os.path.join(self.d, "anchors")
+        os.makedirs(anchors_dir, exist_ok=True)
+        # Create dummy anchor files (they'll be mocked)
+        with open(os.path.join(anchors_dir, "000001.ots"), "w") as f:
+            f.write('dummy')
+        with open(os.path.join(anchors_dir, "000002.ots"), "w") as f:
+            f.write('dummy')
+        with open(os.path.join(anchors_dir, "000002.sigstore.json"), "w") as f:
+            f.write('{"dummy": "bundle"}')
+        
+        # Mock both check_ots and check_sigstore to return valid results
+        with patch('record.check_ots') as mock_ots, \
+             patch('record.check_sigstore') as mock_sigstore:
+            # check_ots returns the earliest Bitcoin block time (or None for pending)
+            mock_ots.return_value = 1234567890
+            # check_sigstore returns (integrated_time, predicate, commit)
+            mock_sigstore.return_value = (1234567890, {
+                "from_seq": 1, "to_seq": 2,
+                "prev_sha256": None,  # from_seq == 1 means no prev
+                "head_sha256": hashlib.sha256(open(self.entry(2), "rb").read()).hexdigest()
+            }, "fake_commit_hash")
+            rc, out, err = self.run_cmd("check-anchors")
+            # Should pass because both .ots files exist
+            self.assertEqual(rc, 0, f"Expected 0, got {rc}: {err}")
+            self.assertNotIn("000002.ots is missing", err)
+        
+        # Now delete the .ots file for the range head (entry 2)
+        os.remove(os.path.join(anchors_dir, "000002.ots"))
+        
+        # Run check-anchors again with mock - should fail with missing .ots error
+        with patch('record.check_ots') as mock_ots, \
+             patch('record.check_sigstore') as mock_sigstore:
+            mock_ots.return_value = 1234567890
+            mock_sigstore.return_value = (1234567890, {
+                "from_seq": 1, "to_seq": 2,
+                "prev_sha256": None,
+                "head_sha256": hashlib.sha256(open(self.entry(2), "rb").read()).hexdigest()
+            }, "fake_commit_hash")
+            rc, out, err = self.run_cmd("check-anchors")
+            self.assertEqual(rc, 1, f"Expected 1, got {rc}: {err}")
+            self.assertIn("000002.ots is missing", err)
+
+    def test_check_anchors_missing_ots_error_format(self):
+        # Verify the error message format for missing .ots files
+        # This test ensures the error message contains "NNNNNN.ots is missing"
+        self.assertEqual(f"{2:06d}.ots is missing", "000002.ots is missing")
+        self.assertEqual(f"{1:06d}.ots is missing", "000001.ots is missing")
+        self.assertEqual(f"{123456:06d}.ots is missing", "123456.ots is missing")
+
