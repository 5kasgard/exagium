+    def test_max_pending_hours_detects_stuck_proofs(self):
+        # Test that --max-pending-hours exits 1 when a range head's OTS proof is pending
+        # and its Sigstore attestation is older than the threshold
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        open(os.path.join(self.d, "anchors", "000002.ots"), "wb").write(b"stub")
+
+        # Stub check_sigstore to return an old attestation time (72 hours ago)
+        old_time = int((datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=72)).timestamp())
+        stubs = {
+            "check_sigstore": lambda *a: (old_time, R.range_predicate(chain, 1, 2), "c0ffee"),
+            "check_ots": lambda *a: None  # pending proof
+        }
+        saved = {k: getattr(R, k) for k in stubs}
+        try:
+            for k, f in stubs.items():
+                setattr(R, k, f)
+            # Without --max-pending-hours, should pass (pending is OK)
+            rc, _, err = self.run_cmd("check-anchors")
+            self.assertEqual(rc, 0)
+            # With --max-pending-hours=48, should fail (72 > 48)
+            rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "48")
+            self.assertEqual(rc, 1)
+            self.assertIn("still pending 72 h", err)
+            # With --max-pending-hours=96, should pass (72 < 96)
+            rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "96")
+            self.assertEqual(rc, 0)
+        finally:
+            for k, f in saved.items():
+                setattr(R, k, f)
+
+    def test_max_pending_hours_ignores_confirmed_proofs(self):
+        # Test that --max-pending-hours does not affect confirmed (non-pending) proofs
+        self._two_entries()
+        chain, _ = R.load_chain(self.d)
+        os.makedirs(os.path.join(self.d, "anchors"))
+        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), "w").write("{}")
+        open(os.path.join(self.d, "anchors", "000002.ots"), "wb").write(b"stub")
+
+        # Stub check_sigstore to return an old attestation time (72 hours ago)
+        old_time = int((datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=72)).timestamp())
+        # But check_ots returns a confirmed time (not None)
+        confirmed_time = int((datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=1)).timestamp())
+        stubs = {
+            "check_sigstore": lambda *a: (old_time, R.range_predicate(chain, 1, 2), "c0ffee"),
+            "check_ots": lambda *a: confirmed_time  # confirmed proof
+        }
+        saved = {k: getattr(R, k) for k in stubs}
+        try:
+            for k, f in stubs.items():
+                setattr(R, k, f)
+            # Even with --max-pending-hours=1, should pass (proof is confirmed)
+            rc, _, err = self.run_cmd("check-anchors", "--max-pending-hours", "1")
+            self.assertEqual(rc, 0)
+        finally:
+            for k, f in saved.items():
+                setattr(R, k, f)
+
+    def test_max_pending_hours_multiple_range_heads(self):
+        # Test with multiple range heads, some stuck, some not
+        self._two_entries()
+        # Add a third entry
+        self.propose("c.json", "plan", dict(PLAN, claim="third"))
