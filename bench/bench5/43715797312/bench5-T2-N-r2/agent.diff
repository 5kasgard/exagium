+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check if the orphan's entries_b64 matches the attested range in pred.
+
+    Returns None if the decoded entries are exactly the attested range:
+    - there are to_seq - from_seq + 1 of them
+    - the first chains from pred["prev_sha256"] (its prev field)
+    - each next one chains from the previous one's sha256
+    - the sha256 of the last one's canonical bytes equals pred["head_sha256"]
+
+    Otherwise returns a short problem string:
+    - containing "range" when the count is wrong
+    - containing "chain" when an entry's prev doesn't link
+    - containing "head" when the last hash doesn't match head_sha256
+    """
+    entries_b64 = orphan["body"].get("entries_b64", [])
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+
+    if from_seq is None or to_seq is None or "prev_sha256" not in pred or head_sha256 is None:
+        return "predicate missing required fields"
+
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        entry_bytes = base64.b64decode(entry_b64)
+        entry = parse_json(entry_bytes, f"orphan entries_b64[{i}]")
+        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"chain: entry {i} malformed"
+        if entry["prev"] != prev_hash:
+            return f"chain: entry {i} prev {entry['prev']!r} != expected {prev_hash!r}"
+        entry_hash = hashlib.sha256(entry_bytes).hexdigest()
+        prev_hash = entry_hash
+
+    if prev_hash != head_sha256:
+        return f"head: last entry hash {prev_hash!r} != head_sha256 {head_sha256!r}"
+
+    return None
+
+
