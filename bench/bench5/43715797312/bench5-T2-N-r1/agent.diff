+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that an orphan's entries_b64 matches the attested range in pred.
+    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'."""
+    if "entries_b64" not in orphan["body"]:
+        return "orphan missing entries_b64"
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    # Validate required fields in pred
+    if from_seq is None or to_seq is None or prev_sha256 is None or head_sha256 is None:
+        return "predicate missing required fields"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count mismatch: expected {expected_count}, got {len(entries_b64)}"
+    
+    prev_hash = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_bytes = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"entry {i} invalid base64"
+        
+        # Verify canonical form
+        try:
+            entry = parse_json(entry_bytes, f"orphan entry {i}")
+        except Bad as ex:
+            return f"entry {i} invalid: {ex}"
+        
+        # Verify the entry's prev field matches the previous hash
+        if entry.get("prev") != prev_hash:
+            return f"chain broken at entry {i}: prev {entry.get('prev')!r} != {prev_hash!r}"
+        
+        # Update prev_hash to this entry's hash
+        prev_hash = hashlib.sha256(entry_bytes).hexdigest()
+    
+    # Verify the last entry's hash matches head_sha256
+    if prev_hash != head_sha256:
+        return f"head mismatch: last entry sha256 {prev_hash!r} != head_sha256 {head_sha256!r}"
+    
+    return None
+
+
