+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Validate that an orphan's hidden entries match the attested range.
+
+    Returns None if valid, otherwise a short problem string containing:
+    - "range" if the count is wrong
+    - "chain" if an entry's prev doesn't link
+    - "head" if the last hash doesn't match head_sha256
+    """
+    entries_b64 = orphan["body"].get("entries_b64")
+    if not isinstance(entries_b64, list):
+        return "range: missing entries_b64 list"
+
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+
+    if not all(isinstance(x, int) for x in (from_seq, to_seq)) or not isinstance(prev_sha256, (str, type(None))) \
+            or not isinstance(head_sha256, str):
+        return "range: invalid predicate"
+
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range: expected {expected_count} entries, got {len(entries_b64)}"
+
+    prev = prev_sha256
+    last_hash = None
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_raw = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"range: entry {i} is not valid base64"
+
+        try:
+            entry = parse_json(entry_raw, f"orphan entry {from_seq + i}")
+        except Bad as ex:
+            return f"range: entry {i} is invalid: {ex}"
+
+        # Check prev link
+        if entry.get("prev") != prev:
+            return f"chain: entry {from_seq + i} prev {entry.get('prev')!r} != expected {prev!r}"
+
+        # Compute hash of this entry
+        last_hash = hashlib.sha256(entry_raw).hexdigest()
+        prev = last_hash
+
+    # Check head hash
+    if last_hash != head_sha256:
+        return f"head: last entry hash {last_hash} != attested head {head_sha256}"
+
+    return None
+
+
