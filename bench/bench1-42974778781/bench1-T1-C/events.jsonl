19\t        prev_commit = commit\n   420\t    if covered < len(chain):\n   421\t        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n   422\t    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n   423\t                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n   424\t    for x in bad:\n   425\t        print(f\"BAD: {x}\", file=sys.stderr)\n   426\t    for x in cant:\n   427\t        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n   428\t    return 1 if bad else 2 if cant else 0\n   429\t\n   430\t\n   431\tdef _git(a, *args):\n   432\t    root = os.path.dirname(os.path.abspath(a.ledger))\n   433\t    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n   434\t    return r.stdout if r.returncode == 0 else None\n   435\t\n   436\t\n   437\tdef _code_changed(a, c1, c2):\n   438\t    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n   439\t    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n   440\t        return \"unknown (commit not in this clone)\"\n   441\t    root = os.path.dirname(os.path.abspath(a.ledger))\n   442\t    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n   443\t    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n   444\t\n   445\t\n   446\tdef _orphan_entries_problem(o, pred):\n   447\t    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n   448\t    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n   449\t    try:\n   450\t        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n   451\t        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n   452\t            return \"its entries don't match the attested range\"\n   453\t        prev = pred.get(\"prev_sha256\")\n   454\t        for i, raw in enumerate(raws):\n   455\t            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n   456\t            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n   457\t                return \"its entries don't chain from the attested prev_sha256\"\n   458\t            if e.get(\"kind\") not in KINDS:\n   459\t                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n   460\t            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n   461\t            prev = hashlib.sha256(raw).hexdigest()\n   462\t        if prev != pred.get(\"head_sha256\"):\n   463\t            return \"its entries don't hash to the attested head\"\n   464\t    except Bad as ex:\n   465\t        return f\"its entries are malformed ({ex})\"\n   466\t    return None\n   467\t\n   468\t\n   469\tdef _published_entry_hashes(a, rev):\n   470\t    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n   471\t    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n   472\t        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n   473\t    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n   474\t    if raw is None:\n   475\t        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n   476\t    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n   477\t    out = set()\n   478\t    for b in blobs:\n   479\t        data = _git(a, \"cat-file\", \"blob\", b)\n   480\t        if data is not None:\n   481\t            out.add(hashlib.sha256(data).hexdigest())\n   482\t    return out\n   483\t\n   484\t\n   485\tdef _pages(url):\n   486\t    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n   487\t    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n   488\t    import urllib.parse\n   489\t    base = url.split(\"?\")[0]\n   490\t    out = []\n   491\t    while url:\n   492\t        body, hdrs = _get(url, headers=True)\n   493\t        if body is None:\n   494\t            raise CantCheck(f\"404 from {url}\")\n   495\t        out.extend(json.loads(body))\n   496\t        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n   497\t        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n   498\t    return out\n   499\t\n   500\t\n   501\tdef _refs(repo):\n   502\t    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n   503\t    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n   504\t    api = f\"https://api.github.com/repos/{repo}\"\n   505\t    refs = {\"refs/heads/main\"}\n   506\t    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n   507\t    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n   508\t    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n   509\t    activity = _pages(f\"{api}/activity?per_page=100\")\n   510\t    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n   511\t    return sorted(refs), activity\n   512\t\n   513\t\n   514\tdef cmd_monitor(a):\n   515\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   516\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   517\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   518\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   519\t    chain, _ = load_chain(a.ledger)\n   520\t    current = {h for _, h in chain}\n   521\t    known, bad = {}, []\n   522\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   523\t        if path.endswith(\".sigstore.json\"):\n   524\t            try:\n   525\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   526\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   527\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   528\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   529\t    if a.only_ref:\n   530\t        refs, activity = [a.only_ref], []\n   531\t    else:\n   532\t        refs, activity = _refs(a.repo)\n   533\t        for x in activity:\n   534\t            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n   535\t                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   536\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   537\t    seen, unknown, orphans = set(), [], []\n   538\t    for ref in refs:\n   539\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n   540\t        if uuids is None:\n   541\t            raise CantCheck(\"Rekor's index returned 404\")\n   542\t        for u in json.loads(uuids):\n   543\t            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n   544\t            if got is None:\n   545\t                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n   546\t            v = next(iter(json.loads(got).values()))\n   547\t            idx = int(v[\"logIndex\"])\n   548\t            seen.add(idx)\n   549\t            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n   550\t            if idx in known:\n   551\t                continue\n   552\t            if idx not in explained:\n   553\t                unknown.append(row)\n   554\t                continue\n   555\t            o = explained[idx]\n   556\t            body = json.loads(base64.b64decode(v[\"body\"]))\n   557\t            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n   558\t            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n   559\t                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n   560\t                continue\n   561\t            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n   562\t            head = pred.get(\"head_sha256\")\n   563\t            problem = _orphan_entries_problem(o, pred)\n   564\t            if problem:\n   565\t                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n   566\t                continue\n   567\t            if head in published and head not in current:\n   568\t                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n   569\t                continue\n   570\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   571\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   572\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   573\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   574\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   575\t    for x in bad:\n   576\t        print(f\"BAD: {x}\", file=sys.stderr)\n   577\t    return 1 if unknown or missing or bad else 0\n   578\t\n   579\t\n   580\tdef cmd_range(a):\n   581\t    chain, _ = load_chain(a.ledger)\n   582\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   583\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   584\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   585\t    return 0\n   586\t\n   587\t\n   588\tdef main(argv=None):\n"}], "is_error": false, "command": "view", "path": "/home/runner/work/exagium/exagium/ws/record/record.py", "prev_exist": true, "old_content": null, "new_content": null, "kind": "FileEditorObservation"}, "action_id": "c51a90cf-d283-43a2-ac29-6db504743e9a", "kind": "ObservationEvent"}