path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n   407\t                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n   408\t                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n   409\t                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n   410\t                ranges.append((pred[\"from_seq\"], seq, commit))\n   411\t                attested_at[seq] = t\n   412\t                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n   413\t                             \"writer_commit\": commit})\n   414\t        except Bad as ex:\n   415\t            bad.append(str(ex))\n   416\t        except CantCheck as ex:\n   417\t            cant.append(f\"anchors/{n}: {ex}\")\n   418\t    for lo, hi, commit in sorted(ranges):\n   419\t        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n   420\t        # was removed (found by Z, 2026-11-06)\n   421\t        if hi not in stamped:\n   422\t            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n   423\t    if a.max_pending_hours is not None:\n   424\t        # a proof still pending long after its Sigstore time means the daily upgrade isn't running (it failed silently\n   425\t        # for its first five days; review 2026-11-11). Opt-in, so the writer's own pre-check never blocks on it.\n   426\t        for seq in pending:\n   427\t            t = attested_at.get(seq)\n   428\t            if t is not None and time.time() - t > a.max_pending_hours * 3600:\n   429\t                bad.append(f\"anchors/{seq:06d}.ots is still pending {(time.time() - t) / 3600:.0f} h after its attestation \"\n   430\t                           f\"(limit {a.max_pending_hours} h): is the daily upgrade running?\")\n   431\t    covered, changes, prev_commit = 0, [], None\n   432\t    for lo, hi, commit in sorted(ranges):\n   433\t        if lo != covered + 1:\n   434\t            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n   435\t        covered = max(covered, hi)\n   436\t        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n   437\t            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n   438\t                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n   439\t        prev_commit = commit\n   440\t    if covered < len(chain):\n   441\t        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n   442\t    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n   443\t                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n   444\t    for x in bad:\n   445\t        print(f\"BAD: {x}\", file=sys.stderr)\n   446\t    for x in cant:\n   447\t        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n   448\t    return 1 if bad else 2 if cant else 0\n   449\t\n   450\t\n"}], "is_error": false, "command": "view", "path": "/home/runner/work/exagium/exagium/src/record/record.py", "prev_exist": true, "old_content": null, "new_content": null, "kind": "FileEditorObservation"}, "action_id": "a3c3e2e9-5a24-4974-b626-9d3e6b138430", "kind": "ObservationEvent"}
