wn.items() if idx not in seen) if not a.only_ref else []\n   272\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   273\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   274\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   275\t    for x in bad:\n   276\t        print(f\"BAD: {x}\", file=sys.stderr)\n   277\t    return 1 if unknown or missing or bad else 0\n   278\t\n   279\t\n   280\tdef cmd_range(a):\n   281\t    chain, _ = load_chain(a.ledger)\n   282\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   283\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   284\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   285\t    return 0\n   286\t\n   287\t\n   288\tdef main(argv=None):\n   289\t    here = os.path.dirname(os.path.abspath(__file__))\n   290\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   291\t    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n   292\t    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n   293\t    sub.add_parser(\"ingest\")\n   294\t    sub.add_parser(\"verify\")\n   295\t    sub.add_parser(\"head\")\n   296\t    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n   297\t    rp.add_argument(\"from_seq\", type=int)\n   298\t    rp.add_argument(\"to_seq\", type=int)\n   299\t    for name in (\"check-anchors\", \"monitor\"):\n   300\t        p = sub.add_parser(name)\n   301\t        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n   302\t        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n   303\t        if name == \"check-anchors\":\n   304\t            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n   305\t            p.add_argument(\"--explorer\", action=\"append\", default=None,\n   306\t                           help=\"esplora API base; default blockstream.info and mempool.space\")\n   307\t            p.add_argument(\"--max-pending-hours\", type=float, default=None,\n   308\t                           help=\"treat an OpenTimestamps proof still pending this long after its attestation as wrong\")\n   309\t        else:\n   310\t            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n   311\t            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n   312\t            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n   313\t    a = ap.parse_args(argv)\n   314\t    if getattr(a, \"explorer\", \"x\") is None:\n   315\t        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n   316\t    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n   317\t          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n   318\t    try:\n   319\t        return fn(a)\n   320\t    except Bad as ex:\n   321\t        print(f\"BAD: {ex}\", file=sys.stderr)\n   322\t        return 1\n   323\t    except CantCheck as ex:\n   324\t        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n   325\t        return 2\n   326\t    except Exception as ex:  # a failure is never reported as a verdict\n   327\t        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n   328\t        return 3\n   329\t\n   330\t\n   331\tif __name__ == \"__main__\":\n   332\t    sys.exit(main())\n   333\t\n"}], "is_error": false, "command": "view", "path": "/home/runner/work/exagium/exagium/src/record/record.py", "prev_exist": true, "old_c