{"id": "84cb2936-91e2-443c-8fa7-269b1429becf", "timestamp": "2026-11-11T07:16:43.742374", "source": "environment", "tool_name": "file_editor", "tool_call_id": "call-5740c364-2e26-473e-b585-885bfbf5127c", "observation": {"content": [{"cache_prompt": false, "type": "text", "text": "Here's the result of running `cat -n` on /home/runner/work/exagium/exagium/src/record/record.py:\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n     3\t\n     4\tLayout (under --ledger, default ../ledger):\n     5\t  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n     6\t  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n     7\t  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n     8\t  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n     9\t\n    10\tAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n    11\t(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\n    12\tkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n    13\t\n    14\tCommands: ingest | verify | head | range | check-anchors | monitor.\n    15\tExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\n    16\tlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n    17\t\"\"\"\n    18\timport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, time, urllib.error, urllib.request\n    19\t\n    20\tMAX_INT = 2**53 - 1\n    21\tKINDS = (\"plan\", \"verdict\", \"orphan\")\n    22\tOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\n    23\tHEX64 = re.compile(r\"[0-9a-f]{64}\")\n    24\tNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\n    25\tENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\n    26\tANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\n    27\tISSUER = \"https://token.actions.githubusercontent.com\"\n    28\t\n    29\t\n    30\tclass Bad(Exception):\n    31\t    \"\"\"The data is wrong: exit 1.\"\"\"\n    32\t\n    33\t\n    34\tclass CantCheck(Exception):\n    35\t    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n    36\t\n    37\t\n    38\t# ---------- canonical form ----------\n    39\tdef canonical(obj):\n    40\t    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n    41\t\n    42\t\n    43\tdef _check_value(v, where):\n    44\t    if isinstance(v, bool) or v is None:\n    45\t        return\n    46\t    if isinstance(v, str):\n    47\t        try:\n    48\t            v.encode(\"utf-8\")\n    49\t        except UnicodeEncodeError:\n    50\t            raise Bad(f\"{where}: string holds a lone surrogate\")\n    51\t        return\n    52\t    if isinstance(v, int):\n    53\t        if abs(v) > MAX_INT:\n    54\t            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n    55\t        return\n    56\t    if isinstance(v, float):\n    57\t        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    58\t    if isinstance(v, list):\n    59\t        for i, x in enumerate(v):\n    60\t            _check_value(x, f\"{where}[{i}]\")\n    61\t        return\n    62\t    if isinstance(v, dict):\n    63\t        for k, x in v.items():\n    64\t            if not k.isascii():\n    65\t                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n    66\t            _check_value(x, f\"{where}.{k}\")\n    67\t        return\n    68\t    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n    69\t\n    70\t\n    71\tdef _no_dup_keys(pairs):\n    72\t    d = {}\n    73\t    for k, v in pairs:\n    74\t        if k in d:\n    75\t            raise Bad(f\"duplicate key {k!r}\")\n    76\t        d[k] = v\n    77\t    return d\n    78\t\n    79\t\n    80\tdef _no_constants(c):\n    81\t    raise Bad(f\"{c} isn't JSON\")\n    82\t\n    83\t\n    84\tdef parse_json(raw, where):\n    85\t    try:\n    86\t        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    87\t    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n    88\t        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n    89\t\n    90\t\n    91\tdef parse_canonical(raw, where):\n    92\t    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    93\t    obj = parse_json(raw, where)\n    94\t    _check_value(obj, where)\n    95\t    if canonical(obj) != raw:\n    96\t        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    97\t    return obj\n    98\t\n    99\t\n   100\t# ---------- schema ----------\n   101\tdef _need(d, key, typ, where):\n   102\t    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n   103\t        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n   104\t    return d[key]\n   105\t\n   106\t\n   107\tdef _name(d, where):\n   108\t    v = _need(d, \"by\", str, where)\n   109\t    if not NAME.fullmatch(v):\n   110\t        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n   111\t    return v\n   112\t\n   113\t\n   114\tdef _check_digests(lst, where):\n   115\t    if not isinstance(lst, list):\n   116\t        raise Bad(f\"{where}: must be a list\")\n   117\t    for i, x in enumerate(lst):\n   118\t        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n   119\t                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n   120\t            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n   121\t\n   122\t\n   123\tdef check_body(kind, body, where):\n   124\t    if not isinstance(body, dict):\n   125\t        raise Bad(f\"{where}: body must be an object\")\n   126\t    _name(body, where)\n   127\t    if kind == \"plan\":\n   128\t        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n   129\t        for k in (\"claim\", \"test\", \"decision_rule\"):\n   130\t            if not _need(body, k, str, where).strip():\n   131\t                raise Bad(f\"{where}: {k} is empty\")\n   132\t        if \"inputs\" in body:\n   133\t            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n   134\t        if \"verdict_due\" in body:\n   135\t            try:\n   136\t                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n   137\t                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n   138\t            except ValueError:\n   139\t                ok = False\n   140\t            if not ok:\n   141\t                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n   142\t    elif kind == \"verdict\":\n   143\t        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n   144\t        p = _need(body, \"plan\", dict, where)\n   145\t        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n   146\t                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n   147\t            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n   148\t        if body.get(\"outcome\") not in OUTCOMES:\n   149\t            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n   150\t        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n   151\t    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n   152\t        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n   153\t        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n   154\t            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n   155\t        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n   156\t            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n   157\t            ents = _need(body, \"entries_b64\", list, where)\n   158\t            if not ents:\n   159\t                raise ValueError\n   160\t            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n   161\t                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n   162\t        except (ValueError, TypeError):\n   163\t            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n   164\t    extra = set(body) - allowed\n   165\t    if extra:\n   166\t        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n   167\t\n   168\t\n   169\t# ---------- the chain ----------\n   170\tdef _listdir(ledger, sub, pattern, what):\n   171\t    d = os.path.join(ledger, sub)\n   172\t    if not os.path.exists(d):\n   173\t        return []\n   174\t    if os.path.islink(d) or not os.path.isdir(d):\n   175\t        raise Bad(f\"{sub}/ must be a plain directory\")\n   176\t    out = []\n   177\t    for n in sorted(os.listdir(d)):\n   178\t        p = os.path.join(d, n)\n   179\t        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n   180\t            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n   181\t        out.append(p)\n   182\t    return out\n   183\t\n   184\t\n   185\tdef load_chain(ledger):\n   186\t    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n   187\t    chain, plans, ve<response clipped><NOTE>Due to the max output limit, only part of this file has been shown to you. You should retry this tool after you have searched inside the file with `grep -n` in order to find the line numbers of what you are looking for.</NOTE>.\"\"\"\n   188\t    import urllib.parse\n   189\t    base = url.split(\"?\")[0]\n   190\t    out = []\n   191\t    while url:\n   192\t        body, hdrs = _get(url, headers=True)\n   193\t        if body is None:\n   194\t            raise CantCheck(f\"404 from {url}\")\n   195\t        out.extend(json.loads(body))\n   196\t        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n   197\t        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n   198\t    return out\n   199\t\n   200\t\n   201\tdef _refs(repo):\n   202\t    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n   203\t    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n   204\t    api = f\"https://api.github.com/repos/{repo}\"\n   205\t    refs = {\"refs/heads/main\"}\n   206\t    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n   207\t    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n   208\t    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n   209\t    activity = _pages(f\"{api}/activity?per_page=100\")\n   210\t    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n   211\t    return sorted(refs), activity\n   212\t\n   213\t\n   214\tdef cmd_monitor(a):\n   215\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   216\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   217\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   218\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   219\t    chain, _ = load_chain(a.ledger)\n   220\t    current = {h for _, h in chain}\n   221\t    known, bad = {}, []\n   222\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   223\t        if path.endswith(\".sigstore.json\"):\n   224\t            try:\n   225\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   226\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   227\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   228\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   229\t    if a.only_ref:\n   230\t        refs, activity = [a.only_ref], []\n   231\t    else:\n   232\t        refs, activity = _refs(a.repo)\n   233\t        for x in activity:\n   234\t            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n   235\t                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   236\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   237\t    seen, unknown, orphans = set(), [], []\n   238\t    for ref in refs:\n   239\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n   240\t        if uuids is None:\n   241\t            raise CantCheck(\"Rekor's index returned 404\")\n   242\t        f