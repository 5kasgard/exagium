n _pages(f\"{api}/tags?per_page=100\"))\n   218\t    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n   219\t    activity = _pages(f\"{api}/activity?per_page=100\")\n   220\t    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n   221\t    return sorted(refs), activity\n   222\t\n   223\t\n   224\tdef cmd_monitor(a):\n   225\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   226\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   227\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   228\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   229\t    chain, _ = load_chain(a.ledger)\n   230\t    current = {h for _, h in chain}\n   231\t    known, bad = {}, []\n   232\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   233\t        if path.endswith(\".sigstore.json\"):\n   234\t            try:\n   235\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   236\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   237\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   238\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   239\t    if a.only_ref:\n   240\t        refs, activity = [a.only_ref], []\n   241\t    else:\n   242\t        refs, activity = _refs(a.repo)\n   243\t        for x in activity:\n   244\t            if x.get(\"activity_type\") == \"force_push\" and x.get(\"ref\") == a.ledger_ref:\n   245\t                bad.append(f\"force push to {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   246\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   247\t    seen, unknown, orphans = set(), [], []\n   248\t    for ref in refs:\n   249\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n   250\t        if uuids is None:\n   251\t            raise CantCheck(\"Rekor's index returned 404\")\n   252\t        for u in json.loads(uuids):\n   253\t            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n   254\t            if got is None:\n   255\t                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n   256\t            v = next(iter(json.loads(got).values()))\n   257\t            idx = int(v[\"logIndex\"])\n   258\t            seen.add(idx)\n   259\t            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n   260\t            if idx in known:\n   261\t                continue\n   262\t            if idx not in explained:\n   263\t                unknown.append(row)\n   264\t                continue\n   265\t            o = explained[idx]\n   266\t            body = json.loads(base64.b64decode(v[\"body\"]))\n   267\t            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n   268\t            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n   269\t                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n   270\t                continue\n   271\t            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n   272\t            head = pred.get(\"head_sha256\")\n   273\t            if head in published and head not in current:\n   274\t                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n   275\t                continue\n   276\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   277\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   278\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   279\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   280\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   281\t    for x in bad:\n   282\t        print(f\"BAD: {x}\", file=sys.stderr)\n   283\t    return 1 if unknown or missing or bad else 0\n   284\t\n   285\t\n   286\tdef cmd_range(a):\n   287\t    chain, _ = load_chain(a.ledger)\n   288\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   289\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   290\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   291\t    return 0\n   292\t\n   293\t\n   294\tdef main(argv=None):\n   295\t    here = os.path.dirname(os.path.abspath(__file__))\n   296\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   297\t    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n   298\t    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n   299\t    sub.add_parser(\"ingest\")\n   300\t    sub.add_parser(\"verify\")\n   301\t    sub.add_parser(\"head\")\n   302\t    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n   303\t    rp.add_argument(\"from_seq\", type=int)\n   304\t    rp.add_argument(\"to_seq\", type=int)\n   305\t    for name in (\"check-anchors\", \"monitor\"):