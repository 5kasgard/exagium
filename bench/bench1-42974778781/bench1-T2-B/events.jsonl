{"id": "6e7f10f1-e6bc-44a5-a608-0478ad528f43", "timestamp": "2026-11-11T07:00:31.104288", "source": "environment", "tool_name": "file_editor", "tool_call_id": "call_2737c67491b745bbb6e2dbbb", "observation": {"content": [{"cache_prompt": false, "type": "text", "text": "Here's the result of running `cat -n` on /home/runner/work/exagium/exagium/ws/record/record.py:\n   180\tdef load_chain(ledger):\n   181\t    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n   182\t    chain, plans, verdict_of = [], {}, {}\n   183\t    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n   184\t        name = os.path.basename(path)\n   185\t        raw = open(path, \"rb\").read()\n   186\t        e = parse_canonical(raw, name)\n   187\t        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n   188\t            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n   189\t        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n   190\t            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n   191\t        if e[\"prev\"] != (chain[-1][1] if chain else None):\n   192\t            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n   193\t        if e[\"kind\"] not in KINDS:\n   194\t            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n   195\t        if not isinstance(e[\"written_at\"], str):\n   196\t            raise Bad(f\"{name}: written_at must be a string\")\n   197\t        check_body(e[\"kind\"], e[\"body\"], name)\n   198\t        h = hashlib.sha256(raw).hexdigest()\n   199\t        if e[\"kind\"] == \"plan\":\n   200\t            plans[i] = (h, e[\"body\"][\"by\"])\n   201\t        elif e[\"kind\"] == \"verdict\":\n   202\t            ref = e[\"body\"][\"plan\"]\n   203\t            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n   204\t                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n   205\t            if ref[\"seq\"] in verdict_of:\n   206\t                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n   207\t            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n   208\t                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n   209\t            verdict_of[ref[\"seq\"]] = i\n   210\t        chain.append((e, h))\n   211\t    return chain, verdict_of\n   212\t\n   213\t\n   214\tdef make_entry(chain, kind, body, now=None):\n   215\t    check_body(kind, body, \"proposal\")\n   216\t    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n   217\t         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n   218\t         \"body\": body}\n   219\t    _check_value(e, \"proposal\")\n   220\t    return e\n   221\t\n   222\t\n   223\tdef cmd_ingest(a):\n   224\t    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n   225\t    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n   226\t    chain, _ = load_chain(a.ledger)\n   227\t    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n   228\t    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n   229\t        n = os.path.basename(p)\n   230\t        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n   231\t        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n   232\t            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n   233\t        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n   234\t        raw = canonical(e)\n   235\t        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n   236\t        with open(out, \"xb\") as f:\n   237\t            f.write(raw)\n   238\t        try:\n   239\t            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n   240\t        except Bad as ex:\n   241\t            os.remove(out)\n   242\t            raise Bad(f\"inbox/{n}: {ex}\")\n   243\t        chain.append((e, hashlib.sha256(raw).hexdigest()))\n   244\t        os.remove(p)\n   245\t        print(out, flush=True)\n   246\t    return 0\n   247\t\n   248\t\n   249\tdef cmd_verify(a):\n   250\t    chain, verdict_of = load_chain(a.ledger)\n   251\t    today = datetime.date.today().isoformat()\n   252\t    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n   253\t    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n   254\t    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n   255\t    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n   256\t                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n   257\t                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n   258\t                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n   259\t    return 0\n   260\t\n   261\t\n   262\tdef cmd_head(a):\n   263\t    chain, _ = load_chain(a.ledger)\n   264\t    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n   265\t    return 0\n   266\t\n   267\t\n   268\t# ---------- anchors ----------\n   269\tdef _get(url, data=None, timeout=20, headers=False):\n   270\t    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n   271\t                                                          \"User-Agent\": \"exagium-record\"})\n   272\t    try:\n   273\t        with urllib.request.urlopen(req, timeout=timeout) as r:\n   274\t            body = r.read()\n   275\t            return (body, r.headers) if headers else body\n   276\t    except urllib.error.HTTPError as ex:\n   277\t        if ex.code == 404:\n   278\t            return (None, None) if headers else None\n   279\t        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n   280\t    except OSError as ex:\n   281\t        raise CantCheck(f\"network: {url}: {ex}\")\n   282\t\n   283\t\n   284\tdef identity(repo, workflow, ref):\n   285\t    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n   286\t\n   287\t\n   288\tdef range_predicate(chain, from_seq, to_seq):\n   289\t    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n   290\t    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n   291\t            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n   292\t\n   293\t\n   294\tdef check_sigstore(bundle, digest, repo, workflow, ref):\n   295\t    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n   296\t    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n   297\t    try:\n   298\t        from sigstore.models import Bundle\n   299\t        from sigstore.verify import Verifier, policy\n   300\t        from sigstore.errors import Error as SigstoreError\n"}], "is_error": false, "command": "view", "path": "/home/runner/work/exagium/exagium/ws/record/record.py", "prev_exist": true, "old_content": null, "new_content": null, "kind": "FileEditorObservation"}, "action_id": "60bd4850-d56c-4717-8b54-d721bf3f352a", "kind": "ObservationEvent"}
