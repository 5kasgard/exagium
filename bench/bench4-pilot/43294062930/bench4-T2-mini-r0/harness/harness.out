#!/usr/bin/env python3
"""exagium record: an append-only, hash-chained ledger of plans and verdicts, 
with outside anchors.

Layout (under --ledger, default ../ledger):
  entries/000001.json ...   one entry per file; CI 
(.github/workflows/record.yml) is the only writer
  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range
of entries it added, ending at NNNNNN
  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes
  inbox/*.json                   proposals {"kind": ..., "body": ...}; CI moves 
them into entries/

An entry's identity is the sha256 of its stored bytes, which must be exactly its
RFC 8785 (JCS) form
(no trailing newline). The rules that make Python's json.dumps output equal JCS 
are enforced: ASCII
keys, no floats, integers within +-(2**53-1), no lone surrogates.

Commands: ingest | verify | head | range | check-anchors | monitor.
Exit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 
can't check (missing
library or network); 3 unexpected failure. A failure is never reported as a 
verdict.
"""
import argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, 
urllib.error, urllib.request

MAX_INT = 2**53 - 1
KINDS = ("plan", "verdict", "orphan")
OUTCOMES = ("pass", "fail", "inconclusive")
HEX64 = re.compile(r"[0-9a-f]{64}")
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")  # who: a plain ASCII handle, so
"same author" can't hide behind look-alikes
ENTRY_NAME = re.compile(r"([0-9]{6})\.json")
ANCHOR_NAME = re.compile(r"([0-9]{6})\.(sigstore\.json|ots)")
ISSUER = "https://token.actions.githubusercontent.com"


class Bad(Exception):
    """The data is wrong: exit 1."""


class CantCheck(Exception):
    """A check couldn't run (missing library, network): exit 2."""


# ---------- canonical form ----------
def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")


def _check_value(v, where):
    if isinstance(v, bool) or v is None:
        return
    if isinstance(v, str):
        try:
            v.encode("utf-8")
        except UnicodeEncodeError:
            raise Bad(f"{where}: string holds a lone surrogate")

