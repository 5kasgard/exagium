    seen, unknown, orphans = set(), [], []
    for ref in refs:
        uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve", 
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
        if uuids is None:
