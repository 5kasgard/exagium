            if idx not in explained:
                unknown.append(row)
                continue
            o = explained[idx]
            body = json.loads(base64.b64decode(v["body"]))
            stmt = base64.b64decode(o["body"]["statement_b64"])
            if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
                bad.append(f"orphan entry {o['seq']}: its statement isn't the 
one Rekor holds for log index {idx}")
                continue
            pred = (parse_json(stmt, f"orphan entry {o['seq']} statement") or 
{}).get("predicate") or {}
            prob = _orphan_entries_problem(o, pred)
            if prob is not None:
                bad.append(f"orphan entry {o['seq']}: {prob}")
                continue
            head = pred.get("head_sha256")
            if head in published and head not in current:
                bad.append(f"orphan entry {o['seq']}: the attested head {head} 
was published on {a.git_rev} and later removed")
                continue
            orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
    missing = sorted(n for idx, n in known.items() if idx not in seen) if not 
a.only_ref else []
    print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
                      "explained_orphans": orphans, "unexplained": unknown, 
"wrong": bad,
                      "ledger_anchors_not_found_in_rekor": missing if not 
a.only_ref else "not checked with --only-ref"}, indent=1))
    for x in bad:
        print(f"BAD: {x}", file=sys.stderr)
    return 1 if unknown or missing or bad else 0

