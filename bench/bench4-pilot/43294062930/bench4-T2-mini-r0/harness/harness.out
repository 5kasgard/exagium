def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """Check that the orphan's entries_b64 matches the attested range in pred.
    Returns None if valid, otherwise a short problem string containing:
    - 'range' when the count is wrong
    - 'chain' when an entry's prev doesn't link
    - 'head' when the last hash doesn't match head_sha256
    """
    entries_b64 = orphan.get("body", {}).get("entries_b64")
    if not entries_b64:
        return "range: missing entries_b64"
    if not isinstance(entries_b64, list):
        return "range: entries_b64 must be a list"
    
    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")
    
    if from_seq is None or to_seq is None or head_sha256 is None:
        return "range: incomplete predicate"
    
    expected_count = to_seq - from_seq + 1
    if len(entries_b64) != expected_count:
        return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    
    prev_hash = prev_sha256
    last_hash = None
    
    for i, entry_b64 in enumerate(entries_b64):
        try:
            entry_raw = base64.b64decode(entry_b64, validate=True)
        except ValueError:
            return f"chain: entry {i} is not valid base64"
        
        try:
            entry = parse_canonical(entry_raw, f"orphan entry {i}")
        except Bad as e:
            return f"chain: entry {i} is not canonical ({e})"
        
        # Check prev field
        if entry.get("prev") != prev_hash:
            return f"chain: entry {i} prev {entry.get('prev')!r} != expected 
{prev_hash!r}"
        
        # Compute this entry's hash
        last_hash = hashlib.sha256(entry_raw).hexdigest()
        prev_hash = last_hash
    
    if last_hash != head_sha256:
        return f"head: last entry hash {last_hash} != predicate head_sha256 
{head_sha256}"
    
    return None

