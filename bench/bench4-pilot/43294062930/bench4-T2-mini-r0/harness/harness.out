    "prev": None,
    "kind": "plan",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "alice", "claim": "test", "test": "test.py", "decision_rule":
"pass"}
}
raw1 = R.canonical(e1)
h1 = hashlib.sha256(raw1).hexdigest()
chain.append((e1, h1))

# Entry 2: plan
e2 = {
    "seq": 2,
    "prev": h1,
    "kind": "plan",
    "written_at": "2024-01-01T00:00:01Z",
    "body": {"by": "bob", "claim": "test2", "test": "test2.py", "decision_rule":
"pass"}
}
raw2 = R.canonical(e2)
h2 = hashlib.sha256(raw2).hexdigest()
chain.append((e2, h2))

# Entry 3: verdict
e3 = {
    "seq": 3,
    "prev": h2,
    "kind": "verdict",
    "written_at": "2024-01-01T00:00:02Z",
    "body": {"by": "carol", "plan": {"seq": 1, "sha256": h1}, "outcome": "pass",
"evidence": []}
}
raw3 = R.canonical(e3)
h3 = hashlib.sha256(raw3).hexdigest()
chain.append((e3, h3))

print(f"Entry 1 hash: {h1}")
print(f"Entry 2 hash: {h2}")
print(f"Entry 3 hash: {h3}")

# Test predicate for range 2-3 (entries 2 and 3)
pred = R.range_predicate(chain, 2, 3)
print(f"Predicate: {pred}")

# Create valid entries_b64 for entries 2 and 3
entries_b64_valid = [base64.b64encode(raw2).decode(), 
base64.b64encode(raw3).decode()]

# Create orphan with valid entries_b64
orphan_valid = {
    "body": {
        "by": "owner",
        "log_index": 12345,
        "reason": "test",
        "statement_b64": "e30=",
        "entries_b64": entries_b64_valid
    }
}

# Test 1: Valid entries
print("\n=== Test 1: Valid entries ===")
result = R._orphan_entries_problem(orphan_valid, pred)
print(f"Result: {result}")
assert result is None, f"Expected None, got {result}"
print("PASS")

# Test 2: Wrong count (range error)
orphan_wrong_count = {
    "body": {
        "by": "owner",
        "log_index": 12345,
        "reason": "test",
        "statement_b64": "e30=",
        "entries_b64": [base64.b64encode(raw2).decode()]  # Only 1 entry instead
of 2
    }
}
print("\n=== Test 2: Wrong count ===")
result = R._orphan_entries_problem(orphan_wrong_count, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected 'range' error, got 
{result}"
print("PASS")

# Test 3: Broken chain (chain error) - entry 3 has wrong prev
e3_bad = e3.copy()
e3_bad["prev"] = "0" * 64
