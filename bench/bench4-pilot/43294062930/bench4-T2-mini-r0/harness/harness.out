        "by": "owner",
        "log_index": 12345,
        "reason": "test",
        "statement_b64": "e30=",
        "entries_b64": [base64.b64encode(raw2).decode(), 
base64.b64encode(raw3_bad).decode()]
    }
}
print("\n=== Test 3: Broken chain ===")
result = R._orphan_entries_problem(orphan_bad_chain, pred)
print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected 'chain' error, got 
