   529  def cmd_monitor(a):
   530      """List every Rekor entry signed by the writer workflow on any ref 
GitHub names. Each must be an anchor in the
   531      ledger, or be explained by an orphan entry whose statement matches 
Rekor's payload hash and whose entries were
   532      never published on the ledger branch (so an orphan can't launder a 
deleted verdict). Any force push to the
   533      ledger branch is wrong. Entries are matched by Rekor log index, 
unique per attestation."""
   534      chain, _ = load_chain(a.ledger)
   535      current = {h for _, h in chain}
   536      known, bad = {}, []
   537      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   538          if path.endswith(".sigstore.json"):
   539              try:
   540                  
known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   541              except (ValueError, KeyError, IndexError, TypeError) as ex:
   542                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   543      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
   544      if a.only_ref:
   545          refs, activity = [a.only_ref], []
   546      else:
   547          refs, activity = _refs(a.repo)
   548          for x in activity:
   549              if x.get("activity_type") == "force_push" and x.get("ref") 
== a.ledger_ref:
   550                  bad.append(f"force push to {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
   551      published = _published_entry_hashes(a, a.git_rev) if explained else 
set()
   552      seen, unknown, orphans = set(), [], []
   553      for ref in refs:
   554          uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve",
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
   555          if uuids is None:
   556              raise CantCheck("Rekor's index returned 404")
   557          for u in json.loads(uuids):
   558              got = 
_get(f"https://rekor.sigstore.dev/api/v1/log/entries/{u}")
   559              if got is None:
   560                  raise CantCheck(f"Rekor lists {u} but won't return it")
   561              v = next(iter(json.loads(got).values()))
   562              idx = int(v["logIndex"])
   563              seen.add(idx)
   564              row = {"ref": ref, "log_index": idx, "integrated": 
iso(v["integratedTime"]), "rekor_uuid": u}
   565              if idx in known:
   566                  continue
   567              if idx not in explained:
   568                  unknown.append(row)
   569                  continue
   570              o = explained[idx]
   571              body = json.loads(base64.b64decode(v["body"]))
   572              stmt = base64.b64decode(o["body"]["statement_b64"])
   573              if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
   574                  bad.append(f"orphan entry {o['seq']}: its statement 
isn't the one Rekor holds for log index {idx}")
   575                  continue
   576              pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
   577              prob = _orphan_entries_problem(o, pred)
   578              if prob:
   579                  bad.append(f"orphan entry {o['seq']}: {prob}")
   580                  continue
   581              head = pred.get("head_sha256")
   582              if head in published and head not in current:
   583                  bad.append(f"orphan entry {o['seq']}: the attested head 
{head} was published on {a.git_rev} and later removed")
   584                  continue
   585              orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
   586      missing = sorted(n for idx, n in known.items() if idx not in seen) 
if not a.only_ref else []
   587      print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
   588                        "explained_orphans": orphans, "unexplained": 
unknown, "wrong": bad,
   589                        "ledger_anchors_not_found_in_rekor": missing if 
not a.only_ref else "not checked with --only-ref"}, indent=1))
   590      for x in bad:
   591          print(f"BAD: {x}", file=sys.stderr)
   592      return 1 if unknown or missing or bad else 0
