   500  def _pages(url):
   501      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   502      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   503      import urllib.parse
   504      base = url.split("?")[0]
   505      out = []
   506      while url:
   507          body, hdrs = _get(url, headers=True)
   508          if body is None:
   509              raise CantCheck(f"404 from {url}")
   510          out.extend(json.loads(body))
   511          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   512          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   513      return out
   514  
   515  
   516  def _refs(repo):
   517      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   518      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   519      api = f"https://api.github.com/repos/{repo}"
   520      refs = {"refs/heads/main"}
   521      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   522      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   523      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   524      activity = _pages(f"{api}/activity?per_page=100")
   525      refs.update(x["ref"] for x in activity if x.get("ref"))
   526      return sorted(refs), activity
   527  
