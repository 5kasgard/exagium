   180  def load_chain(ledger):
   181      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   182      chain, plans, verdict_of = [], {}, {}
   183      for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, 
"file in entries"), start=1):
   184          name = os.path.basename(path)
   185          raw = open(path, "rb").read()
   186          e = parse_canonical(raw, name)
   187          if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", 
"written_at", "body"}:
   188              raise Bad(f"{name}: entry must have exactly seq, 
prev,<response clipped><NOTE>Due to the max output limit, only part of this file
has been shown to you. You should retry this tool after you have searched inside
the file with `grep -n` in order to find the line numbers of what you are 
looking for.</NOTE>  for b in blobs:
   189          data = _git(a, "cat-file", "blob", b)
   190          if data is not None:
   191              out.add(hashlib.sha256(data).hexdigest())
   192      return out
   193  
   194  
   195  def _pages(url):
   196      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   197      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   198      import urllib.parse
   199      base = url.split("?")[0]
   200      out = []
   201      while url:
   202          body, hdrs = _get(url, headers=True)
   203          if body is None:
   204              raise CantCheck(f"404 from {url}")
   205          out.extend(json.loads(body))
   206          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   207          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   208      return out
   209  
   210  
   211  def _refs(repo):
   212      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   213      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   214      api = f"https://api.github.com/repos/{repo}"
   215      refs = {"refs/heads/main"}
   216      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   217      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   218      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   219      activity = _pages(f"{api}/activity?per_page=100")
   220      refs.update(x["ref"] for x in activity if x.get("ref"))
   221      return sorted(refs), activity
   222  
   223  
   224  def cmd_monitor(a):
   225      """List every Rekor entry signed by the writer workflow on any ref 
GitHub names. Each must be an anchor in the
   226      ledger, or be explained by an orphan entry whose statement matches 
Rekor's payload hash and whose entries were
   227      never published on the ledger branch (so an orphan can't launder a 
deleted verdict). Any force push to the
   228      ledger branch is wrong. Entries are matched by Rekor log index, 
unique per attestation."""
   229      chain, _ = load_chain(a.ledger)
   230      current = {h for _, h in chain}
   231      known, bad = {}, []
   232      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   233          if path.endswith(".sigstore.json"):
   234              try:
   235                  
known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   236              except (ValueError, KeyError, IndexError, TypeError) as ex:
   237                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   238      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
   239      if a.only_ref:
   240          refs, activity = [a.only_ref], []
   241      else:
   242          refs, activity = _refs(a.repo)
   243          for x in activity:
   244              if x.get("activity_type") == "force_push" and x.get("ref") 
== a.ledger_ref:
   245                  bad.append(f"force push to {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
   246      published = _published_entry_hashes(a, a.git_rev) if explained else 
set()
   247      seen, unknown, orphans = set(), [], []
   248      for ref in refs:
   249          uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve",
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
   250          if uuids is None:
   251              raise CantCheck("Rekor's index returned 404")
   252          for u in json.loads(uuids):
   253              got = 
_get(f"https://rekor.sigstore.dev/api/v1/log/entries/{u}")
   254              if got is None:
   255                  raise CantCheck(f"Rekor lists {u} but won't return it")
   256              v = next(iter(json.loads(got).values()))
   257              idx = int(v["logIndex"])
   258              seen.add(idx)
   259              row = {"ref": ref, "log_index": idx, "integrated": 
iso(v["integratedTime"]), "rekor_uuid": u}
   260              if idx in known:
   261                  continue
   262              if idx not in explained:
   263                  unknown.append(row)
   264                  continue
   265              o = explained[idx]
   266              body = json.loads(base64.b64decode(v["body"]))
   267              stmt = base64.b64decode(o["body"]["statement_b64"])
   268              if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
   269                  bad.append(f"orphan entry {o['seq']}: its statement 
isn't the one Rekor holds for log index {idx}")
   270                  continue
   271              pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
   272              head = pred.get("head_sha256")
   273              if head in published and head not in current:
   274                  bad.append(f"orphan entry {o['seq']}: the attested head 
{head} was published on {a.git_rev} and later removed")
   275                  continue
   276              orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
   277      missing = sorted(n for idx, n in known.items() if idx not in seen) 
if not a.only_ref else []
   278      print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
   279                        "explained_orphans": orphans, "unexplained": 
unknown, "wrong": bad,
   280                        "ledger_anchors_not_found_in_rekor": missing if 
not a.only_ref else "not checked with --only-ref"}, indent=1))
   281      for x in bad:
   282          print(f"BAD: {x}", file=sys.stderr)
   283      return 1 if unknown or missing or bad else 0
   284  
   285  
   286  def cmd_range(a):
   287      chain, _ = load_chain(a.ledger)
   288      if not 1 <= a.from_seq <= a.to_seq <= len(chain):
   289          raise Bad(f"no range {a.from_seq}-{a.to_seq} in a chain of 
{len(chain)}")
   290      print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), 
sort_keys=True, separators=(",", ":")))
   291      return 0
