   175  def _listdir(ledger, sub, pattern, what):
   176      d = os.path.join(ledger, sub)
   177      if not os.path.exists(d):
   178          return []
   179      if os.path.islink(d) or not os.path.isdir(d):
   180          raise Bad(f"{sub}/ must be a plain directory")
   181      out = []
   182      for n in sorted(os.listdir(d)):
   183          p = os.path.join(d, n)
   184          if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
   185              raise Bad(f"{sub}/{n!r}: unexpected {what}")
   186          out.append(p)
   187      return out
   188  
   189  
   190  def load_chain(ledger):
   191      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   192      chain, plans, verdict_of = [], {}, {}
   193      for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, 
"file in entries"), start=1):
   194          name = os.path.basename(path)
   195          raw = open(path, "rb").read()
   196          e = parse_canonical(raw, name)
   197          if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", 
"written_at", "body"}:
   198              raise Bad(f"{name}: entry must have exactly seq, prev, kind,
written_at, body")
   199          if e["seq"] != i or name != f"{i:06d}.json":
   200              raise Bad(f"{name}: seq {e['seq']!r} out of order (expected 
{i})")
   201          if e["prev"] != (chain[-1][1] if chain else None):
   202              raise Bad(f"{name}: prev doesn't match the previous entry's 
sha256")
   203          if e["kind"] not in KINDS:
   204              raise Bad(f"{name}: kind must be one of {KINDS}")
   205          if not isinstance(e["written_at"], str):
   206              raise Bad(f"{name}: written_at must be a string")
   207          check_body(e["kind"], e["body"], name)
   208          h = hashlib.sha256(raw).hexdigest()
   209          if e["kind"] == "plan":
   210              plans[i] = (h, e["body"]["by"])
   211          elif e["kind"] == "verdict":
   212              ref = e["body"]["plan"]
   213              if ref["seq"] not in plans or plans[ref["seq"]][0] != 
ref["sha256"]:
   214                  raise Bad(f"{name}: verdict refers to no earlier plan 
with that seq and sha256")
   215              if ref["seq"] in verdict_of:
   216                  raise Bad(f"{name}: plan {ref['seq']} already has a 
verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan")
   217              if e["body"]["by"] == plans[ref["seq"]][1]:
   218                  raise Bad(f"{name}: the verdict's author is the plan's 
author; a verdict must come from someone else")
   219              verdict_of[ref["seq"]] = i
   220          chain.append((e, h))


