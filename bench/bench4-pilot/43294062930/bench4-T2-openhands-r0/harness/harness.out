import record as R
import base64
import json
import hashlib

# Test case 1: Valid orphan entries matching predicate
print('Test 1: Valid orphan entries')
chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))

pred = R.range_predicate(chain, 1, 3)
print(f'Predicate: {pred}')

# Build entries_b64
entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain]
orphan = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64}}
prob = R._orphan_entries_problem(orphan, pred)
print(f'Problem: {prob}')
assert prob is None, f'Expected None, got {prob}'

# Test case 2: Wrong count (range problem)
print('Test 2: Wrong count')
orphan2 = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64[:2]}}
prob = R._orphan_entries_problem(orphan2, pred)
print(f'Problem: {prob}')
assert 'range' in prob, f'Expected range problem, got {prob}'

# Test case 3: Wrong chain (chain problem)
print('Test 3: Wrong chain')
# Modify the second entry's prev
e2 = dict(chain[1][0])
e2['prev'] = 'wrong'
entries_b64_bad = [entries_b64[0], base64.b64encode(R.canonical(e2)).decode(), 
entries_b64[2]]
orphan3 = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64_bad}}
prob = R._orphan_entries_problem(orphan3, pred)
print(f'Problem: {prob}')
assert 'chain' in prob, f'Expected chain problem, got {prob}'

# Test case 4: Wrong head (head problem)
print('Test 4: Wrong head')
pred_bad = dict(pred)
pred_bad['head_sha256'] = 'wrong'
prob = R._orphan_entries_problem(orphan, pred_bad)
print(f'Problem: {prob}')
assert 'head' in prob, f'Expected head problem, got {prob}'

# Test case 5: from_seq > 1 with valid prev_sha256
print('Test 5: from_seq > 1 with valid prev_sha256')
pred2 = R.range_predicate(chain, 2, 3)
print(f'Predicate: {pred2}')
entries_b64_2 = entries_b64[1:]
orphan4 = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64_2}}
prob = R._orphan_entries_problem(orphan4, pred2)
print(f'Problem: {prob}')
assert prob is None, f'Expected None, got {prob}'

# Test case 6: from_seq > 1 but prev_sha256 is None
print('Test 6: from_seq > 1 but prev_sha256 is None')
pred_bad2 = dict(pred2)
pred_bad2['prev_sha256'] = None
prob = R._orphan_entries_problem(orphan4, pred_bad2)
print(f'Problem: {prob}')
assert 'incomplete' in prob.lower(), f'Expected incomplete predicate, got 
{prob}'

# Test case 7: No entries_b64
print('Test 7: No entries_b64')
orphan5 = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30='}}
prob = R._orphan_entries_problem(orphan5, pred)
print(f'Problem: {prob}')
assert 'no entries_b64' in prob, f'Expected no entries_b64, got {prob}'

print('All tests passed!')
" 2>&1

