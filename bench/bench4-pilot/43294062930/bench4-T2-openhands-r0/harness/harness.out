$ cd /workspace/record && python3 -c "
import record as R
import base64
import json
import hashlib
import tempfile
import os
import shutil
import io
import contextlib

print('=== Test 1: Valid orphan with correct entries_b64 ===')
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))

chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))
    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:
        f.write(raw)

entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain]
orphan_body = {
    'by': 'tester',
    'log_index': 12345,
    'reason': 'valid orphan',
    'statement_b64': base64.b64encode(json.dumps({'predicate': 
R.range_predicate(chain, 1, 3)}).encode()).decode(),
    'entries_b64': entries_b64
}
with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
assert rc == 0, f'Ingest failed: {err.getvalue()}'

# Test _orphan_entries_problem directly
chain_loaded, _ = R.load_chain(d)
orphan = next(e for e, _ in chain_loaded if e['kind'] == 'orphan')
pred = R.range_predicate(chain, 1, 3)
prob = R._orphan_entries_problem(orphan, pred)
