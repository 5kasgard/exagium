    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Validate that an orphan's entries_b64 matches the attested range.
        Returns None if valid, otherwise a short problem string containing 
'range', 'chain', or 'head'."""
        entries_b64 = orphan.get("body", {}).get("entries_b64")
        if not entries_b64:
            return "no entries_b64"
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
        if from_seq is None or to_seq is None or prev_sha256 is None or 
head_sha256 is None:
            return "incomplete predicate"
        expected_count = to_seq - from_seq + 1
        if len(entries_b64) != expected_count:
            return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
        prev_hash = prev_sha256
        for i, entry_b64 in enumerate(entries_b64):
            try:
                entry_bytes = base64.b64decode(entry_b64, validate=True)
            except ValueError:
                return f"chain: entries_b64[{i}] not valid base64"
            entry = parse_json(entry_bytes, f"entries_b64[{i}]")
            if not isinstance(entry, dict) or "prev" not in entry:
                return f"chain: entries_b64[{i}] missing prev field"
            if entry["prev"] != prev_hash:
                return f"chain: entries_b64[{i}] prev {entry['prev']!r} doesn't 
match {prev_hash!r}"
            prev_hash = hashlib.sha256(entry_bytes).hexdigest()
        if prev_hash != head_sha256:
            return f"head: last hash {prev_hash!r} doesn't match head_sha256 
{head_sha256!r}"
        return None

  new_str: 
    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Validate that an orphan's entries_b64 matches the attested range.
        Returns None if valid, otherwise a short problem string containing 
'range', 'chain', or 'head'."""
        entries_b64 = orphan.get("body", {}).get("entries_b64")
        if not entries_b64:
            return "no entries_b64"
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
        if from_seq is None or to_seq is None or head_sha256 is None:
            return "incomplete predicate"
        # prev_sha256 can be None when from_seq == 1 (first entry has no prev)
        if from_seq > 1 and prev_sha256 is None:
            return "incomplete predicate"
        expected_count = to_seq - from_seq + 1
        if len(entries_b64) != expected_count:
            return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
        prev_hash = prev_sha256
        for i, entry_b64 in enumerate(entries_b64):
            try:
                entry_bytes = base64.b64decode(entry_b64, validate=True)
            except ValueError:
                return f"chain: entries_b64[{i}] not valid base64"
            entry = parse_json(entry_bytes, f"entries_b64[{i}]")
            if not isinstance(entry, dict) or "prev" not in entry:
                return f"chain: entries_b64[{i}] missing prev field"
            if entry["prev"] != prev_hash:
                return f"chain: entries_b64[{i}] prev {entry['prev']!r} doesn't 
match {prev_hash!r}"
            prev_hash = hashlib.sha256(entry_bytes).hexdigest()
        if prev_hash != head_sha256:
            return f"head: last hash {prev_hash!r} doesn't match head_sha256 
{head_sha256!r}"
        return None

