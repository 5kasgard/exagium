'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))

pred = R.range_predicate(chain, 1, 3)
print(f'Predicate: {pred}')

# Build entries_b64
entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain]
orphan = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64}}
prob = R._orphan_entries_problem(orphan, pred)
print(f'Problem: {prob}')
assert prob is None, f'Expected None, got {prob}'

# Test case 2: Wrong count (range problem)
print('Test 2: Wrong count')
orphan2 = {'body': {'by': 'test', 'log_index': 1, 'reason': 'test', 
'statement_b64': 'e30=', 'entries_b64': entries_b64[:2]}}
prob = R._orphan_entries_problem(orphan2, pred)
