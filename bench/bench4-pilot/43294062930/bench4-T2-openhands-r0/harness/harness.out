$ cd /workspace/record && python3 -c "
import record as R
import base64
import json
import hashlib
import tempfile
import os
import shutil
import io
import contextlib

# Test that an orphan with invalid entries_b64 (wrong count) is rejected during 
monitor
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))

# Create a chain with 3 entries
chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))
    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:
        f.write(raw)

# Build entries_b64 but with wrong count (only 2 instead of 3)
entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain[:2]] 
# Only 2 entries

# Create an orphan entry with wrong entries_b64
orphan_body = {
    'by': 'tester',
    'log_index': 12345,
    'reason': 'test orphan with entries',
    'statement_b64': base64.b64encode(json.dumps({'predicate': 
R.range_predicate(chain, 1, 3)}).encode()).decode(),
    'entries_b64': entries_b64
}

with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

# Try to ingest
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print(f'Ingest exit code: {rc}')
if rc != 0:
    print(f'Error: {err.getvalue()}')

# The orphan was ingested (ingest doesn't check entries_b64 against predicate)
# Verify shows it's there
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'verify'])
print(f'Verify exit code: {rc}')
print(f'Output: {out.getvalue()}')

# Now test _orphan_entries_problem directly to see it catches the problem
orphan = R.load_chain(d)[0][-1]  # Get the orphan entry
pred = R.range_predicate(chain, 1, 3)
prob = R._orphan_entries_problem(orphan, pred)
print(f'Problem detected by _orphan_entries_problem: {prob}')
assert 'range' in prob

# Clean up
shutil.rmtree(d)
print('Test passed!')
" 2>&1

