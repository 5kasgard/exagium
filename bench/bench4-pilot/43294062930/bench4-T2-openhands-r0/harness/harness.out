prob = R._orphan_entries_problem(orphan3, pred)
print(f'Problem: {prob}')
assert 'chain' in prob, f'Expected chain problem, got {prob}'

# Test case 4: Wrong head (head problem)
print('Test 4: Wrong head')
pred_bad = dict(pred)
pred_bad['head_sha256'] = 'wrong'
prob = R._orphan_entries_problem(orphan, pred_bad)
print(f'Problem: {prob}')
assert 'head' in prob, f'Expected head problem, got {prob}'

print('All tests passed!')
