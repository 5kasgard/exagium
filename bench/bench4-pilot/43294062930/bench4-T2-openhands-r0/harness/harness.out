$ cd /workspace/record && python3 -c "
import record as R
import base64
import json
import hashlib
import tempfile
import os
import shutil
import io
import contextlib

# Test: from_seq > 1 with valid prev_sha256
print('=== Test: from_seq > 1 with valid prev_sha256 ===')
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))

chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))
    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:
        f.write(raw)

# Use entries 2-3 (from_seq=2, to_seq=3)
entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain[1:]]
pred = R.range_predicate(chain, 2, 3)
print(f'Predicate: {pred}')

orphan_body = {
    'by': 'tester',
    'log_index': 12345,
    'reason': 'orphan for entries 2-3',
    'statement_b64': base64.b64encode(json.dumps({'predicate': 
pred}).encode()).decode(),
    'entries_b64': entries_b64
}
with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
assert rc == 0, f'Ingest failed: {err.getvalue()}'

chain_loaded, _ = R.load_chain(d)
orphan = next(e for e, _ in chain_loaded if e['kind'] == 'orphan')
prob = R._orphan_entries_problem(orphan, pred)
assert prob is None, f'Expected None for valid entries, got: {prob}'
print('PASS: Orphan for entries 2-3 accepted')

shutil.rmtree(d)

# Test: from_seq > 1 but prev_sha256 is missing
print('=== Test: from_seq > 1 but prev_sha256 is None ===')
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))

chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))
    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:
        f.write(raw)

entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain[1:]]
pred = R.range_predicate(chain, 2, 3)
pred_bad = dict(pred)
pred_bad['prev_sha256'] = None  # Missing!

orphan_body = {
    'by': 'tester',
    'log_index': 12345,
    'reason': 'orphan with missing prev_sha256',
    'statement_b64': base64.b64encode(json.dumps({'predicate': 
pred_bad}).encode()).decode(),
    'entries_b64': entries_b64
}
with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
assert rc == 0, f'Ingest failed: {err.getvalue()}'

chain_loaded, _ = R.load_chain(d)
orphan = next(e for e, _ in chain_loaded if e['kind'] == 'orphan')
prob = R._orphan_entries_problem(orphan, pred_bad)
assert 'incomplete' in prob.lower(), f'Expected incomplete predicate, got: 
{prob}'
print(f'PASS: Missing prev_sha256 detected: {prob}')

shutil.rmtree(d)

# Test: invalid base64 in entries_b64
print('=== Test: invalid base64 in entries_b64 ===')
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))

chain = []
for i in range(1, 4):
    e = {'seq': i, 'prev': chain[-1][1] if chain else None, 'kind': 'plan', 
'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': f'claim 
{i}', 'test': 'test', 'decision_rule': 'rule'}}
    raw = R.canonical(e)
    h = hashlib.sha256(raw).hexdigest()
    chain.append((e, h))
    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:
        f.write(raw)

entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in chain]
entries_b64[1] = 'not valid base64!!!'

orphan_body = {
    'by': 'tester',
    'log_index': 12345,
    'reason': 'orphan with invalid base64',
    'statement_b64': base64.b64encode(json.dumps({'predicate': 
R.range_predicate(chain, 1, 3)}).encode()).decode(),
    'entries_b64': entries_b64
}
with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
# Ingest should fail because check_body validates base64
print(f'Ingest exit code: {rc}')
if rc != 0:
    print(f'Error (expected): {err.getvalue()}')

shutil.rmtree(d)

print('\\nAll edge case tests passed!')
" 2>&1

