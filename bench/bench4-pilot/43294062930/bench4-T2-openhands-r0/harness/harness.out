   596      chain, _ = load_chain(a.ledger)
   597      if not 1 <= a.from_seq <= a.to_seq <= len(chain):
   598          raise Bad(f"no range {a.from_seq}-{a.to_seq} in a chain of 
{len(chain)}")
   599      print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), 
