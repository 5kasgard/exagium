dger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n\n[318 more lines in file. Use offset=290 to continue.]"}],"isError":false,"durationMs":1,"timestamp":1794513732586},{"role":"assistant","content":[{"type":"thinking","thinking":"Let me find the `range_predicate` function to add the new function after it.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Let me find the `range_predicate` function to add the new function after it.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-1f16f7de-9593-4442-8954-c60614c278da","name":"bash","arguments":{"command":"grep -n \"def range_predicate\" /workspace/record/record.py"}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":5059,"output":58,"cacheRead":13152,"cacheWrite":0,"reasoning":18,"totalTokens":18269,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794513732588,"responseId":"gen-1794513732-2fqzvgUlSaEuyJAvSFEr","rawStopReason":"tool_calls","durationMs":3239,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call-1f16f7de-9593-4442-8954-c60614c278da","toolName":"bash","content":[{"type":"text","text":"298:def range_predicate(chain, from_seq, to_seq):\n"}],"isError":false,"durationMs":4,"timestamp":1794513735831},{"role":"assistant","content":[{"type":"thinking","thinking":"Let me read the `range_predicate` function and the area around it to find a good place to add the new function.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Let me read the `range_predicate` function and the area around it to find a good place to add the new function.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-859cf97b-08fa-4c43-af7b-0b3c831c008f","name":"read","arguments":{"offset":295,"path":"/workspace/record/record.py","limit":30}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":766,"output":80,"cacheRead":17536,"cacheWrite":0,"reasoning":26,"totalTokens":18382,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794513735833,"responseId":"gen-1794513735-6LXYAFiWVB95owty9Ug1","rawStopReason":"tool_calls","durationMs":2186,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call-859cf97b-08fa-4c43-af7b-0b3c831c008f","toolName":"read","content":[{"type":"text","text":"    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n\n[283 more lines in file. Use offset=325 to continue.]"}],"isError":false,"durationMs":2,"timestamp":1794513738021},{"role":"assistant","content":[{"type":"thinking","thinking":"Good, I'll add the `_orphan_entries_problem` function right after `range_predicate` and before `check_sigstore`.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Good, I'll add the `_orphan_entries_problem` function right after `range_predicate` and before `check_sigstore`.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-6fbdb300-355a-49c9-a67a-4f8891454ad7","name":"edit","arguments":{"path":"/workspace/record/record.py","edits":[{"oldText":"def range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}","newText":"def range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    retu