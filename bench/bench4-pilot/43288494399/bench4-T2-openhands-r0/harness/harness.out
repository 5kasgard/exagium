   484  def cmd_monitor(a):
   485      """List every Rekor entry signed by the writer workflow on any ref 
GitHub names. Each must be an anchor in the
   486      ledger, or be explained by an orphan entry whose statement matches 
Rekor's payload hash and whose entries were
   487      never published on the ledger branch (so an orphan can't launder a 
deleted verdict). Any force push to the
   488      ledger branch is wrong. Entries are matched by Rekor log index, 
unique per attestation."""
   489      chain, _ = load_chain(a.ledger)
   490      current = {h for _, h in chain}
   491      known, bad = {}, []
   492      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   493          if path.endswith(".sigstore.json"):
   494              try:
   495                  
known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   496              except (ValueError, KeyError, IndexError, TypeError) as ex:
   497                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   498      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
   499      if a.only_ref:
   500          refs, activity = [a.only_ref], []
   501      else:
   502          refs, activity = _refs(a.repo)
   503          for x in activity:
   504              if x.get("activity_type") == "force_push" and x.get("ref") 
== a.ledger_ref:
   505                  bad.append(f"force push to {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
   506      published = _published_entry_hashes(a, a.git_rev) if explained else 
set()
   507      seen, unknown, orphans = set(), [], []
   508      for ref in refs:
   509          uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve",
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
   510          if uuids is None:
   511              raise CantCheck("Rekor's index returned 404")
   512          for u in json.loads(uuids):
   513              got = 
_get(f"https://rekor.sigstore.dev/api/v1/log/entries/{u}")
   514              if got is None:
   515                  raise CantCheck(f"Rekor lists {u} but won't return it")
   516              v = next(iter(json.loads(got).values()))
   517              idx = int(v["logIndex"])
   518              seen.add(idx)
   519              row = {"ref": ref, "log_index": idx, "integrated": 
iso(v["integratedTime"]), "rekor_uuid": u}
   520              if idx in known:
   521                  continue
   522              if idx not in explained:
   523                  unknown.append(row)
   524                  continue
   525              o = explained[idx]
   526              body = json.loads(base64.b64decode(v["body"]))
   527              stmt = base64.b64decode(o["body"]["statement_b64"])
   528              if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
   529                  bad.append(f"orphan entry {o['seq']}: its statement 
isn't the one Rekor holds for log index {idx}")
   530                  continue
   531              pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
   532              head = pred.get("head_sha256")
   533              if head in published and head not in current:
   534                  bad.append(f"orphan entry {o['seq']}: the attested head 
{head} was published on {a.git_rev} and later removed")
   535                  continue
   536              orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
   537      missing = sorted(n for idx, n in known.items() if idx not in seen) 
if not a.only_ref else []
   538      print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
   539                        "explained_orphans": orphans, "unexplained": 
unknown, "wrong": bad,
   540                        "ledger_anchors_not_found_in_rekor": missing if 
not a.only_ref else "not checked with --only-ref"}, indent=1))
   541      for x in bad:
   542          print(f"BAD: {x}", file=sys.stderr)
   543      return 1 if unknown or missing or bad else 0
