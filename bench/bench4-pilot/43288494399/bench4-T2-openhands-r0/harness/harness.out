import base64, hashlib, json
import record as R

# Test the full flow: create an orphan with entries_b64, verify it gets 
validated

# Create a simple ledger with one plan
import tempfile, os, shutil

d = tempfile.mkdtemp()
try:
    os.makedirs(os.path.join(d, 'entries'))
    os.makedirs(os.path.join(d, 'inbox'))
    os.makedirs(os.path.join(d, 'anchors'))
    
    # Create entry 1 (plan)
    entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'a', 'claim': 'c', 'test': 't', 
'decision_rule': 'd'}}
    entry1_bytes = R.canonical(entry1)
    with open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:
        f.write(entry1_bytes)
    entry1_sha = hashlib.sha256(entry1_bytes).hexdigest()
    
    # Create entry 2 (orphan with entries_b64)
    # The orphan will explain a failed run that attested entries 1-2
    # But entry 2 was never actually written to the ledger
    entry2 = {'seq': 2, 'prev': entry1_sha, 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'b', 'plan': {'seq': 1, 'sha256': 
entry1_sha}, 'outcome': 'fail', 'evidence': []}}
    entry2_bytes = R.canonical(entry2)
    entry2_b64 = base64.b64encode(entry2_bytes).decode()
    entry2_sha = hashlib.sha256(entry2_bytes).hexdigest()
    
    # Create the predicate that matches what the writer attested
    pred = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': 
entry2_sha}
    # Create a statement with this predicate
    statement = {'predicate': pred}
    statement_bytes = R.canonical(statement)
    statement_b64 = base64.b64encode(statement_bytes).decode()
    
    # Create orphan entry
    orphan_body = {
        'by': 'owner',
        'log_index': 12345,
        'reason': 'run failed after attesting',
        'statement_b64': statement_b64,
        'entries_b64': [entry1_b64, entry2_b64]  # The hidden entries
    }
    # Wait, we need entry1_b64 too
    entry1_b64 = base64.b64encode(entry1_bytes).decode()
    orphan_body['entries_b64'] = [entry1_b64, entry2_b64]
    
    orphan = {'seq': 2, 'prev': entry1_sha, 'kind': 'orphan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': orphan_body}
    orphan_bytes = R.canonical(orphan)
    with open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:
        f.write(orphan_bytes)
    
    print('Ledger created successfully')
    
    # Now test the verify command
    import io, contextlib
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(['--ledger', d, 'verify'])
    print('verify rc:', rc)
    print('verify out:', out.getvalue())
    if err.getvalue():
        print('verify err:', err.getvalue())
    
finally:
    shutil.rmtree(d)
"

