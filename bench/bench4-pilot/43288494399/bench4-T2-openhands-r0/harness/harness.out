   195  def _pages(url):
   196      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   197      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   198      import urllib.parse
   199      base = url.split("?")[0]
   200      out = []
   201      while url:
   202          body, hdrs = _get(url, headers=True)
   203          if body is None:
   204              raise CantCheck(f"404 from {url}")
   205          out.extend(json.loads(body))
   206          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   207          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   208      return out
   209  
   210  
   211  def _refs(repo):
   212      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   213      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   214      api = f"https://api.github.com/repos/{repo}"
   215      refs = {"refs/heads/main"}
   216      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   217      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   218      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   219      activity = _pages(f"{api}/activity?per_page=100")
   220      refs.update(x["ref"] for x in activity if x.get("ref"))
   221      return sorted(refs), activity
