  new_str: 
    def range_predicate(chain, from_seq, to_seq):
        """What the writer attests: the range of entries one run added, tied to 
the chain on both ends."""
        return {"from_seq": from_seq, "to_seq": to_seq,
                "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None,
"head_sha256": chain[to_seq - 1][1]}
    
    
    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Check that the orphan's hidden entries match the attested range.
    
        Args:
            orphan: The orphan entry dict (with body.entries_b64 list of base64 
canonical entry bytes)
            pred: The predicate dict with from_seq, to_seq, prev_sha256, 
head_sha256
    
        Returns:
            None if entries match the predicate exactly, otherwise a short 
problem string
            containing 'range', 'chain', or 'head' describing the mismatch.
        """
        entries_b64 = orphan["body"].get("entries_b64", [])
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
    
        expected_count = to_seq - from_seq + 1 if from_seq is not None and 
to_seq is not None else 0
        if len(entries_b64) != expected_count:
            return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    
        prev = prev_sha256
        last_sha256 = None
        for i, e_b64 in enumerate(entries_b64):
            try:
                entry_bytes = base64.b64decode(e_b64, validate=True)
            except ValueError:
                return f"chain: entries_b64[{i}] not valid base64"
            entry = parse_json(entry_bytes, f"orphan entries_b64[{i}]")
            if not isinstance(entry, dict) or "prev" not in entry:
                return f"chain: entries_b64[{i}] missing prev field"
            if entry["prev"] != prev:
                return f"chain: entries_b64[{i}] prev {entry['prev']!r} doesn't 
match expected {prev!r}"
            last_sha256 = hashlib.sha256(entry_bytes).hexdigest()
            prev = last_sha256
    
        if last_sha256 != head_sha256:
            return f"head: last entry sha256 {last_sha256!r} doesn't match 
head_sha256 {head_sha256!r}"
    
        return None
    
    
    def check_sigstore(bundle, digest, repo, workflow, ref):

  kind: "FileEditorAction"

