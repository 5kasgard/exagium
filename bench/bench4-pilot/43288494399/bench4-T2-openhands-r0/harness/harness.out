   426  def _git(a, *args):
   427      root = os.path.dirname(os.path.abspath(a.ledger))
   428      r = subprocess.run(["git", "-C", root, *args], capture_output=True)
   429      return r.stdout if r.returncode == 0 else None
   430  
   431  
   432  def _code_changed(a, c1, c2):
   433      """True/False if record.py or the writer workflow differ between two
commits; "unknown" without that history."""
   434      if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
   435          return "unknown (commit not in this clone)"
   436      root = os.path.dirname(os.path.abspath(a.ledger))
   437      r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, 
"--", "record/record.py", a.workflow])
   438      return {0: False, 1: True}.get(r.returncode, "unknown")
   439  
