   165  def _listdir(ledger, sub, pattern, what):
   166      d = os.path.join(ledger, sub)
   167      if not os.path.exists(d):
   168          return []
   169      if os.path.islink(d) or not os.path.isdir(d):
   170          raise Bad(f"{sub}/ must be a plain directory")
   171      out = []
   172      for n in sorted(os.listdir(d)):
   173          p = os.path.join(d, n)
   174          if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
   175              raise Bad(f"{sub}/{n!r}: unexpected {what}")
   176          out.append(p)
   177      return out
