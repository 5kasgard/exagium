   554  def main(argv=None):
   555      here = os.path.dirname(os.path.abspath(__file__))
   556      ap = argparse.ArgumentParser(description=__doc__, 
formatter_class=argparse.RawDescriptionHelpFormatter)
   557      ap.add_argument("--ledger", default=os.path.join(here, "..", 
"ledger"))
   558      sub = ap.add_subparsers(dest="cmd", required=True)
   559      sub.add_parser("ingest")
   560      sub.add_parser("verify")
   561      sub.add_parser("head")
   562      rp = sub.add_parser("range", help="print the writer's predicate for 
entries FROM..TO (used by CI)")
   563      rp.add_argument("from_seq", type=int)
   564      rp.add_argument("to_seq", type=int)
   565      for name in ("check-anchors", "monitor"):
   566          p = sub.add_parser(name)
   567          p.add_argument("--repo", default="5kasgard/exagium")
   568          p.add_argument("--workflow", 
default=".github/workflows/record.yml")
   569          if name == "check-anchors":
   570              p.add_argument("--ref", default="refs/heads/main")
   571              p.add_argument("--explorer", action="append", default=None,
   572                             help="esplora API base; default 
blockstream.info and mempool.space")
   573          else:
   574              p.add_argument("--only-ref", help="check this ref only 
(default: every ref GitHub names)")
   575              p.add_argument("--ledger-ref", default="refs/heads/main", 
help="the ledger's branch; a force push to it is wrong")
   576              p.add_argument("--git-rev", default="HEAD", help="the ledger
branch's history in this clone (for orphan checks)")
   577      a = ap.parse_args(argv)
   578      if getattr(a, "explorer", "x") is None:
   579          a.explorer = ["https://blockstream.info/api", 
"https://mempool.space/api"]
   580      fn = {"ingest": cmd_ingest, "verify": cmd_verify, "head": cmd_head, 
"range": cmd_range,
   581            "check-anchors": cmd_check_anchors, "monitor": 
cmd_monitor}[a.cmd]
   582      try:
   583          return fn(a)
   584      except Bad as ex:
   585          print(f"BAD: {ex}", file=sys.stderr)
   586          return 1
   587      except CantCheck as ex:
   588          print(f"CAN'T CHECK: {ex}", file=sys.stderr)
   589          return 2
   590      except Exception as ex:  # a failure is never reported as a verdict
   591          print(f"FAILURE: {type(ex).__name__}: {ex}", file=sys.stderr)
   592          return 3
   593  
   594  
   595  if __name__ == "__main__":
   596      sys.exit(main())


