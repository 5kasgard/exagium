$ cd /workspace/record && python3 -c "
import base64, hashlib, json
import record as R

# Create a proper entry structure with prev field
# Entry 1: seq=1, prev=None, kind='plan'
entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'a', 'claim': 'c', 'test': 't', 
'decision_rule': 'd'}}
entry1_bytes = R.canonical(entry1)
entry1_b64 = base64.b64encode(entry1_bytes).decode()

# Entry 2: seq=2, prev=sha256(entry1), kind='verdict'
entry1_sha = hashlib.sha256(entry1_bytes).hexdigest()
entry2 = {'seq': 2, 'prev': entry1_sha, 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'b', 'plan': {'seq': 1, 'sha256': 
entry1_sha}, 'outcome': 'pass', 'evidence': []}}
entry2_bytes = R.canonical(entry2)
entry2_b64 = base64.b64encode(entry2_bytes).decode()
entry2_sha = hashlib.sha256(entry2_bytes).hexdigest()

# Test 1: Valid entries matching predicate
pred = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': 
entry2_sha}
orphan = {'body': {'entries_b64': [entry1_b64, entry2_b64]}}
result = R._orphan_entries_problem(orphan, pred)
print('Test 1 (valid):', result)
assert result is None, f'Expected None, got {result}'

# Test 2: Wrong count (missing one entry)
orphan = {'body': {'entries_b64': [entry1_b64]}}
result = R._orphan_entries_problem(orphan, pred)
print('Test 2 (wrong count):', result)
assert 'range' in result

# Test 3: Wrong chain (entry2 has wrong prev)
entry2_bad = {'seq': 2, 'prev': 'wrong', 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'b', 'plan': {'seq': 1, 'sha256': 
entry1_sha}, 'outcome': 'pass', 'evidence': []}}
entry2_bad_bytes = R.canonical(entry2_bad)
entry2_bad_b64 = base64.b64encode(entry2_bad_bytes).decode()
orphan = {'body': {'entries_b64': [entry1_b64, entry2_bad_b64]}}
result = R._orphan_entries_problem(orphan, pred)
print('Test 3 (wrong chain):', result)
assert 'chain' in result

# Test 4: Wrong head
pred_wrong_head = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 
'head_sha256': 'wrong_head'}
orphan = {'body': {'entries_b64': [entry1_b64, entry2_b64]}}
result = R._orphan_entries_problem(orphan, pred_wrong_head)
print('Test 4 (wrong head):', result)
assert 'head' in result

print('All tests passed!')
"

