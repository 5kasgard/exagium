   378  def cmd_check_anchors(a):
   379      """Every anchor must be right, and the writer's Sigstore ranges must
cover entries 1..head with no gap or overlap.
   380      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
   381      chain, _ = load_chain(a.ledger)
   382      rows, bad, cant, ranges = [], [], [], []
   383      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   384          n = os.path.basename(path)
   385          m = ANCHOR_NAME.fullmatch(n)
   386          seq = int(m.group(1))
   387          try:
   388              if not 1 <= seq <= len(chain):
   389                  raise Bad(f"anchors/{n}: no entry {seq}")
   390              raw = open(os.path.join(a.ledger, "entries", 
f"{seq:06d}.json"), "rb").read()
   391              if m.group(2) == "ots":
   392                  t = check_ots(path, raw, a.explorer)
   393                  rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
   394              else:
   395                  t, pred, commit = check_sigstore(path, chain[seq - 
1][1], a.repo, a.workflow, a.ref)
   396                  if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
   397                          or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
   398                      raise Bad(f"anchors/{n}: attested range {pred!r} 
doesn't match this chain")
   399                  ranges.append((pred["from_seq"], seq, commit))
   400                  rows.append({"anchor": n, "kind": "sigstore", "entries":
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
   401                               "writer_commit": commit})
   402          except Bad as ex:
   403              bad.append(str(ex))
   404          except CantCheck as ex:
   405              cant.append(f"anchors/{n}: {ex}")
   406      covered, changes, prev_commit = 0, [], None
   407      for lo, hi, commit in sorted(ranges):
   408          if lo != covered + 1:
   409              bad.append(f"the writer's ranges {'overlap' if lo <= covered
else 'leave a gap'} at entry {min(lo, covered + 1)}")
   410          covered = max(covered, hi)
