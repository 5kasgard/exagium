validate=True)
        except ValueError:
            raise Bad(f"{where}: statement_b64 must be base64")
        if "entries_b64" in body:
            entries_b64 = _need(body, "entries_b64", list, where)
            for i, x in enumerate(entries_b64):
                if not isinstance(x, str):
                    raise Bad(f"{where}: entries_b64[{i}] must be a string")
                try:
                    base64.b64decode(x, validate=True)
                except ValueError:
                    raise Bad(f"{where}: entries_b64[{i}] must be base64")'''

content = content.replace(old_orphan_validation, new_orphan_validation)

# 2. Add the _orphan_entries_problem function after the range_predicate function
# Find the range_predicate function and add after it
old_range_predicate = '''def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}'''

new_range_predicate = '''def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}


def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """Validate that orphan["body"]["entries_b64"] matches the attested range in
pred.
    
    Returns None if valid, otherwise a short problem string containing:
    - 'range' when the count is wrong
    - 'chain' when an entry's prev doesn't link
    - 'head' when the last hash doesn't match head_sha256
    """
    entries_b64 = orphan.get("body", {}).get("entries_b64")
    if not entries_b64:
        return None  # No entries to validate
    
    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")
    
    if from_seq is None or to_seq is None:
        return "range: predicate missing from_seq or to_seq"
    
    expected_count = to_seq - from_seq + 1
    if len(entries_b64) != expected_count:
        return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    
    prev = prev_sha256
    for i, entry_b64 in enumerate(entries_b64):
        try:
            entry_raw = base64.b64decode(entry_b64, validate=True)
        except ValueError:
            return f"chain: entry {i} is not valid base64"
        
        try:
            entry = json.loads(entry_raw)
        except json.JSONDecodeError:
            return f"chain: entry {i} is not valid JSON"
        
        # Check prev field
        if entry.get("prev") != prev:
            return f"chain: entry {i} prev {entry.get('prev')!r} doesn't match 
expected {prev!r}"
        
        # Compute sha256 of canonical bytes
        entry_sha256 = hashlib.sha256(entry_raw).hexdigest()
        prev = entry_sha256
    
    # Check head
    if prev != head_sha256:
        return f"head: last entry sha256 {prev} doesn't match head_sha256 
{head_sha256}"
    
    return None'''

content = content.replace(old_range_predicate, new_range_predicate)

# 3. Wire it into cmd_monitor - find where orphans are processed and add the 
check
# Look for the section where orphans are appended to the orphans list
old_monitor_orphan_append = '''            orphans.append(dict(row, 
explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))'''

new_monitor_orphan_append = '''            prob = _orphan_entries_problem(o, 
pred)
            if prob:
                bad.append(f"orphan entry {o['seq']}: entries_b64 {prob}")
                continue
            orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))'''

content = content.replace(old_monitor_orphan_append, new_monitor_orphan_append)

# 4. Wire it into cmd_verify - add validation of entries_b64 for orphans
# Find the cmd_verify function and add the check there
old_cmd_verify = '''def cmd_verify(a):
    chain, verdict_of = load_chain(a.ledger)
    today = datetime.date.today().isoformat()
    plans = [e for e, _ in chain if e["kind"] == "plan"]
    open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
    overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and 
e["body"].get("verdict_due", "9999-12-31") < today]
    print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
                      "plans": len(plans), "verdicts": len(verdict_of),
                      "orphans_explained": sum(e["kind"] == "orphan" for e, _ in
chain),
                      "open_plans": open_, "overdue_plans": overdue}, indent=1))
    return 0'''

new_cmd_verify = '''def cmd_verify(a):
    chain, verdict_of = load_chain(a.ledger)
    today = datetime.date.today().isoformat()
    plans = [e for e, _ in chain if e["kind"] == "plan"]
    open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
    overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and 
e["body"].get("verdict_due", "9999-12-31") < today]
    # Validate orphan entries_b64 against the chain
    bad_orphans = []
    for e, h in chain:
        if e["kind"] == "orphan":
            log_index = e["body"].get("log_index")
            # We can't fully validate without Rekor, but we can check 
entries_b64 against the chain
            # if the orphan attests a range that exists in the current chain
            entries_b64 = e["body"].get("entries_b64")
            if entries_b64:
                # Try to find the predicate from statement_b64
                try:
                    stmt = base64.b64decode(e["body"]["statement_b64"])
                    pred = (parse_json(stmt, f"orphan entry {e['seq']} 
statement") or {}).get("predicate") or {}
                    prob = _orphan_entries_problem(e, pred)
                    if prob:
                        bad_orphans.append(f"orphan entry {e['seq']}: 
entries_b64 {prob}")
                except Exception:
                    bad_orphans.append(f"orphan entry {e['seq']}: failed to 
validate entries_b64")
    print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
                      "plans": len(plans), "verdicts": len(verdict_of),
                      "orphans_explained": sum(e["kind"] == "orphan" for e, _ in
chain),
                      "open_plans": open_, "overdue_plans": overdue,
                      "bad_orphans": bad_orphans}, indent=1))
    return 1 if bad_orphans else 0'''

content = content.replace(old_cmd_verify, new_cmd_verify)

with open('/workspace/record/record.py', 'w') as f:
    f.write(content)

