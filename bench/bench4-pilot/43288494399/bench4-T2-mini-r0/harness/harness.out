def identity(repo, workflow, ref):
    return f"https://github.com/{repo}/{workflow}@{ref}"


def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}


def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """Validate that orphan["body"]["entries_b64"] matches the attested range in
pred.
    
    Returns None if valid, otherwise a short problem string containing:
    - 'range' when the count is wrong
    - 'chain' when an entry's prev doesn't link
    - 'head' when the last hash doesn't match head_sha256
    """
    entries_b64 = orphan.get("body", {}).get("entries_b64")
    if entries_b64 is None:
        return None  # No entries to validate
    
    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")
    
    if from_seq is None or to_seq is None:
        return "range: predicate missing from_seq or to_seq"
    
    expected_count = to_seq - from_seq + 1
    if len(entries_b64) != expected_count:
        return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    
    prev = prev_sha256
    for i, entry_b64 in enumerate(entries_b64):
        try:
            entry_raw = base64.b64decode(entry_b64, validate=True)
        except ValueError:
            return f"chain: entry {i} is not valid base64"
        
        try:
            entry = json.loads(entry_raw)
        except json.JSONDecodeError:
            return f"chain: entry {i} is not valid JSON"
        
        # Check prev field
        if entry.get("prev") != prev:
            return f"chain: entry {i} prev {entry.get('prev')!r} doesn't match 
expected {prev!r}"
        
        # Compute sha256 of canonical bytes
        entry_sha256 = hashlib.sha256(entry_raw).hexdigest()
        prev = entry_sha256
    
    # Check head
    if prev != head_sha256:
        return f"head: last entry sha256 {prev} doesn't match head_sha256 
{head_sha256}"
    
    return None

