import sys
sys.path.insert(0, '/workspace/record')
import record as R
import base64
import hashlib
import json
import tempfile
import os
import shutil

# Create a test ledger
d = tempfile.mkdtemp()
try:
    os.makedirs(os.path.join(d, "inbox"))
    os.makedirs(os.path.join(d, "entries"))
    os.makedirs(os.path.join(d, "anchors"))
    
    # Create a plan
    plan_body = {"by": "proposer", "claim": "test", "test": "test.py", 
"decision_rule": "pass"}
    plan_entry = {"seq": 1, "prev": None, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan_body}
    plan_raw = R.canonical(plan_entry)
    plan_sha = hashlib.sha256(plan_raw).hexdigest()
    
    # Create a verdict
    verdict_body = {"by": "verifier", "plan": {"seq": 1, "sha256": plan_sha}, 
"outcome": "pass", "evidence": []}
    verdict_entry = {"seq": 2, "prev": plan_sha, "kind": "verdict", 
"written_at": "2024-01-01T00:00:01Z", "body": verdict_body}
    verdict_raw = R.canonical(verdict_entry)
    verdict_sha = hashlib.sha256(verdict_raw).hexdigest()
    
    # Write entries directly (simulating ingest)
    with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
        f.write(plan_raw)
    with open(os.path.join(d, "entries", "000002.json"), "wb") as f:
        f.write(verdict_raw)
    
    # Test 1: Valid orphan with entries_b64
    print("Test 1: Valid orphan with entries_b64")
    orphan_body = {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": 
base64.b64encode(b'{"predicate":{"from_seq":1,"to_seq":2,"prev_sha256":null,"hea
d_sha256":"' + verdict_sha.encode() + b'"}}').decode(),
        "entries_b64": [base64.b64encode(plan_raw).decode(), 
base64.b64encode(verdict_raw).decode()]
    }
    with open(os.path.join(d, "inbox", "orphan1.json"), "w") as f:
        json.dump({"kind": "orphan", "body": orphan_body}, f)
    
    rc, out, err = R.main(["--ledger", d, "ingest"])
    print(f"  Ingest rc: {rc}, err: {err.strip()}")
    assert rc == 0, "Ingest should succeed"
    
    # Verify
    rc, out, err = R.main(["--ledger", d, "verify"])
    print(f"  Verify rc: {rc}, out: {out}")
    assert rc == 0, "Verify should succeed"
    rep = json.loads(out)
    assert rep["orphans_explained"] == 1
    assert rep["bad_orphans"] == []
    
    # Test 2: Invalid orphan with wrong entries_b64 (wrong count)
    print("\nTest 2: Invalid orphan with wrong count")
    d2 = tempfile.mkdtemp()
    os.makedirs(os.path.join(d2, "inbox"))
    os.makedirs(os.path.join(d2, "entries"))
    os.makedirs(os.path.join(d2, "anchors"))
    
    with open(os.path.join(d2, "entries", "000001.json"), "wb") as f:
        f.write(plan_raw)
    with open(os.path.join(d2, "entries", "000002.json"), "wb") as f:
        f.write(verdict_raw)
    
    orphan_body2 = {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": 
base64.b64encode(b'{"predicate":{"from_seq":1,"to_seq":2,"prev_sha256":null,"hea
d_sha256":"' + verdict_sha.encode() + b'"}}').decode(),
        "entries_b64": [base64.b64encode(plan_raw).decode()]  # Only 1 entry, 
but range expects 2
    }
    with open(os.path.join(d2, "inbox", "orphan2.json"), "w") as f:
        json.dump({"kind": "orphan", "body": orphan_body2}, f)
    
    rc, out, err = R.main(["--ledger", d2, "ingest"])
    print(f"  Ingest rc: {rc}, err: {err.strip()}")
