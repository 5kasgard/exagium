def cmd_verify(a):
    chain, verdict_of = load_chain(a.ledger)
    today = datetime.date.today().isoformat()
    plans = [e for e, _ in chain if e["kind"] == "plan"]
    open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
    overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and 
e["body"].get("verdict_due", "9999-12-31") < today]
    # Validate orphan entries_b64 against the chain
    bad_orphans = []
    for e, h in chain:
        if e["kind"] == "orphan":
            log_index = e["body"].get("log_index")
            # We can't fully validate without Rekor, but we can check 
entries_b64 against the chain
            # if the orphan attests a range that exists in the current chain
            entries_b64 = e["body"].get("entries_b64")
            if entries_b64:
                # Try to find the predicate from statement_b64
                try:
                    stmt = base64.b64decode(e["body"]["statement_b64"])
                    pred = (parse_json(stmt, f"orphan entry {e['seq']} 
statement") or {}).get("predicate") or {}
                    prob = _orphan_entries_problem(e, pred)
                    if prob:
                        bad_orphans.append(f"orphan entry {e['seq']}: 
entries_b64 {prob}")
                except Exception:
                    bad_orphans.append(f"orphan entry {e['seq']}: failed to 
validate entries_b64")
    print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
                      "plans": len(plans), "verdicts": len(verdict_of),
                      "orphans_explained": sum(e["kind"] == "orphan" for e, _ in
chain),
                      "open_plans": open_, "overdue_plans": overdue,
                      "bad_orphans": bad_orphans}, indent=1))
    return 1 if bad_orphans else 0


def cmd_head(a):
    chain, _ = load_chain(a.ledger)
    print(f"{len(chain)} {chain[-1][1] if chain else '-'}")
