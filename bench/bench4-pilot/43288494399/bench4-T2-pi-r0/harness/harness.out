e range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan, pred):\n    \"\"\"Validate the entries_b64 in an orphan against the attested predicate.\n    Returns None if the entries exactly match the attested range; otherwise a short problem string.\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\")\n    if not isinstance(entries_b64, list):\n        return \"range: missing entries_b64\"\n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    if not isinstance(from_seq, int) or not isinstance(to_seq, int) or from_seq > to_seq:\n        return \"range: invalid predicate bounds\"\n    expected = to_seq - from_seq + 1\n    if len(entries_b64) != expected:\n        return f\"range: expected {expected} entries, got {len(entries_b64)}\"\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    for i, b64 in enumerate(entries_b64):\n        try:\n            raw = base64.b64decode(b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        try:\n            e = parse_canonical(raw, f\"orphan entry {orphan['seq']} entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} invalid ({ex})\"\n        if e.get(\"seq\") != from_seq + i:\n            return f\"chain: entry {i} has seq {e.get('seq')!r}, expected {from_seq + i}\"\n        if e.get(\"prev\") != prev_sha256:\n            return f\"chain: entry {i} prev {e.get('prev')!r} doesn't match expected {prev_sha256!r}\"\n        prev_sha256 = hashlib.sha256(raw).hexdigest()\n    if prev_sha256 != head_sha256:\n        return f\"head: last entry hash {prev_sha256} != attested head {head_sha256}\"\n    return None"}],"path":"/workspace/record/record.py"}}]