                  "type": "text",
                  "text": "def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that orphan's entries_b64 matches the attested range in pred.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    entries_b64 = orphan.get(\"body\", {}).get(\"entries_b64\")\n    if not entries_b64:\n        return \"missing entries_b64\"\n    \n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")  # can be None for first entry\n    head_sha256 = pred.get(\"head_sha256\")\n    \n    if None in (from_seq, to_seq, head_sha256):\n        return \"incomplete predicate\"\n    \n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range count mismatch: expected {expected_count}, got {len(entries_b64)}\"\n    \n    prev_hash = prev_sha256\n    last_hash = None\n    \n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_bytes = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"entry {i}: invalid base64\"\n        \n        # Parse the entry to get its prev field\n        try:\n            entry = parse_json(entry_bytes, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"entry {i}: {ex}\"\n        \n        # Check prev field chains correctly\n        if entry.get(\"prev\") != prev_hash:\n            return f\"chain break at entry {i}: prev={entry.get('prev')!r} != {prev_hash!r}\"\n        \n        # Compute this entry's hash\n        last_hash = hashlib.sha256(entry_bytes).hexdigest()\n        prev_hash = last_hash\n    ",
                  "annotations": {
                    "priority": 0.0
                  }
                }
