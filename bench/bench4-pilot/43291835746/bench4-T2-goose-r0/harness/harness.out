                "after": "def range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that an orphan's entries_b64 matches the attested range in pred.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    entries_b64 = orphan.get(\"body\", {}).get(\"entries_b64\")\n    if entries_b64 is None:\n        return \"missing entries_b64\"\n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    if not all(isinstance(x, int) for x in (from_seq, to_seq)) or from_seq > to_seq:\n        return \"bad predicate range\"\n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    prev = prev_sha256\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"entry {i}: invalid base64\"\n        entry = parse_json(entry_raw, f\"orphan entry {i}\")\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"entry {i}: malformed entry\"\n        if entry[\"prev\"] != prev:\n            return f\"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev!r}\"\n        last_hash = hashlib.sha256(entry_raw).hexdigest()\n        prev = last_hash\n    if last_hash != head_sha256:\n        return f\"head: last entry hash {last_hash!r} doesn't match predicate head_sha256 {head_sha256!r}\"\n    return None",
                "before": "def range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}",
