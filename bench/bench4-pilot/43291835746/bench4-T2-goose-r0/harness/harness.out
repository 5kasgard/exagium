              "name": "shell",
              "arguments": {
                "command": "cd /workspace/record && python3 -c \"\nimport base64, hashlib, json\nimport record as R\n\n# Create a simple chain with 2 entries\nchain = []\n# Entry 1: plan\ne1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'proposer', 'claim': 'test', 'test': 't', 'decision_rule': 'r'}}\nraw1 = R.canonical(e1)\nh1 = hashlib.sha256(raw1).hexdigest()\nchain.append((e1, h1))\n\n# Entry 2: verdict\ne2 = {'seq': 2, 'prev': h1, 'kind': 'verdict', 'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'verifier', 'plan': {'seq': 1, 'sha256': h1}, 'outcome': 'pass', 'evidence': []}}\nraw2 = R.canonical(e2)\nh2 = hashlib.sha256(raw2).hexdigest()\nchain.append((e2, h2))\n\n# Create predicate for range 1-2\npred = R.range_predicate(chain, 1, 2)\n\n# Wrong seq\ne1_bad = dict(e1, seq=99)\nraw1_bad = R.canonical(e1_bad)\norphan = {'body': {'by': 'owner', 'log_index': 123, 'reason': 'test', 'statement_b64': 'e30=', 'entries_b64': [base64.b64encode(raw1_bad).decode(), base64.b64encode(raw2).decode()]}}\nprob = R._orphan_entries_problem(orphan, pred)\nprint('Wrong seq:', prob)\n\""
