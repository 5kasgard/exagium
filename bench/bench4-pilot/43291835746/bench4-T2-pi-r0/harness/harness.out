{"type":"tool_execution_end","toolCallId":"call-05c4d7fe-f1f1-4cad-808a-d8c5c389dbe7","toolName":"read","result":{"content":[{"type":"text","text":"\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that orphan[\"body\"][\"entries_b64\"] matches the attested range in pred.\n    Returns None if valid, otherwise a short problem string containing:\n    - 'range' if the entry count is wrong\n    - 'chain' if an entry's prev doesn't link correctly\n    - 'head' if the last entry's hash doesn't match pred[\"head_sha256\"]\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\", [])\n    expected_count = pred[\"to_seq\"] - pred[\"from_seq\"] + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    \n    prev_sha256 = pred[\"prev_sha256\"]\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        entry = parse_json(entry_raw, f\"orphan entry {i}\")\n        # Check that entry has the required fields\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"chain: entry {i} missing required fields\"\n        if entry[\"prev\"] != prev_sha256:\n            return f\"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev_sha256!r}\"\n        last_hash = hashlib.sha256(entry_raw).hexdigest()\n        prev_sha256 = last_hash\n    \n    if last_hash != pred[\"head_sha256\"]:\n        return f\"head: last entry hash {last_hash!r} doesn't match attested head {pred['head_sha256']!r}\"\n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n\n[290 more lines in file. Use offset=350 to continue.]"}],"structuredContent":"\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that orphan[\"body\"][\"entries_b64\"] matches the attested range in pred.\n    Returns None if valid, otherwise a short problem string containing:\n    - 'range' if the entry count is wrong\n    - 'chain' if an entry's prev doesn't link correctly\n    - 'head' if the last entry's hash doesn't match pred[\"head_sha256\"]\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\", [])\n    expected_count = pred[\"to_seq\"] - pred[\"from_seq\"] + 1\n    if len(entries_b64) != expect