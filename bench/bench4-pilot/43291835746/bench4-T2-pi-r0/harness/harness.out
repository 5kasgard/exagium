\"by\", \"log_index\", \"reason\", \"statement_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n        except ValueError:\n            raise Bad(f\"{where}: statement_b64 must be base64\")","newText":"    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n        except ValueError:\n            raise Bad(f\"{where}: statement_b64 must be base64\")\n        if \"entries_b64\" in body:\n            if not isinstance(body[\"entries_b64\"], list):\n                raise Bad(f\"{where}: entries_b64 must be a list\")\n            for i, x in enumerate(body[\"entries_b64\"]):\n                if not isinstance(x, str):\n                    raise Bad(f\"{where}: entries_b64[{i}] must be a string\")\n                try:\n                    base64.b64decode(x, validate=True)\n                except ValueError:\n                    raise Bad(f\"{where}: entries_b64[{i}] must be base64\")"}],"path":"/workspace/record/record.py"}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":2853,"output":915,"cacheRead":13152,"cacheWrite":0,"reasoning":286,"totalToken