ement_b64': 'e30=',\\n                'entries_b64': [123]\\n            }\\n        }, f)\\n    rc, out, err = R.main(['--ledger', d, 'ingest'])\\n    print(f'Non-string item: rc={rc}, err={err.strip()}')\\n    \\n    # Invalid orphan with invalid base64\\n    os.remove(os.path.join(d, 'inbox', 'a.json'))\\n    with open(os.path.join(d, 'inbox', 'a.json'), 'w') as f:\\n        json.dump({\\n            'kind': 'orphan',\\n            'body': {\\n                'by': 'owner',\\n                'log_index': 12345,\\n                'reason': 'test',\\n                'statement_b64': 'e30=',\\n                'entries_b64': ['not valid base64!']\\n            }\\n        }, f)\\n    rc, out, err = R.main(['--ledger', d, 'ingest'])\\n    print(f'Invalid base64: rc={rc}, err={err.strip()}')\\n    \\nfinally:\\n    import shutil\\n    shutil.rmtree(d)\\n\\\"\"}"}}
