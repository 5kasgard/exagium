#!/usr/bin/env python3
"""Integration test for orphan entries validation in monitor."""
import base64
import hashlib
import json
import os
import shutil
import tempfile
import sys
sys.path.insert(0, '/workspace/record')
import record as R

def make_entry(seq, prev, kind, body, written_at="2024-01-01T00:00:00Z"):
    return {
        "seq": seq,
        "prev": prev,
        "kind": kind,
        "written_at": written_at,
        "body": body
    }

def canonical_entry(entry):
    return R.canonical(entry)

def test_orphan_with_valid_entries():
    """Test that an orphan with valid entries_b64 passes monitor checks."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        # Create a chain of entries
        e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": 
"t1", "decision_rule": "d1"})
        e2 = make_entry(2, hashlib.sha256(canonical_entry(e1)).hexdigest(), 
"verdict", 
                        {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
        e3 = make_entry(3, hashlib.sha256(canonical_entry(e2)).hexdigest(), 
"plan", {"by": "c", "claim": "c2", "test": "t2", "decision_rule": "d2"})
        
        entries = [e1, e2, e3]
        for i, e in enumerate(entries, 1):
            raw = canonical_entry(e)
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
        
        # Create an orphan with valid entries_b64 for entries 2-3
        entries_b64 = [base64.b64encode(canonical_entry(e)).decode() for e in 
entries[1:]]
        pred = {
            "from_seq": 2,
            "to_seq": 3,
            "prev_sha256": hashlib.sha256(canonical_entry(e1)).hexdigest(),
            "head_sha256": hashlib.sha256(canonical_entry(e3)).hexdigest()
        }
        statement = {"predicate": pred}
        statement_b64 = base64.b64encode(R.canonical(statement)).decode()
        
        orphan_body = {
            "by": "owner",
            "log_index": 12345,
            "reason": "run failed after attesting",
            "statement_b64": statement_b64,
            "entries_b64": entries_b64
        }
        
        # Write orphan to entries
        orphan_entry = make_entry(4, 
hashlib.sha256(canonical_entry(e3)).hexdigest(), "orphan", orphan_body)
        with open(os.path.join(d, "entries", "000004.json"), "wb") as f:
            f.write(canonical_entry(orphan_entry))
        
        # Verify the chain
        chain, _ = R.load_chain(d)
        assert len(chain) == 4
        print("✓ Chain verified")
        
        # Test _orphan_entries_problem directly
        problem = R._orphan_entries_problem(orphan_entry, pred)
        assert problem is None, f"Expected None, got {problem}"
        print("✓ Orphan entries validation passed")
        
    finally:
        shutil.rmtree(d)

def test_orphan_with_wrong_entries():
    """Test that an orphan with wrong entries_b64 fails."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        # Create a chain of entries
        e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": 
"t1", "decision_rule": "d1"})
        e2 = make_entry(2, hashlib.sha256(canonical_entry(e1)).hexdigest(), 
"verdict", 
                        {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
        
        entries = [e1, e2]
        for i, e in enumerate(entries, 1):
            raw = canonical_entry(e)
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
        
        # Create an orphan with WRONG entries_b64 (wrong count)
        entries_b64 = [base64.b64encode(canonical_entry(e1)).decode()]  # only 1
entry
        pred = {
            "from_seq": 1,
            "to_seq": 2,
            "prev_sha256": None,
            "head_sha256": hashlib.sha256(canonical_entry(e2)).hexdigest()
        }
        statement = {"predicate": pred}
        statement_b64 = base64.b64encode(R.canonical(statement)).decode()
        
        orphan_body = {
            "by": "owner",
            "log_index": 12345,
            "reason": "run failed after attesting",
            "statement_b64": statement_b64,
            "entries_b64": entries_b64
        }
        
        orphan_entry = make_entry(3, 
hashlib.sha256(canonical_entry(e2)).hexdigest(), "orphan", orphan_body)
        
        # Test _orphan_entries_problem directly
        problem = R._orphan_entries_problem(orphan_entry, pred)
        assert problem is not None and "range" in problem, f"Expected 'range' 
error, got {problem}"
        print(f"✓ Wrong count detected: {problem}")
        
    finally:
        shutil.rmtree(d)

def test_orphan_with_broken_chain():
    """Test that an orphan with broken chain fails."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        # Create a chain of entries
        e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": 
"t1", "decision_rule": "d1"})
        e2 = make_entry(2, hashlib.sha256(canonical_entry(e1)).hexdigest(), 
"verdict", 
                        {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
        
        entries = [e1, e2]
        for i, e in enumerate(entries, 1):
            raw = canonical_entry(e)
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
        
        # Create an orphan with broken chain (wrong prev in second entry)
        e2_broken = make_entry(2, "wrong_prev_hash", "verdict", 
                        {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
        entries_b64 = [base64.b64encode(canonical_entry(e1)).decode(), 
base64.b64encode(canonical_entry(e2_broken)).decode()]
        pred = {
            "from_seq": 1,
            "to_seq": 2,
            "prev_sha256": None,
            "head_sha256": hashlib.sha256(canonical_entry(e2)).hexdigest()
        }
        statement = {"predicate": pred}
        statement_b64 = base64.b64encode(R.canonical(statement)).decode()
        
        orphan_body = {
            "by": "owner",
            "log_index": 12345,
            "reason": "run failed after attesting",
            "statement_b64": statement_b64,
            "entries_b64": entries_b64
        }
        
        orphan_entry = make_entry(3, 
hashlib.sha256(canonical_entry(e2)).hexdigest(), "orphan", orphan_body)
        
        # Test _orphan_entries_problem directly
        problem = R._orphan_entries_problem(orphan_entry, pred)
        assert problem is not None and "chain" in problem, f"Expected 'chain' 
error, got {problem}"
        print(f"✓ Broken chain detected: {problem}")
        
    finally:
        shutil.rmtree(d)

def test_orphan_with_wrong_head():
    """Test that an orphan with wrong head hash fails."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        # Create a chain of entries
        e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": 
"t1", "decision_rule": "d1"})
        
        entries = [e1]
        for i, e in enumerate(entries, 1):
            raw = canonical_entry(e)
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
        
        # Create an orphan with wrong head
        entries_b64 = [base64.b64encode(canonical_entry(e1)).decode()]
        pred = {
            "from_seq": 1,
            "to_seq": 1,
            "prev_sha256": None,
            "head_sha256": "0" * 64  # wrong head
        }
        statement = {"predicate": pred}
        statement_b64 = base64.b64encode(R.canonical(statement)).decode()
        
        orphan_body = {
            "by": "owner",
            "log_index": 12345,
            "reason": "run failed after attesting",
            "statement_b64": statement_b64,
            "entries_b64": entries_b64
        }
        
        orphan_entry = make_entry(2, 
hashlib.sha256(canonical_entry(e1)).hexdigest(), "orphan", orphan_body)
        
        # Test _orphan_entries_problem directly
        problem = R._orphan_entries_problem(orphan_entry, pred)
        assert problem is not None and "head" in problem, f"Expected 'head' 
error, got {problem}"
        print(f"✓ Wrong head detected: {problem}")
        
    finally:
        shutil.rmtree(d)

if __name__ == "__main__":
    test_orphan_with_valid_entries()
    test_orphan_with_wrong_entries()
    test_orphan_with_broken_chain()
    test_orphan_with_wrong_head()
    print("\n✅ All integration tests passed!")
