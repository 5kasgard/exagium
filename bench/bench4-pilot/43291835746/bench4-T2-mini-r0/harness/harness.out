def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """Validate that the orphan's entries_b64 matches the attested range.
    Returns None if valid, otherwise a short problem string containing
    'range', 'chain', or 'head'.
    """
    entries_b64 = orphan["body"].get("entries_b64")
    if not isinstance(entries_b64, list):
        return "range: missing or invalid entries_b64"
    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")
    if not (isinstance(from_seq, int) and isinstance(to_seq, int) and from_seq 
<= to_seq):
        return "range: invalid predicate sequence bounds"
    expected_count = to_seq - from_seq + 1
    if len(entries_b64) != expected_count:
        return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    prev = prev_sha256
    last_hash = None
    for i, entry_b64 in enumerate(entries_b64):
        try:
            raw = base64.b64decode(entry_b64, validate=True)
        except ValueError:
            return f"chain: entry {i} is not valid base64"
        try:
            entry = parse_canonical(raw, f"orphan entry {i}")
        except Bad as ex:
            return f"chain: entry {i} invalid: {ex}"
        # Check prev field
        if entry.get("prev") != prev:
            return f"chain: entry {i} prev {entry.get('prev')!r} != expected 
{prev!r}"
        # Compute hash of this entry
        h = hashlib.sha256(raw).hexdigest()
        prev = h
        last_hash = h
    if last_hash != head_sha256:
        return f"head: last entry hash {last_hash} != predicate head_sha256 
{head_sha256}"
    return None


'''

content = content.replace(insert_marker, new_function + insert_marker)

with open('/workspace/record/record.py', 'w') as f:
    f.write(content)

