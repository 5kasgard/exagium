def _check_digests(lst, where):
    if not isinstance(lst, list):
        raise Bad(f"{where}: must be a list")
    for i, x in enumerate(lst):
        if not isinstance(x, dict) or set(x) != {"name", "sha256"} or not 
isinstance(x["name"], str) \
                or not isinstance(x["sha256"], str) or not 
HEX64.fullmatch(x["sha256"]):
            raise Bad(f"{where}[{i}]: must be {{name, sha256}} with 64 lowercase
hex")


def check_body(kind, body, where):
    if not isinstance(body, dict):
        raise Bad(f"{where}: body must be an object")
    _name(body, where)
    if kind == "plan":
        allowed = {"by", "claim", "test", "decision_rule", "baseline", "inputs",
"verdict_due", "notes"}
        for k in ("claim", "test", "decision_rule"):
            if not _need(body, k, str, where).strip():
                raise Bad(f"{where}: {k} is empty")
        if "inputs" in body:
            _check_digests(body["inputs"], f"{where}.inputs")
        if "verdict_due" in body:
            try:
                ok = isinstance(body["verdict_due"], str) and 
len(body["verdict_due"]) == 10 and \
                    datetime.date.fromisoformat(body["verdict_due"]).isoformat()
== body["verdict_due"]
            except ValueError:
                ok = False
            if not ok:
                raise Bad(f"{where}: verdict_due must be a real date, 
YYYY-MM-DD")
    elif kind == "verdict":
        allowed = {"by", "plan", "outcome", "evidence", "notes"}
        p = _need(body, "plan", dict, where)
        if set(p) != {"seq", "sha256"} or not isinstance(p["seq"], int) or 
isinstance(p["seq"], bool) \
                or not isinstance(p["sha256"], str) or not 
HEX64.fullmatch(p["sha256"]):
            raise Bad(f"{where}: plan must be {{seq, sha256}}")
        if body.get("outcome") not in OUTCOMES:
            raise Bad(f"{where}: outcome must be one of {OUTCOMES}")
        _check_digests(_need(body, "evidence", list, where), 
f"{where}.evidence")
    else:  # orphan: explains a Rekor attestation by the writer that the ledger 
doesn't hold
        allowed = {"by", "log_index", "reason", "statement_b64"}
        if _need(body, "log_index", int, where) < 0 or not _need(body, "reason",
str, where).strip():
            raise Bad(f"{where}: orphan needs log_index >= 0 and a reason")
        try:  # the orphaned attestation's exact signed statement; monitor 
checks it against Rekor's payload hash
            base64.b64decode(_need(body, "statement_b64", str, where), 
validate=True)
        except ValueError:
            raise Bad(f"{where}: statement_b64 must be base64")
    extra = set(body) - allowed
    if extra:
        raise Bad(f"{where}: unknown body fields {sorted(extra)}")


