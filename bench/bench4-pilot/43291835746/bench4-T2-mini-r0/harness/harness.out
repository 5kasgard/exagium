def load_chain(ledger):
    """Check the whole chain; return ([(entry, sha256)], {plan seq: verdict 
seq}). Raises Bad on any fault."""
    chain, plans, verdict_of = [], {}, {}
    for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, "file in 
entries"), start=1):
        name = os.path.basename(path)
        raw = open(path, "rb").read()
        e = parse_canonical(raw, name)
        if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", 
"written_at", "body"}:
            raise Bad(f"{name}: entry must have exactly seq, prev, kind, 
written_at, body")
        if e["seq"] != i or name != f"{i:06d}.json":
            raise Bad(f"{name}: seq {e['seq']!r} out of order (expected {i})")
        if e["prev"] != (chain[-1][1] if chain else None):
            raise Bad(f"{name}: prev doesn't match the previous entry's sha256")
        if e["kind"] not in KINDS:
            raise Bad(f"{name}: kind must be one of {KINDS}")
        if not isinstance(e["written_at"], str):
            raise Bad(f"{name}: written_at must be a string")
        check_body(e["kind"], e["body"], name)
        h = hashlib.sha256(raw).hexdigest()
        if e["kind"] == "plan":
            plans[i] = (h, e["body"]["by"])
        elif e["kind"] == "verdict":
            ref = e["body"]["plan"]
            if ref["seq"] not in plans or plans[ref["seq"]][0] != ref["sha256"]:
                raise Bad(f"{name}: verdict refers to no earlier plan with that 
seq and sha256")
            if ref["seq"] in verdict_of:
                raise Bad(f"{name}: plan {ref['seq']} already has a verdict 
(entry {verdict_of[ref['seq']]}); a re-run needs a new plan")
            if e["body"]["by"] == plans[ref["seq"]][1]:
                raise Bad(f"{name}: the verdict's author is the plan's author; a
verdict must come from someone else")
            verdict_of[ref["seq"]] = i
        chain.append((e, h))
    return chain, verdict_of


def make_entry(chain, kind, body, now=None):
    check_body(kind, body, "proposal")
    e = {"seq": len(chain) + 1, "prev": chain[-1][1] if chain else None, "kind":
kind,
         "written_at": now or 
datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
         "body": body}
    _check_value(e, "proposal")
    return e

