cat <<'EOF' > /workspace/record/test_orphan_entries.py
#!/usr/bin/env python3
"""Test the _orphan_entries_problem function."""
import base64
import hashlib
import json
import sys
sys.path.insert(0, '/workspace/record')
import record as R

def make_entry(seq, prev, kind, body, written_at="2024-01-01T00:00:00Z"):
    return {
        "seq": seq,
        "prev": prev,
        "kind": kind,
        "written_at": written_at,
        "body": body
    }

def canonical_entry(entry):
    return R.canonical(entry)

def test_valid_orphan_entries():
    """Test that valid entries pass."""
    # Create a chain of 3 entries
    e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": "t1", 
"decision_rule": "d1"})
    e2 = make_entry(2, hashlib.sha256(canonical_entry(e1)).hexdigest(), 
"verdict", 
                    {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
    e3 = make_entry(3, hashlib.sha256(canonical_entry(e2)).hexdigest(), "plan", 
{"by": "c", "claim": "c2", "test": "t2", "decision_rule": "d2"})
    
    entries = [e1, e2, e3]
    entries_b64 = [base64.b64encode(canonical_entry(e)).decode() for e in 
entries]
    
    orphan = {"body": {"entries_b64": entries_b64}}
    pred = {
        "from_seq": 1,
        "to_seq": 3,
        "prev_sha256": None,
        "head_sha256": hashlib.sha256(canonical_entry(e3)).hexdigest()
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Valid test: {result}")
    assert result is None, f"Expected None, got {result}"
    print("✓ Valid entries test passed")

def test_wrong_count():
    """Test that wrong count returns 'range' error."""
    e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": "t1", 
"decision_rule": "d1"})
    entries_b64 = [base64.b64encode(canonical_entry(e1)).decode()]
    
    orphan = {"body": {"entries_b64": entries_b64}}
    pred = {
        "from_seq": 1,
        "to_seq": 3,
        "prev_sha256": None,
        "head_sha256": "0" * 64
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Wrong count test: {result}")
    assert result is not None and "range" in result, f"Expected 'range' error, 
got {result}"
    print("✓ Wrong count test passed")

def test_chain_break():
    """Test that broken chain returns 'chain' error."""
    e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": "t1", 
"decision_rule": "d1"})
    e2 = make_entry(2, "wrong_prev", "verdict", 
                    {"by": "b", "plan": {"seq": 1, "sha256": 
hashlib.sha256(canonical_entry(e1)).hexdigest()}, "outcome": "pass", "evidence":
[]})
    entries_b64 = [base64.b64encode(canonical_entry(e)).decode() for e in [e1, 
e2]]
    
    orphan = {"body": {"entries_b64": entries_b64}}
    pred = {
        "from_seq": 1,
        "to_seq": 2,
        "prev_sha256": None,
        "head_sha256": hashlib.sha256(canonical_entry(e2)).hexdigest()
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Chain break test: {result}")
    assert result is not None and "chain" in result, f"Expected 'chain' error, 
got {result}"
    print("✓ Chain break test passed")

def test_wrong_head():
    """Test that wrong head hash returns 'head' error."""
    e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": "t1", 
"decision_rule": "d1"})
    entries_b64 = [base64.b64encode(canonical_entry(e1)).decode()]
    
    orphan = {"body": {"entries_b64": entries_b64}}
    pred = {
        "from_seq": 1,
        "to_seq": 1,
        "prev_sha256": None,
        "head_sha256": "0" * 64  # wrong head
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Wrong head test: {result}")
    assert result is not None and "head" in result, f"Expected 'head' error, got
{result}"
    print("✓ Wrong head test passed")

def test_invalid_base64():
    """Test that invalid base64 returns 'chain' error."""
    orphan = {"body": {"entries_b64": ["not valid base64!"]}}
    pred = {
        "from_seq": 1,
        "to_seq": 1,
        "prev_sha256": None,
        "head_sha256": "0" * 64
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Invalid base64 test: {result}")
    assert result is not None and "chain" in result, f"Expected 'chain' error, 
got {result}"
    print("✓ Invalid base64 test passed")

def test_invalid_entry():
    """Test that invalid entry (not canonical) returns 'chain' error."""
    e1 = make_entry(1, None, "plan", {"by": "a", "claim": "c1", "test": "t1", 
"decision_rule": "d1"})
    # Non-canonical bytes
    raw = json.dumps(e1, indent=1).encode()
    entries_b64 = [base64.b64encode(raw).decode()]
    
    orphan = {"body": {"entries_b64": entries_b64}}
    pred = {
        "from_seq": 1,
        "to_seq": 1,
        "prev_sha256": None,
        "head_sha256": hashlib.sha256(raw).hexdigest()
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Invalid entry test: {result}")
    assert result is not None and "chain" in result, f"Expected 'chain' error, 
got {result}"
    print("✓ Invalid entry test passed")

def test_missing_entries_b64():
    """Test that missing entries_b64 returns 'range' error."""
    orphan = {"body": {}}
    pred = {
        "from_seq": 1,
        "to_seq": 1,
        "prev_sha256": None,
        "head_sha256": "0" * 64
    }
    
    result = R._orphan_entries_problem(orphan, pred)
    print(f"Missing entries_b64 test: {result}")
    assert result is not None and "range" in result, f"Expected 'range' error, 
got {result}"
    print("✓ Missing entries_b64 test passed")

if __name__ == "__main__":
    test_valid_orphan_entries()
    test_wrong_count()
    test_chain_break()
    test_wrong_head()
    test_invalid_base64()
    test_invalid_entry()
    test_missing_entries_b64()
    print("\n✅ All tests passed!")
EOF
