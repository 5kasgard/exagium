with open('/workspace/record/record.py', 'r') as f:
    content = f.read()

# Find the orphan checking section and add the call to _orphan_entries_problem
old_code = '''            pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
            head = pred.get("head_sha256")
            if head in published and head not in current:
                bad.append(f"orphan entry {o['seq']}: the attested head {head} 
was published on {a.git_rev} and later removed")
                continue
            orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))'''

new_code = '''            pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
            head = pred.get("head_sha256")
            if head in published and head not in current:
                bad.append(f"orphan entry {o['seq']}: the attested head {head} 
was published on {a.git_rev} and later removed")
                continue
            problem = _orphan_entries_problem(o, pred)
            if problem is not None:
                bad.append(f"orphan entry {o['seq']}: {problem}")
                continue
            orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))'''

content = content.replace(old_code, new_code)

with open('/workspace/record/record.py', 'w') as f:
    f.write(content)

print("Patch 2 applied")
EOF
python3 /tmp/patch2.py
