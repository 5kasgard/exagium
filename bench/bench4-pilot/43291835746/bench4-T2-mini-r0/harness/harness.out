#!/usr/bin/env python3
"""exagium record: an append-only, hash-chained ledger of plans and verdicts, 
with outside anchors.

Layout (under --ledger, default ../ledger):
  entries/000001.json ...   one entry per file; CI 
(.github/workflows/record.yml) is the only writer
  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range
of entries it added, ending at NNNNNN
  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes
  inbox/*.json                   proposals {"kind": ..., "body": ...}; CI moves 
them into entries/

An entry's identity is the sha256 of its stored bytes, which must be exactly its
RFC 8785 (JCS) form
(no trailing newline). The rules that make Python's json.dumps output equal JCS 
are enforced: ASCII
keys, no floats, integers within +-(2**53-1), no lone surrogates.

Commands: ingest | verify | head | range | check-anchors | monitor.
Exit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 
can't check (missing
library or network); 3 unexpected failure. A failure is never reported as a 
verdict.
"""
import argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, 
urllib.error, urllib.request

MAX_INT = 2**53 - 1
KINDS = ("plan", "verdict", "orphan")
OUTCOMES = ("pass", "fail", "inconclusive")
HEX64 = re.compile(r"[0-9a-f]{64}")
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")  # who: a plain ASCII handle, so
"same author" can't hide behind look-alikes
ENTRY_NAME = re.compile(r"([0-9]{6})\.json")
ANCHOR_NAME = re.compile(r"([0-9]{6})\.(sigstore\.json|ots)")
ISSUER = "https://token.actions.githubusercontent.com"


class Bad(Exception):
    """The data is wrong: exit 1."""


class CantCheck(Exception):
    """A check couldn't run (missing library, network): exit 2."""


# ---------- canonical form ----------
def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")


def _check_value(v, where):
    if isinstance(v, bool) or v is None:
        return
    if isinstance(v, str):
        try:
            v.encode("utf-8")
        except UnicodeEncodeError:
            raise Bad(f"{where}: string holds a lone surrogate")
        return
    if isinstance(v, int):
        if abs(v) > MAX_INT:
            raise Bad(f"{where}: integer outside +-(2**53-1)")
        return
    if isinstance(v, float):
        raise Bad(f"{where}: floats aren't allowed; write numbers with a 
fraction as strings")
    if isinstance(v, list):
        for i, x in enumerate(v):
            _check_value(x, f"{where}[{i}]")
        return
    if isinstance(v, dict):
        for k, x in v.items():
            if not k.isascii():
                raise Bad(f"{where}: non-ASCII key {k!r}")
            _check_value(x, f"{where}.{k}")
        return
    raise Bad(f"{where}: unsupported type {type(v).__name__}")


def _no_dup_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise Bad(f"duplicate key {k!r}")
        d[k] = v
    return d


def _no_constants(c):
    raise Bad(f"{c} isn't JSON")


def parse_json(raw, where):
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=_no_dup_keys, 
parse_constant=_no_constants)
    except (UnicodeDecodeError, ValueError, RecursionError) as e:
        raise Bad(f"{where}: not valid UTF-8 JSON ({e})")


def parse_canonical(raw, where):
    """Parse stored bytes; they must be exactly the canonical form of what they 
contain."""
    obj = parse_json(raw, where)
    _check_value(obj, where)
    if canonical(obj) != raw:
        raise Bad(f"{where}: bytes aren't in canonical form")
    return obj


# ---------- schema ----------
def _need(d, key, typ, where):
    if key not in d or not isinstance(d[key], typ) or (typ is int and 
isinstance(d[key], bool)):
        raise Bad(f"{where}: needs {key} ({typ.__name__})")
    return d[key]


def _name(d, where):
    v = _need(d, "by", str, where)
    if not NAME.fullmatch(v):
        raise Bad(f"{where}: by must be a lowercase ASCII handle matching 
{NAME.pattern}")
    return v


def _check_digests(lst, where):
    if not isinstance(lst, list):
        raise Bad(f"{where}: must be a list")
    for i, x in enumerate(lst):
        if not isinstance(x, dict) or set(x) != {"name", "sha256"} or not 
isinstance(x["name"], str) \
                or not isinstance(x["sha256"], str) or not 
HEX64.fullmatch(x["sha256"]):
            raise Bad(f"{where}[{i}]: must be {{name, sha256}} with 64 lowercase
hex")


def check_body(kind, body, where):
    if not isinstance(body, dict):
        raise Bad(f"{where}: body must be an object")
    _name(body, where)
    if kind == "plan":
        allowed = {"by", "claim", "test", "decision_rule", "baseline", "inputs",
"verdict_due", "notes"}
        for k in ("claim", "test", "decision_rule"):
            if not _need(body, k, str, where).strip():
                raise Bad(f"{where}: {k} is empty")
        if "inputs" in body:
            _ch
