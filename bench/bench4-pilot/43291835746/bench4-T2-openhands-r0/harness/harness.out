  new_str: 
    def test_orphan_entries_explain_attestations(self):
            self.propose("a.json", "orphan", {"by": "owner", "log_index": 12345,
"reason": "run failed after attesting",
                                                "statement_b64": "e30="})
            self.assertEqual(self.run_cmd("ingest")[0], 0)
            self.assertEqual(json.loads(self.run_cmd("verify")[1])["orphans_expl
ained"], 1)
    
        def test_orphan_entries_problem_valid_entries(self):
            # Create an orphan with valid entries_b64 that match the predicate
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            pred = R.range_predicate(chain, 1, 2)
            # Create entries_b64 from the chain
            entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in
chain]
            orphan = {"body": {"by": "owner", "log_index": 12345, "reason": 
"test", "statement_b64": "e30=", "entries_b64": entries_b64}}
            problem = R._orphan_entries_problem(orphan, pred)
            self.assertIsNone(problem)
    
        def test_orphan_entries_problem_wrong_count(self):
            # Wrong number of entries
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            pred = R.range_predicate(chain, 1, 2)
            entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in
chain[:1]]  # Only 1 entry
            orphan = {"body": {"by": "owner", "log_index": 12345, "reason": 
"test", "statement_b64": "e30=", "entries_b64": entries_b64}}
            problem = R._orphan_entries_problem(orphan, pred)
            self.assertIn("range", problem)
            self.assertIn("expected 2 entries, got 1", problem)
    
        def test_orphan_entries_problem_broken_chain(self):
            # Entry's prev doesn't link properly
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            pred = R.range_predicate(chain, 1, 2)
            # Modify the second entry's prev to break the chain
            e1, e2 = chain[0][0], chain[1][0]
            e2_broken = dict(e2)
            e2_broken["prev"] = "0" * 64
            entries_b64 = [base64.b64encode(R.canonical(e1)).decode(), 
base64.b64encode(R.canonical(e2_broken)).decode()]
            orphan = {"body": {"by": "owner", "log_index": 12345, "reason": 
"test", "statement_b64": "e30=", "entries_b64": entries_b64}}
            problem = R._orphan_entries_problem(orphan, pred)
            self.assertIn("chain", problem)
    
        def test_orphan_entries_problem_wrong_head(self):
            # Last entry's hash doesn't match head_sha256
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            pred = R.range_predicate(chain, 1, 2)
            pred = dict(pred, head_sha256="0" * 64)  # Wrong head
            entries_b64 = [base64.b64encode(R.canonical(e)).decode() for e, _ in
chain]
            orphan = {"body": {"by": "owner", "log_index": 12345, "reason": 
"test", "statement_b64": "e30=", "entries_b64": entries_b64}}
            problem = R._orphan_entries_problem(orphan, pred)
            self.assertIn("head", problem)
    
        def test_orphan_entries_problem_missing_entries_b64(self):
            # No entries_b64 at all
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            pred = R.range_predicate(chain, 1, 2)
            orphan = {"body": {"by": "owner", "log_index": 12345, "reason": 
"test", "statement_b64": "e30="}}
            problem = R._orphan_entries_problem(orphan, pred)
            self.assertIn("missing entries_b64", problem)
    
        def test_range_predicate_ties_both_ends(self):

  kind: "FileEditorAction"

