   426  def _git(a, *args):
   427      root = os.path.dirname(os.path.abspath(a.ledger))
   428      r = subprocess.run(["git", "-C", root, *args], capture_output=True)
   429      return r.stdout if r.returncode == 0 else None
   430  
   431  
   432  def _code_changed(a, c1, c2):
   433      """True/False if record.py or the writer workflow differ between two
commits; "unknown" without that history."""
   434      if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
   435          return "unknown (commit not in this clone)"
   436      root = os.path.dirname(os.path.abspath(a.ledger))
   437      r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, 
"--", "record/record.py", a.workflow])
   438      return {0: False, 1: True}.get(r.returncode, "unknown")
   439  
   440  
   441  def _published_entry_hashes(a, rev):
   442      """sha256 of every version of every entry file ever committed in 
rev's history."""
   443      raw = _git(a, "log", rev, "--format=", "--raw", "--no-abbrev", "--",
"ledger/entries")
   444      if raw is None:
   445          raise CantCheck(f"no git history for {rev} next to the ledger 
(run monitor in a full clone)")
   446      blobs = {ln.split()[3] for ln in raw.decode().splitlines() if 
ln.startswith(":") and ln.split()[3].strip("0")}
   447      out = set()
   448      for b in blobs:
   449          data = _git(a, "cat-file", "blob", b)
   450          if data is not None:
   451              out.add(hashlib.sha256(data).hexdigest())
   452      return out
   453  
   454  
   455  def _pages(url):
   456      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   457      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   458      import urllib.parse
   459      base = url.split("?")[0]
   460      out = []
   461      while url:
   462          body, hdrs = _get(url, headers=True)
   463          if body is None:
   464              raise CantCheck(f"404 from {url}")
   465          out.extend(json.loads(body))
   466          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   467          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   468      return out
   469  
   470  
   471  def _refs(repo):
   472      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   473      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   474      api = f"https://api.github.com/repos/{repo}"
   475      refs = {"refs/heads/main"}
   476      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   477      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   478      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   479      activity = _pages(f"{api}/activity?per_page=100")
   480      refs.update(x["ref"] for x in activity if x.get("ref"))


