   223  def cmd_ingest(a):
   224      """Move every inbox proposal (in file-name order) into the chain. 
Used by CI, the only writer.
   225      Prints one line per entry as it's written; any bad proposal stops 
with exit 1 and nothing after it is written."""
   226      chain, _ = load_chain(a.ledger)
   227      os.makedirs(os.path.join(a.ledger, "entries"), exist_ok=True)
   228      for p in _listdir(a.ledger, "inbox", 
re.compile(r"[A-Za-z0-9._-]+\.json"), "file in inbox (proposals are 
NAME.json)"):
   229          n = os.path.basename(p)
   230          prop = parse_json(open(p, "rb").read(), f"inbox/{n}")
   231          if not isinstance(prop, dict) or set(prop) != {"kind", "body"} 
or prop["kind"] not in KINDS:
   232              raise Bad(f"inbox/{n}: must be {{kind, body}} with kind in 
{KINDS}")
   233          e = make_entry(chain, prop["kind"], prop["body"])
   234          raw = canonical(e)
   235          out = os.path.join(a.ledger, "entries", f"{e['seq']:06d}.json")
   236          with open(out, "xb") as f:
   237              f.write(raw)
   238          try:
   239              load_chain(a.ledger)  # the new entry must pass every rule, 
e.g. one verdict per plan
   240          except Bad as ex:
   241              os.remove(out)
   242              raise Bad(f"inbox/{n}: {ex}")
   243          chain.append((e, hashlib.sha256(raw).hexdigest()))
   244          os.remove(p)
   245          print(out, flush=True)
   246      return 0
   247  
   248  
   249  def cmd_verify(a):
   250      chain, verdict_of = load_chain(a.ledger)
   251      today = datetime.date.today().isoformat()
   252      plans = [e for e, _ in chain if e["kind"] == "plan"]
   253      open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
   254      overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and
e["body"].get("verdict_due", "9999-12-31") < today]
   255      print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
   256                        "plans": len(plans), "verdicts": len(verdict_of),
   257                        "orphans_explained": sum(e["kind"] == "orphan" for
e, _ in chain),
   258                        "open_plans": open_, "overdue_plans": overdue}, 
indent=1))
   259      return 0
