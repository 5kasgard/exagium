   294  def main(argv=None):
   295      here = os.path.dirname(os.path.abspath(__file__))
   296      ap = argparse.ArgumentParser(description=__doc__, 
formatter_class=argparse.RawDescriptionHelpFormatter)
   297      ap.add_argument("--ledger", default=os.path.join(here, "..", 
"ledger"))
   298      sub = ap.add_subparsers(dest="cmd", required=True)
   299      sub.add_parser("ingest")
   300      sub.add_parser("verify")
   301      sub.add_parser("head")
   302      rp = sub.add_parser("range", help="print the writer's predicate for 
entries FROM..TO (used by CI)")
   303      rp.add_argument("from_seq", type=int)
   304      rp.add_argument("to_seq", type=int)
   305      for name in ("check-anchors", "monitor"):
   306          p = sub.add_parser(name)
   307          p.add_argument("--repo", default="5kasgard/exagium")
   308          p.add_argument("--workflow", 
default=".github/workflows/record.yml")
   309          if name == "check-anchors":
   310              p.add_argument("--ref", default="refs/heads/main")
   311              p.add_argument("--explorer", action="append", default=None,
   312                             help="esplora API base; default 
blockstream.info and mempool.space")
   313          else:
   314              p.add_argument("--only-ref", help="check this ref only 
(default: every ref GitHub names)")
   315              p.add_argument("--ledger-ref", default="refs/heads/main", 
help="the ledger's branch; a force push to it is wrong")
   316              p.add_argument("--git-rev", default="HEAD", help="the ledger
branch's history in this clone (for orphan checks)")
   317      a = ap.parse_args(argv)
   318      if getattr(a, "explorer", "x") is None:
   319          a.explorer = ["https://blockstream.info/api", 
"https://mempool.space/api"]
   320      fn = {"ingest": cmd_ingest, "verify": cmd_verify, "head": cmd_head, 
"range": cmd_range,
   321            "check-anchors": cmd_check_anchors, "monitor": 
cmd_monitor}[a.cmd]
   322      try:
   323          return fn(a)
   324      except Bad as ex:
   325          print(f"BAD: {ex}", file=sys.stderr)
   326          return 1
   327      except CantCheck as ex:
   328          print(f"CAN'T CHECK: {ex}", file=sys.stderr)
   329          return 2
   330      except Exception as ex:  # a failure is never reported as a verdict
   331          print(f"FAILURE: {type(ex).__name__}: {ex}", file=sys.stderr)
   332          return 3
   333  
   334  
   335  if __name__ == "__main__":
   336      sys.exit(main())


