    def test_orphan_entries_explain_attestations(self):
            self.propose("a.json", "orphan", {"by": "owner", "log_index": 12345,
"reason": "run failed after attesting",
                                                "statement_b64": "e30="})
            self.assertEqual(self.run_cmd("ingest")[0], 0)
            self.assertEqual(json.loads(self.run_cmd("verify")[1])["orphans_expl
ained"], 1)
    
        def test_orphan_with_entries_b64_can_be_ingested(self):
            # Test that orphans with entries_b64 are accepted
            self.propose("a.json", "orphan", {"by": "owner", "log_index": 12345,
"reason": "test",
                                                "statement_b64": "e30=", 
"entries_b64": ["e30="]})
            self.assertEqual(self.run_cmd("ingest")[0], 0)
            self.assertEqual(json.loads(self.run_cmd("verify")[1])["orphans_expl
ained"], 1)
    
        def test_orphan_entries_b64_validation(self):
            # Invalid base64 in entries_b64 is rejected
            self.propose("a.json", "orphan", {"by": "owner", "log_index": 12345,
"reason": "test",
                                                "statement_b64": "e30=", 
"entries_b64": ["not-base64!"]})
            rc, _, err = self.run_cmd("ingest")
            self.assertEqual(rc, 1)
            self.assertIn("entries_b64", err)

