   530  def _refs(repo):
   531      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   532      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   533      api = f"https://api.github.com/repos/{repo}"
   534      refs = {"refs/heads/main"}
   535      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   536      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   537      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   538      activity = _pages(f"{api}/activity?per_page=100")
   539      refs.update(x["ref"] for x in activity if x.get("ref"))
   540      return sorted(refs), activity
