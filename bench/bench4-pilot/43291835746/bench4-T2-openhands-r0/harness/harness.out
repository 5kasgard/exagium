   294  def check_sigstore(bundle, digest, repo, workflow, ref):
   295      """Verify offline that a bundle is an attestation of this digest, 
signed by exactly this workflow on this ref.
   296      Returns (integrated_time, predicate). Wrong data is Bad; a missing 
library is CantCheck."""
   297      try:
   298          from sigstore.models import Bundle
   299          from sigstore.verify import Verifier, policy
   300          from sigstore.errors import Error as SigstoreError
   301      except ImportError as ex:
   302          raise CantCheck(f"sigstore-python isn't usable ({ex}); pip 
install sigstore==4.5.1 in a virtualenv")
   303      name = os.path.basename(bundle)
   304      raw = open(bundle, "rb").read()
   305      pol = policy.AllOf([policy.Identity(identity=identity(repo, 
workflow, ref), issuer=ISSUER),
   306                          policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
   307      try:
   308          b = Bundle.from_json(raw)
   309          ptype, payload = 
Verifier.production(offline=True).verify_dsse(b, pol)
   310      except SigstoreError as ex:   # verification errors and malformed 
bundles alike: the anchor is wrong
   311          raise Bad(f"{name}: Sigstore verification failed: {ex}")
   312      except (ValueError, KeyError, TypeError) as ex:
   313          raise Bad(f"{name}: malformed bundle ({type(ex).__name__}: 
{ex})")
   314      st = parse_json(payload, f"{name} payload")
   315      if ptype != "application/vnd.in-toto+json" or not isinstance(st, 
dict) or \
   316              [s.get("digest", {}).get("sha256") for s in 
st.get("subject", [])] != [digest]:
   317          raise Bad(f"{name}: the attestation's subject isn't this entry")
   318      try:  # the same bytes the verifier just checked; their signed entry
timestamp covers integratedTime
   319          t = 
int(json.loads(raw)["verificationMaterial"]["tlogEntries"][0]["integratedTime"])
   320          from cryptography.x509 import ObjectIdentifier


