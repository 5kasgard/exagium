     1  """Tests for record.py's ledger rules (offline; anchors are tested in 
CI)."""
     2  import io, json, os, shutil, tempfile, unittest, contextlib, hashlib
     3  import record as R
     4  
     5  PLAN = {"by": "proposer-agent", "claim": "mlp beats linear", "test": 
"count.py ...", "decision_rule": "Ir lower by > 2 SE"}
     6  
     7  
     8  class Ledger(unittest.TestCase):
     9      def setUp(self):
    10          self.d = tempfile.mkdtemp()
    11          os.makedirs(os.path.join(self.d, "inbox"))
    12  
    13      def tearDown(self):
    14          shutil.rmtree(self.d)
    15  
    16      def run_cmd(self, *args):
    17          out, err = io.StringIO(), io.StringIO()
    18          with contextlib.redirect_stdout(out), 
contextlib.redirect_stderr(err):
    19              rc = R.main(["--ledger", self.d, *args])
    20          return rc, out.getvalue(), err.getvalue()
    21  
    22      def propose(self, name, kind, body):
    23          with open(os.path.join(self.d, "inbox", name), "w") as f:
    24              json.dump({"kind": kind, "body": body}, f)
    25  
    26      def entry(self, n):
    27          return os.path.join(self.d, "entries", f"{n:06d}.json")
    28  
    29      def plan_ref(self, n):
    30          return {"seq": n, "sha256": hashlib.sha256(open(self.entry(n), 
"rb").read()).hexdigest()}
    31  
    32      def verdict(self, n, by="verifier-agent", outcome="pass"):
    33          return {"by": by, "plan": self.plan_ref(n), "outcome": outcome, 
"evidence": []}
    34  
    35      def test_plan_then_verdict_chains_and_verifies(self):
    36          self.propose("a.json", "plan", PLAN)
    37          self.assertEqual(self.run_cmd("ingest")[0], 0)
    38          self.propose("b.json", "verdict", self.verdict(1))
    39          self.assertEqual(self.run_cmd("ingest")[0], 0)
    40          rc, out, _ = self.run_cmd("verify")


