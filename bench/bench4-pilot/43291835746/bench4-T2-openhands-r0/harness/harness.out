   174  def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
   175      """Check that the entries hidden in an orphan match the attested 
range.
   176  
   177      Returns None if the decoded entries exactly match the predicate 
(right count,
   178      proper chaining from prev_sha256, and head_sha256 matches the last 
entry).
   179      Otherwise returns a short problem string containing 'range', 
'chain', or 'head'.
   180      """
   181      entries_b64 = orphan["body"].get("entries_b64")
   182      if entries_b64 is None:
   183          return "missing entries_b64"
   184  
   185      from_seq = pred.get("from_seq")
   186      to_seq = pred.get("to_seq")
   187      prev_sha256 = pred.get("prev_sha256")
   188      head_sha256 = pred.get("head_sha256")
   189  
   190      if not all(isinstance(x, int) for x in (from_seq, to_seq)) or 
from_seq > to_seq:
   191          return "range: invalid from_seq/to_seq"
   192  
   193      expected_count = to_seq - from_seq + 1
   194      if len(entries_b64) != expected_count:
   195          return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
   196  
   197      # Decode and verify each entry
   198      prev = prev_sha256
   199      for i, entry_b64 in enumerate(entries_b64):
   200          try:
   201              entry_bytes = base64.b64decode(entry_b64, validate=True)
   202          except ValueError:
   203              return f"range: entry {i} not valid base64"
   204          entry = parse_json(entry_bytes, f"orphan entry {i}")
   205          if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
   206              return f"range: entry {i} not a valid entry"
   207  
   208          # Check chain linkage
   209          if entry["prev"] != prev:
   210              return f"chain: entry {i} prev {entry['prev']!r} doesn't 
match expected {prev!r}"
   211          # Check sequence number
   212          if entry["seq"] != from_seq + i:
   213              return f"range: entry {i} seq {entry['seq']} doesn't match 
expected {from_seq + i}"
   214          prev = hashlib.sha256(entry_bytes).hexdigest()
   215  
   216      # Check final head hash
   217      if prev != head_sha256:
   218          return f"head: final hash {prev!r} doesn't match attested 
head_sha256 {head_sha256!r}"
   219  
   220      return None
   221  
   222  
