   543  def cmd_monitor(a):
   544      """List every Rekor entry signed by the writer workflow on any ref 
GitHub names. Each must be an anchor in the
   545      ledger, or be explained by an orphan entry whose statement matches 
Rekor's payload hash and whose entries were
   546      never published on the ledger branch (so an orphan can't launder a 
deleted verdict). Any force push to the
   547      ledger branch is wrong. Entries are matched by Rekor log index, 
unique per attestation."""
   548      chain, _ = load_chain(a.ledger)
