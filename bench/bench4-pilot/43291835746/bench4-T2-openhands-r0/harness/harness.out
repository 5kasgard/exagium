   546  def cmd_range(a):
   547      chain, _ = load_chain(a.ledger)
   548      if not 1 <= a.from_seq <= a.to_seq <= len(chain):
   549          raise Bad(f"no range {a.from_seq}-{a.to_seq} in a chain of 
{len(chain)}")
   550      print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), 
sort_keys=True, separators=(",", ":")))
   551      return 0
