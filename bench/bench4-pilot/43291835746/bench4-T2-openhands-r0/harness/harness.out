dex"])] = os.path.basename(path)
   555              except (ValueError, KeyError, IndexError, TypeError) as ex:
   556                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   557      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
