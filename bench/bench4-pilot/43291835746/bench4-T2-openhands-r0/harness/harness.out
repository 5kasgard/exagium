   180  def load_chain(ledger):
   181      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   182      chain, plans, verdict_of = [], {}, {}
   183      for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, 
"file in entries"), start=1):
   184          name = os.path.basename(path)
   185          raw = open(path, "rb").read()
   186          e = parse_canonical(raw, name)
   187          if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", 
"written_at", "body"}:
   188              raise Bad(f"{name}: entry must have exactly seq, prev, kind,
written_at, body")
   189          if e["seq"] != i or name != f"{i:06d}.json":
   190              raise Bad(f"{name}: seq {e['seq']!r} out of order (expected 
{i})")
   191          if e["prev"] != (chain[-1][1] if chain else None):
   192              raise Bad(f"{name}: prev doesn't match the previous entry's 
sha256")
   193          if e["kind"] not in KINDS:
   194              raise Bad(f"{name}: kind must be one of {KINDS}")
   195          if not isinstance(e["written_at"], str):
   196              raise Bad(f"{name}: written_at must be a string")
   197          check_body(e["kind"], e["body"], name)
   198          h = hashlib.sha256(raw).hexdigest()
   199          if e["kind"] == "plan":
   200              plans[i] = (h, e["body"]["by"])
   201          elif e["kind"] == "verdict":
   202              ref = e["body"]["plan"]
   203              if ref["seq"] not in plans or plans[ref["seq"]][0] != 
ref["sha256"]:
   204                  raise Bad(f"{name}: verdict refers to no earlier plan 
with that seq and sha256")
   205              if ref["seq"] in verdict_of:
   206                  raise Bad(f"{name}: plan {ref['seq']} already has a 
verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan")
   207              if e["body"]["by"] == plans[ref["seq"]][1]:
   208                  raise Bad(f"{name}: the verdict's author is the plan's 
author; a verdict must come from someone else")
   209              verdict_of[ref["seq"]] = i
   210          chain.append((e, h))
   211      return chain, verdict_of
   212  
   213  
   214  def make_entry(chain, kind, body, now=None):
   215      check_body(kind, body, "proposal")
   216      e = {"seq": len(chain) + 1, "prev": chain[-1][1] if chain else None,
"kind": kind,
   217           "written_at": now or 
datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
   218           "body": body}
   219      _check_value(e, "proposal")
   220      return e


