    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Check that the entries hidden in an orphan match the attested range.
    
        Returns None if the decoded entries exactly match the predicate (right 
count,
        proper chaining from prev_sha256, and head_sha256 matches the last 
entry).
        Otherwise returns a short problem string containing 'range', 'chain', or
'head'.
        """
        entries_b64 = orphan["body"].get("entries_b64")
        if entries_b64 is None:
            return "missing entries_b64"
    
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
    
        if not all(isinstance(x, int) for x in (from_seq, to_seq)) or from_seq >
to_seq:
            return "range: invalid from_seq/to_seq"
    
        expected_count = to_seq - from_seq + 1
        if len(entries_b64) != expected_count:
            return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
    
        # Decode and verify each entry
        prev = prev_sha256
        for i, entry_b64 in enumerate(entries_b64):
            try:
                entry_bytes = base64.b64decode(entry_b64, validate=True)
            except ValueError:
                return f"range: entry {i} not valid base64"
            entry = parse_json(entry_bytes, f"orphan entry {i}")
            if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
                return f"range: entry {i} not a valid entry"
    
            # Check chain linkage
            if entry["prev"] != prev:
                return f"chain: entry {i} prev {entry['prev']!r} doesn't match 
expected {prev!r}"
            # Check sequence number
            if entry["seq"] != from_seq + i:
                return f"range: entry {i} seq {entry['seq']} doesn't match 
expected {from_seq + i}"
            prev = hashlib.sha256(entry_bytes).hexdigest()
    
        # Check final head hash
        if prev != head_sha256:
            return f"head: final hash {prev!r} doesn't match attested 
head_sha256 {head_sha256!r}"
    
        return None
    
    
    # ---------- the chain ----------

  kind: "FileEditorAction"

