   179  
   180  def load_chain(ledger):
   181      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   182      chain, plans, verdict_of = [], {}, {}
   183      for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, 
"file in entries"), start=1):
   184          name = os.path.basename(path)
   185          raw = open(path, "rb").read()
   186          e = parse_canonical(raw, name)
   187          if not isinstance(e, dict) or set(e) != {"seq", "prev", "kind", 
"written_at", "body"}:
   188              raise Bad(f"{name}: entry must have exactly seq, 
prev,<response clipped><NOTE>Due to the max output limit, only part of this file
