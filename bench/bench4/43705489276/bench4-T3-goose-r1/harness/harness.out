              "content": [
                {
                  "type": "text",
                  "text": "usage: record.py check-anchors [-h] [--repo REPO] [--workflow WORKFLOW]\n                               [--ref REF] [--explorer EXPLORER]\n                               [--max-pending-hours H]\n\noptions:\n  -h, --help            show this help message and exit\n  --repo REPO\n  --workflow WORKFLOW\n  --ref REF\n  --explorer EXPLORER   esplora API base; default blockstream.info and\n                        mempool.space\n  --max-pending-hours H\n                        if a range head's OTS proof is still pending and its\n                        Sigstore attestation is more than H hours old, exit 1",
                  "annotations": {
                    "priority": 0.0
                  }
                }
              ],
              "structuredContent": {
                "stdout": "usage: record.py check-anchors [-h] [--repo REPO] [--workflow WORKFLOW]\n                               [--ref REF] [--explorer EXPLORER]\n                               [--max-pending-hours H]\n\noptions:\n  -h, --help            show this help message and exit\n  --repo REPO\n  --workflow WORKFLOW\n  --ref REF\n  --explorer EXPLORER   esplora API base; default blockstream.info and\n                        mempool.space\n  --max-pending-hours H\n                        if a range head's OTS proof is still pending and its\n                        Sigstore attestation is more than H hours old, exit 1",
