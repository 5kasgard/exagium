    {
      "id": "gen-1794739651-7VeS9JlXCF2CpGRVqXbp",
      "role": "assistant",
      "created": 1794739652,
      "content": [
        {
          "type": "thinking",
          "thinking": "The help shows the new option. Now let me create a test scenario to verify the functionality works as expected. I need to create a test that:\n1. Creates a ledger with some entries\n2. Adds a sigstore anchor with an old attestation time\n3. Adds an OTS anchor that is pending (returns None from check_ots)\n4. Runs check-anchors with --max-pending-hours and verifies it exits with 1 and prints the \"still pending N h\" message\n\nSince the test_record.py stubs check_sigstore and check_ots, I can write a quick manual test using similar stubbing.",
          "signature": ""
        },
        {
          "type": "text",
          "text": "Let me write a quick test to verify the new functionality works correctly:\n"
        },
        {
          "type": "toolRequest",
          "id": "call-7ecca512-3e77-4034-955b-84f62dff229b",
          "toolCall": {
            "status": "success",
            "value": {
              "name": "shell",
              "arguments": {
                "command": "cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time\nimport record as R\n\n# Create a test ledger\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'entries'))\nos.makedirs(os.path.join(d, 'anchors'))\nos.makedirs(os.path.join(d, 'inbox'))\n\n# Create two entries\nPLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py ...', 'decision_rule': 'Ir lower by > 2 SE'}\nchain = []\nfor i, claim in enumerate(['first', 'second'], 1):\n    body = dict(PLAN, claim=claim)\n    e = R.make_entry(chain, 'plan', body)\n    raw = R.canonical(e)\n    with open(os.path.join(d, 'entries', f'{i:06d}.json'), 'wb') as f:\n        f.write(raw)\n    chain.append((e, hashlib.sha256(raw).hexdigest()))\n\n# Create a sigstore anchor for entry 2 (range 1-2) with an old attestation time (72 hours ago)\nold_time = int(time.time()) - 72 * 3600\n# We'll stub check_sigstore and check_ots\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\ndef stub_check_sigstore(*args, **kwargs):\n    return (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')\n\ndef stub_check_ots(*args, **kwargs):\n    return None  # pending\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ntry:\n    # Write a dummy sigstore anchor\n    with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n        f.write('{}')\n    # Write a dummy ots anchor\n    with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:\n        f.write(b'stub')\n    \n    # Test without --max-pending-hours (should pass)\n    import sys, io, contextlib\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, 'check-anchors'])\n    print(f'Without --max-pending-hours: rc={rc}')\n    print(f'stderr: {err.getvalue()}')\n    \n    # Test with --max-pending-hours 48 (should fail, 72 > 48)\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '48'])\n    print(f'With --max-pending-hours 48: rc={rc}')\n    print(f'stderr: {err.getvalue()}')\n    \n    # Test with --max-pending-hours 96 (should pass, 72 < 96)\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '96'])\n    print(f'With --max-pending-hours 96: rc={rc}')\n    print(f'stderr: {err.getvalue()}')\n    \nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""
              }
            }
          },
          "_meta": {
            "goose.toolCall.providerIndex": 0,
            "goose_extension": "developer"
          }
        }
      ],
