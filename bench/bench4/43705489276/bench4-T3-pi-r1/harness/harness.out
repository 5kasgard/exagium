-hours', '72'])\n    print(f'With --max-pending-hours 72: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 73 (should pass, 73 <= 73... wait, it's > not >=)\n    # The condition is hours_pending > a.max_pending_hours\n    # So if hours_pending=73 and max=73, it should pass (73 > 73 is False)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '73'])\n    print(f'With --max-pending-hours 73: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 74 (should pass, 73 < 74)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '74'])\n    print(f'With --max-pending-hours 74: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""},"partialResult":{"content":[]}}
{"type":"tool_execution_update","toolCallId":"call-e258c0a0-e557-4172-a0a3-39ded563fce2","toolName":"bash","args":{"command":"cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time\nimport record as R\n\n# Create a test ledger\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'entries'))\nos.makedirs(os.path.join(d, 'anchors'))\nos.makedirs(os.path.join(d, 'inbox'))\n\n# Create two entries\nchain = []\nfor i in range(2):\n    kind = 'plan' if i == 0 else 'plan'\n    body = {'by': 'test', 'claim': f'claim {i+1}', 'test': 'test', 'decision_rule': 'rule'}\n    e = R.make_entry(chain, kind, body, now='2024-01-01T00:00:00Z')\n    raw = R.canonical(e)\n    with open(os.path.join(d, 'entries', f'{e[\\\"seq\\\"]:06d}.json'), 'wb') as f:\n        f.write(raw)\n    chain.append((e, hashlib.sha256(raw).hexdigest()))\n\n# Create a sigstore anchor for entry 2 (range head)\n# We'll stub check_sigstore to return an old attestation time (72 hours ago)\nold_time = int(time.time()) - 73 * 3600  # 73 hours ago\n\n# Create dummy sigstore file\nwith open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n    f.write('{}')\n\n# Create dummy ots file\nwith open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:\n    f.write(b'stub')\n\n# Stub the functions\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\ndef stub_check_sigstore(*args, **kwargs):\n    pred = R.range_predicate(chain, 1, 2)\n    return (old_time, pred, 'abc123')\n\ndef stub_check_ots(*args, **kwargs):\n    return None  # pending\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ntry:\n    # Test without --max-pending-hours (should pass)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors'])\n    print(f'Without --max-pending-hours: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 72 (should fail, 73 > 72)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '72'])\n    print(f'With --max-pending-hours 72: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 73 (should pass, 73 <= 73... wait, it's > not >=)\n    # The condition is hours_pending > a.max_pending_hours\n    # So if hours_pending=73 and max=73, it should pass (73 > 73 is False)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '73'])\n    print(f'With --max-pending-hours 73: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 74 (should pass, 73 < 74)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '74'])\n    print(f'With --max-pending-hours 74: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""},"partialResult":{"content":[{"type":"text","text":"Traceback (most recent call last):\n  File \"<string>\", line 50, in <module>\nTypeError: cannot unpack non-iterable int object\n"}],"details":{}}}
{"type":"tool_execution_update","toolCallId":"call-e258c0a0-e557-4172-a0a3-39ded563fce2","toolName":"bash","args":{"command":"cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time\nimport record as R\n\n# Create a test ledger\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'entries'))\nos.makedirs(os.path.join(d, 'anchors'))\nos.makedirs(os.path.join(d, 'inbox'))\n\n# Create two entries\nchain = []\nfor i in range(2):\n    kind = 'plan' if i == 0 else 'plan'\n    body = {'by': 'test', 'claim': f'claim {i+1}', 'test': 'test', 'decision_rule': 'rule'}\n    e = R.make_entry(chain, kind, body, now='2024-01-01T00:00:00Z')\n    raw = R.canonical(e)\n    with open(os.path.join(d, 'entries', f'{e[\\\"seq\\\"]:06d}.json'), 'wb') as f:\n        f.write(raw)\n    chain.append((e, hashlib.sha256(raw).hexdigest()))\n\n# Create a sigstore anchor for entry 2 (range head)\n# We'll stub check_sigstore to return an old attestation time (72 hours ago)\nold_time = int(time.time()) - 73 * 3600  # 73 hours ago\n\n# Create dummy sigstore file\nwith open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n    f.write('{}')\n\n# Create dummy ots file\nwith open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:\n    f.write(b'stub')\n\n# Stub the functions\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\ndef stub_check_sigstore(*args, **kwargs):\n    pred = R.range_predicate(chain, 1, 2)\n    return (old_time, pred, 'abc123')\n\ndef stub_check_ots(*args, **kwargs):\n    return None  # pending\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ntry:\n    # Test without --max-pending-hours (should pass)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors'])\n    print(f'Without --max-pending-hours: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 72 (should fail, 73 > 72)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '72'])\n    print(f'With --max-pending-hours 72: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 73 (should pass, 73 <= 73... wait, it's > not >=)\n    # The condition is hours_pending > a.max_pending_hours\n    # So if hours_pending=73 and max=73, it should pass (73 > 73 is False)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '73'])\n    print(f'With --max-pending-hours 73: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 74 (should pass, 73 < 74)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '74'])\n    print(f'With --max-pending-hours 74: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""},"partialResult":{"content":[{"type":"text","text":"Traceback (most recent call last):\n  File \"<string>\", line 50, in <module>\nTypeError: cannot unpack non-iterable int object\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000002.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-2\",\n   \"existed_by\": \"2026-11-12T09:53:26Z\",\n   \"writer_commit\": \"abc123\"\n  }\n ],\n \"entries\": 2,\n \"writer_attested_through\": 2,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_not_check\": []\n}\n"}],"details":{}}}
