       if row[\"anchor\"] == f\"{hi:06d}.ots\" and row[\"existed_by\"] == \"pending\":\n+431                     hours_pending = int((time.time() - attestation_time[hi]) // 3600)\n+432                     if hours_pending > a.max_pending_hours:\n+433                         bad.append(f\"anchors/{hi:06d}.ots: still pending {hours_pending} h\")\n+434                     break\n 419     covered, changes, prev_commit = 0, [], None\n 420     for lo, hi, commit in sorted(ranges):\n 421         if lo != covered + 1:\n 422             bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n     ...\n 611         if name == \"check-anchors\":\n 612             p.add_argument(\"--ref\", default=\"refs/heads/main\")\n 613             p.add_argument(\"--explorer\", action=\"append\", default=None,\n 614                            help=\"esplora API base; default blockstream.info and mempool.space\")\n+631             p.add_argument(\"--max-pending-hours\", type=int, metavar=\"H\",\n+632                            help=\"if a range head's OTS proof is still pending after H hours since its Sigstore attestation, exit 1\")\n 615         else:\n 616             p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n 617             p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n 618             p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n     ...","patch":"--- /workspace/record/record.py\n+++ /workspace/record/record.py\n@@ -385,8 +385,9 @@\n     and every range head must have its OpenTimestamps proof.\n     Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n     chain, _ = load_chain(a.ledger)\n     rows, bad, cant, ranges, stamped = [], [], [], [], set()\n+    at