{"type":"message_update","usage":{"input":1107,"output":1285,"cacheRead":26304,"cacheWrite":0,"reasoning":326,"totalTokens":28696,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call-dbdadcbd-791b-4ffc-a9d9-41ec5cde14d9","name":"bash","arguments":{"command":"cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time, io, contextlib, sys\nimport record as R\n\n# Create a test ledger\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'entries'))\nos.makedirs(os.path.join(d, 'anchors'))\nos.makedirs(os.path.join(d, 'inbox'))\n\n# Create two entries\nchain = []\nfor i in range(2):\n    kind = 'plan'\n    body = {'by': 'test', 'claim': f'claim {i+1}', 'test': 'test', 'decision_rule': 'rule'}\n    e = R.make_entry(chain, kind, body, now='2024-01-01T00:00:00Z')\n    raw = R.canonical(e)\n    with open(os.path.join(d, 'entries', f'{e[\\\"seq\\\"]:06d}.json'), 'wb') as f:\n        f.write(raw)\n    chain.append((e, hashlib.sha256(raw).hexdigest()))\n\n# Create a sigstore anchor for entry 2 (range head)\n# We'll stub check_sigstore to return an old attestation time (73 hours ago)\nold_time = int(time.time()) - 73 * 3600  # 73 hours ago\n\n# Create dummy sigstore file\nwith open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n    f.write('{}')\n\n# Create dummy ots file\nwith open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:\n    f.write(b'stub')\n\n# Stub the functions\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\ndef stub_check_sigstore(*args, **kwargs):\n    pred = R.range_predicate(chain, 1, 2)\n    return (old_time, pred, 'abc123')\n\ndef stub_check_ots(*args, **kwargs):\n    return None  # pending\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ndef run_cmd(*args):\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, *args])\n    return rc, out.getvalue(), err.getvalue()\n\ntry:\n    # Test without --max-pending-hours (should pass)\n    rc, out, err = run_cmd('check-anchors')\n    print(f'Without --max-pending-hours: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 72 (should fail, 73 > 72)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '72')\n    print(f'With --max-pending-hours 72: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 73 (should pass, 73 > 73 is False)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '73')\n    print(f'With --max-pending-hours 73: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours 74 (should pass, 73 < 74)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '74')\n    print(f'With --max-pending-hours 74: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""}}}}
