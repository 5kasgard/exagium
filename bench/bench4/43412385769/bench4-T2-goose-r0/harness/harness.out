              "arguments": {
                "after": "def range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Check that an orphan's entries_b64 matches the attested range in pred.\n    Returns None if the decoded entries are exactly the attested range, otherwise a short problem string.\n    \"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\")\n    if not entries_b64:\n        return \"range: missing entries_b64\"\n    expected_count = pred[\"to_seq\"] - pred[\"from_seq\"] + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    prev_sha = pred[\"prev_sha256\"]\n    last_sha = None\n    for i, b64 in enumerate(entries_b64):\n        try:\n            raw = base64.b64decode(b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} invalid base64\"\n        e = parse_json(raw, f\"orphan entry {i}\")\n        if e.get(\"prev\") != prev_sha:\n            return f\"chain: entry {i} prev {e.get('prev')!r} doesn't match {prev_sha!r}\"\n        last_sha = hashlib.sha256(raw).hexdigest()\n        prev_sha = last_sha\n    if pred[\"head_sha256\"] != last_sha:\n        return f\"head: last entry sha256 {last_sha!r} doesn't match {pred['head_sha256']!r}\"\n    return None",
