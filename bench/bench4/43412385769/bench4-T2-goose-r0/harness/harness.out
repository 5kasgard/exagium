                "command": "cd /workspace/record && python3 -c \"\nimport record as R\nimport base64\nimport hashlib\nimport json\nimport tempfile\nimport os\n\n# Create a temp ledger\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'inbox'))\nos.makedirs(os.path.join(d, 'entries'))\n\n# Create a plan entry first\ne1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': '2024-01-01T00:00:00Z', 'body': {'by': 'a', 'claim': 'c', 'test': 't', 'decision_rule': 'd'}}\nraw1 = R.canonical(e1)\nh1 = hashlib.sha256(raw1).hexdigest()\nwith open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:\n    f.write(raw1)\n\n# Create an orphan with entries_b64\norphan_body = {\n    'by': 'owner',\n    'log_index': 12345,\n    'reason': 'run failed after attesting',\n    'statement_b64': base64.b64encode(b'{\\\"payload\\\": \\\"test\\\", \\\"predicate\\\": {\\\"from_seq\\\": 1, \\\"to_seq\\\": 1, \\\"prev_sha256\\\": null, \\\"head_sha256\\\": \\\"' + h1.encode() + b'\\\"}}').decode(),\n    'entries_b64': [base64.b64encode(raw1).decode()]\n}\n\nwith open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:\n    json.dump({'kind': 'orphan', 'body': orphan_body}, f)\n\n# Run ingest\nimport sys\nimport io\nimport contextlib\nout, err = io.StringIO(), io.StringIO()\nwith contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n    rc = R.main(['--ledger', d, 'ingest'])\nprint('ingest rc:', rc)\nprint('out:', out.getvalue())\nprint('err:', err.getvalue())\n\n# Verify\nout, err = io.StringIO(), io.StringIO()\nwith contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n    rc = R.main(['--ledger', d, 'verify'])\nprint('verify rc:', rc)\nprint('out:', out.getvalue())\n\n# Clean up\nimport shutil\nshutil.rmtree(d)\n\""
              }
            }
