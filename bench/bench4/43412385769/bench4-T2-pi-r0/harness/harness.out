))\norphan_bad2 = {'by': 'owner', 'log_index': 12345, 'reason': 'test', 'statement_b64': 'e30=', 'entries_b64': 'not a list'}\nwith open(os.path.join(d, 'inbox', 'a.json'), 'w') as f:\n    json.dump({'kind': 'orphan', 'body': orphan_bad2}, f)\n\nrc, out, err = run_cmd(d, 'ingest')\nprint('entries_b64 not a list:', rc, err.strip())\nassert rc == 1\nassert 'list' in err\n\nshutil.rmtree(d)\nprint('Schema validation tests passed!')\n\""}}}}
