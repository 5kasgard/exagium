{"type":"tool_execution_end","toolCallId":"call-7fcb14c3-53a0-4f40-88ae-8fa1371c3784","toolName":"read","result":{"content":[{"type":"text","text":"    \"\"\"Check that an orphan's entries_b64 matches the attested range.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    body = orphan.get(\"body\", {})\n    entries_b64 = body.get(\"entries_b64\")\n    if not isinstance(entries_b64, list):\n        return \"range: missing or invalid entries_b64\"\n    \n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    \n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    \n    prev = prev_sha256\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        \n        try:\n            entry = parse_canonical(entry_raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} invalid ({ex})\"\n        \n        if entry.get(\"prev\") != prev:\n            return f\"chain: entry {i} prev {entry.get('prev')!r} != expected {prev!r}\"\n        \n        last_hash = hashlib.sha256(entry_raw).hexdigest()\n        prev = last_hash\n    \n    if last_hash != head_sha256:\n        return f\"head: last entry hash {last_hash!r} != attested head {head_sha256!r}\"\n    \n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n\n[299 more lines in file. Use offset=355 to continue.]"}],"structuredContent":"    \"\"\"Check that an orphan's entries_b64 matches the attested range.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    body = orphan.get(\"body\", {})\n    entries_b64 = body.get(\"entries_b64\")\n    if not isinstance(entries_b64, list):\n        return \"range: missing or invalid entries_b64\"\n    \n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    \n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    \n    prev = prev_sha256\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        \n        try:\n            entry = parse_canonical(entry_raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} invalid ({ex})\"\n        \n        if entry.get(\"prev\") != prev:\n            return f\"chain: entry {i} prev {entry.get('prev')!r} != expected {prev!r}\"\n        \n        last_hash = hashlib.sha256(entry_raw).hexdigest()\n        prev = last_hash\n    \n    if last_hash != head_sha256:\n        return f\"head: last entry hash {last_hash!r} != attested head {head_sha256!r}\"\n    \n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n\n[299 more lines in file. Use offset=355 to continue.]"},"isError":false,"durationMs":2}
