h)\norphan_bad_chain = {'body': {'entries_b64': [base64.b64encode(raw1).decode(), base64.b64encode(raw2.replace(h1.encode(), b'0'*64)).decode()]}}\nprint('Bad chain:', R._orphan_entries_problem(orphan_bad_chain, pred))\n\n# Test wrong head\norphan_bad_head = {'body': {'entries_b64': [base64.b64encode(raw1).decode(), base64.b64encode(raw2).decode()]}}\npred_bad_head = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': '0'*64}\nprint('Bad head:', R._orphan_entries_problem(orphan_bad_head, pred_bad_head))\n\n# Test missing entries_b64\norphan_missing = {'body': {}}\nprint('Missing entries_b64:', R._orphan_entries_problem(orphan_missing, pred))\n\n# Test invalid base64\norphan_bad_b64 = {'body': {'entries_b64': ['not valid base64!']}}\nprint('Invalid base64:', R._orphan_entries_problem(orphan_bad_b64, pred))\n\nshutil.rmtree(ledger)\nprint('All tests passed!')\n\""}}}}
