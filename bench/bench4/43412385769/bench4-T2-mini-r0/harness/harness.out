def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}


def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """Verify that an orphan's hidden entries match the attested range.

    Args:
        orphan: The orphan entry dict, must have orphan["body"]["entries_b64"].
        pred: The predicate dict with from_seq, to_seq, prev_sha256, 
head_sha256.

    Returns:
        None if the entries are exactly the attested range; otherwise a short
        problem string containing "range", "chain", or "head".
    """
    entries_b64 = orphan.get("body", {}).get("entries_b64")
    if not isinstance(entries_b64, list):
        return "range: missing entries_b64 list"

    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")

    if not all(isinstance(x, int) for x in (from_seq, to_seq)) or from_seq > 
to_seq:
        return "range: invalid predicate sequence bounds"

    expected_count = to_seq - from_seq + 1
    if len(entries_b64) != expected_count:
        return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"

    prev = prev_sha256
    last_sha = None
    for i, b64 in enumerate(entries_b64):
        try:
            raw = base64.b64decode(b64, validate=True)
        except ValueError:
            return f"chain: entry {i} is not valid base64"
        try:
            entry = parse_canonical(raw, f"orphan entry {i}")
        except Bad as ex:
            return f"chain: entry {i} invalid ({ex})"
        # Check seq matches expected
        if entry.get("seq") != from_seq + i:
            return f"chain: entry {i} has seq {entry.get('seq')}, expected 
{from_seq + i}"
        # Check prev links correctly
        if entry.get("prev") != prev:
            return f"chain: entry {i} prev {entry.get('prev')!r} != expected 
{prev!r}"
        last_sha = hashlib.sha256(raw).hexdigest()
        prev = last_sha

    if last_sha != head_sha256:
        return f"head: last entry sha256 {last_sha!r} != predicate head_sha256 
{head_sha256!r}"

    return None


def check_sigstore(bundle, digest, repo, workflow, ref):
    """Verify offline that a bundle is an attestation of this digest, signed by 
exactly this workflow on this ref.
    Returns (integrated_time, predicate). Wrong data is Bad; a missing library 
is CantCheck."""
    try:
        from sigstore.models import Bundle
        from sigstore.verify import Verifier, policy
        from sigstore.errors import Error as SigstoreError
    except ImportError as ex:
        raise CantCheck(f"sigstore-python isn't usable ({ex}); pip install 
sigstore==4.5.1 in a virtualenv")
    name = os.path.basename(bundle)
    raw = open(bundle, "rb").read()
    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), 
issuer=ISSUER),
                        policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
    try:
        b = Bundle.from_json(raw)

