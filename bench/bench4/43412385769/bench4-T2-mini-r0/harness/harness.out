#!/usr/bin/env python3
"""Test ingesting and verifying an orphan with entries_b64."""
import base64
import hashlib
import json
import os
import shutil
import tempfile
import sys
sys.path.insert(0, '/workspace/record')
import record as R

def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")

# Create a temp ledger
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, "inbox"))
os.makedirs(os.path.join(d, "entries"))

try:
    # Create a plan entry first
    plan1 = {"by": "proposer-agent", "claim": "test claim", "test": "test", 
"decision_rule": "rule"}
    e1 = {"seq": 1, "prev": None, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan1}
    raw1 = canonical(e1)
    sha1 = hashlib.sha256(raw1).hexdigest()
    
    with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
        f.write(raw1)
    
    # Create a second plan
    plan2 = {"by": "proposer-agent", "claim": "test claim 2", "test": "test", 
"decision_rule": "rule"}
    e2 = {"seq": 2, "prev": sha1, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan2}
    raw2 = canonical(e2)
    sha2 = hashlib.sha256(raw2).hexdigest()
    
    with open(os.path.join(d, "entries", "000002.json"), "wb") as f:
        f.write(raw2)
    
    # Create an orphan with entries_b64
    entries_b64 = [base64.b64encode(raw1).decode(), 
base64.b64encode(raw2).decode()]
    orphan_body = {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": base64.b64encode(b'{"predicateType": "test", 
"predicate": {"from_seq": 1, "to_seq": 2, "prev_sha256": null, "head_sha256": "'
+ sha2 + '"}}').decode(),
        "entries_b64": entries_b64
    }
    
    with open(os.path.join(d, "inbox", "orphan.json"), "w") as f:
        json.dump({"kind": "orphan", "body": orphan_body}, f)
    
    # Ingest the orphan
    import io, contextlib
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(["--ledger", d, "ingest"])
    
    print(f"Ingest rc: {rc}")
    print(f"Out: {out.getvalue()}")
    print(f"Err: {err.getvalue()}")
    
    if rc == 0:
        print("Ingest successful!")
        
        # Verify
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(["--ledger", d, "verify"])
        print(f"Verify rc: {rc}")
        print(f"Verify out: {out.getvalue()}")
        if rc != 0:
            print(f"Verify err: {err.getvalue()}")
    else:
        print("Ingest failed!")
        print(f"Err: {err.getvalue()}")

finally:
    shutil.rmtree(d)
EOF
python3 /workspace/test_orphan_ingest.py
