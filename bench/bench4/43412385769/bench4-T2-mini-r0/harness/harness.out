#!/usr/bin/env python3
"""Test script to understand orphan entries validation."""
import base64
import hashlib
import json
import sys
sys.path.insert(0, '/workspace/record')
import record as R

# Create a simple chain to understand the structure
def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")

# Create a fake orphan entry with entries_b64
plan1 = {"by": "proposer-agent", "claim": "test claim", "test": "test", 
"decision_rule": "rule"}
e1 = {"seq": 1, "prev": None, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan1}
raw1 = canonical(e1)
sha1 = hashlib.sha256(raw1).hexdigest()

plan2 = {"by": "proposer-agent", "claim": "test claim 2", "test": "test", 
"decision_rule": "rule"}
e2 = {"seq": 2, "prev": sha1, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan2}
raw2 = canonical(e2)
sha2 = hashlib.sha256(raw2).hexdigest()

# Orphan with entries_b64 containing e1 and e2
entries_b64 = [base64.b64encode(raw1).decode(), base64.b64encode(raw2).decode()]

orphan = {
    "body": {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": base64.b64encode(b'{}').decode(),
        "entries_b64": entries_b64
    }
}

pred = {
    "from_seq": 1,
    "to_seq": 2,
    "prev_sha256": None,
    "head_sha256": sha2
}

print("orphan:", json.dumps(orphan, indent=2))
print("pred:", json.dumps(pred, indent=2))
print("sha1:", sha1)
print("sha2:", sha2)

# Test decode
for i, b64 in enumerate(entries_b64):
    raw = base64.b64decode(b64)
    entry = json.loads(raw)
    print(f"Entry {i+1}: seq={entry['seq']}, prev={entry['prev']}, 
sha={hashlib.sha256(raw).hexdigest()}")
