def _refs(repo):
    """Every ref GitHub will name for this repo: branches, tags, every pull 
request's merge and head refs,
    and every ref in the activity log (which keeps deleted branches while the 
repo exists)."""
    api = f"https://api.github.com/repos/{repo}"
    refs = {"refs/heads/main"}
    refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
    refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
    refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
    activity = _pages(f"{api}/activity?per_page=100")
    refs.update(x["ref"] for x in activity if x.get("ref"))
    return sorted(refs), activity


def cmd_monitor(a):
    """List every Rekor entry signed by the writer workflow on any ref GitHub 
names. Each must be an anchor in the
    ledger, or be explained by an orphan entry whose statement matches Rekor's 
payload hash and whose entries were
    never published on the ledger branch (so an orphan can't launder a deleted 
verdict). Any force push to the
    ledger branch is wrong. Entries are matched by Rekor log index, unique per 
attestation."""
    chain, _ = load_chain(a.ledger)
    current = {h for _, h in chain}
    known, bad = {}, []
    for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in anchors"):
        if path.endswith(".sigstore.json"):
            try:
                known[int(json.load(open(path))["verificationMaterial"]["tlogEnt
ries"][0]["logIndex"])] = os.path.basename(path)
            except (ValueError, KeyError, IndexError, TypeError) as ex:
                raise Bad(f"{os.path.basename(path)}: malformed bundle ({ex})")
    explained = {e["body"]["log_index"]: e for e, _ in chain if e["kind"] == 
"orphan"}

