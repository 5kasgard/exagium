"""Final verification test."""
import base64
import hashlib
import json
import sys
sys.path.insert(0, '/workspace/record')
import record as R

def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")

# Create a simple chain to test with
plan1 = {"by": "proposer-agent", "claim": "test claim", "test": "test", 
"decision_rule": "rule"}
e1 = {"seq": 1, "prev": None, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan1}
raw1 = canonical(e1)
sha1 = hashlib.sha256(raw1).hexdigest()

plan2 = {"by": "proposer-agent", "claim": "test claim 2", "test": "test", 
"decision_rule": "rule"}
e2 = {"seq": 2, "prev": sha1, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan2}
raw2 = canonical(e2)
sha2 = hashlib.sha256(raw2).hexdigest()

# Test 1: Valid orphan with correct entries_b64
entries_b64 = [base64.b64encode(raw1).decode(), base64.b64encode(raw2).decode()]
orphan_valid = {"body": {"entries_b64": entries_b64}}
pred_valid = {"from_seq": 1, "to_seq": 2, "prev_sha256": None, "head_sha256": 
sha2}
assert R._orphan_entries_problem(orphan_valid, pred_valid) is None, "Test 1 
failed"

# Test 2: Wrong count
orphan_wrong_count = {"body": {"entries_b64": 
[base64.b64encode(raw1).decode()]}}
assert "range" in R._orphan_entries_problem(orphan_wrong_count, pred_valid), 
"Test 2 failed"

# Test 3: Wrong prev
