def _git(a, *args):
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def _code_changed(a, c1, c2):
    """True/False if record.py or the writer workflow differ between two 
commits; "unknown" without that history."""
    if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
        return "unknown (commit not in this clone)"
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, "--", 
"record/record.py", a.workflow])
    return {0: False, 1: True}.get(r.returncode, "unknown")


def _published_entry_hashes(a, rev):
    """sha256 of every version of every entry file ever committed in rev's 
history."""
    raw = _git(a, "log", rev, "--format=", "--raw", "--no-abbrev", "--", 
"ledger/entries")
    if raw is None:
        raise CantCheck(f"no git history for {rev} next to the ledger (run 
monitor in a full clone)")
    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if 
ln.startswith(":") and ln.split()[3].strip("0")}
    out = set()
    for b in blobs:
        data = _git(a, "cat-file", "blob", b)
        if data is not None:
            out.add(hashlib.sha256(data).hexdigest())
    return out


def _pages(url):
    """Follow GitHub's Link: rel="next" (works for page= and the cursor-paged 
activity API). The next link may name
    the repo by numeric id; keep the original /repos/owner/name path and take 
only the query from it."""
    import urllib.parse
    base = url.split("?")[0]
    out = []
    while url:
        body, hdrs = _get(url, headers=True)
        if body is None:
            raise CantCheck(f"404 from {url}")
        out.extend(json.loads(body))
        m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if hdrs else
None) or "")
        url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m else None
    return out


def _refs(repo):
    """Every ref GitHub will name for this repo: branches, tags, every pull 
request's merge and head refs,
    and every ref in the activity log (which keeps deleted branches while the 
repo exists)."""
    api = f"https://api.github.com/repos/{repo}"
    refs = {"refs/heads/main"}
    refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
    refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
    refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
    activity = _pages(f"{api}/activity?per_page=100")
    refs.update(x["ref"] for x in activity if x.get("ref"))
    return sorted(refs), activity


