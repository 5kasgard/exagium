#!/usr/bin/env python3
"""Test ingesting an orphan with invalid entries_b64."""
import base64
import hashlib
import json
import os
import shutil
import tempfile
import sys
sys.path.insert(0, '/workspace/record')
import record as R

def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")

# Create a temp ledger
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, "inbox"))
os.makedirs(os.path.join(d, "entries"))

try:
    # Create a plan entry first
    plan1 = {"by": "proposer-agent", "claim": "test claim", "test": "test", 
"decision_rule": "rule"}
    e1 = {"seq": 1, "prev": None, "kind": "plan", "written_at": 
"2024-01-01T00:00:00Z", "body": plan1}
    raw1 = canonical(e1)
    sha1 = hashlib.sha256(raw1).hexdigest()
    
    with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
        f.write(raw1)
    
    # Create an orphan with INVALID entries_b64 (wrong count)
    entries_b64 = [base64.b64encode(raw1).decode()]  # Only 1 entry but 
predicate says 1-2
    stmt = {"predicateType": "test", "predicate": {"from_seq": 1, "to_seq": 2, 
"prev_sha256": None, "head_sha256": sha1}}
    stmt_b64 = base64.b64encode(json.dumps(stmt).encode()).decode()
    
    orphan_body = {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": stmt_b64,
        "entries_b64": entries_b64
    }
    
    with open(os.path.join(d, "inbox", "orphan.json"), "w") as f:
        json.dump({"kind": "orphan", "body": orphan_body}, f)
    
    # Ingest the orphan - should fail because entries_b64 count doesn't match 
predicate
    import io, contextlib
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(["--ledger", d, "ingest"])
    
    print(f"Ingest rc: {rc}")
    print(f"Out: {out.getvalue()}")
    print(f"Err: {err.getvalue()}")
    
    # The ingest should succeed because check_body only validates base64 format,
not the content
    # The content validation happens in monitor via _orphan_entries_problem
    if rc == 0:
        print("Ingest succeeded (as expected - content validation is in 
monitor)")
    else:
        print("Ingest failed (unexpected)")

finally:
    shutil.rmtree(d)
