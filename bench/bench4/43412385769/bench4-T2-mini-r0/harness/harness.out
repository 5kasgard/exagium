def make_entry(chain, kind, body, now=None):
    check_body(kind, body, "proposal")
    e = {"seq": len(chain) + 1, "prev": chain[-1][1] if chain else None, "kind":
kind,
         "written_at": now or 
datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
         "body": body}
    _check_value(e, "proposal")
    return e


def cmd_ingest(a):
    """Move every inbox proposal (in file-name order) into the chain. Used by 
CI, the only writer.
    Prints one line per entry as it's written; any bad proposal stops with exit 
1 and nothing after it is written."""
    chain, _ = load_chain(a.ledger)
    os.makedirs(os.path.join(a.ledger, "entries"), exist_ok=True)
    for p in _listdir(a.ledger, "inbox", re.compile(r"[A-Za-z0-9._-]+\.json"), 
"file in inbox (proposals are NAME.json)"):
        n = os.path.basename(p)
        prop = parse_json(open(p, "rb").read(), f"inbox/{n}")
        if not isinstance(prop, dict) or set(prop) != {"kind", "body"} or 
prop["kind"] not in KINDS:
            raise Bad(f"inbox/{n}: must be {{kind, body}} with kind in {KINDS}")
        e = make_entry(chain, prop["kind"], prop["body"])
        raw = canonical(e)
        out = os.path.join(a.ledger, "entries", f"{e['seq']:06d}.json")
        with open(out, "xb") as f:
            f.write(raw)
        try:
            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one
verdict per plan
        except Bad as ex:
            os.remove(out)
            raise Bad(f"inbox/{n}: {ex}")
        chain.append((e, hashlib.sha256(raw).hexdigest()))
        os.remove(p)
        print(out, flush=True)
    return 0


def cmd_verify(a):
    chain, verdict_of = load_chain(a.ledger)
    today = datetime.date.today().isoformat()
    plans = [e for e, _ in chain if e["kind"] == "plan"]
    open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
    overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and 
e["body"].get("verdict_due", "9999-12-31") < today]
    print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
                      "plans": len(plans), "verdicts": len(verdict_of),
                      "orphans_explained": sum(e["kind"] == "orphan" for e, _ in
chain),
                      "open_plans": open_, "overdue_plans": overdue}, indent=1))
    return 0


def cmd_head(a):
    chain, _ = load_chain(a.ledger)
    print(f"{len(chain)} {chain[-1][1] if chain else '-'}")
    return 0


# ---------- anchors ----------
def _get(url, data=None, timeout=20, headers=False):
    req = urllib.request.Request(url, data=data, headers={"Content-Type": 
"application/json", "Accept": "application/json",
                                                          "User-Agent": 
"exagium-record"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read()
            return (body, r.headers) if headers else body
    except urllib.error.HTTPError as ex:
        if ex.code == 404:
            return (None, None) if headers else None
        raise CantCheck(f"network: {url}: HTTP {ex.code}")
    except OSError as ex:
        raise CantCheck(f"network: {url}: {ex}")


def identity(repo, workflow, ref):
    return f"https://github.com/{repo}/{workflow}@{ref}"


def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}


