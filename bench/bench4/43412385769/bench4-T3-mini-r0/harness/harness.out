    def test_wrong_data_exits_1_not_3(self):
        # review 1: these used to crash (exit 3) instead of being reported as 
wrong data
        self.propose("a.json", "plan", PLAN)
        self.run_cmd("ingest")
        raw = open(self.entry(1), "rb").read().replace(b'"claim":"mlp beats 
linear"', b'"claim":"\\ud800"')
        open(self.entry(1), "wb").write(raw)
        self.assertEqual(self.run_cmd("verify")[0], 1)
        os.remove(self.entry(1))
        os.makedirs(self.entry(1))
        self.assertEqual(self.run_cmd("verify")[0], 1)

    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):
        self.propose("a.json", "plan", dict(PLAN, verdict_due="2026-99-99"))
        self.assertEqual(self.run_cmd("ingest")[0], 1)
        os.remove(os.path.join(self.d, "inbox", "a.json"))
        open(os.path.join(self.d, "inbox", "a.txt"), "w").write("{}")
        self.assertEqual(self.run_cmd("ingest")[0], 1)

    def test_orphan_entries_explain_attestations(self):
        self.propose("a.json", "orphan", {"by": "owner", "log_index": 12345, 
"reason": "run failed after attesting",
                                            "statement_b64": "e30=", 
"entries_b64": ["e30="]})
        self.assertEqual(self.run_cmd("ingest")[0], 0)
        self.assertEqual(json.loads(self.run_cmd("verify")[1])["orphans_explaine
d"], 1)

    def test_orphans_must_publish_the_hidden_entries(self):
        # review 3: an orphan explained only by its statement could hide an 
attested verdict. Now the orphan must carry
        # the hidden entries, chained from the attested prev and hashing to the 
attested head.
        import base64
        self.propose("a.json", "plan", PLAN)
        self.run_cmd("ingest")
        chain, _ = R.load_chain(self.d)
        hidden = R.make_entry(chain, "verdict", {"by": "verifier-agent", "plan":
{"seq": 1, "sha256": chain[0][1]},
                                                 "outcome": "fail", "evidence": 
[]})
        raw = R.canonical(hidden)
        pred = {"from_seq": 2, "to_seq": 2, "prev_sha256": chain[0][1], 
"head_sha256": hashlib.sha256(raw).hexdigest()}
        b64 = base64.b64encode(raw).decode()
        self.assertIsNone(R._orphan_entries_problem({"body": {"entries_b64": 
[b64]}}, pred))
        other = base64.b64encode(raw.replace(b'"fail"', b'"pass"')).decode()
        self.assertIn("head", R._orphan_entries_problem({"body": {"entries_b64":
[other]}}, pred))
        self.assertIn("range", R._orphan_entries_problem({"body": 
{"entries_b64": [b64, b64]}}, pred))
        self.assertIn("chain", R._orphan_entries_problem({"body": 
{"entries_b64": [b64]}}, dict(pred, prev_sha256="0" * 64)))

    def test_range_predicate_ties_both_ends(self):
        self._two_entries()
        rc, out, _ = self.run_cmd("range", "2", "2")
        p = json.loads(out)
        self.assertEqual((p["from_seq"], p["to_seq"], p["prev_sha256"]), (2, 2, 
self.plan_ref(1)["sha256"]))
        self.assertEqual(self.run_cmd("range", "1", "3")[0], 1)

    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):
        # review 1: a hand-written entry passed every check. Now an entry no 
writer attestation covers is wrong.
        self._two_entries()
        rc, out, err = self.run_cmd("check-anchors")
        self.assertEqual(rc, 1)
        self.assertIn("never attested by the writer", err)

    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):
        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 
0. Anchor checks are stubbed here
        # (CI checks real ones); what's tested is that check-anchors notices the
proof is gone.
        self._two_entries()
        chain, _ = R.load_chain(self.d)
        os.makedirs(os.path.join(self.d, "anchors"))
        open(os.path.join(self.d, "anchors", "000002.sigstore.json"), 
"w").write("{}")
        stubs = {"check_sigstore": lambda *a: (1, R.range_predicate(chain, 1, 
2), "c0ffee"), "check_ots": lambda *a: None}
        saved = {k: getattr(R, k) for k in stubs}
        try:
            for k, f in stubs.items():
                setattr(R, k, f)
            rc, _, err = self.run_cmd("check-anchors")
            self.assertEqual(rc, 1)
            self.assertIn("000002.ots is missing", err)
            open(os.path.join(self.d, "anchors", "000002.ots"), 
"wb").write(b"stub")
            self.assertEqual(self.run_cmd("check-anchors")[0], 0)
        finally:
            for k, f in saved.items():
                setattr(R, k, f)

    def test_unknown_files_and_fields_are_refused(self):
        self._two_entries()
        open(os.path.join(self.d, "entries", "notes.txt"), "w").write("x")
        self.assertEqual(self.run_cmd("verify")[0], 1)
        os.remove(os.path.join(self.d, "entries", "notes.txt"))
        self.propose("c.json", "plan", dict(PLAN, secret="x"))
        self.assertEqual(self.run_cmd("ingest")[0], 1)


if __name__ == "__main__":
    unittest.main()

