stamp stops the run: a missing proof
        # was removed (found by Z, 2026-11-06)
        if hi not in stamped:
            bad.append(f"anchors/{hi:06d}.ots is missing, though the writer 
stamps every range head before attesting")
        elif a.max_pending_hours is not None and hi in attestation_times:
            # The OTS file exists but we haven't checked its status yet - it was
checked in the loop above
            # If it was pending, we would have already added to bad. If it was 
confirmed, no issue.
            # But we need to handle the case where the OTS file exists but 
check_ots wasn't called
            # because the file was processed before the sigstore file.
            # Actually, the first loop processes all files, so both 
.sigstore.json and .ots are checked.
            # The attestation_times is populated when .sigstore.json is 
processed.
            # If .ots was processed first, attestation_times[seq] won't exist 
yet.
            # So we need a second pass to check pending OTS proofs that were 
processed before their sigstore anchor.
            pass
    covered, changes, prev_commit = 0, [], None
    for lo, hi, commit in sorted(ranges):
        if lo != covered + 1:
            bad.append(f"the writer's ranges {'overlap' if lo <= covered else 
'leave a gap'} at entry {min(lo, covered + 1)}")
        covered = max(covered, hi)
        if prev_commit:  # did the writer's code change between these two runs? 
(information: a stranger reads the diff)
            changes.append({"entries": f"{lo}-{hi}", "from_commit": prev_commit,
"to_commit": commit,
                            "writer_code_changed": _code_changed(a, prev_commit,
commit)})
        prev_commit = commit
    if covered < len(chain):
        bad.append(f"entries {covered + 1}-{len(chain)} were never attested by 
the writer")
    # Second pass: check any pending OTS proofs for range heads that were 
processed before their sigstore anchor
    if a.max_pending_hours is not None:
        for seq in stamped:
            if seq in attestation_times:
                # We need to check if the OTS proof for this range head is 
pending
                # The OTS proof was already checked in the first loop, but if it
was processed before the sigstore
                # anchor, we didn't have the attestation time yet. So we need to
re-check.
                ots_path = os.path.join(a.ledger, "anchors", f"{seq:06d}.ots")
                if os.path.exists(ots_path):
                    raw = open(os.path.join(a.ledger, "entries", 
f"{seq:06d}.json"), "rb").read()
                    t = check_ots(ots_path, raw, a.explorer)
                    if t is None:
                        hours_pending = 
int((datetime.datetime.now(datetime.timezone.utc).timestamp() - 
attestation_times[seq]) // 3600)
                        if hours_pending > a.max_pending_hours:
                            bad.append(f"anchors/{seq:06d}.ots: still pending 
{hours_pending} h")
    print(json.dumps({"anchors": rows, "entries": len(chain), 
"writer_attested_through": covered,
                      "writer_runs": changes, "wrong": bad, "could_not_check": 
cant}, indent=1))
    for x in bad:
        print(f"BAD: {x}", file=sys.stderr)
    for x in cant:
        print(f"CAN'T CHECK: {x}", file=sys.stderr)
    return 1 if bad else 2 if cant else 0


def _git(a, *args):
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def _code_changed(a, c1, c2):
    """True/False if anything under record/ or .github/ differs between two 
commits; "unknown" without that history."""
    if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:

