              "name": "shell",
              "arguments": {
                "command": "cd /workspace && python3 -c \"\nimport tempfile, os, json, shutil, hashlib, io, contextlib, unittest.mock\nfrom record import record as R\n\n# Create a temp ledger\nd = tempfile.mkdtemp()\ntry:\n    os.makedirs(os.path.join(d, 'entries'))\n    os.makedirs(os.path.join(d, 'anchors'))\n    os.makedirs(os.path.join(d, 'inbox'))\n    \n    # Create a simple chain of 2 entries\n    PLAN = {'by': 'proposer-agent', 'claim': 'test', 'test': 't', 'decision_rule': 'r'}\n    e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': '2024-01-01T00:00:00Z', 'body': PLAN}\n    raw1 = R.canonical(e1)\n    with open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:\n        f.write(raw1)\n    h1 = hashlib.sha256(raw1).hexdigest()\n    \n    e2 = {'seq': 2, 'prev': h1, 'kind': 'plan', 'written_at': '2024-01-01T00:00:00Z', 'body': dict(PLAN, claim='test2')}\n    raw2 = R.canonical(e2)\n    with open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:\n        f.write(raw2)\n    h2 = hashlib.sha256(raw2).hexdigest()\n    \n    # Create a fake sigstore attestation file\n    fake_bundle = {\n        'verificationMaterial': {\n            'tlogEntries': [{'integratedTime': 1234567890, 'logIndex': 1}]\n        }\n    }\n    with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n        json.dump(fake_bundle, f)\n    \n    # Test 2: With sigstore attestation but no .ots file - should fail with '000002.ots is missing'\n    # We need to mock check_sigstore to return a valid range\n    with unittest.mock.patch('record.record.check_sigstore') as mock_check:\n        mock_check.return_value = (1234567890, {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': h2}, 'abc123')\n        \n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main(['--ledger', d, 'check-anchors'])\n        print(f'Test 2 (sigstore but no ots): rc={rc}, err={err.getvalue()!r}')\n    \n    # Test 3: Add the .ots file - should pass (but check_ots will fail since it's not a real OTS file)\n    # Create a dummy .ots file\n    with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:\n        f.write(b'dummy')\n    \n    with unittest.mock.patch('record.record.check_sigstore') as mock_check:\n        mock_check.return_value = (1234567890, {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': h2}, 'abc123')\n        with unittest.mock.patch('record.record.check_ots') as mock_ots:\n            mock_ots.return_value = 1234567890\n            \n            out, err = io.StringIO(), io.StringIO()\n            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n                rc = R.main(['--ledger', d, 'check-anchors'])\n            print(f'Test 3 (sigstore with ots): rc={rc}, err={err.getvalue()!r}')\n    \nfinally:\n    shutil.rmtree(d)\n\""
