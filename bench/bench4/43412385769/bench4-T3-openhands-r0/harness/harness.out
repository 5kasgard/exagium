   299  def check_sigstore(bundle, digest, repo, workflow, ref):
   300      """Verify offline that a bundle is an attestation of this digest, 
signed by exactly this workflow on this ref.
   301      Returns (integrated_time, predicate). Wrong data is Bad; a missing 
library is CantCheck."""
   302      try:
   303          from sigstore.models import Bundle
   304          from sigstore.verify import Verifier, policy
   305          from sigstore.errors import Error as SigstoreError
   306      except ImportError as ex:
   307          raise CantCheck(f"sigstore-python isn't usable ({ex}); pip 
install sigstore==4.5.1 in a virtualenv")
   308      name = os.path.basename(bundle)
   309      raw = open(bundle, "rb").read()
   310      pol = policy.AllOf([policy.Identity(identity=identity(repo, 
workflow, ref), issuer=ISSUER),
   311                          policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
   312      try:
   313          b = Bundle.from_json(raw)
   314          ptype, payload = 
Verifier.production(offline=True).verify_dsse(b, pol)
   315      except SigstoreError as ex:   # verification errors and malformed 
bundles alike: the anchor is wrong
   316          raise Bad(f"{name}: Sigstore verification failed: {ex}")
   317      except (ValueError, KeyError, TypeError) as ex:
   318          raise Bad(f"{name}: malformed bundle ({type(ex).__name__}: 
{ex})")
   319      st = parse_json(payload, f"{name} payload")
   320      if ptype != "application/vnd.in-toto+json" or not isinstance(st, 
dict) or \
   321              [s.get("digest", {}).get("sha256") for s in 
st.get("subject", [])] != [digest]:
   322          raise Bad(f"{name}: the attestation's subject isn't this entry")
   323      try:  # the same bytes the verifier just checked; their signed entry
timestamp covers integratedTime
   324          t = 
int(json.loads(raw)["verificationMaterial"]["tlogEntries"][0]["integratedTime"])
   325          from cryptography.x509 import ObjectIdentifier
   326          commit = b.signing_certificate.extensions.get_extension_for_oid(
   327              
ObjectIdentifier("1.3.6.1.4.1.57264.1.3")).value.value.decode("ascii")  # the 
commit the run was given
   328      except Exception as ex:
   329          raise Bad(f"{name}: malformed bundle or certificate 
({type(ex).__name__}: {ex})")
   330      return t, st.get("predicate"), commit
   331  
