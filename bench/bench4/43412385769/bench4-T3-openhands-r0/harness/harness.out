anchors"):
   224          if path.endswith(".sigstore.json"):
   225              try:
   226                  
known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   227              except (ValueError, KeyError, IndexError, TypeError) as ex:
   228                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   229      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
   230      if a.only_ref:
   231          refs, activity = [a.only_ref], []
   232      else:
   233          refs, activity = _refs(a.repo)
   234          for x in activity:
   235              if x.get("activity_type") in ("force_push", 
"branch_deletion") and x.get("ref") == a.ledger_ref:
   236                  bad.append(f"{x['activity_type']} on {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
   237      published = _published_entry_hashes(a, a.git_rev) if explained else 
set()
   238      seen, unknown, orphans = set(), [], []
   239      for ref in refs:
   240          uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve",
