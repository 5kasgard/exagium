   454  def _orphan_entries_problem(o, pred):
   455      """The orphan must publish the hidden entries: canonical, 
consecutive from from_seq, chained from prev_sha256,
   456      ending at head_sha256. Returns a description of the first problem, 
or None."""
   457      try:
   458          raws = [base64.b64decode(x) for x in o["body"]["entries_b64"]]
   459          if not isinstance(pred.get("from_seq"), int) or len(raws) != 
pred.get("to_seq", -1) - pred["from_seq"] + 1:
   460              return "its entries don't match the attested range"
   461          prev = pred.get("prev_sha256")
   462          for i, raw in enumerate(raws):
   463              e = parse_canonical(raw, f"hidden entry {i + 1}")
   464              if not isinstance(e, dict) or e.get("seq") != 
pred["from_seq"] + i or e.get("prev") != prev:
   465                  return "its entries don't chain from the attested 
prev_sha256"
   466              if e.get("kind") not in KINDS:
   467                  return f"hidden entry {e.get('seq')} has an unknown 
kind"
   468              check_body(e["kind"], e.get("body"), f"hidden entry 
{e['seq']}")
   469              prev = hashlib.sha256(raw).hexdigest()
   470          if prev != pred.get("head_sha256"):
   471              return "its entries don't hash to the attested head"
   472      except Bad as ex:
   473          return f"its entries are malformed ({ex})"
   474      return None
