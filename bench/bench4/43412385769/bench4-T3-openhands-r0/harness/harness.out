$ cd /workspace/record && python3 -c "
import sys
import io
import contextlib
sys.path.insert(0, '.')
import record as R
import tempfile, os, json, shutil
import datetime

d = tempfile.mkdtemp()
try:
    os.makedirs(os.path.join(d, 'inbox'))
    os.makedirs(os.path.join(d, 'entries'))
    os.makedirs(os.path.join(d, 'anchors'))
    
    # Create two entries using make_entry
    chain = []
    e1 = R.make_entry(chain, 'plan', {'by': 'proposer-agent', 'claim': 'mlp 
beats linear', 'test': 'count.py ...', 'decision_rule': 'Ir lower by > 2 SE'})
    chain.append(e1)
    raw1 = R.canonical(e1)
    with open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:
        f.write(raw1)
    e2 = R.make_entry(chain, 'plan', {'by': 'proposer-agent', 'claim': 'second',
'test': 'count.py ...', 'decision_rule': 'Ir lower by > 2 SE'})
    chain.append(e2)
    raw2 = R.canonical(e2)
    with open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:
        f.write(raw2)
    
    # Create sigstore anchor for range 1-2
    with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:
        f.write('{}')
    
    # Create OTS file
    with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:
        f.write(b'stub')
    
    # Stub the functions
    old_time = 1000000000  # Some time in the past (2001)
    def check_sigstore_stub(*a):
        return (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')
    
    def check_ots_stub(*a):
        return None  # pending
    
    saved_check_sigstore = R.check_sigstore
    saved_check_ots = R.check_ots
    
    try:
        R.check_sigstore = check_sigstore_stub
        R.check_ots = check_ots_stub
        
        # Test without --max-pending-hours (should pass with rc=0)
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors'])
        print(f'Without --max-pending-hours: rc={rc}')
        print(f'  stderr: {err.getvalue()[:300]}')
        
        # Test with --max-pending-hours 0 (should fail since attestation was 
1000000000, which is in the past)
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', 
'0'])
        print(f'With --max-pending-hours 0: rc={rc}')
        print(f'  stderr: {err.getvalue()[:300]}')
        
        # Test with large --max-pending-hours (should pass)
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', 
'999999'])
        print(f'With --max-pending-hours 999999: rc={rc}')
        print(f'  stderr: {err.getvalue()[:300]}')
        
    finally:
        R.check_sigstore = saved_check_sigstore
        R.check_ots = saved_check_ots
finally:
    shutil.rmtree(d)
"

