   185  def load_chain(ledger):
   186      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   187      chain, plans, verdict_<response clipped><NOTE>Due to the max output 
limit, only part of this file has been shown to you. You should retry this tool 
after you have searched inside the file with `grep -n` in order to find the line
numbers of what you are looking for.</NOTE>'s Link: rel="next" (works for page= 
and the cursor-paged activity API). The next link may name
   188      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   189      import urllib.parse
   190      base = url.split("?")[0]
   191      out = []
   192      while url:
   193          body, hdrs = _get(url, headers=True)
   194          if body is None:
   195              raise CantCheck(f"404 from {url}")
   196          out.extend(json.loads(body))
   197          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   198          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   199      return out
