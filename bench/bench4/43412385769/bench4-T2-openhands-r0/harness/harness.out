import base64
import record as R

# Test that orphan with extra fields is rejected
orphan_bad = {'body': {
    'by': 'owner',
    'log_index': 123,
    'reason': 'test',
    'statement_b64': base64.b64encode(b'{}').decode(),
    'entries_b64': [],
    'extra_field': 'not allowed'
}}
try:
    R.check_body('orphan', orphan_bad['body'], 'test')
    print('ERROR: Should have raised Bad')
except R.Bad as e:
    print('Correctly rejected extra field:', e)

# Test that entries_b64 with invalid base64 is rejected
orphan_bad_b64 = {'body': {
    'by': 'owner',
    'log_index': 123,
    'reason': 'test',
    'statement_b64': base64.b64encode(b'{}').decode(),
    'entries_b64': ['not-base64!']
}}
try:
    R.check_body('orphan', orphan_bad_b64['body'], 'test')
    print('ERROR: Should have raised Bad')
except R.Bad as e:
    print('Correctly rejected invalid base64:', e)

# Test that entries_b64 with non-string is rejected
