$ cd /workspace/record && python3 -c "
import base64
import record as R

# Create a test orphan with entries_b64
# First, let's create a chain to get valid entries
chain = []
# Entry 1
e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'a', 'claim': 'c', 'test': 't', 
'decision_rule': 'd'}}
raw1 = R.canonical(e1)
h1 = __import__('hashlib').sha256(raw1).hexdigest()
chain.append((e1, h1))

# Entry 2
e2 = {'seq': 2, 'prev': h1, 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'b', 'plan': {'seq': 1, 'sha256': h1}, 
'outcome': 'pass', 'evidence': []}}
raw2 = R.canonical(e2)
h2 = __import__('hashlib').sha256(raw2).hexdigest()
chain.append((e2, h2))

# Create predicate
pred = R.range_predicate(chain, 1, 2)
print('pred:', pred)

# Create orphan with correct entries_b64
orphan_body = {
    'by': 'owner',
    'log_index': 123,
    'reason': 'test',
    'statement_b64': base64.b64encode(b'{}').decode(),
    'entries_b64': [base64.b64encode(raw1).decode(), 
base64.b64encode(raw2).decode()]
}
orphan = {'body': orphan_body}

# Test _orphan_entries_problem with correct entries
result = R._orphan_entries_problem(orphan, pred)
print('Correct entries result:', result)

# Test with wrong count
orphan_wrong_count = {'body': {**orphan_body, 'entries_b64': 
[base64.b64encode(raw1).decode()]}}
result = R._orphan_entries_problem(orphan_wrong_count, pred)
print('Wrong count result:', result)

# Test with wrong chain
orphan_wrong_chain = {'body': {**orphan_body, 'entries_b64': 
[base64.b64encode(raw1).decode(), base64.b64encode(b'{}').decode()]}}
result = R._orphan_entries_problem(orphan_wrong_chain, pred)
print('Wrong chain result:', result)

# Test with wrong head
wrong_pred = {**pred, 'head_sha256': '0'*64}
result = R._orphan_entries_problem(orphan, wrong_pred)
print('Wrong head result:', result)

print('All manual tests passed!')
"

