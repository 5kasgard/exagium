   174  def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
   175      """Validate that an orphan's entries_b64 matches the attested range 
in pred.
   176      Returns None if valid, otherwise a short problem string containing 
'range', 'chain', or 'head'."""
   177      if "entries_b64" not in orphan["body"] or not 
isinstance(orphan["body"]["entries_b64"], list):
   178          return "range: missing entries_b64"
   179      entries_b64 = orphan["body"]["entries_b64"]
   180      from_seq = pred.get("from_seq")
   181      to_seq = pred.get("to_seq")
   182      prev_sha256 = pred.get("prev_sha256")
   183      head_sha256 = pred.get("head_sha256")
   184      if not isinstance(from_seq, int) or not isinstance(to_seq, int) or 
from_seq > to_seq:
   185          return "range: invalid from_seq/to_seq in predicate"
   186      expected_count = to_seq - from_seq + 1
   187      if len(entries_b64) != expected_count:
   188          return f"range: {len(entries_b64)} entries but predicate says 
{expected_count}"
   189      # Decode and check chain links
   190      prev_hash = prev_sha256
   191      for i, b64 in enumerate(entries_b64):
   192          try:
   193              entry_bytes = base64.b64decode(b64, validate=True)
   194          except ValueError:
   195              return f"range: entries_b64[{i}] is not valid base64"
   196          # Verify canonical form
   197          try:
   198              entry = parse_json(entry_bytes, f"entries_b64[{i}]")
