import base64
import json
import record as R
import hashlib
import tempfile
import os
import shutil

# Create a temp ledger
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))

try:
    # Create a chain with 2 entries
    e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 
          'body': {'by': 'a', 'claim': 'c', 'test': 't', 'decision_rule': 'd'}}
    raw1 = R.canonical(e1)
    h1 = hashlib.sha256(raw1).hexdigest()
    with open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:
        f.write(raw1)
    
    e2 = {'seq': 2, 'prev': h1, 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 
          'body': {'by': 'b', 'plan': {'seq': 1, 'sha256': h1}, 'outcome': 
'pass', 'evidence': []}}
    raw2 = R.canonical(e2)
    h2 = hashlib.sha256(raw2).hexdigest()
    with open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:
        f.write(raw2)
    
    # Create predicate for entries 1-2
    chain = [(e1, h1), (e2, h2)]
    pred = R.range_predicate(chain, 1, 2)
    print('Predicate:', pred)
    
    # Create orphan with correct entries_b64
    orphan_body = {
        'by': 'owner',
        'log_index': 123,
        'reason': 'test',
        'statement_b64': base64.b64encode(b'{}').decode(),
        'entries_b64': [base64.b64encode(raw1).decode(), 
base64.b64encode(raw2).decode()]
    }
    
    # Test _orphan_entries_problem with correct entries
    orphan = {'body': orphan_body}
    result = R._orphan_entries_problem(orphan, pred)
    print('Correct entries result:', result)
    assert result is None, 'Expected None for valid entries'
    
    # Verify the orphan body passes check_body
    R.check_body('orphan', orphan_body, 'test')
    print('Orphan body passes check_body')
    
    print('All integration tests passed!')
finally:
    shutil.rmtree(d)
"

