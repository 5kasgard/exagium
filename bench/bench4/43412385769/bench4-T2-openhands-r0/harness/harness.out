    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Validate that an orphan's entries_b64 matches the attested range in 
pred.
        Returns None if valid, otherwise a short problem string containing 
'range', 'chain', or 'head'."""
        if "entries_b64" not in orphan["body"] or not 
isinstance(orphan["body"]["entries_b64"], list):
            return "range: missing entries_b64"
        entries_b64 = orphan["body"]["entries_b64"]
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
        if not isinstance(from_seq, int) or not isinstance(to_seq, int) or 
from_seq > to_seq:
            return "range: invalid from_seq/to_seq in predicate"
        expected_count = to_seq - from_seq + 1
        if len(entries_b64) != expected_count:
            return f"range: {len(entries_b64)} entries but predicate says 
{expected_count}"
        # Decode and check chain links
        prev_hash = prev_sha256
        for i, b64 in enumerate(entries_b64):
            try:
                entry_bytes = base64.b64decode(b64, validate=True)
            except ValueError:
                return f"range: entries_b64[{i}] is not valid base64"
            # Verify canonical form
            try:
                entry = parse_json(entry_bytes, f"entries_b64[{i}]")
            except Bad:
                return f"range: entries_b64[{i}] is not valid JSON"
            if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
                return f"range: entries_b64[{i}] is not a valid entry"
            # Check seq
            if entry["seq"] != from_seq + i:
                return f"range: entries_b64[{i}] has seq {entry['seq']} but 
expected {from_seq + i}"
            # Check prev chain
            if entry["prev"] != prev_hash:
                return f"chain: entries_b64[{i}] prev {entry['prev']!r} doesn't 
match previous hash {prev_hash!r}"
            prev_hash = hashlib.sha256(entry_bytes).hexdigest()
        # Check final head hash
        if prev_hash != head_sha256:
            return f"head: last entry hash {prev_hash} != predicate head_sha256 
{head_sha256}"
        return None
    
    
    # ---------- the chain ----------

  kind: "FileEditorAction"

