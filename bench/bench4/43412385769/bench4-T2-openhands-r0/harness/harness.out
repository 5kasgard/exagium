    'by': 'owner',
    'log_index': 123,
    'reason': 'test',
    'statement_b64': base64.b64encode(b'{}').decode(),
    'entries_b64': [123]
}}
try:
    R.check_body('orphan', orphan_bad_type['body'], 'test')
    print('ERROR: Should have raised Bad')
except R.Bad as e:
    print('Correctly rejected non-string:', e)

print('Schema validation tests passed!')
"

