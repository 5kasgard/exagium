   200              return f"range: entries_b64[{i}] is not valid JSON"
   201          if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
   202              return f"range: entries_b64[{i}] is not a valid entry"
   203          # Check seq
   204          if entry["seq"] != from_seq + i:
   205              return f"range: entries_b64[{i}] has seq {entry['seq']} but 
expected {from_seq + i}"
   206          # Check prev chain
   207          if entry["prev"] != prev_hash:
   208              return f"chain: entries_b64[{i}] prev {entry['prev']!r} 
doesn't match previous hash {prev_hash!r}"
   209          prev_hash = hashlib.sha256(entry_bytes).hexdigest()
   210      # Check final head hash
   211      if prev_hash != head_sha256:
   212          return f"head: last entry hash {prev_hash} != predicate 
head_sha256 {head_sha256}"
   213      return None
