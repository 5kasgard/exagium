def check_sigstore(bundle, digest, repo, workflow, ref):
    """Verify offline that a bundle is an attestation of this digest, signed by 
exactly this workflow on this ref.
    Returns (integrated_time, predicate). Wrong data is Bad; a missing library 
is CantCheck."""
    try:
        from sigstore.models import Bundle
        from sigstore.verify import Verifier, policy
        from sigstore.errors import Error as SigstoreError
    except ImportError as ex:
        raise CantCheck(f"sigstore-python isn't usable ({ex}); pip install 
sigstore==4.5.1 in a virtualenv")
    name = os.path.basename(bundle)
    raw = open(bundle, "rb").read()
    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), 
issuer=ISSUER),
                        policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
    try:
        b = Bundle.from_json(raw)
        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)
    except SigstoreError as ex:   # verification errors and malformed bundles 
alike: the anchor is wrong
        raise Bad(f"{name}: Sigstore verification failed: {ex}")
    except (ValueError, KeyError, TypeError) as ex:
        raise Bad(f"{name}: malformed bundle ({type(ex).__name__}: {ex})")
    st = parse_json(payload, f"{name} payload")
    if ptype != "application/vnd.in-toto+json" or not isinstance(st, dict) or \
            [s.get("digest", {}).get("sha256") for s in st.get("subject", [])] 
!= [digest]:
        raise Bad(f"{name}: the attestation's subject isn't this entry")
    try:  # the same bytes the verifier just checked; their signed entry 
timestamp covers integratedTime
        t = 
int(json.loads(raw)["verificationMaterial"]["tlogEntries"][0]["integratedTime"])
        from cryptography.x509 import ObjectIdentifier
        commit = b.signing_certificate.extensions.get_extension_for_oid(
            ObjectIdentifier("1.3.6.1.4.1.57264.1.3")).value.value.decode("ascii
")  # the commit the run was given
    except Exception as ex:
        raise Bad(f"{name}: malformed bundle or certificate 
({type(ex).__name__}: {ex})")
    return t, st.get("predicate"), commit


def check_ots(proof, entry_raw, explorers):
    """Returns the earliest Bitcoin block time the proof reaches, or None if 
it's still pending."""
    try:
        from opentimestamps.core.timestamp import DetachedTimestampFile
        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation
        from opentimestamps.core.serialize import StreamDeserializationContext, 
DeserializationError
    except ImportError:
        raise CantCheck("opentimestamps isn't installed (pip install 
opentimestamps-client==0.8.0)")
    name = os.path.basename(proof)
    try:
        with open(proof, "rb") as f:
            dt = 
DetachedTimestampFile.deserialize(StreamDeserializationContext(f))
        atts = list(dt.timestamp.all_attestations())
    except (DeserializationError, ValueError, TypeError, EOFError) as ex:
        raise Bad(f"{name}: malformed proof ({ex})")
    if dt.file_digest != hashlib.sha256(entry_raw).digest():
        raise Bad(f"{name}: proof is for different bytes")
    times = []
    for msg, att in atts:
        if not isinstance(att, BitcoinBlockHeaderAttestation):
            continue
        headers = set()
        for base in explorers:
            bh = _get(f"{base}/block-height/{att.height}")
            if bh is None:  # 404: either the block doesn't exist (a forged 
height) or the explorer is behind
                tip = _get(f"{base}/blocks/tip/height")
                if tip is not None and att.height > int(tip):
                    raise Bad(f"{name}: claims block {att.height}, beyond the 
chain tip {int(tip)}")
                raise CantCheck(f"{base}: no block at height {att.height}")
            bh = bh.decode().strip()
            hdr = _get(f"{base}/block/{bh}/header")
            if hdr is None:
                raise CantCheck(f"{base}: no header for block {bh}")
            hdr = bytes.fromhex(hdr.decode().strip())
            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex()
!= bh:
                raise CantCheck(f"{base}: header doesn't hash to block {bh} 
(explorer fault)")
            headers.add(hdr)
        if len(headers) != 1:
            raise CantCheck(f"explorers disagree about block {att.height}")
        hdr = headers.pop()
        if hdr[36:68] != msg:
            raise Bad(f"{name}: path doesn't reach block {att.height}'s merkle 
root")
        times.append(int.from_bytes(hdr[68:72], "little"))
    return min(times) if times else None


def iso(t):
    return datetime.datetime.fromtimestamp(t, 
datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else None



