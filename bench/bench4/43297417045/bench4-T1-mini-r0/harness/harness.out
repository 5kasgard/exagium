def cmd_check_anchors(a):
    """Every anchor must be right, and the writer's Sigstore ranges must cover 
entries 1..head with no gap or overlap.
    Checks every anchor even after a failure; exit 1 if anything was wrong, else
2 if anything couldn't be checked."""
    chain, _ = load_chain(a.ledger)
    rows, bad, cant, ranges = [], [], [], []
    for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in anchors"):
        n = os.path.basename(path)
        m = ANCHOR_NAME.fullmatch(n)
        seq = int(m.group(1))
        try:
            if not 1 <= seq <= len(chain):
                raise Bad(f"anchors/{n}: no entry {seq}")
            raw = open(os.path.join(a.ledger, "entries", f"{seq:06d}.json"), 
"rb").read()
            if m.group(2) == "ots":
                t = check_ots(path, raw, a.explorer)
                rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
            else:
                t, pred, commit = check_sigstore(path, chain[seq - 1][1], 
a.repo, a.workflow, a.ref)
                if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
                        or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
                    raise Bad(f"anchors/{n}: attested range {pred!r} doesn't 
match this chain")
                ranges.append((pred["from_seq"], seq, commit))
                rows.append({"anchor": n, "kind": "sigstore", "entries": 
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
                             "writer_commit": commit})
        except Bad as ex:
            bad.append(str(ex))
        except CantCheck as ex:
            cant.append(f"anchors/{n}: {ex}")
    covered, changes, prev_commit = 0, [], None
    for lo, hi, commit in sorted(ranges):
        if lo != covered + 1:
            bad.append(f"the writer's ranges {'overlap' if lo <= covered else 
'leave a gap'} at entry {min(lo, covered + 1)}")
        covered = max(covered, hi)
        if prev_commit:  # did the writer's code change between these two runs? 
(information: a stranger reads the diff)
            changes.append({"entries": f"{lo}-{hi}", "from_commit": prev_commit,
"to_commit": commit,
                            "writer_code_changed": _code_changed(a, prev_commit,
commit)})
        prev_commit = commit
    if covered < len(chain):
        bad.append(f"entries {covered + 1}-{len(chain)} were never attested by 
the writer")
    print(json.dumps({"anchors": rows, "entries": len(chain), 
"writer_attested_through": covered,
                      "writer_runs": changes, "wrong": bad, "could_not_check": 
cant}, indent=1))
    for x in bad:
        print(f"BAD: {x}", file=sys.stderr)
    for x in cant:
        print(f"CAN'T CHECK: {x}", file=sys.stderr)
    return 1 if bad else 2 if cant else 0


def _git(a, *args):
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def _code_changed(a, c1, c2):
    """True/False if anything under record/ or .github/ differs between two 
commits; "unknown" without that history."""
    if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
        return "unknown (commit not in this clone)"

