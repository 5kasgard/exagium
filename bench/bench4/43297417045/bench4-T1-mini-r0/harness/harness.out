import tempfile, os, json, hashlib, shutil
import record as R
import io, contextlib
from unittest.mock import patch

# Create a temp ledger with 4 entries
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))

PLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py 
...', 'decision_rule': 'Ir lower by > 2 SE'}

# Create 4 entries
for i in range(4):
    with open(os.path.join(d, 'inbox', f'{i}.json'), 'w') as f:
        json.dump({'kind': 'plan', 'body': dict(PLAN, claim=f'entry {i+1}')}, f)
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(['--ledger', d, 'ingest'])

chain, _ = R.load_chain(d)
print('Chain length:', len(chain))

# Create sigstore attestations for two ranges: 1-2 and 3-4
for seq in [2, 4]:
    sigstore_path = os.path.join(d, 'anchors', f'{seq:06d}.sigstore.json')
    with open(sigstore_path, 'w') as f:
        f.write('{}')
    ots_path = os.path.join(d, 'anchors', f'{seq:06d}.ots')
    with open(ots_path, 'wb') as f:
        f.write(b'dummy ots content')

print('Anchors:', sorted(os.listdir(os.path.join(d, 'anchors'))))

# Mock check_sigstore to return attestations for ranges 1-2 and 3-4
def mock_check_sigstore(bundle, digest, repo, workflow, ref):
    n = os.path.basename(bundle)
    seq = int(n[:6])
    if seq == 2:
        predicate = R.range_predicate(chain, 1, 2)
    elif seq == 4:
        predicate = R.range_predicate(chain, 3, 4)
    else:
        raise ValueError(f'Unexpected seq {seq}')
    return (1234567890, predicate, 'abcdef123456')

def mock_check_ots(proof, entry_raw, explorers):
    return 1234567890

# Test 1: All .ots files exist - should pass
with patch('record.check_sigstore', mock_check_sigstore):
    with patch('record.check_ots', mock_check_ots):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors'])
        print('Test 1 (all ots exist): rc =', rc)
        print('stderr:', err.getvalue())

# Test 2: Delete 000002.ots - should complain about 000002.ots missing
os.remove(os.path.join(d, 'anchors', '000002.ots'))
print('Anchors after deleting 000002.ots:', sorted(os.listdir(os.path.join(d, 
'anchors'))))

with patch('record.check_sigstore', mock_check_sigstore):
    with patch('record.check_ots', mock_check_ots):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors'])
        print('Test 2 (000002.ots missing): rc =', rc)
        print('stderr:', err.getvalue())

# Test 3: Delete 000004.ots as well - should complain about both
os.remove(os.path.join(d, 'anchors', '000004.ots'))
print('Anchors after deleting 000004.ots:', sorted(os.listdir(os.path.join(d, 
'anchors'))))

with patch('record.check_sigstore', mock_check_sigstore):
    with patch('record.check_ots', mock_check_ots):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            rc = R.main(['--ledger', d, 'check-anchors'])
        print('Test 3 (both missing): rc =', rc)
        print('stderr:', err.getvalue())

shutil.rmtree(d)
