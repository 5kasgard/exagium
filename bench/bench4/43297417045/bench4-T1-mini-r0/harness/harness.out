```
cat <<'EOF' > /tmp/fix.py
import re

# Read the file
with open('/workspace/record/record.py', 'r') as f:
    content = f.read()

# Find the cmd_check_anchors function and add the check for missing .ots files
# We need to add the check after the ranges are collected but before the 
gap/overlap check

old_code = '''    covered, changes, prev_commit = 0, [], None
    for lo, hi, commit in sorted(ranges):'''

new_code = '''    # Check that each attested range head has its .ots proof
    for lo, hi, commit in ranges:
        ots_path = os.path.join(a.ledger, "anchors", f"{hi:06d}.ots")
        if not os.path.exists(ots_path):
            bad.append(f"{hi:06d}.ots is missing")

    covered, changes, prev_commit = 0, [], None
    for lo, hi, commit in sorted(ranges):'''

if old_code in content:
    content = content.replace(old_code, new_code)
    with open('/workspace/record/record.py', 'w') as f:
        f.write(content)
    print("Fix applied successfully")
else:
    print("Could not find the target code block")
    # Let's search for the pattern
    for i, line in enumerate(content.split('\n')):
        if 'covered, changes, prev_commit' in line:
            print(f"Line {i}: {line}")

EOF
