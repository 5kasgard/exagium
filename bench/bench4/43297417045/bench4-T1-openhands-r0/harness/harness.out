#!/usr/bin/env python3
"""Test script to verify the check-anchors fix for missing .ots files."""
import os
import json
import tempfile
import shutil
import hashlib
import sys
import datetime
sys.path.insert(0, '/workspace/record')
import record as R
def create_test_ledger():
    """Create a test ledger with entries and sigstore.json but missing .ots"""
    d = tempfile.mkdtemp()

    os.makedirs(os.path.join(d, "inbox"))
    os.makedirs(os.path.join(d, "entries"))
    os.makedirs(os.path.join(d, "anchors"))

    # Create two entries using make_entry
    PLAN = {"by": "proposer-agent", "claim": "mlp beats linear", "test": 
"count.py ...", "decision_rule": "Ir lower by > 2 SE"}

    # Entry 1
    chain = []
    e1 = R.make_entry(chain, "plan", PLAN, "2024-01-01T00:00:00Z")
    raw1 = R.canonical(e1)
    open(os.path.join(d, "entries", "000001.json"), "wb").write(raw1)
    chain.append((e1, hashlib.sha256(raw1).hexdigest()))

    # Entry 2
    e2 = R.make_entry(chain, "plan", dict(PLAN, claim="second"), 
"2024-01-01T00:00:01Z")
    raw2 = R.canonical(e2)
    open(os.path.join(d, "entries", "000002.json"), "wb").write(raw2)
    chain.append((e2, hashlib.sha256(raw2).hexdigest()))

    return d
# Test the fix logic directly
d = create_test_ledger()
print(f"Test ledger created at: {d}")
try:
    # Load the chain
    chain, _ = R.load_chain(d)
    print(f"Chain has {len(chain)} entries")

    # Simulate what cmd_check_anchors does
    ranges = [(1, 2, "abc123")]  # from_seq, to_seq (range head), commit

    # Check for missing .ots files
    bad = []
    for lo, hi, commit in ranges:
        ots_path = os.path.join(d, "anchors", f"{hi:06d}.ots")
        if not os.path.exists(ots_path):
            bad.append(f"{hi:06d}.ots is missing")

    print(f"Bad messages: {bad}")
    if "000002.ots is missing" in bad:
        print("SUCCESS: Missing .ots file correctly detected!")
    else:
        print("FAILURE: Missing .ots file NOT detected!")
        sys.exit(1)

    # Now add the .ots file and check again
    open(os.path.join(d, "anchors", "000002.ots"), "w").write("fake ots 
content")

    bad = []
    for lo, hi, commit in ranges:
        ots_path = os.path.join(d, "anchors", f"{hi:06d}.ots")
        if not os.path.exists(ots_path):
            bad.append(f"{hi:06d}.ots is missing")

    print(f"Bad messages after adding .ots: {bad}")
    if not bad:
        print("SUCCESS: No missing .ots file when it exists!")
    else:
        print("FAILURE: Still reports missing .ots when it exists!")
        sys.exit(1)

finally:
    shutil.rmtree(d)
print("All tests passed!")
