   300      for name in ("check-anchors", "monitor"):
   301          p = sub.add_parser(name)
   302          p.add_argument("--repo", default="5kasgard/exagium")
   303          p.add_argument("--workflow", 
default=".github/workflows/record.yml")
   304          if name == "check-anchors":
   305              p.add_argument("--ref", default="refs/heads/main")
   306              p.add_argument("--explorer", action="append", default=None,
   307                             help="esplora API base; default 
blockstream.info and mempool.space")
   308          else:
