   215  def cmd_monitor(a):
   216      """List every Rekor entry signed by the writer workflow on any ref 
GitHub names. Each must be an anchor in the
   217      ledger, or be explained by an orphan entry whose statement matches 
Rekor's payload hash and whose entries were
   218      never published on the ledger branch (so an orphan can't launder a 
deleted verdict). Any force push to the
   219      ledger branch is wrong. Entries are matched by Rekor log index, 
unique per attestation."""
   220      chain, _ = load_chain(a.ledger)
   221      current = {h for _, h in chain}
   222      known, bad = {}, []
   223      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   224          if path.endswith(".sigstore.json"):
   225              try:
   226                  
known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   227              except (ValueError, KeyError, IndexError, TypeError) as ex:
   228                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   229      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
   230      if a.only_ref:
   231          refs, activity = [a.only_ref], []
   232      else:
   233          refs, activity = _refs(a.repo)
   234          for x in activity:
   235              if x.get("activity_type") in ("force_push", 
"branch_deletion") and x.get("ref") == a.ledger_ref:
   236                  bad.append(f"{x['activity_type']} on {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
   237      published = _published_entry_hashes(a, a.git_rev) if explained else 
set()
   238      seen, unknown, orphans = set(), [], []
   239      for ref in refs:
   240          uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve",
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
   241          if uuids is None:
   242              raise CantCheck("Rekor's index returned 404")
   243          for u in json.loads(uuids):
   244              got = 
_get(f"https://rekor.sigstore.dev/api/v1/log/entries/{u}")
   245              if got is None:
   246                  raise CantCheck(f"Rekor lists {u} but won't return it")
   247              v = next(iter(json.loads(got).values()))
   248              idx = int(v["logIndex"])
   249              seen.add(idx)
   250              row = {"ref": ref, "log_index": idx, "integrated": 
iso(v["integratedTime"]), "rekor_uuid": u}
   251              if idx in known:
   252                  continue
   253              if idx not in explained:
   254                  unknown.append(row)
   255                  continue
   256              o = explained[idx]
   257              body = json.loads(base64.b64decode(v["body"]))
   258              stmt = base64.b64decode(o["body"]["statement_b64"])
   259              if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
   260                  bad.append(f"orphan entry {o['seq']}: its statement 
isn't the one Rekor holds for log index {idx}")
   261                  continue
   262              pred = (parse_json(stmt, f"orphan entry {o['seq']} 
statement") or {}).get("predicate") or {}
   263              head = pred.get("head_sha256")
   264              problem = _orphan_entries_problem(o, pred)
   265              if problem:
   266                  bad.append(f"orphan entry {o['seq']}: {problem}")
   267                  continue
   268              if head in published and head not in current:
   269                  bad.append(f"orphan entry {o['seq']}: the attested head 
{head} was published on {a.git_rev} and later removed")
   270                  continue
   271              orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
   272      missing = sorted(n for idx, n in known.items() if idx not in seen) 
if not a.only_ref else []
   273      print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
   274                        "explained_orphans": orphans, "unexplained": 
unknown, "wrong": bad,
   275                        "ledger_anchors_not_found_in_rekor": missing if 
not a.only_ref else "not checked with --only-ref"}, indent=1))
   276      for x in bad:
