   141      def test_canonical_form_matches_jcs_rules(self):
   142          # Sorted keys, no spaces, UTF-8 unescaped, control chars 
escaped: the JCS output for these values.
   143          obj = {"b": "é\n\u0001", "a": [1, True, None], "A": 
-9007199254740991}
   144          self.assertEqual(R.canonical(obj), 
b'{"A":-9007199254740991,"a":[1,true,null],"b":"\xc3\xa9\\n\\u0001"}')
   145          with self.assertRaises(R.Bad):
   146              R._check_value({"x": 2**53}, "t")
   147          with self.assertRaises(R.Bad):
   148              R._check_value({"é": 1}, "t")
   149  
   150      def test_canonical_form_is_rfc8785(self):
   151          try:
   152              import rfc8785
   153          except ImportError:
   154              self.skipTest("rfc8785 not installed")
   155          import random
   156          rnd = random.Random(7)
   157          chars = 'aZ0 "\\\n\t\b\f\r\x01\x1f\x7fé€\U0001f600 /'
   158          def s():
   159              return "".join(rnd.choice(chars) for _ in 
range(rnd.randint(0, 6)))
   160          def v(d=0):
   161              t = rnd.randint(0, 5 if d < 3 else 2)
   162              return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, 
lambda: rnd.choice([True, False, None]),
   163                      lambda: [v(d + 1) for _ in range(rnd.randint(0, 
3))],
   164                      lambda: {"k" + s().encode("ascii", 
"ignore").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()
   165          for _ in range(3000):
   166              o = {"x": v(), "y": v()}
   167              self.assertEqual(R.canonical(o), rfc8785.dumps(o))
   168  
