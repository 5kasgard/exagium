$ cd /workspace/record && python3 -c "
import tempfile, os, json, shutil
import record as R

# Create a test ledger with entries and sigstore anchors but no .ots for one
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))
os.makedirs(os.path.join(d, 'inbox'))

# Write some entries manually
PLAN = {'by': 'proposer-agent', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}
e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'body': PLAN}
e2 = {'seq': 2, 'prev': R.canonical(e1).hex(), 'kind': 'plan', 'body': PLAN}

# Fix: prev should be sha256 of previous entry raw bytes
e1_raw = R.canonical(e1)
e1_sha = hashlib.sha256(e1_raw).hexdigest()
e2 = {'seq': 2, 'prev': e1_sha, 'kind': 'plan', 'body': PLAN}
e2_raw = R.canonical(e2)
e2_sha = hashlib.sha256(e2_raw).hexdigest()

open(os.path.join(d, 'entries', '000001.json'), 'wb').write(e1_raw)
open(os.path.join(d, 'entries', '000002.json'), 'wb').write(e2_raw)

# Create a minimal sigstore.json that would pass verification (using a mock)
# For testing, let's create the anchors that would be produced by the writer
# We can't easily mock sigstore, but we can test the missing .ots check logic

import hashlib
print('e1_sha:', e1_sha)
print('e2_sha:', e2_sha)

# Cleanup
shutil.rmtree(d)
"

