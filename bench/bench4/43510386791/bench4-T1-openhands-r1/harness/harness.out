   333  def check_ots(proof, entry_raw, explorers):
   334      """Returns the earliest Bitcoin block time the proof reaches, or 
None if it's still pending."""
   335      try:
   336          from opentimestamps.core.timestamp import DetachedTimestampFile
   337          from opentimestamps.core.notary import 
BitcoinBlockHeaderAttestation
   338          from opentimestamps.core.serialize import 
StreamDeserializationContext, DeserializationError
   339      except ImportError:
   340          raise CantCheck("opentimestamps isn't installed (pip install 
opentimestamps-client==0.8.0)")
   341      name = os.path.basename(proof)
   342      try:
   343          with open(proof, "rb") as f:
   344              dt = 
DetachedTimestampFile.deserialize(StreamDeserializationContext(f))
   345          atts = list(dt.timestamp.all_attestations())
   346      except (DeserializationError, ValueError, TypeError, EOFError) as 
ex:
   347          raise Bad(f"{name}: malformed proof ({ex})")
   348      if dt.file_digest != hashlib.sha256(entry_raw).digest():
   349          raise Bad(f"{name}: proof is for different bytes")
   350      times = []
   351      for msg, att in atts:
   352          if not isinstance(att, BitcoinBlockHeaderAttestation):
   353              continue
   354          headers = set()
   355          for base in explorers:
   356              bh = _get(f"{base}/block-height/{att.height}")
   357              if bh is None:  # 404: either the block doesn't exist (a 
forged height) or the explorer is behind
   358                  tip = _get(f"{base}/blocks/tip/height")
   359                  if tip is not None and att.height > int(tip):
   360                      raise Bad(f"{name}: claims block {att.height}, 
beyond the chain tip {int(tip)}")
   361                  raise CantCheck(f"{base}: no block at height 
{att.height}")
   362              bh = bh.decode().strip()
   363              hdr = _get(f"{base}/block/{bh}/header")
   364              if hdr is None:
   365                  raise CantCheck(f"{base}: no header for block {bh}")
   366              hdr = bytes.fromhex(hdr.decode().strip())
   367              if 
hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:
   368                  raise CantCheck(f"{base}: header doesn't hash to block 
{bh} (explorer fault)")
   369              headers.add(hdr)
   370          if len(headers) != 1:
   371              raise CantCheck(f"explorers disagree about block 
{att.height}")
   372          hdr = headers.pop()
   373          if hdr[36:68] != msg:
   374              raise Bad(f"{name}: path doesn't reach block {att.height}'s 
merkle root")
   375          times.append(int.from_bytes(hdr[68:72], "little"))
   376      return min(times) if times else None
   377  
   378  
   379  def iso(t):
   380      return datetime.datetime.fromtimestamp(t, 
datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else None


