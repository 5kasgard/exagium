   384      """Every anchor must be right, and the writer's Sigstore ranges must
cover entries 1..head with no gap or overlap.
   385      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
   386      chain, _ = load_chain(a.ledger)
   387      rows, bad, cant, ranges = [], [], [], []
   388      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   389          n = os.path.basename(path)
   390          m = ANCHOR_NAME.fullmatch(n)
