   170  def _listdir(ledger, sub, pattern, what):
   171      d = os.path.join(ledger, sub)
   172      if not os.path.exists(d):
   173          return []
   174      if os.path.islink(d) or not os.path.isdir(d):
   175          raise Bad(f"{sub}/ must be a plain directory")
   176      out = []
   177      for n in sorted(os.listdir(d)):
   178          p = os.path.join(d, n)
   179          if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
   180              raise Bad(f"{sub}/{n!r}: unexpected {what}")
   181          out.append(p)
   182      return out
