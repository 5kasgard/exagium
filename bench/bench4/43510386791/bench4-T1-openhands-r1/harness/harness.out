!= b"false":
   472          raise CantCheck("this clone is shallow or not a git repository; 
orphan checks need the ledger branch's full history")
   473      raw = _git(a, "log", rev, "--format=", "--raw", "--no-abbrev", "--",
"ledger/entries")
   474      if raw is None:
   475          raise CantCheck(f"no git history for {rev} next to the ledger 
(run monitor in a full clone)")
   476      blobs = {ln.split()[3] for ln in raw.decode().splitlines() if 
ln.startswith(":") and ln.split()[3].strip("0")}
   477      out = set()
   478      for b in blobs:
   479          data = _git(a, "cat-file", "blob", b)
   480          if data is not None:
   481              out.add(hashlib.sha256(data).hexdigest())
   482      return out
