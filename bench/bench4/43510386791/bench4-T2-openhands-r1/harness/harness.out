   251      today = datetime.date.today().isoformat()
   252      plans = [e for e, _ in chain if e["kind"] == "plan"]
   253      open_ = [e["seq"] for e in plans if e["seq"] not in verdict_of]
   254      overdue = [e["seq"] for e in plans if e["seq"] not in verdict_of and
e["body"].get("verdict_due", "9999-12-31") < today]
   255      print(json.dumps({"entries": len(chain), "head_seq": len(chain), 
"head_sha256": chain[-1][1] if chain else None,
   256                        "plans": len(plans), "verdicts": len(verdict_of),
   257                        "orphans_explained": sum(e["kind"] == "orphan" for
e, _ in chain),
   258                        "open_plans": open_, "overdue_plans": overdue}, 
indent=1))
