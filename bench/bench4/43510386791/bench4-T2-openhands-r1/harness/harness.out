    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Check that an orphan's entries_b64 matches the attested range in 
pred.
    
        Returns None if the decoded entries are exactly the attested range:
        - count is to_seq - from_seq + 1
        - first entry's prev matches pred["prev_sha256"]
        - each next entry's prev matches the previous entry's sha256
        - last entry's sha256 matches pred["head_sha256"]
    
        Otherwise returns a short problem string containing:
        - "range" when the count is wrong
        - "chain" when an entry's prev doesn't link
        - "head" when the last hash doesn't match head_sha256
        """
        entries_b64 = orphan.get("body", {}).get("entries_b64", [])
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
    
        if from_seq is None or to_seq is None or prev_sha256 is None or 
head_sha256 is None:
            return "predicate missing required fields"
    
        expected_count = to_seq - from_seq + 1
        if len(entries_b64) != expected_count:
            return f"range count mismatch: expected {expected_count}, got 
{len(entries_b64)}"
    
        prev = prev_sha256
        for i, entry_b64 in enumerate(entries_b64):
            entry_raw = base64.b64decode(entry_b64)
            entry = parse_canonical(entry_raw, f"orphan entry {i}")
            if entry.get("prev") != prev:
                return f"chain break at entry {i}: prev {entry.get('prev')!r} !=
{prev!r}"
            prev = hashlib.sha256(entry_raw).hexdigest()
    
        if prev != head_sha256:
            return f"head mismatch: computed {prev!r} != {head_sha256!r}"
    
        return None
    
    
    # ---------- the chain ----------

  kind: "FileEditorAction"

