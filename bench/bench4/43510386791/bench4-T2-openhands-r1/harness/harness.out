   175  def _listdir(ledger, sub, pattern, what):
   176      d = os.path.join(ledger, sub)
   177      if not os.path.exists(d):
   178          return []
   179      if os.path.islink(d) or not os.path.isdir(d):
   180          raise Bad(f"{sub}/ must be a plain directory")
   181      out = []
   182      for n in sorted(os.listdir(d)):
   183          p = os.path.join(d, n)
   184          if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
   185              raise Bad(f"{sub}/{n!r}: unexpected {what}")
   186          out.append(p)
   187      return out
