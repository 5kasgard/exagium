   100  # ---------- schema ----------
   101  def _need(d, key, typ, where):
   102      if key not in d or not isinstance(d[key], typ) or (typ is int and 
isinstance(d[key], bool)):
   103          raise Bad(f"{where}: needs {key} ({typ.__name__})")
   104      return d[key]
   105  
   106  
   107  def _name(d, where):
   108      v = _need(d, "by", str, where)
   109      if not NAME.fullmatch(v):
   110          raise Bad(f"{where}: by must be a lowercase ASCII handle 
matching {NAME.pattern}")
   111      return v
   112  
   113  
   114  def _check_digests(lst, where):
   115      if not isinstance(lst, list):
   116          raise Bad(f"{where}: must be a list")
   117      for i, x in enumerate(lst):
   118          if not isinstance(x, dict) or set(x) != {"name", "sha256"} or 
not isinstance(x["name"], str) \
   119                  or not isinstance(x["sha256"], str) or not 
HEX64.fullmatch(x["sha256"]):
   120              raise Bad(f"{where}[{i}]: must be {{name, sha256}} with 64 
lowercase hex")
   121  
   122  
   123  def check_body(kind, body, where):
   124      if not isinstance(body, dict):
   125          raise Bad(f"{where}: body must be an object")
   126      _name(body, where)
   127      if kind == "plan":
   128          allowed = {"by", "claim", "test", "decision_rule", "baseline", 
"inputs", "verdict_due", "notes"}
   129          for k in ("claim", "test", "decision_rule"):
   130              if not _need(body, k, str, where).strip():
   131                  raise Bad(f"{where}: {k} is empty")
   132          if "inputs" in body:
   133              _check_digests(body["inputs"], f"{where}.inputs")
   134          if "verdict_due" in body:
   135              try:
   136                  ok = isinstance(body["verdict_due"], str) and 
len(body["verdict_due"]) == 10 and \
   137                      
datetime.date.fromisoformat(body["verdict_due"]).isoformat() == 
body["verdict_due"]
   138              except ValueError:
   139                  ok = False
   140              if not ok:
   141                  raise Bad(f"{where}: verdict_due must be a real date, 
YYYY-MM-DD")
   142      elif kind == "verdict":
   143          allowed = {"by", "plan", "outcome", "evidence", "notes"}
   144          p = _need(body, "plan", dict, where)
   145          if set(p) != {"seq", "sha256"} or not isinstance(p["seq"], int) 
or isinstance(p["seq"], bool) \
   146                  or not isinstance(p["sha256"], str) or not 
HEX64.fullmatch(p["sha256"]):
   147              raise Bad(f"{where}: plan must be {{seq, sha256}}")
   148          if body.get("outcome") not in OUTCOMES:
   149              raise Bad(f"{where}: outcome must be one of {OUTCOMES}")
   150          _check_digests(_need(body, "evidence", list, where), 
f"{where}.evidence")
   151      else:  # orphan: explains a Rekor attestation by the writer that the
ledger doesn't hold
   152          allowed = {"by", "log_index", "reason", "statement_b64"}
   153          if _need(body, "log_index", int, where) < 0 or not _need(body, 
"reason", str, where).strip():
   154              raise Bad(f"{where}: orphan needs log_index >= 0 and a 
reason")
   155          try:  # the orphaned attestation's exact signed statement; 
monitor checks it against Rekor's payload hash
   156              base64.b64decode(_need(body, "statement_b64", str, where), 
validate=True)
   157          except ValueError:
   158              raise Bad(f"{where}: statement_b64 must be base64")
   159      extra = set(body) - allowed
   160      if extra:
   161          raise Bad(f"{where}: unknown body fields {sorted(extra)}")
   162  
