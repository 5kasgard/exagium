   214  def make_entry(chain, kind, body, now=None):
   215      check_body(kind, body, "proposal")
   216      e = {"seq": len(chain) + 1, "prev": chain[-1][1] if chain else None,
"kind": kind,
   217           "written_at": now or 
datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
   218           "body": body}
   219      _check_value(e, "proposal")
   220      return e
