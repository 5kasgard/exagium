   269  def _get(url, data=None, timeout=20, headers=False):
   270      req = urllib.request.Request(url, data=data, 
headers={"Content-Type": "application/json", "Accept": "application/json",
   271                                                            "User-Agent": 
"exagium-record"})
   272      try:
   273          with urllib.request.urlopen(req, timeout=timeout) as r:
   274              body = r.read()
   275              return (body, r.headers) if headers else body
   276      except urllib.error.HTTPError as ex:
   277          if ex.code == 404:
   278              return (None, None) if headers else None
   279          raise CantCheck(f"network: {url}: HTTP {ex.code}")
   280      except OSError as ex:
   281          raise CantCheck(f"network: {url}: {ex}")
