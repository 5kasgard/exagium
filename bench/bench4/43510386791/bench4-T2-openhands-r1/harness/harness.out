   190  def load_chain(ledger):
   191      """Check the whole chain; return ([(entry, sha256)], {plan seq: 
verdict seq}). Raises Bad on any fault."""
   192      chain, plans, verdict_of = [], {}, {}
   193      for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, 
"file in entries"), start=1):
   194          name = os.path.basename(path)
   195          raw = open(path, "rb").read()
