import record as R
import base64
import hashlib

# Test 1: Valid orphan with correct entries
chain = []
# Create some test entries
e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}}
e1_raw = R.canonical(e1)
e1_hash = hashlib.sha256(e1_raw).hexdigest()

e2 = {'seq': 2, 'prev': e1_hash, 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test2', 'plan': {'seq': 1, 'sha256': 
e1_hash}, 'outcome': 'pass', 'evidence': []}}
e2_raw = R.canonical(e2)
e2_hash = hashlib.sha256(e2_raw).hexdigest()

# Valid orphan with entries_b64
orphan = {
    'body': {
        'by': 'test',
        'log_index': 123,
        'reason': 'test',
        'statement_b64': 'e30=',
        'entries_b64': [base64.b64encode(e1_raw).decode(), 
base64.b64encode(e2_raw).decode()]
    }
}
pred = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': e2_hash}
result = R._orphan_entries_problem(orphan, pred)
print(f'Test 1 (valid): {result}')
assert result is None, f'Expected None, got {result}'

# Test 2: Wrong count
orphan2 = {
    'body': {
        'by': 'test',
        'log_index': 123,
        'reason': 'test',
        'statement_b64': 'e30=',
        'entries_b64': [base64.b64encode(e1_raw).decode()]  # only 1 entry, 
expected 2
    }
}
result2 = R._orphan_entries_problem(orphan2, pred)
print(f'Test 2 (wrong count): {result2}')
assert 'range' in result2, f'Expected range error, got {result2}'

# Test 3: Chain break
orphan3 = {
    'body': {
        'by': 'test',
        'log_index': 123,
        'reason': 'test',
        'statement_b64': 'e30=',
        'entries_b64': [base64.b64encode(e1_raw).decode(), 
base64.b64encode(e2_raw).decode()]
    }
}
pred3 = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': '0' * 64, 'head_sha256': 
e2_hash}  # wrong prev_sha256
result3 = R._orphan_entries_problem(orphan3, pred3)
print(f'Test 3 (chain break): {result3}')
assert 'chain' in result3, f'Expected chain error, got {result3}'

# Test 4: Head mismatch
orphan4 = {
    'body': {
        'by': 'test',
        'log_index': 123,
        'reason': 'test',
        'statement_b64': 'e30=',
        'entries_b64': [base64.b64encode(e1_raw).decode(), 
base64.b64encode(e2_raw).decode()]
    }
}
pred4 = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': '0' * 
64}  # wrong head_sha256
result4 = R._orphan_entries_problem(orphan4, pred4)
print(f'Test 4 (head mismatch): {result4}')
assert 'head' in result4, f'Expected head error, got {result4}'

print('All tests passed!')
"

