   328  def check_ots(proof, entry_raw, explorers):
   329      """Returns the earliest Bitcoin block time the proof reaches, or 
None if it's still pending."""
   330      try:
   331          from opentimestamps.core.timestamp import DetachedTimestampFile
   332          from opentimestamps.core.notary import 
BitcoinBlockHeaderAttestation
   333          from opentimestamps.core.serialize import 
StreamDeserializationContext, DeserializationError
   334      except ImportError:
   335          raise CantCheck("opentimestamps isn't installed (pip install 
opentimestamps-client==0.8.0)")
   336      name = os.path.basename(proof)
   337      try:
   338          with open(proof, "rb") as f:
   339              dt = 
DetachedTimestampFile.deserialize(StreamDeserializationContext(f))
   340          atts = list(dt.timestamp.all_attestations())
   341      except (DeserializationError, ValueError, TypeError, EOFError) as 
ex:
   342          raise Bad(f"{name}: malformed proof ({ex})")
   343      if dt.file_digest != hashlib.sha256(entry_raw).digest():
   344          raise Bad(f"{name}: proof is for different bytes")
   345      times = []
   346      for msg, att in atts:
   347          if not isinstance(att, BitcoinBlockHeaderAttestation):
   348              continue
   349          headers = set()
   350          for base in explorers:
   351              bh = _get(f"{base}/block-height/{att.height}")
   352              if bh is None:  # 404: either the block doesn't exist (a 
forged height) or the explorer is behind
   353                  tip = _get(f"{base}/blocks/tip/height")
   354                  if tip is not None and att.height > int(tip):
   355                      raise Bad(f"{name}: claims block {att.height}, 
beyond the chain tip {int(tip)}")
   356                  raise CantCheck(f"{base}: no block at height 
{att.height}")
   357              bh = bh.decode().strip()
   358              hdr = _get(f"{base}/block/{bh}/header")
   359              if hdr is None:
   360                  raise CantCheck(f"{base}: no header for block {bh}")
   361              hdr = bytes.fromhex(hdr.decode().strip())
   362              if 
hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:
   363                  raise CantCheck(f"{base}: header doesn't hash to block 
{bh} (explorer fault)")
   364              headers.add(hdr)
   365          if len(headers) != 1:
   366              raise CantCheck(f"explorers disagree about block 
{att.height}")
   367          hdr = headers.pop()
   368          if hdr[36:68] != msg:
   369              raise Bad(f"{name}: path doesn't reach block {att.height}'s 
merkle root")
   370          times.append(int.from_bytes(hdr[68:72], "little"))
   371      return min(times) if times else None
