   289          raise Bad(f"no range {a.from_seq}-{a.to_seq} in a chain of 
{len(chain)}")
   290      print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), 
sort_keys=True, separators=(",", ":")))
   291      return 0
