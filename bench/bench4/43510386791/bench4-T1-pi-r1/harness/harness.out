r e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n\n[359 more lines in file. Use offset=280 to continue.]"}],"isError":false,"durationMs":1,"timestamp":1794611552021},{"role":"assistant","content":[{"type":"thinking","thinking":"Let me read the specific section where I made the change.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Let me read the specific section where I made the change.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-73ef4d8b-8d2f-462b-811b-0544135d1fee","name":"read","arguments":{"limit":60,"offset":400,"path":"/workspace/record/record.py"}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":28609,"output":66,"cacheRead":0,"cacheWrite":0,"reasoning":12,"totalTokens":28675,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794611552022,"responseId":"gen-1794611552-JoQJr