8')\nwith open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:\n    f.write(raw2)\n\n# Create a dummy sigstore file\nsigstore_content = {\n    'verificationMaterial': {'tlogEntries': [{'integratedTime': 1704067200, 'logIndex': 12345}]},\n    'payload': {'subject': [{'digest': {'sha256': hashlib.sha256(raw2).hexdigest()}}], 'predicate': {\n        'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': hashlib.sha256(raw2).hexdigest()}}\n}\nwith open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:\n    json.dump(sigstore_content, f)\n\nprint('Created test ledger at', d)\nprint('Files:', os.listdir(os.path.join(d, 'anchors')))\n\""}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":10733,"output":661,"cacheRead":13152,"cacheWrite":0,"reasoning":21,"totalTokens":24546,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794610985416,"responseId":"gen-1794610985-60wLOkrWdHmBq6aG9neZ","rawStopReason":"tool_calls","durationMs":118750,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call-4dd6384c-395c-4add-8587-30aef2c233d2","toolName":"bash","content":[{"type":"text","text":"Created test ledger at /tmp/test_ledger_2\nFiles: ['000002.sigstore.json']\n"}],"isError":false,"durationMs":22,"timestamp":1794611104188},{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me run check-anchors on this ledger. It will fail on sigstore verification (since it's a dummy bundle), but it should also report the missing .ots file.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Now let me run check-anchors on this ledger. It will fail on sigstore verification (since it's a dummy bundle), but it should also report the missing .ots file.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-b1533d17-e036-42a8-8b87-56427269e295","name":"bash","arguments":{"co