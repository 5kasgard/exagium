not os.path.exists(ots_path):\n        bad.append(f'{seq:06d}.ots is missing')\n\nprint('Test 2: .ots present')\nprint('  bad =', bad)\nassert bad == [], f'Expected [], got {bad}'\n\n# Test with multiple ranges\nranges = [(1, 1, 'commit1'), (2, 2, 'commit2')]\nrange_heads = {hi for _, hi, _ in ranges}\nbad = []\nfor seq in range_heads:\n    ots_path = os.path.join(d, 'anchors', f'{seq:06d}.ots')\n    if not os.path.exists(ots_path):\n        bad.append(f'{seq:06d}.ots is missing')\n\nprint('Test 3: Multiple ranges, only 000002.ots exists')\nprint('  bad =', bad)\nassert bad == ['000001.ots is missing'], f'Expected [\\\"000001.ots is missing\\\"], got {bad}'\n\n# Create 000001.ots\nopen(os.path.join(d, 'anchors', '000001.ots'), 'wb').write(b'dummy')\nbad = []\nfor seq in range_heads:\n    ots_path = os.path.join(d, 'anchors', f'{seq:06d}.ots')\n    if not os.path.exists(ots_path):\n        bad.append(f'{seq:06d}.ots is missing')\n\nprint('Test 4: Both .ots files exist')\nprint('  bad =', bad)\nassert bad == [], f'Expected [], got {bad}'\n\nshutil.rmtree(d)\nprint('All tests passed!')\n\""}}
