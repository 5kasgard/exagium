{"type":"tool_execution_start","toolCallId":"call-7b302ead-a816-4fff-b9cd-059aeef52adb","toolName":"bash","args":{"command":"cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time\nimport record as R\nimport io, contextlib, sys\n\n# Create a test ledger with:\n# - 2 entries (plan + plan)\n# - 1 sigstore anchor for entry 2 (range 1-2) with an old attestation time\n# - 1 OTS anchor for entry 2 that will return None (pending)\n\nd = tempfile.mkdtemp()\ntry:\n    os.makedirs(os.path.join(d, 'entries'))\n    os.makedirs(os.path.join(d, 'anchors'))\n    os.makedirs(os.path.join(d, 'inbox'))\n    \n    # Create two entries\n    PLAN = {'by': 'proposer-agent', 'claim': 'test', 'test': 'test.py', 'decision_rule': 'test'}\n    e1 = R.make_entry([], 'plan', PLAN, now='2024-01-01T00:00:00Z')\n    e2 = R.make_entry([(e1, hashlib.sha256(R.canonical(e1)).hexdigest())], 'plan', PLAN, now='2024-01-01T00:00:00Z')\n    \n    open(os.path.join(d, 'entries', '000001.json'), 'wb').write(R.canonical(e1))\n    open(os.path.join(d, 'entries', '000002.json'), 'wb').write(R.canonical(e2))\n    \n    # Create a fake sigstore bundle with old integratedTime (5 days ago = 120 hours)\n    old_time = int(time.time()) - 5 * 24 * 3600\n    bundle = {\n        'verificationMaterial': {\n            'tlogEntries': [{'integratedTime': old_time, 'logIndex': 12345}]\n        }\n    }\n    open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w').write(json.dumps(bundle))\n    \n    # Create a dummy OTS file (will be treated as pending since we can't verify)\n    open(os.path.join(d, 'anchors', '000002.ots'), 'wb').write(b'dummy')\n    \n    # Test without --max-pending-hours (should pass, exit 0)\n    # We need to stub check_ots to return None (pending) and check_sigstore to return our old_time\n    original_check_ots = R.check_ots\n    original_check_sigstore = R.check_sigstore\n    \n    def stub_check_ots(proof, entry_raw, explorers):\n        return None  # pending\n    \n    def stub_check_sigstore(bundle, digest, repo, workflow, ref):\n        pred = R.range_predicate([(e1, hashlib.sha256(R.canonical(e1)).hexdigest()), (e2, hashlib.sha256(R.canonical(e2)).hexdigest())], 1, 2)\n        return old_time, pred, 'c0ffee'\n    \n    R.check_ots = stub_check_ots\n    R.check_sigstore = stub_check_sigstore\n    \n    try:\n        # Without --max-pending-hours\n        rc, out, err = R.main(['--ledger', d, 'check-anchors'])\n        print(f'Without --max-pending-hours: rc={rc}, err={err.strip()}')\n        \n        # With --max-pending-hours 24 (1 day) - should fail because 120h > 24h\n        rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '24'])\n        print(f'With --max-pending-hours 24: rc={rc}, err={err.strip()}')\n        \n        # With --max-pending-hours 200 (200 hours) - should pass because 120h < 200h\n        rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '200'])\n        print(f'With --max-pending-hours 200: rc={rc}, err={err.strip()}')\n    finally:\n        R.check_ots = original_check_ots\n        R.check_sigstore = original_check_sigstore\n\nfinally:\n    import shutil\n    shutil.rmtree(d)\n\""}}
