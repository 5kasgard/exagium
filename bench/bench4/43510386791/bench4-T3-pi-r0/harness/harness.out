nding OTS, sigstore 2h old, --max-pending-hours 24: rc={rc}')\n    finally:\n        R.check_ots = original_check_ots\n        R.check_sigstore = original_check_sigstore\n\nfinally:\n    import shutil\n    shutil.rmtree(d)\n\""},"partialResult":{"content":[{"type":"text","text":"{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000002.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-2\",\n   \"existed_by\": \"2026-11-13T19:28:05Z\",\n   \"writer_commit\": \"c0ffee\"\n  }\n ],\n \"entries\": 2,\n \"writer_attested_through\": 2,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_not_check\": []\n}\nPending OTS, sigstore 2h old, --max-pending-hours 24: rc=0\n"}],"details":{}}}
