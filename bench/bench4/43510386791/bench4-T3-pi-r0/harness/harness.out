0:00:00Z')\n    \n    chain = [(e1, hashlib.sha256(R.canonical(e1)).hexdigest()), (e2, hashlib.sha256(R.canonical(e2)).hexdigest())]\n    \n    open(os.path.join(d, 'entries', '000001.json'), 'wb').write(R.canonical(e1))\n    open(os.path.join(d, 'entries', '000002.json'), 'wb').write(R.canonical(e2))\n    \n    recent_time = int(time.time()) - 2 * 3600  # 2 hours ago\n    bundle = {\n        'verificationMaterial': {\n            'tlogEntries': [{'integratedTime': recent_time, 'logIndex': 12345}]\n        }\n    }\n    open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w').write(json.dumps(bundle))\n    open(os.path.join(d, 'anchors', '000002.ots'), 'wb').write(b'dummy')\n    \n    original_check_ots = R.check_ots\n    original_check_sigstore = R.check_sigstore\n    \n    def stub_check_ots(proof, entry_raw, explorers):\n        return None  # pending\n    \n    def stub_check_sigstore(bundle, digest, repo, workflow, ref):\n        pred = R.range_predicate(chain, 1, 2)\n        return recent_time, pred, 'c0ffee'\n    \n    R.check_ots = stub_check_ots\n    R.check_sigstore = stub_check_sigstore\n    \n    try:\n        # With --max-pending-hours 24 - should PASS because sigstore is only 2 hours old\n        rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '24'])\n        print(f'Pending OTS, sigstore 2h old, --max-pending-hours 24: rc={rc}')\n    finally:\n        R.check_ots = original_check_ots\n        R.check_sigstore = original_check_sigstore\n\nfinally:\n    import shutil\n    shutil.rmtree(d)\n\""}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":5368,"output":790,"cacheRead":21920,"cacheWrite":0,"reasoning":57,"totalTokens":28078,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794605274983,"responseId":"gen-1794605275-TFwsDc1SpcX8P5hsQ0Nq","rawStopReason":"tool_calls","durationMs":10457,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call-e02ca347-f9b4-4ed9-8536-ba730bcf757d","toolName":"bash","content":[{"type":"text","text":"{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000002.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-2\",\n   \"existed_by\": \"2026-11-13T19:28:05Z\",\n   \"writer_commit\": \"c0ffee\"\n  }\n ],\n \"entries\": 2,\n \"writer_attested_through\": 2,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_not_check\": []\n}\nPending OTS, sigstore 2h old, --max-pending-hours 24: rc=0\n"}],"isError":false,"durationMs":45,"timestamp":1794605285485},{"role":"assistant","content":[{"type":"thinking","thinking":"The implementation is working correctly:\n1. Without `--max-pending-hours`, pending OTS proofs are accepted (exit 0)\n2. With `--max-pending-hours H`, if a range head's OTS proof is pending AND its sigstore attestation is older than H hours, exit 1 with message containing \"still pending N h\"\n3. If the OTS proof is confirmed (not pending), it passes regardless of the sigstore attestation age\n4. If the sigstore attestation is within H hours, it passes even if the OTS proof is pending\n\nAll existing tests pass. The implementation is complete.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"The implementation is working correctly:\\n1. Without `--max-pending-hours`, pending OTS proofs are accepted (exit 0)\\n2. With `--max-pending-hours H`, if a range head's OTS proof is pending AND its sigstore attestation is older than H hours, exit 1 with message containing \\\"still pending N h\\\"\\n3. If the OTS proof is confirmed (not pending), it passes regardless of the sigstore attestation age\\n4. If the sigstore attestation is within H hours, it passes even if the OTS proof is pending\\n\\nAll existing tests pass. The implementation is complete.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"text","text":"The implementation is complete and all tests pass. Let me summarize what was done:\n\n## Summary\n\nAdded the `--max-pending-hours H` option to `check-anchors` command:\n\n### Changes made to `/workspace/record/record.py`:\n\n1. **Added `time` import** (line 17)\n\n2. **Added CLI argument** for `check-anchors`:\n   ```python\n   p.add_argument(\"--max-pending-hours\", type=int, default=None,\n                  help=\"if a range head's OTS proof is still pending and its Sigstore attestation is older than H hours, exit 1\")\n   ```\n\n3. **Modified `cmd_check_anchors`** to:\n   - Track sigstore attestation times per sequence number (`sigstore_times` dict)\n   - After checking that each range head has its OTS proof, if `--max-pending-hours` is set:\n     - Re-check the OTS proof for each range head\n     - If it's still pending (`check_ots` returns `None`) and the sigstore attestation is older than H hours\n     - Exit 1 with error message: `still pending N h` where N is whole hours since attestation\n\n### Behavior:\n- **Without `--max-pending-hours`**: Unchanged - pending proofs accepted (exit 0)\n- **With `--max-pending-hours H`**: \n  - Pending OTS proof + sigstore attestation > H hours ago → exit 1, prints `still pending N h` to stderr\n  - Pending OTS proof + sigstore attestation ≤ H hours ago → exit 0\n  - Confirmed OTS proof (not pending) → exit 0 regardless of attestation age\n\n### Tests:\nAll 21 existing tests in `test_record.py` pass."}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":1968,"output":515,"cacheRead":26304,"cacheWrite":0,"reasoning":130,"totalTokens":28787,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"stop","timestamp":1794605285486,"responseId":"gen-1794605285-hP2dusBNnFQZSoKy7YAH","rawStopReason":"stop","durationMs":17750,"thinkingLevel":"medium"}],"willRetry":false}
