rkflow, ref):\n        pred = R.range_predicate(chain, 1, 2)\n        return old_time, pred, 'c0ffee'\n    \n    R.check_ots = stub_check_ots\n    R.check_sigstore = stub_check_sigstore\n    \n    try:\n        # Capture stderr\n        import sys, io\n        old_stderr = sys.stderr\n        sys.stderr = io.StringIO()\n        rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '24'])\n        err = sys.stderr.getvalue()\n        sys.stderr = old_stderr\n        print(f'rc={rc}')\n        print(f'stderr: {err.strip()}')\n    finally:\n        R.check_ots = original_check_ots\n        R.check_sigstore = original_check_sigstore\n\nfinally:\n    import shutil\n    shutil.rmtree(d)\n\""}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":5019,"output":771,"cacheRead":17536,"cacheWrite":0,"reasoning":23,"totalTokens":23326,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794605256437,"responseId":"gen-1794605256-iWwdfzspO2NiIzlJSdiU","rawStopReason":"tool_calls","durationMs":8901,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call-e4fd2fa3-d729-409f-a4aa-6136aa0b3d2b","toolName":"bash","content":[{"type":"text","text":"{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000002.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-2\",\n   \"existed_by\": \"2026-11-08T21:27:45Z\",\n   \"writer_commit\": \"c0ffee\"\n  }\n ],\n \"entries\": 2,\n \"writer_attested_through\": 2,\n \"writer_runs\": [],\n \"wrong\": [\n  \"anchors/000002.ots: still pending 120 h (sigstore attestation 2026-11-08T21:27:45Z)\"\n ],\n \"could_not_check\": []\n}\nrc=1\nstderr: BAD: anchors/000002.ots: still pending 120 h (sigstore attestation 2026-11-08T21:27:45Z)\n"}],"isError":false,"durationMs":