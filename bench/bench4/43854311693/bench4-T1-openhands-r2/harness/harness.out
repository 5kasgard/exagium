    35      def test_plan_then_verdict_chains_and_verifies(self):
    36          self.propose("a.json", "plan", PLAN)
    37          self.assertEqual(self.run_cmd("ingest")[0], 0)
    38          self.propose("b.json", "verdict", self.verdict(1))
    39          self.assertEqual(self.run_cmd("ingest")[0], 0)
    40          rc, out, _ = self.run_cmd("verify")
    41          self.assertEqual(rc, 0)
    42          rep = json.loads(out)
    43          self.assertEqual((rep["entries"], rep["verdicts"], 
rep["open_plans"]), (2, 1, []))
    44          e2 = json.load(open(self.entry(2)))
    45          self.assertEqual(e2["prev"], self.plan_ref(1)["sha256"])
    46          self.assertEqual(os.listdir(os.path.join(self.d, "inbox")), [])
    47  
    48      def test_open_and_overdue_plans_are_reported(self):
    49          self.propose("a.json", "plan", dict(PLAN, 
verdict_due="2000-01-01"))
    50          self.propose("b.json", "plan", PLAN)
    51          self.run_cmd("ingest")
