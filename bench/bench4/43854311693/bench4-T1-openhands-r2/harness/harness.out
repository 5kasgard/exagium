   383  def cmd_check_anchors(a):
   384      """Every anchor must be right, and the writer's Sigstore ranges must
cover entries 1..head with no gap or overlap.
   385      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
   386      chain, _ = load_chain(a.ledger)
   387      rows, bad, cant, ranges = [], [], [], []
   388      sigstore_seqs = set()  # sequence numbers that have sigstore anchors
(range heads)
   389      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   390          n = os.path.basename(path)
   391          m = ANCHOR_NAME.fullmatch(n)
   392          seq = int(m.group(1))
   393          if m.group(2) != "ots":
   394              sigstore_seqs.add(seq)  # this seq has a sigstore anchor, 
must check for .ots
   395          try:
   396              if not 1 <= seq <= len(chain):
   397                  raise Bad(f"anchors/{n}: no entry {seq}")
   398              raw = open(os.path.join(a.ledger, "entries", 
f"{seq:06d}.json"), "rb").read()
   399              if m.group(2) == "ots":
   400                  t = check_ots(path, raw, a.explorer)
   401                  rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
   402              else:
   403                  t, pred, commit = check_sigstore(path, chain[seq - 
1][1], a.repo, a.workflow, a.ref)
   404                  if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
   405                          or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
   406                      raise Bad(f"anchors/{n}: attested range {pred!r} 
doesn't match this chain")
   407                  ranges.append((pred["from_seq"], seq, commit))
   408                  rows.append({"anchor": n, "kind": "sigstore", "entries":
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
   409                               "writer_commit": commit})
   410          except Bad as ex:
   411              bad.append(str(ex))
   412          except CantCheck as ex:
   413              cant.append(f"anchors/{n}: {ex}")
   414      # Check that every range head (sigstore anchor) also has its .ots 
proof
   415      for seq in sigstore_seqs:
   416          ots_path = os.path.join(a.ledger, "anchors", f"{seq:06d}.ots")
   417          if not os.path.exists(ots_path):
   418              bad.append(f"{seq:06d}.ots is missing")
   419      covered, changes, prev_commit = 0, [], None
   420      for lo, hi, commit in sorted(ranges):
   421          if lo != covered + 1:
   422              bad.append(f"the writer's ranges {'overlap' if lo <= covered
else 'leave a gap'} at entry {min(lo, covered + 1)}")
   423          covered = max(covered, hi)
   424          if prev_commit:  # did the writer's code change between these 
two runs? (information: a stranger reads the diff)
   425              changes.append({"entries": f"{lo}-{hi}", "from_commit": 
prev_commit, "to_commit": commit,
   426                              "writer_code_changed": _code_changed(a, 
prev_commit, commit)})
   427          prev_commit = commit
   428      if covered < len(chain):
   429          bad.append(f"entries {covered + 1}-{len(chain)} were never 
attested by the writer")
   430      print(json.dumps({"anchors": rows, "entries": len(chain), 
"writer_attested_through": covered,
   431                        "writer_runs": changes, "wrong": bad, 
"could_not_check": cant}, indent=1))
   432      for x in bad:
   433          print(f"BAD: {x}", file=sys.stderr)
   434      for x in cant:
   435          print(f"CAN'T CHECK: {x}", file=sys.stderr)
   436      return 1 if bad else 2 if cant else 0
