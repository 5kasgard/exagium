$ cd /workspace/record && python3 -c "
import json, os, tempfile, shutil, hashlib

# Create a minimal test ledger with a single entry and both anchors
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))
os.makedirs(os.path.join(d, 'inbox'))

# Create a simple entry
entry = {
    'seq': 1,
    'prev': None,
    'kind': 'plan',
    'written_at': '2026-01-01T00:00:00Z',
    'body': {'by': 'test', 'claim': 'test', 'test': 'test', 'decision_rule': 
'test'}
}

import record as R
raw = R.canonical(entry)
open(os.path.join(d, 'entries', '000001.json'), 'wb').write(raw)

# Create a dummy .sigstore.json
sigstore = {
    'verificationMaterial': {
        'tlogEntries': [{'logIndex': 12345}]
    }
}
open(os.path.join(d, 'anchors', '000001.sigstore.json'), 
'w').write(json.dumps(sigstore))

# NOTE: NOT creating the .ots file - this is the bug we're testing

# Check files exist
print('Files in anchors:', os.listdir(os.path.join(d, 'anchors')))
print('000001.ots exists:', os.path.exists(os.path.join(d, 'anchors', 
'000001.ots')))

# Run check-anchors - this SHOULD report '000001.ots is missing'
import sys, io, contextlib
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'check-anchors'])

print('RC:', rc)
print('STDOUT:')
print(out.getvalue())
print('STDERR:')
print(err.getvalue())
"

