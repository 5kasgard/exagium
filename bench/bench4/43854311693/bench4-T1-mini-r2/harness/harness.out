            stderr = err.getvalue()
            
            print(f"Return code: {rc}")
            print(f"Stdout: {stdout}")
            print(f"Stderr: {stderr}")
            
            # Check that only 000004.ots is reported missing
            if rc == 1 and "000004.ots is missing" in stderr and "000002.ots is 
missing" not in stderr:
                print("SUCCESS: Only missing .ots file reported!")
                return True
            else:
                print("FAILURE: Incorrect missing .ots reporting!")
                return False
        finally:
            R.check_sigstore = original_check_sigstore
            R.check_ots = original_check_ots
        
    finally:
        shutil.rmtree(d)

