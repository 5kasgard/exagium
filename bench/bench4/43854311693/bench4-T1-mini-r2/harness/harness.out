```
cat <<'EOF' > /workspace/record/record.py.fixed
#!/usr/bin/env python3
"""exagium record: an append-only, hash-chained ledger of plans and verdicts, 
with outside anchors.

Layout (under --ledger, default ../ledger):
  entries/000001.json ...   one entry per file; CI 
(.github/workflows/record.yml) is the only writer
  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range
of entries it added, ending at NNNNNN
  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes
  inbox/*.json                   proposals {"kind": ..., "body": ...}; CI moves 
them into entries/

An entry's identity is the sha256 of its stored bytes, which must be exactly its
RFC 8785 (JCS) form
(no trailing newline). The rules that make Python's json.dumps output equal JCS 
are enforced: ASCII
keys, no floats, integers within +-(2**53-1), no lone surrogates.

Commands: ingest | verify | head | range | check-anchors | monitor.
Exit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 
can't check (missing
library or network); 3 unexpected failure. A failure is never reported as a 
verdict.
"""
import argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, 
urllib.error, urllib.request

MAX_INT = 2**53 - 1
KINDS = ("plan", "verdict", "orphan")
OUTCOMES = ("pass", "fail", "inconclusive")
HEX64 = re.compile(r"[0-9a-f]{64}")
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")  # who: a plain ASCII handle, so
"same author" can't hide behind look-alikes
ENTRY_NAME = re.compile(r"([0-9]{6})\.json")
ANCHOR_NAME = re.compile(r"([0-9]{6})\.(sigstore\.json|ots)")
ISSUER = "https://token.actions.githubusercontent.com"


class Bad(Exception):
    """The data is wrong: exit 1."""


class CantCheck(Exception):
    """A check couldn't run (missing library, network): exit 2."""


# ---------- canonical form ----------
def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", 
":"), allow_nan=False).encode("utf-8")


def _check_value(v, where):
    if isinstance(v, bool) or v is None:
        return
    if isinstance(v, str):
        try:
            v.encode("utf-8")
        except UnicodeEncodeError:
            raise Bad(f"{where}: string holds a lone surrogate")
        return
    if isinstance(v, int):
        if abs(v) > MAX_INT:
            raise Bad(f"{where}: integer outside +-(2**53-1)")
        return
    if isinstance(v, float):
        raise Bad(f"{where}: floats aren't allowed; write numbers with a 
fraction as strings")
    if isinstance(v, list):
        for i, x in enumerate(v):
            _check_value(x, f"{where}[{i}]")
        return
    if isinstance(v, dict):
        for k, x in v.items():
            if not k.isascii():
                raise Bad(f"{where}: non-ASCII key {k!r}")
            _check_value(x, f"{where}.{k}")
        return
    raise Bad(f"{where}: unsupported type {type(v).__name__}")


def _no_dup_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise Bad(f"duplicate key {k!r}")
        d[k] = v
    return d


def _no_constants(c):
    raise Bad(f"{c} isn't JSON")


def parse_json(raw, where):
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=_no_dup_keys, 
parse_constant=_no_constants)
    except (UnicodeDecodeError, ValueError, RecursionError) as e:
        raise Bad(f"{where}: not valid UTF-8 JSON ({e})")


def parse_canonical(raw, where):
    """Parse stored bytes; they must be exactly the canonical form of what they 
contain."""
    obj = parse_json(raw, where)
    _check_value(obj, where)
    if canonical(obj) != raw:
        raise Bad(f"{where}: bytes aren't in canonical form")
    return obj


# ---------- schema ----------
def _need(d, key, typ, where):
    if key not in d or not isinstance(d[key], typ) or (typ is int and 
isinstance(d[key], bool)):
        raise Bad(f"{where}: needs {key} ({typ.__name__})")
    return d[key]


def _name(d, where):
    v = _need(d, "by", str, where)
    if not NAME.fullmatch(v):
        raise Bad(f"{where}: by must be a lowercase ASCII handle matching 
{NAME.pattern}")
    return v


def _check_digests(lst, where):
    if not isinstance(lst, list):
        raise Bad(f"{where}: must be a list")
    for i, x in enumerate(lst):
        if not isinstance(x, dict) or set(x) != {"name", "sha256"} or not 
isinstance(x["name"], str) \
                or not isinstance(x["sha256"], str) or not 
HEX64.fullmatch(x["sha256"]):
            raise Bad(f"{where}[{i}]: must be {{name, sha256}} with 64 lowercase
hex")


def check_body(kind, body, where):
    if not isinstance(body, dict):
        raise Bad(f"{where}: body must be an object")
    _name(body, where)
    if kind == "plan":
        allowed = {"by", "claim", "test", "decision_rule", "baseline", "inputs",
"verdict_due", "notes"}
        for k in ("claim", "test", "decision_rule"):
            if not _need(body, k, str, where).strip():
                raise Bad(f"{where}: {k} is empty")
        if "inputs" in body:
            _check_digests(body["inputs"], where)
        if "verdict_due" in body:
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", body["verdict_due"]):
                raise Bad(f"{where}: verdict_due must be YYYY-MM-DD")
    elif kind == "verdict":
        allowed = {"by", "plan", "outcome", "evidence"}
        _need(body, "plan", dict, where)
        p = body["plan"]
        if not isinstance(p.get("seq"), int) or not isinstance(p.get("sha256"), 
str) or not HEX64.fullmatch(p["sha256"]):
            raise Bad(f"{where}: plan must be {{seq, sha256}} with 64 lowercase 
hex")
        if _need(body, "outcome", str, where) not in OUTCOMES:
            raise Bad(f"{where}: outcome must be one of {OUTCOMES}")
        _check_digests(_need(body, "evidence", list, where), where)
    elif kind == "orphan":
        allowed = {"by", "log_index", "reason", "statement_b64", "entries_b64"}
        _need(body, "log_index", int, where)
        _need(body, "reason", str, where)
        _need(body, "statement_b64", str, where)
        _need(body, "entries_b64", list, where)
    else:
        raise Bad(f"{where}: unknown kind {kind!r}")
    for k in body:
        if k not in allowed:
            raise Bad(f"{where}: unexpected field {k!r}")


def make_entry(chain, kind, body):
    """Return the canonical entry bytes and its sha256. Does not write to 
disk."""
    prev = chain[-1][1] if chain else None
    entry = {"seq": len(chain) + 1, "prev": prev, "kind": kind, "body": body}
    return entry, hashlib.sha256(canonical(entry)).hexdigest()


# ---------- chain ----------
def load_chain(ledger):
    """Check the whole chain; return ([(entry, sha256)], {plan seq: verdict 
seq}). Raises Bad on any fault."""
    chain, plans, verdict_of = [], {}, {}
    for i, path in enumerate(_listdir(ledger, "entries", ENTRY_NAME, "file in 
entries"), start=1):
        name = os.path.basename(path)
        raw = open(path, "rb").read()
        entry = parse_canonical(raw, f"entries/{name}")
        if entry["seq"] != i:
            raise Bad(f"entries/{name}: seq {entry['seq']} != expected {i}")
        if i == 1:
            if entry["prev"] is not None:
                raise Bad(f"entries/{name}: first entry must have prev=null")
        else:
            if entry["prev"] != chain[-1][1]:
                raise Bad(f"entries/{name}: prev doesn't match entry {i-1}")
        if entry["kind"] not in KINDS:
            raise Bad(f"entries/{name}: unknown kind {entry['kind']!r}")
        check_body(entry["kind"], entry["body"], f"entries/{name}")
        if entry["kind"] == "plan":
            if entry["seq"] in plans:
                raise Bad(f"entries/{name}: duplicate plan seq")
            plans[entry["seq"]] = entry["body"]
        elif entry["kind"] == "verdict":
            plan_seq = entry["body"]["plan"]["seq"]
            if plan_seq not in plans:
                raise Bad(f"entries/{name}: verdict for unknown plan 
{plan_seq}")
            if plan_seq in verdict_of:
                raise Bad(f"entries/{name}: plan {plan_seq} already has a 
verdict")
            if entry["body"]["plan"]["sha256"] != 
hashlib.sha256(open(os.path.join(ledger, "entries", f"{plan_seq:06d}.json"), 
"rb").read()).hexdigest():
                raise Bad(f"entries/{name}: plan sha256 doesn't match")
            if entry["body"]["by"] == plans[plan_seq]["by"]:
                raise Bad(f"entries/{name}: verdict by same author as plan")
            verdict_of[plan_seq] = entry["seq"]
        chain.append((entry, hashlib.sha256(raw).hexdigest()))
    return chain, verdict_of


def range_predicate(chain, from_seq, to_seq):
    """Predicate the writer signs: the range of entries from_seq..to_seq, 
chained from prev_sha256 to head_sha256."""
    if not 1 <= from_seq <= to_seq <= len(chain):
        raise Bad(f"no range {from_seq}-{to_seq} in a chain of {len(chain)}")
    prev = chain[from_seq - 2][1] if from_seq > 1 else None
    head = chain[to_seq - 1][1]
    return {"from_seq": from_seq, "to_seq": to_seq, "prev_sha256": prev, 
"head_sha256": head}


def identity(repo, workflow, ref):
    return f"https://github.com/{repo}/.github/workflows/{workflow}@{ref}"


# ---------- network ----------
def _get(url):
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    except urllib.error.URLError:
        return None


# ---------- anchors ----------
def check_sigstore(bundle, digest, repo, workflow, ref):
    """Verify offline that a bundle is an attestation of this digest, signed by 
exactly this workflow on this ref.
    Returns (integrated_time, predicate). Wrong data is Bad; a missing library 
is CantCheck."""
    try:
        from sigstore.models import Bundle
        from sigstore.verify import Verifier, policy
        from sigstore.errors import Error as SigstoreError
    except ImportError as ex:
        raise CantCheck(f"sigstore-python isn't usable ({ex}); pip install 
sigstore==4.5.1 in a virtualenv")
    name = os.path.basename(bundle)
    raw = open(bundle, "rb").read()
    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), 
issuer=ISSUER),
                        policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
    try:
        b = Bundle.from_json(raw)
        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)
    except SigstoreError as ex:   # verification errors and malformed bundles 
alike: the anchor is wrong
        raise Bad(f"{name}: Sigstore verification failed: {ex}")
    except (ValueError, KeyError, TypeError) as ex:
        raise Bad(f"{name}: malformed bundle ({type(ex).__name__}: {ex})")
    st = parse_json(payload, f"{name} payload")
    if ptype != "application/vnd.in-toto+json" or not isinstance(st, dict) or \
            [s.get("digest", {}).get("sha256") for s in st.get("subject", [])] 
!= [digest]:
        raise Bad(f"{name}: the attestation's subject isn't this entry")
    try:  # the same bytes the verifier just checked; their signed entry 
timestamp covers integratedTime
        t = 
int(json.loads(raw)["verificationMaterial"]["tlogEntries"][0]["integratedTime"])
        from cryptography.x509 import ObjectIdentifier
        commit = b.signing_certificate.extensions.get_extension_for_oid(
            ObjectIdentifier("1.3.6.1.4.1.57264.1.3")).value.value.decode("ascii
")  # the commit the run was given
    except Exception as ex:
        raise Bad(f"{name}: malformed bundle or certificate 
({type(ex).__name__}: {ex})")
    return t, st.get("predicate"), commit


def check_ots(proof, entry_raw, explorers):
    """Returns the earliest Bitcoin block time the proof reaches, or None if 
it's still pending."""
    try:
        from opentimestamps.core.timestamp import DetachedTimestampFile
        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation
        from opentimestamps.core.serialize import StreamDeserializationContext, 
DeserializationError
    except ImportError:
        raise CantCheck("opentimestamps isn't installed (pip install 
opentimestamps-client==0.8.0)")
    name = os.path.basename(proof)
    try:
        with open(proof, "rb") as f:
