            err = io.StringIO()
            with contextlib.redirect_stdout(out), 
contextlib.redirect_stderr(err):
                rc = R.cmd_check_anchors(a)
            
            stdout = out.getvalue()
            stderr = err.getvalue()
            
            print(f"Return code: {rc}")
            print(f"Stdout: {stdout}")
            print(f"Stderr: {stderr}")
            
            # Check that the error is about the invalid sigstore, not missing 
.ots
            if rc == 1 and "Invalid sigstore" in stderr and "000002.ots is 
missing" not in stderr:
                print("SUCCESS: Invalid sigstore reported, no false missing 
.ots!")
                return True
            else:
                print("FAILURE: Unexpected error reporting!")
                return False
        finally:
            R.check_sigstore = original_check_sigstore
        
    finally:
        shutil.rmtree(d)

def test_ots_without_sigstore():
    """Test that .ots file without sigstore is allowed."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        chain = []
        for i in range(1, 3):
            plan = {"by": "proposer-agent", "claim": f"test{i}", "test": "t.py",
"decision_rule": "pass"}
            entry = R.make_entry(chain, "plan", plan)
            raw = R.canonical(entry)
            digest = hashlib.sha256(raw).hexdigest()
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
            chain.append((entry, digest))
        
        # Create .ots file for entry 2 but NO sigstore.json
        ots_path = os.path.join(d, "anchors", "000002.ots")
        with open(ots_path, "wb") as f:
            f.write(b"dummy ots")
        
        # Mock check_ots
        original_check_ots = R.check_ots
        
        def mock_check_ots(proof, entry_raw, explorers):
            return 1234567890
        
        R.check_ots = mock_check_ots
        
        try:
            a = type('Args', (), {
                'ledger': d,
                'repo': '5kasgard/exagium',
                'workflow': '.github/workflows/record.yml',
                'ref': 'refs/heads/main',
                'explorer': ['https://blockstream.info/api', 
'https://mempool.space/api']
            })()
            
            out = io.StringIO()
            err = io.StringIO()
            with contextlib.redirect_stdout(out), 
contextlib.redirect_stderr(err):
                rc = R.cmd_check_anchors(a)
            
            stdout = out.getvalue()
            stderr = err.getvalue()
            
            print(f"Return code: {rc}")
            print(f"Stdout: {stdout}")
