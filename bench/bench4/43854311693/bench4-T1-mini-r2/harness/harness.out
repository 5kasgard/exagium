DetachedTimestampFile.deserialize(StreamDeserializationContext(f))
        atts = list(dt.timestamp.all_attestations())
    except (DeserializationError, ValueError, TypeError, EOFError) as ex:
        raise Bad(f"{name}: malformed proof ({ex})")
    if dt.file_digest != hashlib.sha256(entry_raw).digest():
        raise Bad(f"{name}: proof is for different bytes")
    times = []
    for msg, att in atts:
        if not isinstance(att, BitcoinBlockHeaderAttestation):
            continue
        headers = set()
        for base in explorers:
            bh = _get(f"{base}/block-height/{att.height}")
            if bh is None:  # 404: either the block doesn't exist (a forged 
height) or the explorer is behind
                tip = _get(f"{base}/blocks/tip/height")
                if tip is not None and att.height > int(tip):
                    raise Bad(f"{name}: claims block {att.height}, beyond the 
chain tip {int(tip)}")
                raise CantCheck(f"{base}: no block at height {att.height}")
            bh = bh.decode().strip()
            hdr = _get(f"{base}/block/{bh}/header")
            if hdr is None:
                raise CantCheck(f"{base}: no header for block {bh}")
            hdr = bytes.fromhex(hdr.decode().strip())
            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex()
!= bh:
                raise CantCheck(f"{base}: header doesn't hash to block {bh} 
(explorer fault)")
            headers.add(hdr)
        if len(headers) != 1:
            raise CantCheck(f"explorers disagree about block {att.height}")
        hdr = headers.pop()
        if hdr[36:68] != msg:
            raise Bad(f"{name}: path doesn't reach block {att.height}'s merkle 
root")
        times.append(int.from_bytes(hdr[68:72], "little"))
    return min(times) if times else None


def iso(t):
    return datetime.datetime.fromtimestamp(t, 
datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else None


def _listdir(ledger, sub, pattern, what):
    d = os.path.join(ledger, sub)
    if not os.path.exists(d):
        return []
    if os.path.islink(d) or not os.path.isdir(d):
        raise Bad(f"{sub}/ must be a plain directory")
    out = []
    for n in sorted(os.listdir(d)):
        p = os.path.join(d, n)
        if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
            raise Bad(f"{sub}/{n!r}: unexpected {what}")
        out.append(p)
    return out


def cmd_check_anchors(a):
    """Every anchor must be right, and the writer's Sigstore ranges must cover 
entries 1..head with no gap or overlap.
    Checks every anchor even after a failure; exit 1 if anything was wrong, else
2 if anything couldn't be checked."""
    chain, _ = load_chain(a.ledger)
    rows, bad, cant, ranges = [], [], [], []
    sigstore_seq = set()  # sequence numbers that have a valid sigstore anchor
    for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in anchors"):
        n = os.path.basename(path)
        m = ANCHOR_NAME.fullmatch(n)
        seq = int(m.group(1))
        try:
            if not 1 <= seq <= len(chain):
                raise Bad(f"anchors/{n}: no entry {seq}")
            raw = open(os.path.join(a.ledger, "entries", f"{seq:06d}.json"), 
"rb").read()
            if m.group(2) == "ots":
                t = check_ots(path, raw, a.explorer)
                rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
            else:
