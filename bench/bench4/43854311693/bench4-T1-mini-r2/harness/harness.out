def test_multiple_sigstore_anchors():
    """Test with multiple sigstore anchors, some missing .ots."""
    d = tempfile.mkdtemp()
    try:
        # Create a ledger with 4 entries
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
        chain = []
        for i in range(1, 5):
            plan = {"by": "proposer-agent", "claim": f"test{i}", "test": "t.py",
"decision_rule": "pass"}
            entry = R.make_entry(chain, "plan", plan)
            raw = R.canonical(entry)
            digest = hashlib.sha256(raw).hexdigest()
            with open(os.path.join(d, "entries", f"{i:06d}.json"), "wb") as f:
                f.write(raw)
            chain.append((entry, digest))
        
        # Create sigstore.json files for entries 2 and 4
        for seq in [2, 4]:
            sigstore_path = os.path.join(d, "anchors", 
f"{seq:06d}.sigstore.json")
            with open(sigstore_path, "w") as f:
                f.write('{"dummy": "sigstore"}')
        
        # Create .ots file only for entry 2
        ots_path = os.path.join(d, "anchors", "000002.ots")
        with open(ots_path, "wb") as f:
            f.write(b"dummy ots")
        
        # Mock check_sigstore and check_ots
        original_check_sigstore = R.check_sigstore
        original_check_ots = R.check_ots
        
        def mock_check_sigstore(bundle, digest, repo, workflow, ref):
            # Extract seq from bundle path
            seq = int(os.path.basename(bundle)[:6])
            # Return a predicate covering 1..seq
            pred = R.range_predicate(chain, 1, seq)
            return 1234567890, pred, "abcdef123456"
        
        def mock_check_ots(proof, entry_raw, explorers):
            return 1234567890
        
        R.check_sigstore = mock_check_sigstore
        R.check_ots = mock_check_ots
        
        try:
            a = type('Args', (), {
                'ledger': d,
                'repo': '5kasgard/exagium',
                'workflow': '.github/workflows/record.yml',
                'ref': 'refs/heads/main',
