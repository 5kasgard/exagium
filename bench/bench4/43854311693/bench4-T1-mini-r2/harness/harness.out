sys.path.insert(0, '/workspace/record')
import record as R

def test_invalid_sigstore_no_false_ots_error():
    """Test that invalid sigstore anchor doesn't cause false missing .ots 
report."""
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, "entries"))
        os.makedirs(os.path.join(d, "anchors"))
        os.makedirs(os.path.join(d, "inbox"))
        
