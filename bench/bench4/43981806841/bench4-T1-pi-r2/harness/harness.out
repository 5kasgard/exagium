-ish one\nimport base64\nbundle = {\n    'mediaType': 'application/vnd.dev.sigstore.bundle.v0.3+json',\n    'dsseEnvelope': {\n        'payload': base64.b64encode(json.dumps({\n            'payloadType': 'application/vnd.in-toto+json',\n            'predicateType': 'https://exagium.example/writer-range',\n            'subject': [{'name': '000002.json', 'digest': {'sha256': hashlib.sha256(raw2).hexdigest()}}],\n            'predicate': {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': hashlib.sha256(raw2).hexdigest()}\n        }, separators=(',', ':')).encode()).decode(),\n        'signatures': [{'keyid': '', 'sig': ''}]\n    },\n    'verificationMaterial': {\n        'tlogEntries': [{'logIndex': 123, 'integratedTime': 1234567890, 'inclusionPromise': {'signedEntryTimestamp': ''}}]\n    }\n}\nwith open(f'{ledger}/anchors/000002.sigstore.json', 'w') as f:\n    json.dump(bundle, f)\n\nprint('Created ledger with sigstore anchor for entry 2 but no .ots file')\n\""}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":465,"output":849,"cacheRead":17536,"cacheWrite":0,"reasoning":68,"totalTokens":18850,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794872776143,"responseId":"gen-1794872776-nixQ6xhtMk6VxQMXVCIT","rawStopReason":"tool_calls","durationMs":7866,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call-278f0aef-f957-4eb1-a38d-d280ef9bfbe1","toolName":"bash","content":[{"type":"text","text":"Created ledger with sigstore anchor for entry 2 but no .ots file\n"}],"isError":false,"durationMs":20,"timestamp":1794872784029}]}
