    {
      "id": "msg_56cdf81e-612c-4444-850f-25ab05b7c833",
      "role": "user",
      "created": 1794916450,
      "content": [
        {
          "type": "toolResponse",
          "id": "call-1f12a843-a0c6-4985-ade6-d7a7ded34107",
          "toolResult": {
            "status": "success",
            "value": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "def _orphan_entries_problem(orphan, pred):\n    \"\"\"Validate that an orphan's hidden entries match the attested range.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\", [])\n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    if not all(isinstance(x, int) for x in (from_seq, to_seq)) or from_seq > to_seq:\n        return \"range: invalid predicate bounds\"\n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    prev = prev_sha256\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        try:\n            entry = parse_json(raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} is not valid JSON ({ex})\"\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"chain: entry {i} is not a valid entry\"\n        if entry[\"seq\"] != from_seq + i:\n            return f\"chain: entry {i} has seq {entry['seq']}, expected {from_seq + i}\"\n        if entry[\"prev\"] != prev:\n            return f\"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev!r}\"\n        last_hash = hashlib.sha256(raw).hexdigest()\n        prev = last_hash\n    if last_hash != head_sha256:\n        return f\"head: last entry hash {last_hash} != predicate head_sha256 {head_sha256}\"\n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)",
                  "annotations": {
                    "priority": 0.0
                  }
                }
              ],
              "structuredContent": {
                "stdout": "def _orphan_entries_problem(orphan, pred):\n    \"\"\"Validate that an orphan's hidden entries match the attested range.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\", [])\n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    if not all(isinstance(x, int) for x in (from_seq, to_seq)) or from_seq > to_seq:\n        return \"range: invalid predicate bounds\"\n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    prev = prev_sha256\n    last_hash = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} is not valid base64\"\n        try:\n            entry = parse_json(raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} is not valid JSON ({ex})\"\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"chain: entry {i} is not a valid entry\"\n        if entry[\"seq\"] != from_seq + i:\n            return f\"chain: entry {i} has seq {entry['seq']}, expected {from_seq + i}\"\n        if entry[\"prev\"] != prev:\n            return f\"chain: entry {i} prev {entry['prev']!r} doesn't match expected {prev!r}\"\n        last_hash = hashlib.sha256(raw).hexdigest()\n        prev = last_hash\n    if last_hash != head_sha256:\n        return f\"head: last entry hash {last_hash} != predicate head_sha256 {head_sha256}\"\n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)",
                "stderr": "",
                "exit_code": 0
              },
              "isError": false
            }
