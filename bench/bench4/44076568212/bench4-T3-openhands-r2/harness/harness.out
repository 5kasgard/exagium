   493  def _pages(url):
   494      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   495      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   496      import urllib.parse
   497      base = url.split("?")[0]
   498      out = []
   499      while url:
   500          body, hdrs = _get(url, headers=True)
   501          if body is None:
   502              raise CantCheck(f"404 from {url}")
   503          out.extend(json.loads(body))
   504          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   505          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   506      return out
   507  
   508  
   509  def _refs(repo):
   510      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   511      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   512      api = f"https://api.github.com/repos/{repo}"
   513      refs = {"refs/heads/main"}
   514      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   515      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   516      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   517      activity = _pages(f"{api}/activity?per_page=100")
   518      refs.update(x["ref"] for x in activity if x.get("ref"))
   519      return sorted(refs), activity
