# Create sigstore anchor
open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w').write('{}')

chain, _ = R.load_chain(d)
print('Chain loaded:', len(chain), 'entries')

old_check_sigstore = R.check_sigstore
old_check_ots = R.check_ots

# Attestation time 100 hours ago - very old
attestation_time = int(time.time()) - 100 * 3600

def stub_check_sigstore(*args):
    return (attestation_time, R.range_predicate(chain, 1, 2), 'c0ffee')

# This time return a confirmed block time (not None)
block_time = int(time.time()) - 50 * 3600  # confirmed 50h ago

def stub_check_ots(*args):
    return block_time  # confirmed, not pending

R.check_sigstore = stub_check_sigstore
R.check_ots = stub_check_ots

try:
    # Test with --max-pending-hours 24
    # Should pass because OTS is confirmed (not pending), even though 
