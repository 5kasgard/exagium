   383  def cmd_check_anchors(a):
   384      """Every anchor must be right, the writer's Sigstore ranges must 
cover entries 1..head with no gap or overlap,
   385      and every range head must have its OpenTimestamps proof.
   386      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
   387      chain, _ = load_chain(a.ledger)
   388      rows, bad, cant, ranges, stamped = [], [], [], [], set()
   389      # Track attestation time for each range head (hi) from sigstore
   390      attestation_times = {}
   391      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   392          n = os.path.basename(path)
   393          m = ANCHOR_NAME.fullmatch(n)
   394          seq = int(m.group(1))
   395          if m.group(2) == "ots":
   396              stamped.add(seq)
   397          try:
   398              if not 1 <= seq <= len(chain):
   399                  raise Bad(f"anchors/{n}: no entry {seq}")
   400              raw = open(os.path.join(a.ledger, "entries", 
f"{seq:06d}.json"), "rb").read()
   401              if m.group(2) == "ots":
   402                  t = check_ots(path, raw, a.explorer)
   403                  rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
   404              else:
   405                  t, pred, commit = check_sigstore(path, chain[seq - 
1][1], a.repo, a.workflow, a.ref)
   406                  if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
   407                          or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
   408                      raise Bad(f"anchors/{n}: attested range {pred!r} 
doesn't match this chain")
   409                  ranges.append((pred["from_seq"], seq, commit))
   410                  rows.append({"anchor": n, "kind": "sigstore", "entries":
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
   411                               "writer_commit": commit})
   412                  # Store attestation time for this range head
   413                  attestation_times[seq] = t
   414          except Bad as ex:
   415              bad.append(str(ex))
   416          except CantCheck as ex:
   417              cant.append(f"anchors/{n}: {ex}")
   418      for lo, hi, commit in sorted(ranges):
   419          # the writer stamps every range head before it attests, and a 
failed stamp stops the run: a missing proof
   420          # was removed (found by Z, 2026-11-06)
   421          if hi not in stamped:
   422              bad.append(f"anchors/{hi:06d}.ots is missing, though the 
writer stamps every range head before attesting")
   423          # Check if OTS proof is pending and attestation is older than 
max-pending-hours
   424          elif a.max_pending_hours is not None and hi in 
attestation_times:
   425              # Re-check the OTS proof to see if it's still pending
