    assert rc == 0, 'Expected rc=0 because OTS is confirmed'
    print('Test passed: confirmed OTS does not trigger pending check!')
finally:
    R.check_sigstore = old_check_sigstore
    R.check_ots = old_check_ots

import shutil
shutil.rmtree(d)
