print('Chain loaded:', len(chain), 'entries')

# Test 1: Without --max-pending-hours, should pass even if pending
# We need to stub check_sigstore and check_ots
old_check_sigstore = R.check_sigstore
old_check_ots = R.check_ots

# Return attestation time 25 hours ago (90000 seconds ago)
