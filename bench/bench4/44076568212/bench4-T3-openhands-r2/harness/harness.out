import tempfile, os, json, hashlib, time, datetime, sys, io
import record as R

# Test case: OTS proof is confirmed (not pending)
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))
os.makedirs(os.path.join(d, 'inbox'))

now = 
datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

PLAN = {'by': 'proposer-agent', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}
entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'body': PLAN, 'written_at': 
now}
entry2 = {'seq': 2, 'prev': None, 'kind': 'plan', 'body': {'by': 
'proposer-agent', 'claim': 'test2', 'test': 'test', 'decision_rule': 'test'}, 
'written_at': now}

open(os.path.join(d, 'entries', '000001.json'), 'wb').write(R.canonical(entry1))
e1_hash = hashlib.sha256(R.canonical(entry1)).hexdigest()
entry2['prev'] = e1_hash
open(os.path.join(d, 'entries', '000002.json'), 'wb').write(R.canonical(entry2))

