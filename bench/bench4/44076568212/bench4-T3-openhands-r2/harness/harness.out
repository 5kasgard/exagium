$ cd /workspace/record && python3 -c "
import tempfile, os, json, hashlib, time, datetime, sys, io
import record as R

# Test case: Multiple range heads with different attestation times
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))
os.makedirs(os.path.join(d, 'inbox'))

now = 
datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

# Create 4 entries (2 ranges: 1-2 and 3-4)
PLAN = {'by': 'proposer-agent', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}
entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'body': PLAN, 'written_at': 
now}
entry2 = {'seq': 2, 'prev': None, 'kind': 'plan', 'body': {'by': 
'proposer-agent', 'claim': 'test2', 'test': 'test', 'decision_rule': 'test'}, 
'written_at': now}
entry3 = {'seq': 3, 'prev': None, 'kind': 'plan', 'body': {'by': 
'proposer-agent', 'claim': 'test3', 'test': 'test', 'decision_rule': 'test'}, 
'written_at': now}
entry4 = {'seq': 4, 'prev': None, 'kind': 'plan', 'body': {'by': 
'proposer-agent', 'claim': 'test4', 'test': 'test', 'decision_rule': 'test'}, 
'written_at': now}

open(os.path.join(d, 'entries', '000001.json'), 'wb').write(R.canonical(entry1))
e1_hash = hashlib.sha256(R.canonical(entry1)).hexdigest()
entry2['prev'] = e1_hash
open(os.path.join(d, 'entries', '000002.json'), 'wb').write(R.canonical(entry2))
e2_hash = hashlib.sha256(R.canonical(entry2)).hexdigest()
entry3['prev'] = e2_hash
open(os.path.join(d, 'entries', '000003.json'), 'wb').write(R.canonical(entry3))
e3_hash = hashlib.sha256(R.canonical(entry3)).hexdigest()
entry4['prev'] = e3_hash
open(os.path.join(d, 'entries', '000004.json'), 'wb').write(R.canonical(entry4))

# Create OTS files for range heads 2 and 4
open(os.path.join(d, 'anchors', '000002.ots'), 'wb').write(b'stub')
open(os.path.join(d, 'anchors', '000004.ots'), 'wb').write(b'stub')
# Create sigstore anchors
open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w').write('{}')
open(os.path.join(d, 'anchors', '000004.sigstore.json'), 'w').write('{}')

chain, _ = R.load_chain(d)
print('Chain loaded:', len(chain), 'entries')

old_check_sigstore = R.check_sigstore
old_check_ots = R.check_ots

# Range 1-2: attestation 25h ago (will exceed 24h threshold)
# Range 3-4: attestation 12h ago (within 24h threshold)
attestation_time_old = int(time.time()) - 25 * 3600
attestation_time_new = int(time.time()) - 12 * 3600

call_count = [0]
def stub_check_sigstore(*args):
    seq = args[0].split('/')[-1].split('.')[0]
    if seq == '000002':
        return (attestation_time_old, R.range_predicate(chain, 1, 2), 'c0ffee')
    else:
        return (attestation_time_new, R.range_predicate(chain, 3, 4), 
'deadbeef')

def stub_check_ots(*args):
    return None  # pending

R.check_sigstore = stub_check_sigstore
R.check_ots = stub_check_ots

try:
    # Test with --max-pending-hours 24
    # Range head 2: 25h pending -> should fail
    # Range head 4: 12h pending -> should pass
    rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '24'])
    print('Test (--max-pending-hours 24): rc =', rc)
    # Should fail because range head 2 is pending > 24h
    assert rc == 1, 'Expected rc=1 because range head 2 has been pending for 
25h'
    
    # Test with --max-pending-hours 48
    # Both should pass
    rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '48'])
    print('Test (--max-pending-hours 48): rc =', rc)
    assert rc == 0, 'Expected rc=0 because both range heads are within 48h'
    
    print('All edge case tests passed!')
finally:
    R.check_sigstore = old_check_sigstore
    R.check_ots = old_check_ots

import shutil
shutil.rmtree(d)
"

