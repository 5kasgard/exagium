  new_str: 
    def range_predicate(chain, from_seq, to_seq):
        """What the writer attests: the range of entries one run added, tied to 
the chain on both ends."""
        return {"from_seq": from_seq, "to_seq": to_seq,
                "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None,
"head_sha256": chain[to_seq - 1][1]}
    
    
    def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
        """Validate that an orphan's entries_b64 matches the attested range.
        
        Returns None if the decoded entries exactly match the attested range:
        - there are to_seq - from_seq + 1 entries
        - the first chains from pred["prev_sha256"] (its prev field)
        - each next chains from the previous one's sha256
        - the sha256 of the last one's canonical bytes equals 
pred["head_sha256"]
        
        Otherwise returns a short problem string containing:
        - "range" when the count is wrong
        - "chain" when an entry's prev doesn't link
        - "head" when the last hash doesn't match head_sha256
        """
        entries_b64 = orphan["body"].get("entries_b64", [])
        
        from_seq = pred.get("from_seq")
        to_seq = pred.get("to_seq")
        prev_sha256 = pred.get("prev_sha256")
        head_sha256 = pred.get("head_sha256")
        
        # Validate predicate has required fields
        if from_seq is None or to_seq is None or head_sha256 is None:
            return "predicate missing required fields"
        
        expected_count = to_seq - from_seq + 1
        
        # Check count
        if len(entries_b64) != expected_count:
            return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
        
        # Decode and validate each entry
        prev_hash = prev_sha256
        for i, entry_b64 in enumerate(entries_b64):
            try:
                entry_raw = base64.b64decode(entry_b64, validate=True)
            except ValueError:
                return f"entry {i}: invalid base64"
            
            # Parse the entry
            try:
                entry = parse_canonical(entry_raw, f"orphan entry {i}")
            except Bad as e:
                return f"entry {i}: {e}"
            
            # Check entry structure
            if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
                return f"entry {i}: invalid entry structure"
            
            # Check sequence number
            expected_seq = from_seq + i
            if entry.get("seq") != expected_seq:
                return f"entry {i}: wrong seq, expected {expected_seq}, got 
{entry.get('seq')}"
            
            # Check prev link
            if entry.get("prev") != prev_hash:
                return f"chain: entry {i} prev {entry.get('prev')!r} != expected
{prev_hash!r}"
            
            # Update prev_hash for next iteration
            prev_hash = hashlib.sha256(entry_raw).hexdigest()
        
        # Check final head hash
        if prev_hash != head_sha256:
            return f"head: computed {prev_hash} != expected {head_sha256}"
        
        return None

  kind: "FileEditorAction"

