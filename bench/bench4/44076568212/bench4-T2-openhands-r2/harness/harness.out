import base64, hashlib, json, tempfile, os, shutil
import record as R

# Test: multi-entry orphan with broken chain
print('=== Test: Multi-entry orphan with broken chain ===')
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))

entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': 'test1', 'test': 'test',
'decision_rule': 'test'}}
entry1_raw = R.canonical(entry1)
entry1_hash = hashlib.sha256(entry1_raw).hexdigest()
entry1_b64 = base64.b64encode(entry1_raw).decode()

# entry2 has wrong prev
entry2 = {'seq': 2, 'prev': 'wrong_hash', 'kind': 'verdict', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test2', 'plan': {'seq': 1, 'sha256': 
'wrong_hash'}, 'outcome': 'pass', 'evidence': []}}
entry2_raw = R.canonical(entry2)
entry2_hash = hashlib.sha256(entry2_raw).hexdigest()
entry2_b64 = base64.b64encode(entry2_raw).decode()

orphan_body = {
    'by': 'owner',
    'log_index': 12345,
    'reason': 'run failed after attesting',
    'statement_b64': 
base64.b64encode(b'{\"predicate\":{\"from_seq\":1,\"to_seq\":2,\"prev_sha256\":n
ull,\"head_sha256\":\"' + entry2_hash.encode() + b'\"}}').decode(),
    'entries_b64': [entry1_b64, entry2_b64]
}

with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

import io, contextlib
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print('Ingest rc:', rc)
if rc != 0:
    print('Err:', err.getvalue())

shutil.rmtree(d)
"

