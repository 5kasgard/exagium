     1  #!/usr/bin/env python3
     2  """exagium record: an append-only, hash-chained ledger of plans and 
verdicts, with outside anchors.
     3  
     4  Layout (under --ledger, default ../ledger):
     5    entries/000001.json ...   one entry per file; CI 
(.github/workflows/record.yml) is the only writer
     6    anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of 
the range of entries it added, ending at NNNNNN
     7    anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's 
bytes
     8    inbox/*.json                   proposals {"kind": ..., "body": ...}; 
CI moves them into entries/
     9  
    10  An entry's identity is the sha256 of its stored bytes, which must be 
exactly its RFC 8785 (JCS) form
    11  (no trailing newline). The rules that make Python's json.dumps output 
equal JCS are enforced: ASCII
    12  keys, no floats, integers within +-(2**53-1), no lone surrogates.
    13  
    14  Commands: ingest | verify | head | range | check-anchors | monitor.
    15  Exit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is 
wrong; 2 can't check (missing
    16  library or network); 3 unexpected failure. A failure is never reported 
as a verdict.
    17  """
    18  import argparse, base64, datetime, hashlib, json, os, re, subprocess, 
sys, urllib.error, urllib.request
    19  
    20  MAX_INT = 2**53 - 1
    21  KINDS = ("plan", "verdict", "orphan")
    22  OUTCOMES = ("pass", "fail", "inconclusive")
    23  HEX64 = re.compile(r"[0-9a-f]{64}")
    24  NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")  # who: a plain ASCII 
handle, so "same author" can't hide behind look-alikes
    25  ENTRY_NAME = re.compile(r"([0-9]{6})\.json")
    26  ANCHOR_NAME = re.compile(r"([0-9]{6})\.(sigstore\.json|ots)")
    27  ISSUER = "https://token.actions.githubusercontent.com"
    28  
    29  
    30  class Bad(Exception):
    31      """The data is wrong: exit 1."""
    32  
    33  
    34  class CantCheck(Exception):
    35      """A check couldn't run (missing library, network): exit 2."""
    36  
    37  
    38  # ---------- canonical form ----------
    39  def canonical(obj):
    40      return json.dumps(obj, sort_keys=True, ensure_ascii=False, 
separators=(",", ":"), allow_nan=False).encode("utf-8")
    41  
    42  
    43  def _check_value(v, where):
    44      if isinstance(v, bool) or v is None:
    45          return
    46      if isinstance(v, str):
    47          try:
    48              v.encode("utf-8")
    49          except UnicodeEncodeError:
    50              raise Bad(f"{where}: string holds a lone surrogate")


