   533  def _pages(url):
   534      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   535      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   536      import urllib.parse
   537      base = url.split("?")[0]
   538      out = []
   539      while url:
   540          body, hdrs = _get(url, headers=True)
   541          if body is None:
   542              raise CantCheck(f"404 from {url}")
   543          out.extend(json.loads(body))
   544          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   545          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   546      return out
   547  
   548  
   549  def _refs(repo):
   550      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   551      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   552      api = f"https://api.github.com/repos/{repo}"
   553      refs = {"refs/heads/main"}
   554      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   555      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   556      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   557      activity = _pages(f"{api}/activity?per_page=100")
   558      refs.update(x["ref"] for x in activity if x.get("ref"))
   559      return sorted(refs), activity
