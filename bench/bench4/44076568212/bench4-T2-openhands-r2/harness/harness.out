   406  def check_ots(proof, entry_raw, explorers):
   407      """Returns the earliest Bitcoin block time the proof reaches, or 
None if it's still pending."""
   408      try:
   409          from opentimestamps.core.timestamp import DetachedTimestampFile
   410          from opentimestamps.core.notary import 
BitcoinBlockHeaderAttestation
   411          from opentimestamps.core.serialize import 
StreamDeserializationContext, DeserializationError
   412      except ImportError:
   413          raise CantCheck("opentimestamps isn't installed (pip install 
opentimestamps-client==0.8.0)")
   414      name = os.path.basename(proof)
   415      try:
   416          with open(proof, "rb") as f:
   417              dt = 
DetachedTimestampFile.deserialize(StreamDeserializationContext(f))
   418          atts = list(dt.timestamp.all_attestations())
   419      except (DeserializationError, ValueError, TypeError, EOFError) as 
ex:
   420          raise Bad(f"{name}: malformed proof ({ex})")
   421      if dt.file_digest != hashlib.sha256(entry_raw).digest():
   422          raise Bad(f"{name}: proof is for different bytes")
   423      times = []
   424      for msg, att in atts:
   425          if not isinstance(att, BitcoinBlockHeaderAttestation):
   426              continue
   427          headers = set()
   428          for base in explorers:
   429              bh = _get(f"{base}/block-height/{att.height}")
   430              if bh is None:  # 404: either the block doesn't exist (a 
forged height) or the explorer is behind
   431                  tip = _get(f"{base}/blocks/tip/height")
   432                  if tip is not None and att.height > int(tip):
   433                      raise Bad(f"{name}: claims block {att.height}, 
beyond the chain tip {int(tip)}")
   434                  raise CantCheck(f"{base}: no block at height 
{att.height}")
   435              bh = bh.decode().strip()
   436              hdr = _get(f"{base}/block/{bh}/header")
   437              if hdr is None:
   438                  raise CantCheck(f"{base}: no header for block {bh}")
   439              hdr = bytes.fromhex(hdr.decode().strip())
   440              if 
hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:
   441                  raise CantCheck(f"{base}: header doesn't hash to block 
{bh} (explorer fault)")
   442              headers.add(hdr)
   443          if len(headers) != 1:
   444              raise CantCheck(f"explorers disagree about block 
{att.height}")
   445          hdr = headers.pop()
   446          if hdr[36:68] != msg:
   447              raise Bad(f"{name}: path doesn't reach block {att.height}'s 
merkle root")
   448          times.append(int.from_bytes(hdr[68:72], "little"))
   449      return min(times) if times else None
   450  
