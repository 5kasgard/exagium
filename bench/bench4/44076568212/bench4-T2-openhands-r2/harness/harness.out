   310  def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
   311      """Validate that an orphan's entries_b64 matches the attested range.
   312      
   313      Returns None if the decoded entries exactly match the attested 
range:
   314      - there are to_seq - from_seq + 1 entries
   315      - the first chains from pred["prev_sha256"] (its prev field)
   316      - each next chains from the previous one's sha256
   317      - the sha256 of the last one's canonical bytes equals 
pred["head_sha256"]
   318      
   319      Otherwise returns a short problem string containing:
   320      - "range" when the count is wrong
   321      - "chain" when an entry's prev doesn't link
   322      - "head" when the last hash doesn't match head_sha256
   323      """
   324      entries_b64 = orphan["body"].get("entries_b64", [])
   325      
   326      from_seq = pred.get("from_seq")
   327      to_seq = pred.get("to_seq")
   328      prev_sha256 = pred.get("prev_sha256")
   329      head_sha256 = pred.get("head_sha256")
   330      
   331      # Validate predicate has required fields
   332      if from_seq is None or to_seq is None or head_sha256 is None:
   333          return "predicate missing required fields"
   334      
   335      expected_count = to_seq - from_seq + 1
   336      
   337      # Check count
   338      if len(entries_b64) != expected_count:
   339          return f"range: expected {expected_count} entries, got 
{len(entries_b64)}"
   340      
   341      # Decode and validate each entry
   342      prev_hash = prev_sha256
   343      for i, entry_b64 in enumerate(entries_b64):
   344          try:
   345              entry_raw = base64.b64decode(entry_b64, validate=True)
   346          except ValueError:
   347              return f"entry {i}: invalid base64"
   348          
   349          # Parse the entry
   350          try:
   351              entry = parse_canonical(entry_raw, f"orphan entry {i}")
   352          except Bad as e:
   353              return f"entry {i}: {e}"
   354          
   355          # Check entry structure
   356          if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
   357              return f"entry {i}: invalid entry structure"
   358          
   359          # Check sequence number
   360          expected_seq = from_seq + i
   361          if entry.get("seq") != expected_seq:
   362              return f"entry {i}: wrong seq, expected {expected_seq}, got 
{entry.get('seq')}"
   363          
   364          # Check prev link
   365          if entry.get("prev") != prev_hash:
   366              return f"chain: entry {i} prev {entry.get('prev')!r} != 
expected {prev_hash!r}"
   367          
   368          # Update prev_hash for next iteration
   369          prev_hash = hashlib.sha256(entry_raw).hexdigest()
   370      
   371      # Check final head hash
   372      if prev_hash != head_sha256:
   373          return f"head: computed {prev_hash} != expected {head_sha256}"
   374      
   375      return None


