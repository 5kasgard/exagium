import base64, hashlib, json, tempfile, os, shutil
import record as R

# Now test with a correct orphan (valid entries_b64)
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))

entry = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}}
entry_raw = R.canonical(entry)
entry_hash = hashlib.sha256(entry_raw).hexdigest()
entry_b64 = base64.b64encode(entry_raw).decode()

# Create orphan with correct head_sha256
orphan_body = {
    'by': 'owner',
    'log_index': 12345,
    'reason': 'run failed after attesting',
    'statement_b64': 
base64.b64encode(b'{\"predicate\":{\"from_seq\":1,\"to_seq\":1,\"prev_sha256\":n
ull,\"head_sha256\":\"' + entry_hash.encode() + b'\"}}').decode(),
    'entries_b64': [entry_b64]
}

with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

import io, contextlib
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print('Ingest rc:', rc)

# After ingest, let's load the chain and check the orphan entry
chain, _ = R.load_chain(d)
print('Chain length:', len(chain))
for e, h in chain:
    print('Entry:', e['kind'], 'seq:', e['seq'])
    if e['kind'] == 'orphan':
        print('  statement_b64:', e['body'].get('statement_b64'))
        print('  entries_b64:', e['body'].get('entries_b64'))
        
        # Now check the predicate
        st = base64.b64decode(e['body']['statement_b64']).decode()
        pred = json.loads(st)['predicate']
        print('  predicate:', pred)
        
        # Check _orphan_entries_problem
        result = R._orphan_entries_problem(e, pred)
        print('  _orphan_entries_problem:', result)

shutil.rmtree(d)
"

