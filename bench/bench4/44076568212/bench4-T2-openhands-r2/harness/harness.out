   452  def iso(t):
   453      return datetime.datetime.fromtimestamp(t, 
datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if t else None
   454  
   455  
   456  def cmd_check_anchors(a):
   457      """Every anchor must be right, and the writer's Sigstore ranges must
cover entries 1..head with no gap or overlap.
   458      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
   459      chain, _ = load_chain(a.ledger)
   460      rows, bad, cant, ranges = [], [], [], []
   461      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   462          n = os.path.basename(path)
   463          m = ANCHOR_NAME.fullmatch(n)
   464          seq = int(m.group(1))
   465          try:
   466              if not 1 <= seq <= len(chain):
   467                  raise Bad(f"anchors/{n}: no entry {seq}")
   468              raw = open(os.path.join(a.ledger, "entries", 
f"{seq:06d}.json"), "rb").read()
   469              if m.group(2) == "ots":
   470                  t = check_ots(path, raw, a.explorer)
   471                  rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
