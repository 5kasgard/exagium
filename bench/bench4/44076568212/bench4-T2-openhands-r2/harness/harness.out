'2024-01-01T00:00:00Z', 'body': {'by': 'test2', 'plan': {'seq': 1, 'sha256': 
'wrong_hash'}, 'outcome': 'pass', 'evidence': []}}
entry2_bad_raw = R.canonical(entry2_bad)
entry2_bad_b64 = base64.b64encode(entry2_bad_raw).decode()
orphan_bad = {'body': {'entries_b64': [entry1_b64, entry2_bad_b64]}}
pred_bad = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': 
hashlib.sha256(entry2_bad_raw).hexdigest()}
result_bad = R._orphan_entries_problem(orphan_bad, pred_bad)
print('Multi-entry wrong chain:', result_bad)
"

