'2024-01-01T00:00:00Z', 'body': {'by': 'test2', 'plan': {'seq': 1, 'sha256': 
''}, 'outcome': 'pass', 'evidence': []}}

# Need to set correct prev for entry2
entry1_raw = R.canonical(entry1)
entry1_hash = hashlib.sha256(entry1_raw).hexdigest()
entry2['prev'] = entry1_hash
entry2['body']['plan']['sha256'] = entry1_hash
entry2_raw = R.canonical(entry2)
entry2_hash = hashlib.sha256(entry2_raw).hexdigest()

entry1_b64 = base64.b64encode(entry1_raw).decode()
entry2_b64 = base64.b64encode(entry2_raw).decode()

orphan = {'body': {'entries_b64': [entry1_b64, entry2_b64]}}
pred = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': 
entry2_hash}
result = R._orphan_entries_problem(orphan, pred)
