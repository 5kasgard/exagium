+324|    
+325|    # Decode and validate each entry
+326|    prev_hash = prev_sha256
+327|    for i, entry_b64 in enumerate(entries_b64):
+328|        try:
+329|            entry_raw = base64.b64decode(entry_b64, validate=True)
+330|        except ValueError:
+331|            return f"entry {i}: invalid base64"
+332|        
+333|        # Parse the entry
+334|        try:
+335|            entry = parse_canonical(entry_raw, f"orphan entry {i}")
+336|        except Bad as e:
+337|            return f"entry {i}: {e}"
+338|        
+339|        # Check entry structure
+340|        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", 
"kind", "written_at", "body"}:
+341|            return f"entry {i}: invalid entry structure"
+342|        
+343|        # Check sequence number
+344|        expected_seq = from_seq + i
+345|        if entry.get("seq") != expected_seq:
+346|            return f"entry {i}: wrong seq, expected {expected_seq}, got 
{entry.get('seq')}"
+347|        
+348|        # Check prev link
+349|        if entry.get("prev") != prev_hash:
+350|            return f"chain: entry {i} prev {entry.get('prev')!r} != 
expected {prev_hash!r}"
+351|        
+352|        # Update prev_hash for next iteration
+353|        prev_hash = hashlib.sha256(entry_raw).hexdigest()
+354|    
+355|    # Check final head hash
+356|    if prev_hash != head_sha256:
+357|        return f"head: computed {prev_hash} != expected {head_sha256}"
+358|    
+359|    return None
