$ cd /workspace/record && python3 -c "
import base64, hashlib, json, tempfile, os, shutil
import record as R

# Test: orphan with invalid entries_b64 (non-matching chain)
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))

entry = {'seq': 1, 'prev': None, 'kind': 'plan', 'written_at': 
'2024-01-01T00:00:00Z', 'body': {'by': 'test', 'claim': 'test', 'test': 'test', 
'decision_rule': 'test'}}
entry_raw = R.canonical(entry)
entry_hash = hashlib.sha256(entry_raw).hexdigest()
entry_b64 = base64.b64encode(entry_raw).decode()

# Create orphan with mismatched head_sha256
orphan_body = {
    'by': 'owner',
    'log_index': 12345,
    'reason': 'run failed after attesting',
    'statement_b64': 
base64.b64encode(b'{\"predicate\":{\"from_seq\":1,\"to_seq\":1,\"prev_sha256\":n
ull,\"head_sha256\":\"wrong_hash\"}}').decode(),
    'entries_b64': [entry_b64]
}

with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

import io, contextlib
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print('Ingest rc:', rc)

out2, err2 = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out2), contextlib.redirect_stderr(err2):
    rc = R.main(['--ledger', d, 'verify'])
print('Verify rc:', rc)
if rc != 0:
    print('Err:', err2.getvalue())
else:
    rep = json.loads(out2.getvalue())
    print('Orphans explained:', rep.get('orphans_explained'))

shutil.rmtree(d)
"

