#!/usr/bin/env python3
"""Test the _orphan_entries_problem function."""
import sys
sys.path.insert(0, '/workspace/record')
import record as R
import base64
import hashlib
import json

# Create a simple chain with some entries
chain = []

# Entry 1: a plan
e1 = {
    "seq": 1,
    "prev": None,
    "kind": "plan",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "alice", "claim": "test", "test": "test", "decision_rule": 
"test"}
}
raw1 = R.canonical(e1)
h1 = hashlib.sha256(raw1).hexdigest()
chain.append((e1, h1))

# Entry 2: a verdict
e2 = {
    "seq": 2,
    "prev": h1,
    "kind": "verdict",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "bob", "plan": {"seq": 1, "sha256": h1}, "outcome": "pass", 
"evidence": []}
}
raw2 = R.canonical(e2)
h2 = hashlib.sha256(raw2).hexdigest()
chain.append((e2, h2))

# Entry 3: another plan
e3 = {
    "seq": 3,
    "prev": h2,
    "kind": "plan",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "alice", "claim": "test2", "test": "test", "decision_rule": 
"test"}
}
raw3 = R.canonical(e3)
h3 = hashlib.sha256(raw3).hexdigest()
chain.append((e3, h3))

print("Chain hashes:", [h1, h2, h3])

# Test 1: Correct orphan entries for range 2-3
print("\n=== Test 1: Correct orphan entries for range 2-3 ===")
orphan1 = {
    "body": {
        "entries_b64": [base64.b64encode(raw2).decode(), 
base64.b64encode(raw3).decode()]
    }
}
pred1 = {"from_seq": 2, "to_seq": 3, "prev_sha256": h1, "head_sha256": h3}
result = R._orphan_entries_problem(orphan1, pred1)
print(f"Result: {result}")
assert result is None, "Expected None for correct entries"

# Test 2: Wrong count (range error)
print("\n=== Test 2: Wrong count (range error) ===")
orphan2 = {
    "body": {
        "entries_b64": [base64.b64encode(raw2).decode()]  # Only 1 entry, 
expected 2
    }
}
pred2 = {"from_seq": 2, "to_seq": 3, "prev_sha256": h1, "head_sha256": h3}
result = R._orphan_entries_problem(orphan2, pred2)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test 3: Wrong prev (chain error)
print("\n=== Test 3: Wrong prev (chain error) ===")
