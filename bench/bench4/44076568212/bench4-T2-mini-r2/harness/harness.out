result = R._orphan_entries_problem(orphan6, pred6)
print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected chain error, got: 
{result}"

# Test 7: Entry with wrong structure (not a dict)
print("\n=== Test 7: Entry with wrong structure ===")
orphan7 = {"body": {"entries_b64": [base64.b64encode(b"not a dict").decode()]}}
pred7 = {"from_seq": 2, "to_seq": 2, "prev_sha256": h1, "head_sha256": h2}
result = R._orphan_entries_problem(orphan7, pred7)
print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected chain error, got: 
{result}"

# Test 8: Entry with invalid JSON
