cat <<'EOF' > /tmp/test_orphan_integration.py
#!/usr/bin/env python3
"""Test orphan entries integration with monitor command."""
import sys
import os
import tempfile
import shutil
import json
import base64
import hashlib
import io
import contextlib
sys.path.insert(0, '/workspace/record')
import record as R

def run_cmd(d, *args):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(["--ledger", d, *args])
    return rc, out.getvalue(), err.getvalue()

# Create a temporary ledger
d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, "entries"))
os.makedirs(os.path.join(d, "inbox"))
os.makedirs(os.path.join(d, "anchors"))

try:
    # Create a chain with 3 entries
    # Entry 1: plan
    e1 = {
        "seq": 1,
        "prev": None,
        "kind": "plan",
        "written_at": "2024-01-01T00:00:00Z",
        "body": {"by": "alice", "claim": "test", "test": "test", 
"decision_rule": "test"}
    }
    raw1 = R.canonical(e1)
    h1 = hashlib.sha256(raw1).hexdigest()
    with open(os.path.join(d, "entries", "000001.json"), "wb") as f:
        f.write(raw1)
    
    # Entry 2: verdict
    e2 = {
        "seq": 2,
        "prev": h1,
        "kind": "verdict",
        "written_at": "2024-01-01T00:00:00Z",
        "body": {"by": "bob", "plan": {"seq": 1, "sha256": h1}, "outcome": 
"pass", "evidence": []}
    }
    raw2 = R.canonical(e2)
    h2 = hashlib.sha256(raw2).hexdigest()
    with open(os.path.join(d, "entries", "000002.json"), "wb") as f:
        f.write(raw2)
    
    # Entry 3: plan
    e3 = {
        "seq": 3,
        "prev": h2,
        "kind": "plan",
        "written_at": "2024-01-01T00:00:00Z",
        "body": {"by": "alice", "claim": "test2", "test": "test", 
"decision_rule": "test"}
    }
    raw3 = R.canonical(e3)
    h3 = hashlib.sha256(raw3).hexdigest()
    with open(os.path.join(d, "entries", "000003.json"), "wb") as f:
        f.write(raw3)
    
    print("Chain created with entries 1-3")
    print(f"Hashes: {h1}, {h2}, {h3}")
    
    # Create a statement for an orphan that attests entries 2-3
    predicate = {
        "from_seq": 2,
        "to_seq": 3,
        "prev_sha256": h1,
        "head_sha256": h3
    }
    statement = {"predicate": predicate, "predicateType": 
"https://exagium.example/range"}
    stmt_raw = R.canonical(statement)
    stmt_b64 = base64.b64encode(stmt_raw).decode()
    stmt_hash = hashlib.sha256(stmt_raw).hexdigest()
    
    print(f"Statement hash: {stmt_hash}")
    
    # Test 1: Orphan with correct hidden entries
    print("\n=== Test 1: Orphan with correct hidden entries ===")
    orphan_body = {
        "by": "owner",
        "log_index": 12345,
        "reason": "run failed after attesting",
        "statement_b64": stmt_b64,
        "entries_b64": [base64.b64encode(raw2).decode(), 
base64.b64encode(raw3).decode()]
    }
    orphan_entry = {
        "seq": 4,
        "prev": h3,
        "kind": "orphan",
        "written_at": "2024-01-01T00:00:00Z",
        "body": orphan_body
    }
    orphan_raw = R.canonical(orphan_entry)
    orphan_hash = hashlib.sha256(orphan_raw).hexdigest()
    with open(os.path.join(d, "entries", "000004.json"), "wb") as f:
        f.write(orphan_raw)
    
    # Verify the chain
    rc, out, err = run_cmd(d, "verify")
    print(f"Verify rc: {rc}")
    print(f"Output: {out}")
    if rc != 0:
        print(f"Error: {err}")
    
    # Test 2: Orphan with wrong hidden entries (missing one)
    print("\n=== Test 2: Orphan with wrong hidden entries (wrong count) ===")
    os.remove(os.path.join(d, "entries", "000004.json"))
    orphan_body2 = {
        "by": "owner",
        "log_index": 12346,
        "reason": "run failed after attesting",
        "statement_b64": stmt_b64,
        "entries_b64": [base64.b64encode(raw2).decode()]  # Only 1 entry, 
expected 2
    }
    orphan_entry2 = {
        "seq": 4,
        "prev": h3,
        "kind": "orphan",
        "written_at": "2024-01-01T00:00:00Z",
        "body": orphan_body2
    }
    orphan_raw2 = R.canonical(orphan_entry2)
    with open(os.path.join(d, "entries", "000004.json"), "wb") as f:
        f.write(orphan_raw2)
    
    # Verify the chain (should still pass because verify doesn't check orphans)
    rc, out, err = run_cmd(d, "verify")
    print(f"Verify rc: {rc}")
    rep = json.loads(out)
    print(f"Orphans explained: {rep['orphans_explained']}")
    
    # Test 3: Orphan with correct count but wrong chain
    print("\n=== Test 3: Orphan with wrong chain (wrong prev) ===")
    os.remove(os.path.join(d, "entries", "000004.json"))
    # Create an entry with wrong prev
    bad_e3 = dict(e3)
    bad_e3["prev"] = "0" * 64
    bad_raw3 = R.canonical(bad_e3)
    orphan_body3 = {
        "by": "owner",
        "log_index": 12347,
        "reason": "run failed after attesting",
        "statement_b64": stmt_b64,
        "entries_b64": [base64.b64encode(raw2).decode(), 
base64.b64encode(bad_raw3).decode()]
    }
    orphan_entry3 = {
        "seq": 4,
        "prev": h3,
        "kind": "orphan",
        "written_at": "2024-01-01T00:00:00Z",
        "body": orphan_body3
    }
    orphan_raw3 = R.canonical(orphan_entry3)
    with open(os.path.join(d, "entries", "000004.json"), "wb") as f:
        f.write(orphan_raw3)
    
    rc, out, err = run_cmd(d, "verify")
    print(f"Verify rc: {rc}")
    rep = json.loads(out)
    print(f"Orphans explained: {rep['orphans_explained']}")
    
    print("\n=== Integration tests completed ===")

finally:
    shutil.rmtree(d)
EOF
python3 /tmp/test_orphan_integration.py
