print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected chain error, got: 
{result}"

# Test 4: Wrong head (head error)
print("\n=== Test 4: Wrong head (head error) ===")
orphan4 = {
    "body": {
        "entries_b64": [base64.b64encode(raw2).decode(), 
base64.b64encode(raw3).decode()]
    }
}
pred4 = {"from_seq": 2, "to_seq": 3, "prev_sha256": h1, "head_sha256": "0" * 64}
# Wrong head
result = R._orphan_entries_problem(orphan4, pred4)
print(f"Result: {result}")
assert result is not None and "head" in result, f"Expected head error, got: 
{result}"

# Test 5: Missing entries_b64
print("\n=== Test 5: Missing entries_b64 ===")
