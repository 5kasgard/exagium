pred5 = {"from_seq": 2, "to_seq": 3, "prev_sha256": h1, "head_sha256": h3}
result = R._orphan_entries_problem(orphan5, pred5)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
