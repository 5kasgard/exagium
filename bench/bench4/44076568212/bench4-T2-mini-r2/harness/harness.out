orphan9 = {"body": {"entries_b64": [base64.b64encode(raw2).decode()]}}
pred9 = {"from_seq": 2, "to_seq": 2, "prev_sha256": h1, "head_sha256": h2}
result = R._orphan_entries_problem(orphan9, pred9)
print(f"Result: {result}")
assert result is None, f"Expected None for correct single entry, got: {result}"

# Test 10: Empty range (from > to)
