#!/usr/bin/env python3
"""Test edge cases for _orphan_entries_problem function."""
import sys
sys.path.insert(0, '/workspace/record')
import record as R
import base64
import hashlib
import json

# Create a simple chain with some entries
chain = []
e1 = {
    "seq": 1,
    "prev": None,
    "kind": "plan",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "alice", "claim": "test", "test": "test", "decision_rule": 
"test"}
}
raw1 = R.canonical(e1)
h1 = hashlib.sha256(raw1).hexdigest()
chain.append((e1, h1))

e2 = {
    "seq": 2,
    "prev": h1,
    "kind": "verdict",
    "written_at": "2024-01-01T00:00:00Z",
    "body": {"by": "bob", "plan": {"seq": 1, "sha256": h1}, "outcome": "pass", 
"evidence": []}
}
raw2 = R.canonical(e2)
h2 = hashlib.sha256(raw2).hexdigest()
chain.append((e2, h2))

print("=== Edge Case Tests ===")

# Test: entries_b64 with non-string elements
print("\nTest: entries_b64 with non-string elements")
orphan = {"body": {"entries_b64": [base64.b64encode(raw1).decode(), 123]}}
pred = {"from_seq": 1, "to_seq": 2, "prev_sha256": None, "head_sha256": h2}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected chain error, got: 
{result}"

# Test: Predicate with missing keys
print("\nTest: Predicate with missing keys")
orphan = {"body": {"entries_b64": [base64.b64encode(raw1).decode()]}}
pred = {"from_seq": 1}  # Missing to_seq, prev_sha256, head_sha256
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: Predicate with non-int from_seq/to_seq
print("\nTest: Predicate with non-int from_seq")
orphan = {"body": {"entries_b64": [base64.b64encode(raw1).decode()]}}
pred = {"from_seq": "1", "to_seq": 1, "prev_sha256": None, "head_sha256": h1}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: Empty entries_b64 for empty range (should this be allowed?)
print("\nTest: Empty entries_b64 with from_seq > to_seq (invalid bounds)")
orphan = {"body": {"entries_b64": []}}
pred = {"from_seq": 2, "to_seq": 1, "prev_sha256": h1, "head_sha256": h2}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: Very large range (just checking it doesn't crash)
print("\nTest: Large expected count but small actual count")
orphan = {"body": {"entries_b64": [base64.b64encode(raw1).decode()]}}
pred = {"from_seq": 1, "to_seq": 1000, "prev_sha256": None, "head_sha256": h2}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: Entry missing prev field
print("\nTest: Entry missing prev field")
bad_entry = {"seq": 1, "kind": "plan", "written_at": "2024-01-01T00:00:00Z", 
"body": {"by": "alice", "claim": "test", "test": "test", "decision_rule": 
"test"}}
bad_raw = R.canonical(bad_entry)
orphan = {"body": {"entries_b64": [base64.b64encode(bad_raw).decode()]}}
pred = {"from_seq": 1, "to_seq": 1, "prev_sha256": None, "head_sha256": 
hashlib.sha256(bad_raw).hexdigest()}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
# Note: entry.get("prev") returns None, which matches pred["prev_sha256"] (also 
None)
# So this should actually pass if the hash matches
assert result is None, f"Expected None, got: {result}"

# Test: Entry with prev=None but predicate expects a hash
print("\nTest: Entry with prev=None but predicate expects a hash")
orphan = {"body": {"entries_b64": [base64.b64encode(raw2).decode()]}}  # raw2 
has prev=h1
pred = {"from_seq": 2, "to_seq": 2, "prev_sha256": "0" * 64, "head_sha256": h2}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "chain" in result, f"Expected chain error, got: 
{result}"

# Test: entries_b64 is not a list (e.g., a string)
print("\nTest: entries_b64 is a string")
orphan = {"body": {"entries_b64": "not a list"}}
pred = {"from_seq": 1, "to_seq": 1, "prev_sha256": None, "head_sha256": h1}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: entries_b64 is None
print("\nTest: entries_b64 is None")
orphan = {"body": {"entries_b64": None}}
pred = {"from_seq": 1, "to_seq": 1, "prev_sha256": None, "head_sha256": h1}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: orphan body is None
print("\nTest: orphan body is None")
orphan = {"body": None}
pred = {"from_seq": 1, "to_seq": 1, "prev_sha256": None, "head_sha256": h1}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
{result}"

# Test: orphan is empty dict
print("\nTest: orphan is empty dict")
orphan = {}
pred = {"from_seq": 1, "to_seq": 1, "prev_sha256": None, "head_sha256": h1}
result = R._orphan_entries_problem(orphan, pred)
print(f"Result: {result}")
assert result is not None and "range" in result, f"Expected range error, got: 
