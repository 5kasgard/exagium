{"type":"message_update","usage":{"input":1580,"output":1413,"cacheRead":30688,"cacheWrite":0,"reasoning":135,"totalTokens":33681,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call-ba3c2b1c-2ff2-4b3b-b2f6-426f042c00a8","name":"bash","arguments":{"command":"cd /workspace/record && python3 -c \"\nimport tempfile, os, json, hashlib, time, io, contextlib\nimport record as R\n\n# Create a test ledger with 4 entries (2 ranges)\nd = tempfile.mkdtemp()\nos.makedirs(os.path.join(d, 'entries'))\nos.makedirs(os.path.join(d, 'anchors'))\nos.makedirs(os.path.join(d, 'inbox'))\n\n# Create 4 entries\nchain = []\nPLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py ...', 'decision_rule': 'Ir lower by > 2 SE'}\n\n# Entry 1: plan\ne1 = R.make_entry(chain, 'plan', PLAN, now='2024-01-01T12:00:00Z')\nraw1 = R.canonical(e1)\nopen(os.path.join(d, 'entries', '000001.json'), 'wb').write(raw1)\nchain.append((e1, hashlib.sha256(raw1).hexdigest()))\n\n# Entry 2: verdict for plan 1 (range head 1)\ne2 = R.make_entry(chain, 'verdict', {'by': 'verifier-agent', 'plan': {'seq': 1, 'sha256': chain[0][1]}, 'outcome': 'pass', 'evidence': []}, now='2024-01-01T12:00:00Z')\nraw2 = R.canonical(e2)\nopen(os.path.join(d, 'entries', '000002.json'), 'wb').write(raw2)\nchain.append((e2, hashlib.sha256(raw2).hexdigest()))\n\n# Entry 3: plan 2\ne3 = R.make_entry(chain, 'plan', PLAN, now='2024-01-01T12:00:00Z')\nraw3 = R.canonical(e3)\nopen(os.path.join(d, 'entries', '000003.json'), 'wb').write(raw3)\nchain.append((e3, hashlib.sha256(raw3).hexdigest()))\n\n# Entry 4: verdict for plan 2 (range head 2)\ne4 = R.make_entry(chain, 'verdict', {'by': 'verifier-agent', 'plan': {'seq': 3, 'sha256': chain[2][1]}, 'outcome': 'pass', 'evidence': []}, now='2024-01-01T12:00:00Z')\nraw4 = R.canonical(e4)\nopen(os.path.join(d, 'entries', '000004.json'), 'wb').write(raw4)\nchain.append((e4, hashlib.sha256(raw4).hexdigest()))\n\n# Create sigstore and OTS anchor files for both range heads (entries 2 and 4)\nfor seq in [2, 4]:\n    open(os.path.join(d, 'anchors', f'{seq:06d}.sigstore.json'), 'w').write('{}')\n    open(os.path.join(d, 'anchors', f'{seq:06d}.ots'), 'wb').write(b'stub')\n\n# Stub check_sigstore to return different attestation times for each range head\n# Entry 2: 100 hours ago (old)\n# Entry 4: 10 hours ago (recent)\ndef stub_check_sigstore(path, entry_digest, repo, workflow, ref):\n    seq = int(os.path.basename(path).split('.')[0])\n    if seq == 2:\n        return (int(time.time()) - 100 * 3600, R.range_predicate(chain, 1, 2), 'c0ffee')\n    else:  # seq == 4\n        return (int(time.time()) - 10 * 3600, R.range_predicate(chain, 3, 4), 'deadbeef')\n\ndef stub_check_ots(*args):\n    return None  # both pending\n\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ndef run_cmd(*args):\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, *args])\n    return rc, out.getvalue(), err.getvalue()\n\ntry:\n    # Test with --max-pending-hours=50 (should fail for entry 2, pass for entry 4)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '50')\n    print(f'--max-pending-hours=50: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours=150 (should pass for both)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '150')\n    print(f'--max-pending-hours=150: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""}}}}
