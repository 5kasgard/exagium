ding-hours=50 (should fail, 100 > 50)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '50'])\n    print(f'With --max-pending-hours=50: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours=150 (should pass, 100 < 150)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '150'])\n    print(f'With --max-pending-hours=150: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""},"partialResult":{"content":[{"type":"text","text":"Traceback (most recent call last):\n  File \"<string>\", line 45, in <module>\nTypeError: cannot unpack non-iterable int object\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000002.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-2\",\n   \"existed_by\": \"2026-11-13T08:10:25Z\",\n   \"writer_commit\": \"c0ffee\"\n  }\n ],\n \"entries\": 2,\n \"writer_attested_through\": 2,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_not_check\": []\n}\n"}],"details":{}}}
