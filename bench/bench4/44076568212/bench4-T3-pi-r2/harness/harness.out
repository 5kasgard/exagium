{"type":"tool_execution_end","toolCallId":"call-5b5a7ef3-245b-41a7-bf2e-04e9aff4eefa","toolName":"read","result":{"content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n            ents = _need(body, \"entries_b64\", list, where)\n            if not ents:\n                raise ValueError\n            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n        except (ValueError, TypeError):\n            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, the writer's Sigstore ranges must cover entries 1..head with no gap or overlap,\n    and every range head must have its OpenTimestamps proof.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges, stamped = [], [], [], [], set()\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        if m.group(2) == \"ots\":\n            stamped.add(seq)\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    for lo, hi, commit in sorted(ranges):\n        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n        # was removed (found by Z, 2026-11-06)\n        if hi not in stamped:\n            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _orphan_entries_problem(o, pred):\n    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n    try:\n        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n            return \"its entries don't match the attested range\"\n        prev = pred.get(\"prev_sha256\")\n        for i, raw in enumerate(raws):\n            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n                return \"its entries don't chain from the attested prev_sha256\"\n            if e.get(\"kind\") not in KINDS:\n                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n            prev = hashlib.sha256(raw).hexdigest()\n        if prev != pred.get(\"head_sha256\"):\n            return \"its entries don't hash to the attested head\"\n    except Bad as ex:\n        return f\"its entries are malformed ({ex})\"\n    return None\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            problem = _orphan_entries_problem(o, pred)\n            if problem:\n                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n                continue\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"structuredContent":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n            ents = _need(body, \"entries_b64\", list, where)\n            if not ents:\n                raise ValueError\n            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n        except (ValueError, TypeError):\n            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, the writer's Sigstore ranges must cover entries 1..head with no gap or overlap,\n    and every range head must have its OpenTimestamps proof.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges, stamped = [], [], [], [], set()\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        if m.group(2) == \"ots\":\n            stamped.add(seq)\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    for lo, hi, commit in sorted(ranges):\n        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n        # was removed (found by Z, 2026-11-06)\n        if hi not in stamped:\n            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _orphan_entries_problem(o, pred):\n    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n    try:\n        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n            return \"its entries don't match the attested range\"\n        prev = pred.get(\"prev_sha256\")\n        for i, raw in enumerate(raws):\n            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n                return \"its entries don't chain from the attested prev_sha256\"\n            if e.get(\"kind\") not in KINDS:\n                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n            prev = hashlib.sha256(raw).hexdigest()\n        if prev != pred.get(\"head_sha256\"):\n            return \"its entries don't hash to the attested head\"\n    except Bad as ex:\n        return f\"its entries are malformed ({ex})\"\n    return None\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            problem = _orphan_entries_problem(o, pred)\n            if problem:\n                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n                continue\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"},"isError":false,"durationMs":4}
{"type":"tool_execution_end","toolCallId":"call-e6b31f8f-9100-4b42-a23f-14f5509ef7d3","toolName":"read","result":{"content":[{"type":"text","text":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\", \"entries_b64\": [\"e30=\"]})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_orphans_must_publish_the_hidden_entries(self):\n        # review 3: an orphan explained only by its statement could hide an attested verdict. Now the orphan must carry\n        # the hidden entries, chained from the attested prev and hashing to the attested head.\n        import base64\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        chain, _ = R.load_chain(self.d)\n        hidden = R.make_entry(chain, \"verdict\", {\"by\": \"verifier-agent\", \"plan\": {\"seq\": 1, \"sha256\": chain[0][1]},\n                                                 \"outcome\": \"fail\", \"evidence\": []})\n        raw = R.canonical(hidden)\n        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n        b64 = base64.b64encode(raw).decode()\n        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):\n        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 0. Anchor checks are stubbed here\n        # (CI checks real ones); what's tested is that check-anchors notices the proof is gone.\n        self._two_entries()\n        chain, _ = R.load_chain(self.d)\n        os.makedirs(os.path.join(self.d, \"anchors\"))\n        open(os.path.join(self.d, \"anchors\", \"000002.sigstore.json\"), \"w\").write(\"{}\")\n        stubs = {\"check_sigstore\": lambda *a: (1, R.range_predicate(chain, 1, 2), \"c0ffee\"), \"check_ots\": lambda *a: None}\n        saved = {k: getattr(R, k) for k in stubs}\n        try:\n            for k, f in stubs.items():\n                setattr(R, k, f)\n            rc, _, err = self.run_cmd(\"check-anchors\")\n            self.assertEqual(rc, 1)\n            self.assertIn(\"000002.ots is missing\", err)\n            open(os.path.join(self.d, \"anchors\", \"000002.ots\"), \"wb\").write(b\"stub\")\n            self.assertEqual(self.run_cmd(\"check-anchors\")[0], 0)\n        finally:\n            for k, f in saved.items():\n                setattr(R, k, f)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}],"structuredContent":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\", \"entries_b64\": [\"e30=\"]})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_orphans_must_publish_the_hidden_entries(self):\n        # review 3: an orphan explained only by its statement could hide an attested verdict. Now the orphan must carry\n        # the hidden entries, chained from the attested prev and hashing to the attested head.\n        import base64\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        chain, _ = R.load_chain(self.d)\n        hidden = R.make_entry(chain, \"verdict\", {\"by\": \"verifier-agent\", \"plan\": {\"seq\": 1, \"sha256\": chain[0][1]},\n                                                 \"outcome\": \"fail\", \"evidence\": []})\n        raw = R.canonical(hidden)\n        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n        b64 = base64.b64encode(raw).decode()\n        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):\n        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 0. Anchor checks are stubbed here\n        # (CI checks real ones); what's tested is that check-anchors notices the proof is gone.\n        self._two_entries()\n        chain, _ = R.load_chain(self.d)\n        os.makedirs(os.path.join(self.d, \"anchors\"))\n        open(os.path.join(self.d, \"anchors\", \"000002.sigstore.json\"), \"w\").write(\"{}\")\n        stubs = {\"check_sigstore\": lambda *a: (1, R.range_predicate(chain, 1, 2), \"c0ffee\"), \"check_ots\": lambda *a: None}\n        saved = {k: getattr(R, k) for k in stubs}\n        try:\n            for k, f in stubs.items():\n                setattr(R, k, f)\n            rc, _, err = self.run_cmd(\"check-anchors\")\n            self.assertEqual(rc, 1)\n            self.assertIn(\"000002.ots is missing\", err)\n            open(os.path.join(self.d, \"anchors\", \"000002.ots\"), \"wb\").write(b\"stub\")\n            self.assertEqual(self.run_cmd(\"check-anchors\")[0], 0)\n        finally:\n            for k, f in saved.items():\n                setattr(R, k, f)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"},"isError":false,"durationMs":4}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call-5b5a7ef3-245b-41a7-bf2e-04e9aff4eefa","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n            ents = _need(body, \"entries_b64\", list, where)\n            if not ents:\n                raise ValueError\n            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n        except (ValueError, TypeError):\n            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, the writer's Sigstore ranges must cover entries 1..head with no gap or overlap,\n    and every range head must have its OpenTimestamps proof.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges, stamped = [], [], [], [], set()\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        if m.group(2) == \"ots\":\n            stamped.add(seq)\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    for lo, hi, commit in sorted(ranges):\n        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n        # was removed (found by Z, 2026-11-06)\n        if hi not in stamped:\n            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _orphan_entries_problem(o, pred):\n    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n    try:\n        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n            return \"its entries don't match the attested range\"\n        prev = pred.get(\"prev_sha256\")\n        for i, raw in enumerate(raws):\n            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n                return \"its entries don't chain from the attested prev_sha256\"\n            if e.get(\"kind\") not in KINDS:\n                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n            prev = hashlib.sha256(raw).hexdigest()\n        if prev != pred.get(\"head_sha256\"):\n            return \"its entries don't hash to the attested head\"\n    except Bad as ex:\n        return f\"its entries are malformed ({ex})\"\n    return None\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            problem = _orphan_entries_problem(o, pred)\n            if problem:\n                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n                continue\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call-5b5a7ef3-245b-41a7-bf2e-04e9aff4eefa","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n            ents = _need(body, \"entries_b64\", list, where)\n            if not ents:\n                raise ValueError\n            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n        except (ValueError, TypeError):\n            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, the writer's Sigstore ranges must cover entries 1..head with no gap or overlap,\n    and every range head must have its OpenTimestamps proof.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges, stamped = [], [], [], [], set()\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        if m.group(2) == \"ots\":\n            stamped.add(seq)\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    for lo, hi, commit in sorted(ranges):\n        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n        # was removed (found by Z, 2026-11-06)\n        if hi not in stamped:\n            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _orphan_entries_problem(o, pred):\n    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n    try:\n        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n            return \"its entries don't match the attested range\"\n        prev = pred.get(\"prev_sha256\")\n        for i, raw in enumerate(raws):\n            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n                return \"its entries don't chain from the attested prev_sha256\"\n            if e.get(\"kind\") not in KINDS:\n                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n            prev = hashlib.sha256(raw).hexdigest()\n        if prev != pred.get(\"head_sha256\"):\n            return \"its entries don't hash to the attested head\"\n    except Bad as ex:\n        return f\"its entries are malformed ({ex})\"\n    return None\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            problem = _orphan_entries_problem(o, pred)\n            if problem:\n                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n                continue\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571}}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call-e6b31f8f-9100-4b42-a23f-14f5509ef7d3","toolName":"read","content":[{"type":"text","text":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\", \"entries_b64\": [\"e30=\"]})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_orphans_must_publish_the_hidden_entries(self):\n        # review 3: an orphan explained only by its statement could hide an attested verdict. Now the orphan must carry\n        # the hidden entries, chained from the attested prev and hashing to the attested head.\n        import base64\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        chain, _ = R.load_chain(self.d)\n        hidden = R.make_entry(chain, \"verdict\", {\"by\": \"verifier-agent\", \"plan\": {\"seq\": 1, \"sha256\": chain[0][1]},\n                                                 \"outcome\": \"fail\", \"evidence\": []})\n        raw = R.canonical(hidden)\n        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n        b64 = base64.b64encode(raw).decode()\n        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):\n        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 0. Anchor checks are stubbed here\n        # (CI checks real ones); what's tested is that check-anchors notices the proof is gone.\n        self._two_entries()\n        chain, _ = R.load_chain(self.d)\n        os.makedirs(os.path.join(self.d, \"anchors\"))\n        open(os.path.join(self.d, \"anchors\", \"000002.sigstore.json\"), \"w\").write(\"{}\")\n        stubs = {\"check_sigstore\": lambda *a: (1, R.range_predicate(chain, 1, 2), \"c0ffee\"), \"check_ots\": lambda *a: None}\n        saved = {k: getattr(R, k) for k in stubs}\n        try:\n            for k, f in stubs.items():\n                setattr(R, k, f)\n            rc, _, err = self.run_cmd(\"check-anchors\")\n            self.assertEqual(rc, 1)\n            self.assertIn(\"000002.ots is missing\", err)\n            open(os.path.join(self.d, \"anchors\", \"000002.ots\"), \"wb\").write(b\"stub\")\n            self.assertEqual(self.run_cmd(\"check-anchors\")[0], 0)\n        finally:\n            for k, f in saved.items():\n                setattr(R, k, f)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call-e6b31f8f-9100-4b42-a23f-14f5509ef7d3","toolName":"read","content":[{"type":"text","text":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\", \"entries_b64\": [\"e30=\"]})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_orphans_must_publish_the_hidden_entries(self):\n        # review 3: an orphan explained only by its statement could hide an attested verdict. Now the orphan must carry\n        # the hidden entries, chained from the attested prev and hashing to the attested head.\n        import base64\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        chain, _ = R.load_chain(self.d)\n        hidden = R.make_entry(chain, \"verdict\", {\"by\": \"verifier-agent\", \"plan\": {\"seq\": 1, \"sha256\": chain[0][1]},\n                                                 \"outcome\": \"fail\", \"evidence\": []})\n        raw = R.canonical(hidden)\n        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n        b64 = base64.b64encode(raw).decode()\n        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):\n        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 0. Anchor checks are stubbed here\n        # (CI checks real ones); what's tested is that check-anchors notices the proof is gone.\n        self._two_entries()\n        chain, _ = R.load_chain(self.d)\n        os.makedirs(os.path.join(self.d, \"anchors\"))\n        open(os.path.join(self.d, \"anchors\", \"000002.sigstore.json\"), \"w\").write(\"{}\")\n        stubs = {\"check_sigstore\": lambda *a: (1, R.range_predicate(chain, 1, 2), \"c0ffee\"), \"check_ots\": lambda *a: None}\n        saved = {k: getattr(R, k) for k in stubs}\n        try:\n            for k, f in stubs.items():\n                setattr(R, k, f)\n            rc, _, err = self.run_cmd(\"check-anchors\")\n            self.assertEqual(rc, 1)\n            self.assertIn(\"000002.ots is missing\", err)\n            open(os.path.join(self.d, \"anchors\", \"000002.ots\"), \"wb\").write(b\"stub\")\n            self.assertEqual(self.run_cmd(\"check-anchors\")[0], 0)\n        finally:\n            for k, f in saved.items():\n                setattr(R, k, f)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571}}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Let me start by understanding the codebase and the task. I need to:\n1. Examine the `record/record.py` file to understand the `check-anchors` command\n2. Look at the tests in `record/test_record.py` to understand expected behavior\n3. Add a new `--max-pending-hours H` option to `check-anchors`\n4. Implement the logic to check if pending proofs are older than H hours\n5. Ensure all existing tests still pass\n\nLet me start by reading the files.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Let me start by understanding the codebase and the task. I need to:\\n1. Examine the `record/record.py` file to understand the `check-anchors` command\\n2. Look at the tests in `record/test_record.py` to understand expected behavior\\n3. Add a new `--max-pending-hours H` option to `check-anchors`\\n4. Implement the logic to check if pending proofs are older than H hours\\n5. Ensure all existing tests still pass\\n\\nLet me start by reading the files.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call-5b5a7ef3-245b-41a7-bf2e-04e9aff4eefa","name":"read","arguments":{"path":"/workspace/record/record.py"}},{"type":"toolCall","id":"call-e6b31f8f-9100-4b42-a23f-14f5509ef7d3","name":"read","arguments":{"path":"/workspace/record/test_record.py"}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":1883,"output":170,"cacheRead":0,"cacheWrite":0,"reasoning":111,"totalTokens":2053,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794917232744,"responseId":"gen-1794917232-qIiLxMVXudwo1aEfcDEE","rawStopReason":"tool_calls","durationMs":4819,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call-5b5a7ef3-245b-41a7-bf2e-04e9aff4eefa","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n            ents = _need(body, \"entries_b64\", list, where)\n            if not ents:\n                raise ValueError\n            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n        except (ValueError, TypeError):\n            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, the writer's Sigstore ranges must cover entries 1..head with no gap or overlap,\n    and every range head must have its OpenTimestamps proof.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges, stamped = [], [], [], [], set()\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        if m.group(2) == \"ots\":\n            stamped.add(seq)\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    for lo, hi, commit in sorted(ranges):\n        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n        # was removed (found by Z, 2026-11-06)\n        if hi not in stamped:\n            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _orphan_entries_problem(o, pred):\n    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n    try:\n        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n            return \"its entries don't match the attested range\"\n        prev = pred.get(\"prev_sha256\")\n        for i, raw in enumerate(raws):\n            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n            if not isinstance(e, dict) or e.get(\"seq\") != pred[\"from_seq\"] + i or e.get(\"prev\") != prev:\n                return \"its entries don't chain from the attested prev_sha256\"\n            if e.get(\"kind\") not in KINDS:\n                return f\"hidden entry {e.get('seq')} has an unknown kind\"\n            check_body(e[\"kind\"], e.get(\"body\"), f\"hidden entry {e['seq']}\")\n            prev = hashlib.sha256(raw).hexdigest()\n        if prev != pred.get(\"head_sha256\"):\n            return \"its entries don't hash to the attested head\"\n    except Bad as ex:\n        return f\"its entries are malformed ({ex})\"\n    return None\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    if (_git(a, \"rev-parse\", \"--is-shallow-repository\") or b\"\").strip() != b\"false\":\n        raise CantCheck(\"this clone is shallow or not a git repository; orphan checks need the ledger branch's full history\")\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            problem = _orphan_entries_problem(o, pred)\n            if problem:\n                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n                continue\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571},{"role":"toolResult","toolCallId":"call-e6b31f8f-9100-4b42-a23f-14f5509ef7d3","toolName":"read","content":[{"type":"text","text":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\", \"entries_b64\": [\"e30=\"]})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_orphans_must_publish_the_hidden_entries(self):\n        # review 3: an orphan explained only by its statement could hide an attested verdict. Now the orphan must carry\n        # the hidden entries, chained from the attested prev and hashing to the attested head.\n        import base64\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        chain, _ = R.load_chain(self.d)\n        hidden = R.make_entry(chain, \"verdict\", {\"by\": \"verifier-agent\", \"plan\": {\"seq\": 1, \"sha256\": chain[0][1]},\n                                                 \"outcome\": \"fail\", \"evidence\": []})\n        raw = R.canonical(hidden)\n        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n        b64 = base64.b64encode(raw).decode()\n        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_a_missing_ots_proof_for_a_range_head_is_caught(self):\n        # Z, 2026-11-06: deleting a range head's .ots left every check at exit 0. Anchor checks are stubbed here\n        # (CI checks real ones); what's tested is that check-anchors notices the proof is gone.\n        self._two_entries()\n        chain, _ = R.load_chain(self.d)\n        os.makedirs(os.path.join(self.d, \"anchors\"))\n        open(os.path.join(self.d, \"anchors\", \"000002.sigstore.json\"), \"w\").write(\"{}\")\n        stubs = {\"check_sigstore\": lambda *a: (1, R.range_predicate(chain, 1, 2), \"c0ffee\"), \"check_ots\": lambda *a: None}\n        saved = {k: getattr(R, k) for k in stubs}\n        try:\n            for k, f in stubs.items():\n                setattr(R, k, f)\n            rc, _, err = self.run_cmd(\"check-anchors\")\n            self.assertEqual(rc, 1)\n            self.assertIn(\"000002.ots is missing\", err)\n            open(os.path.join(self.d, \"anchors\", \"000002.ots\"), \"wb\").write(b\"stub\")\n            self.assertEqual(self.run_cmd(\"check-anchors\")[0], 0)\n        finally:\n            for k, f in saved.items():\n                setattr(R, k, f)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}],"isError":false,"durationMs":4,"timestamp":1794917237571}]}
