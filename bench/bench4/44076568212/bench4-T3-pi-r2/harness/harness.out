chors', f'{seq:06d}.ots'), 'wb').write(b'stub')\n\n# Stub check_sigstore to return different attestation times for each range head\n# Entry 2: 100 hours ago (old)\n# Entry 4: 10 hours ago (recent)\ndef stub_check_sigstore(path, entry_digest, repo, workflow, ref):\n    seq = int(os.path.basename(path).split('.')[0])\n    if seq == 2:\n        return (int(time.time()) - 100 * 3600, R.range_predicate(chain, 1, 2), 'c0ffee')\n    else:  # seq == 4\n        return (int(time.time()) - 10 * 3600, R.range_predicate(chain, 3, 4), 'deadbeef')\n\ndef stub_check_ots(*args):\n    return None  # both pending\n\noriginal_check_sigstore = R.check_sigstore\noriginal_check_ots = R.check_ots\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ndef run_cmd(*args):\n    out, err = io.StringIO(), io.StringIO()\n    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n        rc = R.main(['--ledger', d, *args])\n    return rc, out.getvalue(), err.getvalue()\n\ntry:\n    # Test with --max-pending-hours=50 (should fail for entry 2, pass for entry 4)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '50')\n    print(f'--max-pending-hours=50: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours=150 (should pass for both)\n    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '150')\n    print(f'--max-pending-hours=150: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""}}
