= R.check_sigstore\noriginal_check_ots = R.check_ots\n\ndef stub_check_sigstore(*args):\n    return (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')\n\ndef stub_check_ots(*args):\n    return None  # pending\n\nR.check_sigstore = stub_check_sigstore\nR.check_ots = stub_check_ots\n\ntry:\n    # Test without --max-pending-hours (should pass)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors'])\n    print(f'Without --max-pending-hours: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours=50 (should fail, 100 > 50)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '50'])\n    print(f'With --max-pending-hours=50: rc={rc}')\n    print(f'  stderr: {err.strip()}')\n    \n    # Test with --max-pending-hours=150 (should pass, 100 < 150)\n    rc, out, err = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '150'])\n    print(f'With --max-pending-hours=150: rc={rc}')\n    print(f'  stderr: {err.strip()}')\nfinally:\n    R.check_sigstore = original_check_sigstore\n    R.check_ots = original_check_ots\n    import shutil\n    shutil.rmtree(d)\n\""}}],"api":"openai-completions","provider":"openrouter","model":"nvidia/nemotron-3-ultra-550b-a55b:free","usage":{"input":936,"output":934,"cacheRead":26304,"cacheWrite":0,"reasoning":41,"totalTokens":28174,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794917410616,"responseId":"gen-1794917410-ygPXYRrrdA526QqQiQ9q","rawStopReason":"tool_calls","durationMs":14439,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call-3d50b6d4-4663-4340-8e1e-992a6bccd877","toolName":"bash","content":[{"type":"text","text":"Traceback (most recent call last):\n  File \"<string>\", line 45, in <module>\nTypeError: cannot unpack non-iterable int object\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000002.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\