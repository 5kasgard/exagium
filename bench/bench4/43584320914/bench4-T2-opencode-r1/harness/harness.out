missing library is CantCheck.\"\"\"\n     try:\n","filediff":{"file":"/workspace/record/record.py","patch":"Index: /workspace/record/record.py\n===================================================================\n--- /workspace/record/record.py\n+++ /workspace/record/record.py\n@@ -300,8 +300,33 @@\n     return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n             \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n \n \n+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n+    \"\"\"Check that the orphan's hidden entries match the attested range.\n+    Returns None if they match exactly, else a short problem string.\"\"\"\n+    entries_b64 = orphan.get(\"body\", {}).get(\"entries_b64\", [])\n+    from_seq = pred.get(\"from_seq\")\n+    to_seq = pred.get(\"to_seq\")\n+    prev_sha256 = pred.get(\"prev_sha256\")\n+    head_sha256 = pred.get(\"head_sha256\")\n+    if from_seq is None or to_seq is None or head_sha256 is None:\n+        return \"predicate missing fields\"\n+    expected_count = to_seq - from_seq + 1\n+    if len(entries_b64) != expected_count:\n+        return f\"range count {len(entries_b64)} != expected {expected_count}\"\n+    prev = prev_sha256\n+    for i, b64 in enumerate(entries_b64):\n+        raw = base64.b64decode(b64)\n+        e = parse_json(raw, f\"orphan entry {i}\")\n+        if e.get(\"prev\") != prev:\n+            return f\"chain broken at index {i}: prev {e.get('prev')!r} != {prev!r}\"\n+        prev = hashlib.sha256(raw).hexdigest()\n+    if prev != head_sha256:\n+        return f\"head {prev} != {head_sha256}\"\n+    return None\n+\n+\n def check_sigstore(bundle, digest, repo, workflow, ref):\n     \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n     Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n     try:\n","additions":25,"deletions":0},"tr