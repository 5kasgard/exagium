{"type":"step_start","timestamp":1794652182095,"sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","part":{"id":"prt_1d99b164c001R97ss1bOEfuMu0","messageID":"msg_1d99b10e80017d25C2ZtV2GLjG","sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","type":"step-start"}}
{"type":"tool_use","timestamp":1794652183111,"sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","part":{"type":"tool","tool":"read","callID":"call-132d074d-7a66-46ba-a67e-2cd0b8f5f5a4","state":{"status":"completed","input":{"filePath":"/workspace/record/record.py"},"output":"<path>/workspace/record/record.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n3: \n4: Layout (under --ledger, default ../ledger):\n5:   entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n6:   anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n7:   anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n8:   inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n9: \n10: An entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n11: (no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\n12: keys, no floats, integers within +-(2**53-1), no lone surrogates.\n13: \n14: Commands: ingest | verify | head | range | check-anchors | monitor.\n15: Exit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\n16: library or network); 3 unexpected failure. A failure is never reported as a verdict.\n17: \"\"\"\n18: import argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n19: \n20: MAX_INT = 2**53 - 1\n21: KINDS = (\"plan\", \"verdict\", \"orphan\")\n22: OUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\n23: HEX64 = re.compile(r\"[0-9a-f]{64}\")\n24: NAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\n25: ENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\n26: ANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\n27: ISSUER = \"https://token.actions.githubusercontent.com\"\n28: \n29: \n30: class Bad(Exception):\n31:     \"\"\"The data is wrong: exit 1.\"\"\"\n32: \n33: \n34: class CantCheck(Exception):\n35:     \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n36: \n37: \n38: # ---------- canonical form ----------\n39: def canonical(obj):\n40:     return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n41: \n42: \n43: def _check_value(v, where):\n44:     if isinstance(v, bool) or v is None:\n45:         return\n46:     if isinstance(v, str):\n47:         try:\n48:             v.encode(\"utf-8\")\n49:         except UnicodeEncodeError:\n50:             raise Bad(f\"{where}: string holds a lone surrogate\")\n51:         return\n52:     if isinstance(v, int):\n53:         if abs(v) > MAX_INT:\n54:             raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n55:         return\n56:     if isinstance(v, float):\n57:         raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n58:     if isinstance(v, list):\n59:         for i, x in enumerate(v):\n60:             _check_value(x, f\"{where}[{i}]\")\n61:         return\n62:     if isinstance(v, dict):\n63:         for k, x in v.items():\n64:             if not k.isascii():\n65:                 raise Bad(f\"{where}: non-ASCII key {k!r}\")\n66:             _check_value(x, f\"{where}.{k}\")\n67:         return\n68:     raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n69: \n70: \n71: def _no_dup_keys(pairs):\n72:     d = {}\n73:     for k, v in pairs:\n74:         if k in d:\n75:             raise Bad(f\"duplicate key {k!r}\")\n76:         d[k] = v\n77:     return d\n78: \n79: \n80: def _no_constants(c):\n81:     raise Bad(f\"{c} isn't JSON\")\n82: \n83: \n84: def parse_json(raw, where):\n85:     try:\n86:         return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n87:     except (UnicodeDecodeError, ValueError, RecursionError) as e:\n88:         raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n89: \n90: \n91: def parse_canonical(raw, where):\n92:     \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n93:     obj = parse_json(raw, where)\n94:     _check_value(obj, where)\n95:     if canonical(obj) != raw:\n96:         raise Bad(f\"{where}: bytes aren't in canonical form\")\n97:     return obj\n98: \n99: \n100: # ---------- schema ----------\n101: def _need(d, key, typ, where):\n102:     if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n103:         raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n104:     return d[key]\n105: \n106: \n107: def _name(d, where):\n108:     v = _need(d, \"by\", str, where)\n109:     if not NAME.fullmatch(v):\n110:         raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n111:     return v\n112: \n113: \n114: def _check_digests(lst, where):\n115:     if not isinstance(lst, list):\n116:         raise Bad(f\"{where}: must be a list\")\n117:     for i, x in enumerate(lst):\n118:         if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n119:                 or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n120:             raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n121: \n122: \n123: def check_body(kind, body, where):\n124:     if not isinstance(body, dict):\n125:         raise Bad(f\"{where}: body must be an object\")\n126:     _name(body, where)\n127:     if kind == \"plan\":\n128:         allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n129:         for k in (\"claim\", \"test\", \"decision_rule\"):\n130:             if not _need(body, k, str, where).strip():\n131:                 raise Bad(f\"{where}: {k} is empty\")\n132:         if \"inputs\" in body:\n133:             _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n134:         if \"verdict_due\" in body:\n135:             try:\n136:                 ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n137:                     datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n138:             except ValueError:\n139:                 ok = False\n140:             if not ok:\n141:                 raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n142:     elif kind == \"verdict\":\n143:         allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n144:         p = _need(body, \"plan\", dict, where)\n145:         if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n146:                 or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n147:             raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n148:         if body.get(\"outcome\") not in OUTCOMES:\n149:             raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n150:         _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n151:     else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n152:         allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\"}\n153:         if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n154:             raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n155:         try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n156:             base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n157:         except ValueError:\n158:             raise Bad(f\"{where}: statement_b64 must be base64\")\n159:     extra = set(body) - allowed\n160:     if extra:\n161:         raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n162: \n163: \n164: # ---------- the chain ----------\n165: def _listdir(ledger, sub, pattern, what):\n166:     d = os.path.join(ledger, sub)\n167:     if not os.path.exists(d):\n168:         return []\n169:     if os.path.islink(d) or not os.path.isdir(d):\n170:         raise Bad(f\"{sub}/ must be a plain directory\")\n171:     out = []\n172:     for n in sorted(os.listdir(d)):\n173:         p = os.path.join(d, n)\n174:         if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n175:             raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n176:         out.append(p)\n177:     return out\n178: \n179: \n180: def load_chain(ledger):\n181:     \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n182:     chain, plans, verdict_of = [], {}, {}\n183:     for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n184:         name = os.path.basename(path)\n185:         raw = open(path, \"rb\").read()\n186:         e = parse_canonical(raw, name)\n187:         if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n188:             raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n189:         if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n190:             raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n191:         if e[\"prev\"] != (chain[-1][1] if chain else None):\n192:             raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n193:         if e[\"kind\"] not in KINDS:\n194:             raise Bad(f\"{name}: kind must be one of {KINDS}\")\n195:         if not isinstance(e[\"written_at\"], str):\n196:             raise Bad(f\"{name}: written_at must be a string\")\n197:         check_body(e[\"kind\"], e[\"body\"], name)\n198:         h = hashlib.sha256(raw).hexdigest()\n199:         if e[\"kind\"] == \"plan\":\n200:             plans[i] = (h, e[\"body\"][\"by\"])\n201:         elif e[\"kind\"] == \"verdict\":\n202:             ref = e[\"body\"][\"plan\"]\n203:             if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n204:                 raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n205:             if ref[\"seq\"] in verdict_of:\n206:                 raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n207:             if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n208:                 raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n209:             verdict_of[ref[\"seq\"]] = i\n210:         chain.append((e, h))\n211:     return chain, verdict_of\n212: \n213: \n214: def make_entry(chain, kind, body, now=None):\n215:     check_body(kind, body, \"proposal\")\n216:     e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n217:          \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n218:          \"body\": body}\n219:     _check_value(e, \"proposal\")\n220:     return e\n221: \n222: \n223: def cmd_ingest(a):\n224:     \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n225:     Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n226:     chain, _ = load_chain(a.ledger)\n227:     os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n228:     for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n229:         n = os.path.basename(p)\n230:         prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n231:         if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n232:             raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n233:         e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n234:         raw = canonical(e)\n235:         out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n236:         with open(out, \"xb\") as f:\n237:             f.write(raw)\n238:         try:\n239:             load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n240:         except Bad as ex:\n241:             os.remove(out)\n242:             raise Bad(f\"inbox/{n}: {ex}\")\n243:         chain.append((e, hashlib.sha256(raw).hexdigest()))\n244:         os.remove(p)\n245:         print(out, flush=True)\n246:     return 0\n247: \n248: \n249: def cmd_verify(a):\n250:     chain, verdict_of = load_chain(a.ledger)\n251:     today = datetime.date.today().isoformat()\n252:     plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n253:     open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n254:     overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n255:     print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n256:                       \"plans\": len(plans), \"verdicts\": len(verdict_of),\n257:                       \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n258:                       \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n259:     return 0\n260: \n261: \n262: def cmd_head(a):\n263:     chain, _ = load_chain(a.ledger)\n264:     print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n265:     return 0\n266: \n267: \n268: # ---------- anchors ----------\n269: def _get(url, data=None, timeout=20, headers=False):\n270:     req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n271:                                                           \"User-Agent\": \"exagium-record\"})\n272:     try:\n273:         with urllib.request.urlopen(req, timeout=timeout) as r:\n274:             body = r.read()\n275:             return (body, r.headers) if headers else body\n276:     except urllib.error.HTTPError as ex:\n277:         if ex.code == 404:\n278:             return (None, None) if headers else None\n279:         raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n280:     except OSError as ex:\n281:         raise CantCheck(f\"network: {url}: {ex}\")\n282: \n283: \n284: def identity(repo, workflow, ref):\n285:     return f\"https://github.com/{repo}/{workflow}@{ref}\"\n286: \n287: \n288: def range_predicate(chain, from_seq, to_seq):\n289:     \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n290:     return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n291:             \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n292: \n293: \n294: def check_sigstore(bundle, digest, repo, workflow, ref):\n295:     \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n296:     Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n297:     try:\n298:         from sigstore.models import Bundle\n299:         from sigstore.verify import Verifier, policy\n300:         from sigstore.errors import Error as SigstoreError\n301:     except ImportError as ex:\n302:         raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n303:     name = os.path.basename(bundle)\n304:     raw = open(bundle, \"rb\").read()\n305:     pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n306:                         policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n307:     try:\n308:         b = Bundle.from_json(raw)\n309:         ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n310:     except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n311:         raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n312:     except (ValueError, KeyError, TypeError) as ex:\n313:         raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n314:     st = parse_json(payload, f\"{name} payload\")\n315:     if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n316:             [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n317:         raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n318:     try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n319:         t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n320:         from cryptography.x509 import ObjectIdentifier\n321:         commit = b.signing_certificate.extensions.get_extension_for_oid(\n322:             ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n323:     except Exception as ex:\n324:         raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n325:     return t, st.get(\"predicate\"), commit\n326: \n327: \n328: def check_ots(proof, entry_raw, explorers):\n329:     \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n330:     try:\n331:         from opentimestamps.core.timestamp import DetachedTimestampFile\n332:         from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n333:         from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n334:     except ImportError:\n335:         raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n336:     name = os.path.basename(proof)\n337:     try:\n338:         with open(proof, \"rb\") as f:\n339:             dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n340:         atts = list(dt.timestamp.all_attestations())\n341:     except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n342:         raise Bad(f\"{name}: malformed proof ({ex})\")\n343:     if dt.file_digest != hashlib.sha256(entry_raw).digest():\n344:         raise Bad(f\"{name}: proof is for different bytes\")\n345:     times = []\n346:     for msg, att in atts:\n347:         if not isinstance(att, BitcoinBlockHeaderAttestation):\n348:             continue\n349:         headers = set()\n350:         for base in explorers:\n351:             bh = _get(f\"{base}/block-height/{att.height}\")\n352:             if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n353:                 tip = _get(f\"{base}/blocks/tip/height\")\n354:                 if tip is not None and att.height > int(tip):\n355:                     raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n356:                 raise CantCheck(f\"{base}: no block at height {att.height}\")\n357:             bh = bh.decode().strip()\n358:             hdr = _get(f\"{base}/block/{bh}/header\")\n359:             if hdr is None:\n360:                 raise CantCheck(f\"{base}: no header for block {bh}\")\n361:             hdr = bytes.fromhex(hdr.decode().strip())\n362:             if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n363:                 raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n364:             headers.add(hdr)\n365:         if len(headers) != 1:\n366:             raise CantCheck(f\"explorers disagree about block {att.height}\")\n367:         hdr = headers.pop()\n368:         if hdr[36:68] != msg:\n369:             raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n370:         times.append(int.from_bytes(hdr[68:72], \"little\"))\n371:     return min(times) if times else None\n372: \n373: \n374: def iso(t):\n375:     return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n376: \n377: \n378: def cmd_check_anchors(a):\n379:     \"\"\"Every anchor must be right, and the writer's Sigstore ranges must cover entries 1..head with no gap or overlap.\n380:     Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n381:     chain, _ = load_chain(a.ledger)\n382:     rows, bad, cant, ranges = [], [], [], []\n383:     for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n384:         n = os.path.basename(path)\n385:         m = ANCHOR_NAME.fullmatch(n)\n386:         seq = int(m.group(1))\n387:         try:\n388:             if not 1 <= seq <= len(chain):\n389:                 raise Bad(f\"anchors/{n}: no entry {seq}\")\n390:             raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n391:             if m.group(2) == \"ots\":\n392:                 t = check_ots(path, raw, a.explorer)\n393:                 rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n394:             else:\n395:                 t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n396:                 if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n397:                         or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n398:                     raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n399:                 ranges.append((pred[\"from_seq\"], seq, commit))\n400:                 rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n401:                              \"writer_commit\": commit})\n402:         except Bad as ex:\n403:             bad.append(str(ex))\n404:         except CantCheck as ex:\n405:             cant.append(f\"anchors/{n}: {ex}\")\n406:     covered, changes, prev_commit = 0, [], None\n407:     for lo, hi, commit in sorted(ranges):\n408:         if lo != covered + 1:\n409:             bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n410:         covered = max(covered, hi)\n411:         if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n412:             changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n413:                             \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n414:         prev_commit = commit\n415:     if covered < len(chain):\n416:         bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n417:     print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n418:                       \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n419:     for x in bad:\n420:         print(f\"BAD: {x}\", file=sys.stderr)\n421:     for x in cant:\n422:         print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n423:     return 1 if bad else 2 if cant else 0\n424: \n425: \n426: def _git(a, *args):\n427:     root = os.path.dirname(os.path.abspath(a.ledger))\n428:     r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n429:     return r.stdout if r.returncode == 0 else None\n430: \n431: \n432: def _code_changed(a, c1, c2):\n433:     \"\"\"True/False if record.py or the writer workflow differ between two commits; \"unknown\" without that history.\"\"\"\n434:     if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n435:         return \"unknown (commit not in this clone)\"\n436:     root = os.path.dirname(os.path.abspath(a.ledger))\n437:     r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record/record.py\", a.workflow])\n438:     return {0: False, 1: True}.get(r.returncode, \"unknown\")\n439: \n440: \n441: def _published_entry_hashes(a, rev):\n442:     \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n443:     raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n444:     if raw is None:\n445:         raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n446:     blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n447:     out = set()\n448:     for b in blobs:\n449:         data = _git(a, \"cat-file\", \"blob\", b)\n450:         if data is not None:\n451:             out.add(hashlib.sha256(data).hexdigest())\n452:     return out\n453: \n454: \n455: def _pages(url):\n456:     \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n457:     the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n458:     import urllib.parse\n459:     base = url.split(\"?\")[0]\n460:     out = []\n461:     while url:\n462:         body, hdrs = _get(url, headers=True)\n463:         if body is None:\n464:             raise CantCheck(f\"404 from {url}\")\n465:         out.extend(json.loads(body))\n466:         m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n467:         url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n468:     return out\n469: \n470: \n471: def _refs(repo):\n472:     \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n473:     and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n474:     api = f\"https://api.github.com/repos/{repo}\"\n475:     refs = {\"refs/heads/main\"}\n476:     refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n477:     refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n478:     refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n479:     activity = _pages(f\"{api}/activity?per_page=100\")\n480:     refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n481:     return sorted(refs), activity\n482: \n483: \n484: def cmd_monitor(a):\n485:     \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n486:     ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n487:     never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n488:     ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n489:     chain, _ = load_chain(a.ledger)\n490:     current = {h for _, h in chain}\n491:     known, bad = {}, []\n492:     for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n493:         if path.endswith(\".sigstore.json\"):\n494:             try:\n495:                 known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n496:             except (ValueError, KeyError, IndexError, TypeError) as ex:\n497:                 raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n498:     explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n499:     if a.only_ref:\n500:         refs, activity = [a.only_ref], []\n501:     else:\n502:         refs, activity = _refs(a.repo)\n503:         for x in activity:\n504:             if x.get(\"activity_type\") == \"force_push\" and x.get(\"ref\") == a.ledger_ref:\n505:                 bad.append(f\"force push to {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n506:     published = _published_entry_hashes(a, a.git_rev) if explained else set()\n507:     seen, unknown, orphans = set(), [], []\n508:     for ref in refs:\n509:         uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n510:         if uuids is None:\n511:             raise CantCheck(\"Rekor's index returned 404\")\n512:         for u in json.loads(uuids):\n513:             got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n514:             if got is None:\n515:                 raise CantCheck(f\"Rekor lists {u} but won't return it\")\n516:             v = next(iter(json.loads(got).values()))\n517:             idx = int(v[\"logIndex\"])\n518:             seen.add(idx)\n519:             row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n520:             if idx in known:\n521:                 continue\n522:             if idx not in explained:\n523:                 unknown.append(row)\n524:                 continue\n525:             o = explained[idx]\n526:             body = json.loads(base64.b64decode(v[\"body\"]))\n527:             stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n528:             if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n529:                 bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n530:                 continue\n531:             pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n532:             head = pred.get(\"head_sha256\")\n533:             if head in published and head not in current:\n534:                 bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n535:                 continue\n536:             orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n537:     missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n538:     print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n539:                       \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n540:                       \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n541:     for x in bad:\n542:         print(f\"BAD: {x}\", file=sys.stderr)\n543:     return 1 if unknown or missing or bad else 0\n544: \n545: \n546: def cmd_range(a):\n547:     chain, _ = load_chain(a.ledger)\n548:     if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n549:         raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n550:     print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n551:     return 0\n552: \n553: \n554: def main(argv=None):\n555:     here = os.path.dirname(os.path.abspath(__file__))\n556:     ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n557:     ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n558:     sub = ap.add_subparsers(dest=\"cmd\", required=True)\n559:     sub.add_parser(\"ingest\")\n560:     sub.add_parser(\"verify\")\n561:     sub.add_parser(\"head\")\n562:     rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n563:     rp.add_argument(\"from_seq\", type=int)\n564:     rp.add_argument(\"to_seq\", type=int)\n565:     for name in (\"check-anchors\", \"monitor\"):\n566:         p = sub.add_parser(name)\n567:         p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n568:         p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n569:         if name == \"check-anchors\":\n570:             p.add_argument(\"--ref\", default=\"refs/heads/main\")\n571:             p.add_argument(\"--explorer\", action=\"append\", default=None,\n572:                            help=\"esplora API base; default blockstream.info and mempool.space\")\n573:         else:\n574:             p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n575:             p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n576:             p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n577:     a = ap.parse_args(argv)\n578:     if getattr(a, \"explorer\", \"x\") is None:\n579:         a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n580:     fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n581:           \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n582:     try:\n583:         return fn(a)\n584:     except Bad as ex:\n585:         print(f\"BAD: {ex}\", file=sys.stderr)\n586:         return 1\n587:     except CantCheck as ex:\n588:         print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n589:         return 2\n590:     except Exception as ex:  # a failure is never reported as a verdict\n591:         print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n592:         return 3\n593: \n594: \n595: if __name__ == \"__main__\":\n596:     sys.exit(main())\n\n(End of file - total 596 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/record/record.py","text":"#!/usr/bin/env python3\n\"\"\"exagium record: an append-only, hash-chained ledger of plans and verdicts, with outside anchors.\n\nLayout (under --ledger, default ../ledger):\n  entries/000001.json ...   one entry per file; CI (.github/workflows/record.yml) is the only writer\n  anchors/NNNNNN.sigstore.json   Sigstore attestation by the writer of the range of entries it added, ending at NNNNNN\n  anchors/NNNNNN.ots             OpenTimestamps proof of entry NNNNNN's bytes\n  inbox/*.json                   proposals {\"kind\": ..., \"body\": ...}; CI moves them into entries/\n\nAn entry's identity is the sha256 of its stored bytes, which must be exactly its RFC 8785 (JCS) form\n(no trailing newline). The rules that make Python's json.dumps output equal JCS are enforced: ASCII\nkeys, no floats, integers within +-(2**53-1), no lone surrogates.\n\nCommands: ingest | verify | head | range | check-anchors | monitor.\nExit codes: 0 ok; 1 the ledger, an anchor or the monitor's finding is wrong; 2 can't check (missing\nlibrary or network); 3 unexpected failure. A failure is never reported as a verdict.\n\"\"\"\nimport argparse, base64, datetime, hashlib, json, os, re, subprocess, sys, urllib.error, urllib.request\n\nMAX_INT = 2**53 - 1\nKINDS = (\"plan\", \"verdict\", \"orphan\")\nOUTCOMES = (\"pass\", \"fail\", \"inconclusive\")\nHEX64 = re.compile(r\"[0-9a-f]{64}\")\nNAME = re.compile(r\"[a-z0-9][a-z0-9._-]{0,63}\")  # who: a plain ASCII handle, so \"same author\" can't hide behind look-alikes\nENTRY_NAME = re.compile(r\"([0-9]{6})\\.json\")\nANCHOR_NAME = re.compile(r\"([0-9]{6})\\.(sigstore\\.json|ots)\")\nISSUER = \"https://token.actions.githubusercontent.com\"\n\n\nclass Bad(Exception):\n    \"\"\"The data is wrong: exit 1.\"\"\"\n\n\nclass CantCheck(Exception):\n    \"\"\"A check couldn't run (missing library, network): exit 2.\"\"\"\n\n\n# ---------- canonical form ----------\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")\n\n\ndef _check_value(v, where):\n    if isinstance(v, bool) or v is None:\n        return\n    if isinstance(v, str):\n        try:\n            v.encode(\"utf-8\")\n        except UnicodeEncodeError:\n            raise Bad(f\"{where}: string holds a lone surrogate\")\n        return\n    if isinstance(v, int):\n        if abs(v) > MAX_INT:\n            raise Bad(f\"{where}: integer outside +-(2**53-1)\")\n        return\n    if isinstance(v, float):\n        raise Bad(f\"{where}: floats aren't allowed; write numbers with a fraction as strings\")\n    if isinstance(v, list):\n        for i, x in enumerate(v):\n            _check_value(x, f\"{where}[{i}]\")\n        return\n    if isinstance(v, dict):\n        for k, x in v.items():\n            if not k.isascii():\n                raise Bad(f\"{where}: non-ASCII key {k!r}\")\n            _check_value(x, f\"{where}.{k}\")\n        return\n    raise Bad(f\"{where}: unsupported type {type(v).__name__}\")\n\n\ndef _no_dup_keys(pairs):\n    d = {}\n    for k, v in pairs:\n        if k in d:\n            raise Bad(f\"duplicate key {k!r}\")\n        d[k] = v\n    return d\n\n\ndef _no_constants(c):\n    raise Bad(f\"{c} isn't JSON\")\n\n\ndef parse_json(raw, where):\n    try:\n        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n\n\ndef parse_canonical(raw, where):\n    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    obj = parse_json(raw, where)\n    _check_value(obj, where)\n    if canonical(obj) != raw:\n        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    return obj\n\n\n# ---------- schema ----------\ndef _need(d, key, typ, where):\n    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n    return d[key]\n\n\ndef _name(d, where):\n    v = _need(d, \"by\", str, where)\n    if not NAME.fullmatch(v):\n        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n    return v\n\n\ndef _check_digests(lst, where):\n    if not isinstance(lst, list):\n        raise Bad(f\"{where}: must be a list\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n\n\ndef check_body(kind, body, where):\n    if not isinstance(body, dict):\n        raise Bad(f\"{where}: body must be an object\")\n    _name(body, where)\n    if kind == \"plan\":\n        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n        for k in (\"claim\", \"test\", \"decision_rule\"):\n            if not _need(body, k, str, where).strip():\n                raise Bad(f\"{where}: {k} is empty\")\n        if \"inputs\" in body:\n            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n        if \"verdict_due\" in body:\n            try:\n                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n            except ValueError:\n                ok = False\n            if not ok:\n                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n    elif kind == \"verdict\":\n        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n        p = _need(body, \"plan\", dict, where)\n        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n        if body.get(\"outcome\") not in OUTCOMES:\n            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\"}\n        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n        except ValueError:\n            raise Bad(f\"{where}: statement_b64 must be base64\")\n    extra = set(body) - allowed\n    if extra:\n        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n\n\n# ---------- the chain ----------\ndef _listdir(ledger, sub, pattern, what):\n    d = os.path.join(ledger, sub)\n    if not os.path.exists(d):\n        return []\n    if os.path.islink(d) or not os.path.isdir(d):\n        raise Bad(f\"{sub}/ must be a plain directory\")\n    out = []\n    for n in sorted(os.listdir(d)):\n        p = os.path.join(d, n)\n        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n        out.append(p)\n    return out\n\n\ndef load_chain(ledger):\n    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n    chain, plans, verdict_of = [], {}, {}\n    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n        name = os.path.basename(path)\n        raw = open(path, \"rb\").read()\n        e = parse_canonical(raw, name)\n        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            raise Bad(f\"{name}: entry must have exactly seq, prev, kind, written_at, body\")\n        if e[\"seq\"] != i or name != f\"{i:06d}.json\":\n            raise Bad(f\"{name}: seq {e['seq']!r} out of order (expected {i})\")\n        if e[\"prev\"] != (chain[-1][1] if chain else None):\n            raise Bad(f\"{name}: prev doesn't match the previous entry's sha256\")\n        if e[\"kind\"] not in KINDS:\n            raise Bad(f\"{name}: kind must be one of {KINDS}\")\n        if not isinstance(e[\"written_at\"], str):\n            raise Bad(f\"{name}: written_at must be a string\")\n        check_body(e[\"kind\"], e[\"body\"], name)\n        h = hashlib.sha256(raw).hexdigest()\n        if e[\"kind\"] == \"plan\":\n            plans[i] = (h, e[\"body\"][\"by\"])\n        elif e[\"kind\"] == \"verdict\":\n            ref = e[\"body\"][\"plan\"]\n            if ref[\"seq\"] not in plans or plans[ref[\"seq\"]][0] != ref[\"sha256\"]:\n                raise Bad(f\"{name}: verdict refers to no earlier plan with that seq and sha256\")\n            if ref[\"seq\"] in verdict_of:\n                raise Bad(f\"{name}: plan {ref['seq']} already has a verdict (entry {verdict_of[ref['seq']]}); a re-run needs a new plan\")\n            if e[\"body\"][\"by\"] == plans[ref[\"seq\"]][1]:\n                raise Bad(f\"{name}: the verdict's author is the plan's author; a verdict must come from someone else\")\n            verdict_of[ref[\"seq\"]] = i\n        chain.append((e, h))\n    return chain, verdict_of\n\n\ndef make_entry(chain, kind, body, now=None):\n    check_body(kind, body, \"proposal\")\n    e = {\"seq\": len(chain) + 1, \"prev\": chain[-1][1] if chain else None, \"kind\": kind,\n         \"written_at\": now or datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n         \"body\": body}\n    _check_value(e, \"proposal\")\n    return e\n\n\ndef cmd_ingest(a):\n    \"\"\"Move every inbox proposal (in file-name order) into the chain. Used by CI, the only writer.\n    Prints one line per entry as it's written; any bad proposal stops with exit 1 and nothing after it is written.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    os.makedirs(os.path.join(a.ledger, \"entries\"), exist_ok=True)\n    for p in _listdir(a.ledger, \"inbox\", re.compile(r\"[A-Za-z0-9._-]+\\.json\"), \"file in inbox (proposals are NAME.json)\"):\n        n = os.path.basename(p)\n        prop = parse_json(open(p, \"rb\").read(), f\"inbox/{n}\")\n        if not isinstance(prop, dict) or set(prop) != {\"kind\", \"body\"} or prop[\"kind\"] not in KINDS:\n            raise Bad(f\"inbox/{n}: must be {{kind, body}} with kind in {KINDS}\")\n        e = make_entry(chain, prop[\"kind\"], prop[\"body\"])\n        raw = canonical(e)\n        out = os.path.join(a.ledger, \"entries\", f\"{e['seq']:06d}.json\")\n        with open(out, \"xb\") as f:\n            f.write(raw)\n        try:\n            load_chain(a.ledger)  # the new entry must pass every rule, e.g. one verdict per plan\n        except Bad as ex:\n            os.remove(out)\n            raise Bad(f\"inbox/{n}: {ex}\")\n        chain.append((e, hashlib.sha256(raw).hexdigest()))\n        os.remove(p)\n        print(out, flush=True)\n    return 0\n\n\ndef cmd_verify(a):\n    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):\n    \"\"\"Verify offline that a bundle is an attestation of this digest, signed by exactly this workflow on this ref.\n    Returns (integrated_time, predicate). Wrong data is Bad; a missing library is CantCheck.\"\"\"\n    try:\n        from sigstore.models import Bundle\n        from sigstore.verify import Verifier, policy\n        from sigstore.errors import Error as SigstoreError\n    except ImportError as ex:\n        raise CantCheck(f\"sigstore-python isn't usable ({ex}); pip install sigstore==4.5.1 in a virtualenv\")\n    name = os.path.basename(bundle)\n    raw = open(bundle, \"rb\").read()\n    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), issuer=ISSUER),\n                        policy.GitHubWorkflowRepository(repo), policy.GitHubWorkflowRef(ref)])\n    try:\n        b = Bundle.from_json(raw)\n        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)\n    except SigstoreError as ex:   # verification errors and malformed bundles alike: the anchor is wrong\n        raise Bad(f\"{name}: Sigstore verification failed: {ex}\")\n    except (ValueError, KeyError, TypeError) as ex:\n        raise Bad(f\"{name}: malformed bundle ({type(ex).__name__}: {ex})\")\n    st = parse_json(payload, f\"{name} payload\")\n    if ptype != \"application/vnd.in-toto+json\" or not isinstance(st, dict) or \\\n            [s.get(\"digest\", {}).get(\"sha256\") for s in st.get(\"subject\", [])] != [digest]:\n        raise Bad(f\"{name}: the attestation's subject isn't this entry\")\n    try:  # the same bytes the verifier just checked; their signed entry timestamp covers integratedTime\n        t = int(json.loads(raw)[\"verificationMaterial\"][\"tlogEntries\"][0][\"integratedTime\"])\n        from cryptography.x509 import ObjectIdentifier\n        commit = b.signing_certificate.extensions.get_extension_for_oid(\n            ObjectIdentifier(\"1.3.6.1.4.1.57264.1.3\")).value.value.decode(\"ascii\")  # the commit the run was given\n    except Exception as ex:\n        raise Bad(f\"{name}: malformed bundle or certificate ({type(ex).__name__}: {ex})\")\n    return t, st.get(\"predicate\"), commit\n\n\ndef check_ots(proof, entry_raw, explorers):\n    \"\"\"Returns the earliest Bitcoin block time the proof reaches, or None if it's still pending.\"\"\"\n    try:\n        from opentimestamps.core.timestamp import DetachedTimestampFile\n        from opentimestamps.core.notary import BitcoinBlockHeaderAttestation\n        from opentimestamps.core.serialize import StreamDeserializationContext, DeserializationError\n    except ImportError:\n        raise CantCheck(\"opentimestamps isn't installed (pip install opentimestamps-client==0.8.0)\")\n    name = os.path.basename(proof)\n    try:\n        with open(proof, \"rb\") as f:\n            dt = DetachedTimestampFile.deserialize(StreamDeserializationContext(f))\n        atts = list(dt.timestamp.all_attestations())\n    except (DeserializationError, ValueError, TypeError, EOFError) as ex:\n        raise Bad(f\"{name}: malformed proof ({ex})\")\n    if dt.file_digest != hashlib.sha256(entry_raw).digest():\n        raise Bad(f\"{name}: proof is for different bytes\")\n    times = []\n    for msg, att in atts:\n        if not isinstance(att, BitcoinBlockHeaderAttestation):\n            continue\n        headers = set()\n        for base in explorers:\n            bh = _get(f\"{base}/block-height/{att.height}\")\n            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n                tip = _get(f\"{base}/blocks/tip/height\")\n                if tip is not None and att.height > int(tip):\n                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n                raise CantCheck(f\"{base}: no block at height {att.height}\")\n            bh = bh.decode().strip()\n            hdr = _get(f\"{base}/block/{bh}/header\")\n            if hdr is None:\n                raise CantCheck(f\"{base}: no header for block {bh}\")\n            hdr = bytes.fromhex(hdr.decode().strip())\n            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n            headers.add(hdr)\n        if len(headers) != 1:\n            raise CantCheck(f\"explorers disagree about block {att.height}\")\n        hdr = headers.pop()\n        if hdr[36:68] != msg:\n            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n        times.append(int.from_bytes(hdr[68:72], \"little\"))\n    return min(times) if times else None\n\n\ndef iso(t):\n    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n\n\ndef cmd_check_anchors(a):\n    \"\"\"Every anchor must be right, and the writer's Sigstore ranges must cover entries 1..head with no gap or overlap.\n    Checks every anchor even after a failure; exit 1 if anything was wrong, else 2 if anything couldn't be checked.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    rows, bad, cant, ranges = [], [], [], []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        n = os.path.basename(path)\n        m = ANCHOR_NAME.fullmatch(n)\n        seq = int(m.group(1))\n        try:\n            if not 1 <= seq <= len(chain):\n                raise Bad(f\"anchors/{n}: no entry {seq}\")\n            raw = open(os.path.join(a.ledger, \"entries\", f\"{seq:06d}.json\"), \"rb\").read()\n            if m.group(2) == \"ots\":\n                t = check_ots(path, raw, a.explorer)\n                rows.append({\"anchor\": n, \"kind\": \"opentimestamps\", \"existed_by\": iso(t) or \"pending\"})\n            else:\n                t, pred, commit = check_sigstore(path, chain[seq - 1][1], a.repo, a.workflow, a.ref)\n                if not isinstance(pred, dict) or not isinstance(pred.get(\"from_seq\"), int) or pred.get(\"to_seq\") != seq \\\n                        or not 1 <= pred[\"from_seq\"] <= seq or pred != range_predicate(chain, pred[\"from_seq\"], seq):\n                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n                ranges.append((pred[\"from_seq\"], seq, commit))\n                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n                             \"writer_commit\": commit})\n        except Bad as ex:\n            bad.append(str(ex))\n        except CantCheck as ex:\n            cant.append(f\"anchors/{n}: {ex}\")\n    covered, changes, prev_commit = 0, [], None\n    for lo, hi, commit in sorted(ranges):\n        if lo != covered + 1:\n            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n        covered = max(covered, hi)\n        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n        prev_commit = commit\n    if covered < len(chain):\n        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n                      \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    for x in cant:\n        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n    return 1 if bad else 2 if cant else 0\n\n\ndef _git(a, *args):\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n    return r.stdout if r.returncode == 0 else None\n\n\ndef _code_changed(a, c1, c2):\n    \"\"\"True/False if record.py or the writer workflow differ between two commits; \"unknown\" without that history.\"\"\"\n    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n        return \"unknown (commit not in this clone)\"\n    root = os.path.dirname(os.path.abspath(a.ledger))\n    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record/record.py\", a.workflow])\n    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n\n\ndef _published_entry_hashes(a, rev):\n    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n    if raw is None:\n        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n    out = set()\n    for b in blobs:\n        data = _git(a, \"cat-file\", \"blob\", b)\n        if data is not None:\n            out.add(hashlib.sha256(data).hexdigest())\n    return out\n\n\ndef _pages(url):\n    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n    import urllib.parse\n    base = url.split(\"?\")[0]\n    out = []\n    while url:\n        body, hdrs = _get(url, headers=True)\n        if body is None:\n            raise CantCheck(f\"404 from {url}\")\n        out.extend(json.loads(body))\n        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n    return out\n\n\ndef _refs(repo):\n    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n    api = f\"https://api.github.com/repos/{repo}\"\n    refs = {\"refs/heads/main\"}\n    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n    activity = _pages(f\"{api}/activity?per_page=100\")\n    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n    return sorted(refs), activity\n\n\ndef cmd_monitor(a):\n    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n    chain, _ = load_chain(a.ledger)\n    current = {h for _, h in chain}\n    known, bad = {}, []\n    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n        if path.endswith(\".sigstore.json\"):\n            try:\n                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n            except (ValueError, KeyError, IndexError, TypeError) as ex:\n                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n    if a.only_ref:\n        refs, activity = [a.only_ref], []\n    else:\n        refs, activity = _refs(a.repo)\n        for x in activity:\n            if x.get(\"activity_type\") == \"force_push\" and x.get(\"ref\") == a.ledger_ref:\n                bad.append(f\"force push to {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n    seen, unknown, orphans = set(), [], []\n    for ref in refs:\n        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n        if uuids is None:\n            raise CantCheck(\"Rekor's index returned 404\")\n        for u in json.loads(uuids):\n            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n            if got is None:\n                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n            v = next(iter(json.loads(got).values()))\n            idx = int(v[\"logIndex\"])\n            seen.add(idx)\n            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n            if idx in known:\n                continue\n            if idx not in explained:\n                unknown.append(row)\n                continue\n            o = explained[idx]\n            body = json.loads(base64.b64decode(v[\"body\"]))\n            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n                continue\n            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n            head = pred.get(\"head_sha256\")\n            if head in published and head not in current:\n                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n                continue\n            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n    for x in bad:\n        print(f\"BAD: {x}\", file=sys.stderr)\n    return 1 if unknown or missing or bad else 0\n\n\ndef cmd_range(a):\n    chain, _ = load_chain(a.ledger)\n    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n    return 0\n\n\ndef main(argv=None):\n    here = os.path.dirname(os.path.abspath(__file__))\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    sub.add_parser(\"ingest\")\n    sub.add_parser(\"verify\")\n    sub.add_parser(\"head\")\n    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n    rp.add_argument(\"from_seq\", type=int)\n    rp.add_argument(\"to_seq\", type=int)\n    for name in (\"check-anchors\", \"monitor\"):\n        p = sub.add_parser(name)\n        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n        if name == \"check-anchors\":\n            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n            p.add_argument(\"--explorer\", action=\"append\", default=None,\n                           help=\"esplora API base; default blockstream.info and mempool.space\")\n        else:\n            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n    a = ap.parse_args(argv)\n    if getattr(a, \"explorer\", \"x\") is None:\n        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n    try:\n        return fn(a)\n    except Bad as ex:\n        print(f\"BAD: {ex}\", file=sys.stderr)\n        return 1\n    except CantCheck as ex:\n        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n        return 2\n    except Exception as ex:  # a failure is never reported as a verdict\n        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n        return 3\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":596,"totalLines":596,"truncated":false}},"title":"workspace/record/record.py","time":{"start":1794652183097,"end":1794652183108}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me start by understanding the task. I need to:\n1. Look at the record.py file to understand the structure\n2. Look at the test file to understand existing tests\n3. Implement the `_orphan_entries_problem` function\n4. Wire it into wherever orphans are checked\n5. Run tests to ensure they pass\n\nLet me start by reading the relevant files.","format":"unknown","index":0}]}},"id":"prt_1d99b1a33001ySMTKx6Tz6leND","sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","messageID":"msg_1d99b10e80017d25C2ZtV2GLjG"}}
{"type":"tool_use","timestamp":1794652183803,"sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","part":{"type":"tool","tool":"read","callID":"call-e37e3e3d-ddc9-46f5-9cd0-763bbd1d95fb","state":{"status":"completed","input":{"filePath":"/workspace/record/test_record.py"},"output":"<path>/workspace/record/test_record.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\n2: import io, json, os, shutil, tempfile, unittest, contextlib, hashlib\n3: import record as R\n4: \n5: PLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n6: \n7: \n8: class Ledger(unittest.TestCase):\n9:     def setUp(self):\n10:         self.d = tempfile.mkdtemp()\n11:         os.makedirs(os.path.join(self.d, \"inbox\"))\n12: \n13:     def tearDown(self):\n14:         shutil.rmtree(self.d)\n15: \n16:     def run_cmd(self, *args):\n17:         out, err = io.StringIO(), io.StringIO()\n18:         with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n19:             rc = R.main([\"--ledger\", self.d, *args])\n20:         return rc, out.getvalue(), err.getvalue()\n21: \n22:     def propose(self, name, kind, body):\n23:         with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n24:             json.dump({\"kind\": kind, \"body\": body}, f)\n25: \n26:     def entry(self, n):\n27:         return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n28: \n29:     def plan_ref(self, n):\n30:         return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n31: \n32:     def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n33:         return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n34: \n35:     def test_plan_then_verdict_chains_and_verifies(self):\n36:         self.propose(\"a.json\", \"plan\", PLAN)\n37:         self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n38:         self.propose(\"b.json\", \"verdict\", self.verdict(1))\n39:         self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n40:         rc, out, _ = self.run_cmd(\"verify\")\n41:         self.assertEqual(rc, 0)\n42:         rep = json.loads(out)\n43:         self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n44:         e2 = json.load(open(self.entry(2)))\n45:         self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n46:         self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n47: \n48:     def test_open_and_overdue_plans_are_reported(self):\n49:         self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n50:         self.propose(\"b.json\", \"plan\", PLAN)\n51:         self.run_cmd(\"ingest\")\n52:         rep = json.loads(self.run_cmd(\"verify\")[1])\n53:         self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n54: \n55:     def _two_entries(self):\n56:         self.propose(\"a.json\", \"plan\", PLAN)\n57:         self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n58:         self.run_cmd(\"ingest\")\n59: \n60:     def test_edited_entry_breaks_the_chain(self):\n61:         self._two_entries()\n62:         raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n63:         open(self.entry(1), \"wb\").write(raw)\n64:         rc, _, err = self.run_cmd(\"verify\")\n65:         self.assertEqual(rc, 1)\n66:         self.assertIn(\"prev doesn't match\", err)\n67: \n68:     def test_dropped_entry_is_caught(self):\n69:         self._two_entries()\n70:         os.remove(self.entry(1))\n71:         self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n72: \n73:     def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n74:         # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n75:         # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n76:         self._two_entries()\n77:         e2 = json.load(open(self.entry(2)))\n78:         os.remove(self.entry(1)); os.remove(self.entry(2))\n79:         e2.update(seq=1, prev=None)\n80:         open(self.entry(1), \"wb\").write(R.canonical(e2))\n81:         self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n82: \n83:     def test_non_canonical_bytes_are_refused(self):\n84:         self._two_entries()\n85:         e = json.load(open(self.entry(2)))\n86:         open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n87:         rc, _, err = self.run_cmd(\"verify\")\n88:         self.assertEqual(rc, 1)\n89:         self.assertIn(\"canonical\", err)\n90: \n91:     def test_duplicate_keys_are_refused(self):\n92:         self._two_entries()\n93:         raw = open(self.entry(2), \"rb\").read()\n94:         open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n95:         rc, _, err = self.run_cmd(\"verify\")\n96:         self.assertEqual(rc, 1)\n97:         self.assertIn(\"duplicate key\", err)\n98: \n99:     def test_floats_are_refused(self):\n100:         self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n101:         rc, _, err = self.run_cmd(\"ingest\")\n102:         self.assertEqual(rc, 1)\n103:         self.assertIn(\"float\", err)\n104:         self.assertFalse(os.path.exists(self.entry(1)))\n105: \n106:     def test_one_verdict_per_plan(self):\n107:         self.propose(\"a.json\", \"plan\", PLAN)\n108:         self.run_cmd(\"ingest\")\n109:         self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n110:         self.run_cmd(\"ingest\")\n111:         self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n112:         rc, _, err = self.run_cmd(\"ingest\")\n113:         self.assertEqual(rc, 1)\n114:         self.assertIn(\"already has a verdict\", err)\n115:         self.assertFalse(os.path.exists(self.entry(3)))\n116:         self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n117: \n118:     def test_verdict_must_come_from_someone_else(self):\n119:         self.propose(\"a.json\", \"plan\", PLAN)\n120:         self.run_cmd(\"ingest\")\n121:         self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n122:         rc, _, err = self.run_cmd(\"ingest\")\n123:         self.assertEqual(rc, 1)\n124:         self.assertIn(\"someone else\", err)\n125:         # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n126:         for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n127:             os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n128:             self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n129:             rc, _, err = self.run_cmd(\"ingest\")\n130:             self.assertEqual(rc, 1, alias)\n131:             self.assertIn(\"handle\", err)\n132: \n133:     def test_verdict_must_name_the_plan_by_hash(self):\n134:         self.propose(\"a.json\", \"plan\", PLAN)\n135:         self.run_cmd(\"ingest\")\n136:         v = self.verdict(1)\n137:         v[\"plan\"][\"sha256\"] = \"0\" * 64\n138:         self.propose(\"b.json\", \"verdict\", v)\n139:         self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n140: \n141:     def test_canonical_form_matches_jcs_rules(self):\n142:         # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n143:         obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n144:         self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n145:         with self.assertRaises(R.Bad):\n146:             R._check_value({\"x\": 2**53}, \"t\")\n147:         with self.assertRaises(R.Bad):\n148:             R._check_value({\"é\": 1}, \"t\")\n149: \n150:     def test_canonical_form_is_rfc8785(self):\n151:         try:\n152:             import rfc8785\n153:         except ImportError:\n154:             self.skipTest(\"rfc8785 not installed\")\n155:         import random\n156:         rnd = random.Random(7)\n157:         chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n158:         def s():\n159:             return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n160:         def v(d=0):\n161:             t = rnd.randint(0, 5 if d < 3 else 2)\n162:             return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n163:                     lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n164:                     lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n165:         for _ in range(3000):\n166:             o = {\"x\": v(), \"y\": v()}\n167:             self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n168: \n169:     def test_wrong_data_exits_1_not_3(self):\n170:         # review 1: these used to crash (exit 3) instead of being reported as wrong data\n171:         self.propose(\"a.json\", \"plan\", PLAN)\n172:         self.run_cmd(\"ingest\")\n173:         raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n174:         open(self.entry(1), \"wb\").write(raw)\n175:         self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n176:         os.remove(self.entry(1))\n177:         os.makedirs(self.entry(1))\n178:         self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n179: \n180:     def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n181:         self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n182:         self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n183:         os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n184:         open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n185:         self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n186: \n187:     def test_orphan_entries_explain_attestations(self):\n188:         self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n189:                                             \"statement_b64\": \"e30=\"})\n190:         self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n191:         self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n192: \n193:     def test_range_predicate_ties_both_ends(self):\n194:         self._two_entries()\n195:         rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n196:         p = json.loads(out)\n197:         self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n198:         self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n199: \n200:     def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n201:         # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n202:         self._two_entries()\n203:         rc, out, err = self.run_cmd(\"check-anchors\")\n204:         self.assertEqual(rc, 1)\n205:         self.assertIn(\"never attested by the writer\", err)\n206: \n207:     def test_unknown_files_and_fields_are_refused(self):\n208:         self._two_entries()\n209:         open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n210:         self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n211:         os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n212:         self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n213:         self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n214: \n215: \n216: if __name__ == \"__main__\":\n217:     unittest.main()\n\n(End of file - total 217 lines)\n</content>","metadata":{"preview":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/record/test_record.py","text":"\"\"\"Tests for record.py's ledger rules (offline; anchors are tested in CI).\"\"\"\nimport io, json, os, shutil, tempfile, unittest, contextlib, hashlib\nimport record as R\n\nPLAN = {\"by\": \"proposer-agent\", \"claim\": \"mlp beats linear\", \"test\": \"count.py ...\", \"decision_rule\": \"Ir lower by > 2 SE\"}\n\n\nclass Ledger(unittest.TestCase):\n    def setUp(self):\n        self.d = tempfile.mkdtemp()\n        os.makedirs(os.path.join(self.d, \"inbox\"))\n\n    def tearDown(self):\n        shutil.rmtree(self.d)\n\n    def run_cmd(self, *args):\n        out, err = io.StringIO(), io.StringIO()\n        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\n            rc = R.main([\"--ledger\", self.d, *args])\n        return rc, out.getvalue(), err.getvalue()\n\n    def propose(self, name, kind, body):\n        with open(os.path.join(self.d, \"inbox\", name), \"w\") as f:\n            json.dump({\"kind\": kind, \"body\": body}, f)\n\n    def entry(self, n):\n        return os.path.join(self.d, \"entries\", f\"{n:06d}.json\")\n\n    def plan_ref(self, n):\n        return {\"seq\": n, \"sha256\": hashlib.sha256(open(self.entry(n), \"rb\").read()).hexdigest()}\n\n    def verdict(self, n, by=\"verifier-agent\", outcome=\"pass\"):\n        return {\"by\": by, \"plan\": self.plan_ref(n), \"outcome\": outcome, \"evidence\": []}\n\n    def test_plan_then_verdict_chains_and_verifies(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.propose(\"b.json\", \"verdict\", self.verdict(1))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        rc, out, _ = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 0)\n        rep = json.loads(out)\n        self.assertEqual((rep[\"entries\"], rep[\"verdicts\"], rep[\"open_plans\"]), (2, 1, []))\n        e2 = json.load(open(self.entry(2)))\n        self.assertEqual(e2[\"prev\"], self.plan_ref(1)[\"sha256\"])\n        self.assertEqual(os.listdir(os.path.join(self.d, \"inbox\")), [])\n\n    def test_open_and_overdue_plans_are_reported(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2000-01-01\"))\n        self.propose(\"b.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        rep = json.loads(self.run_cmd(\"verify\")[1])\n        self.assertEqual((rep[\"open_plans\"], rep[\"overdue_plans\"]), ([1, 2], [1]))\n\n    def _two_entries(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.propose(\"b.json\", \"plan\", dict(PLAN, claim=\"second\"))\n        self.run_cmd(\"ingest\")\n\n    def test_edited_entry_breaks_the_chain(self):\n        self._two_entries()\n        raw = open(self.entry(1), \"rb\").read().replace(b\"mlp beats linear\", b\"mlp beats linea!\")\n        open(self.entry(1), \"wb\").write(raw)\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"prev doesn't match\", err)\n\n    def test_dropped_entry_is_caught(self):\n        self._two_entries()\n        os.remove(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_dropped_entry_with_rewritten_chain_is_only_caught_by_anchors(self):\n        # Removing entry 1 and rebuilding entry 2 as a fresh first entry gives a valid chain:\n        # the chain alone can't show a missing record. That's what anchors and the monitor are for.\n        self._two_entries()\n        e2 = json.load(open(self.entry(2)))\n        os.remove(self.entry(1)); os.remove(self.entry(2))\n        e2.update(seq=1, prev=None)\n        open(self.entry(1), \"wb\").write(R.canonical(e2))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 0)\n\n    def test_non_canonical_bytes_are_refused(self):\n        self._two_entries()\n        e = json.load(open(self.entry(2)))\n        open(self.entry(2), \"w\").write(json.dumps(e, indent=1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"canonical\", err)\n\n    def test_duplicate_keys_are_refused(self):\n        self._two_entries()\n        raw = open(self.entry(2), \"rb\").read()\n        open(self.entry(2), \"wb\").write(raw.replace(b'{\"body\":{', b'{\"body\":{\"by\":\"x\",', 1))\n        rc, _, err = self.run_cmd(\"verify\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"duplicate key\", err)\n\n    def test_floats_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, notes=1.5))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"float\", err)\n        self.assertFalse(os.path.exists(self.entry(1)))\n\n    def test_one_verdict_per_plan(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, outcome=\"fail\"))\n        self.run_cmd(\"ingest\")\n        self.propose(\"c.json\", \"verdict\", self.verdict(1, outcome=\"pass\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"already has a verdict\", err)\n        self.assertFalse(os.path.exists(self.entry(3)))\n        self.assertTrue(os.path.exists(os.path.join(self.d, \"inbox\", \"c.json\")))\n\n    def test_verdict_must_come_from_someone_else(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        self.propose(\"b.json\", \"verdict\", self.verdict(1, by=\"proposer-agent\"))\n        rc, _, err = self.run_cmd(\"ingest\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"someone else\", err)\n        # look-alike names can't dodge the rule: names are plain lowercase ASCII handles\n        for alias in (\"Proposer-Agent\", \"proposer-agent\\u200b\", \"proposer-agent \"):\n            os.remove(os.path.join(self.d, \"inbox\", \"b.json\"))\n            self.propose(\"b.json\", \"verdict\", self.verdict(1, by=alias))\n            rc, _, err = self.run_cmd(\"ingest\")\n            self.assertEqual(rc, 1, alias)\n            self.assertIn(\"handle\", err)\n\n    def test_verdict_must_name_the_plan_by_hash(self):\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        v = self.verdict(1)\n        v[\"plan\"][\"sha256\"] = \"0\" * 64\n        self.propose(\"b.json\", \"verdict\", v)\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_canonical_form_matches_jcs_rules(self):\n        # Sorted keys, no spaces, UTF-8 unescaped, control chars escaped: the JCS output for these values.\n        obj = {\"b\": \"é\\n\\u0001\", \"a\": [1, True, None], \"A\": -9007199254740991}\n        self.assertEqual(R.canonical(obj), b'{\"A\":-9007199254740991,\"a\":[1,true,null],\"b\":\"\\xc3\\xa9\\\\n\\\\u0001\"}')\n        with self.assertRaises(R.Bad):\n            R._check_value({\"x\": 2**53}, \"t\")\n        with self.assertRaises(R.Bad):\n            R._check_value({\"é\": 1}, \"t\")\n\n    def test_canonical_form_is_rfc8785(self):\n        try:\n            import rfc8785\n        except ImportError:\n            self.skipTest(\"rfc8785 not installed\")\n        import random\n        rnd = random.Random(7)\n        chars = 'aZ0 \"\\\\\\n\\t\\b\\f\\r\\x01\\x1f\\x7fé€\\U0001f600 /'\n        def s():\n            return \"\".join(rnd.choice(chars) for _ in range(rnd.randint(0, 6)))\n        def v(d=0):\n            t = rnd.randint(0, 5 if d < 3 else 2)\n            return [lambda: rnd.randint(-R.MAX_INT, R.MAX_INT), s, lambda: rnd.choice([True, False, None]),\n                    lambda: [v(d + 1) for _ in range(rnd.randint(0, 3))],\n                    lambda: {\"k\" + s().encode(\"ascii\", \"ignore\").decode(): v(d + 1) for _ in range(rnd.randint(0, 3))}, s][t]()\n        for _ in range(3000):\n            o = {\"x\": v(), \"y\": v()}\n            self.assertEqual(R.canonical(o), rfc8785.dumps(o))\n\n    def test_wrong_data_exits_1_not_3(self):\n        # review 1: these used to crash (exit 3) instead of being reported as wrong data\n        self.propose(\"a.json\", \"plan\", PLAN)\n        self.run_cmd(\"ingest\")\n        raw = open(self.entry(1), \"rb\").read().replace(b'\"claim\":\"mlp beats linear\"', b'\"claim\":\"\\\\ud800\"')\n        open(self.entry(1), \"wb\").write(raw)\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(self.entry(1))\n        os.makedirs(self.entry(1))\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n\n    def test_bogus_due_date_and_stray_inbox_files_are_refused(self):\n        self.propose(\"a.json\", \"plan\", dict(PLAN, verdict_due=\"2026-99-99\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n        os.remove(os.path.join(self.d, \"inbox\", \"a.json\"))\n        open(os.path.join(self.d, \"inbox\", \"a.txt\"), \"w\").write(\"{}\")\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n    def test_orphan_entries_explain_attestations(self):\n        self.propose(\"a.json\", \"orphan\", {\"by\": \"owner\", \"log_index\": 12345, \"reason\": \"run failed after attesting\",\n                                            \"statement_b64\": \"e30=\"})\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 0)\n        self.assertEqual(json.loads(self.run_cmd(\"verify\")[1])[\"orphans_explained\"], 1)\n\n    def test_range_predicate_ties_both_ends(self):\n        self._two_entries()\n        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n        p = json.loads(out)\n        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n\n    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n        self._two_entries()\n        rc, out, err = self.run_cmd(\"check-anchors\")\n        self.assertEqual(rc, 1)\n        self.assertIn(\"never attested by the writer\", err)\n\n    def test_unknown_files_and_fields_are_refused(self):\n        self._two_entries()\n        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n        self.propose(\"c.json\", \"plan\", dict(PLAN, secret=\"x\"))\n        self.assertEqual(self.run_cmd(\"ingest\")[0], 1)\n\n\nif __name__ == \"__main__\":\n    unittest.main()","lineStart":1,"lineEnd":217,"totalLines":217,"truncated":false}},"title":"workspace/record/test_record.py","time":{"start":1794652183785,"end":1794652183791}},"id":"prt_1d99b1ce6001aNchgOGShtHbFg","sessionID":"ses_e2664f1aeffe9y62wg3QJH9bd4","messageID":"msg_1d99b10e80017d25C2ZtV2GLjG"}}
