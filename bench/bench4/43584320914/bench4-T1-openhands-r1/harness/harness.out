   485  def _pages(url):
   486      """Follow GitHub's Link: rel="next" (works for page= and the 
cursor-paged activity API). The next link may name
   487      the repo by numeric id; keep the original /repos/owner/name path and
take only the query from it."""
   488      import urllib.parse
   489      base = url.split("?")[0]
   490      out = []
   491      while url:
   492          body, hdrs = _get(url, headers=True)
   493          if body is None:
   494              raise CantCheck(f"404 from {url}")
   495          out.extend(json.loads(body))
   496          m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if 
hdrs else None) or "")
   497          url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m 
else None
   498      return out
