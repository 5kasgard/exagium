b'"pass"')).decode()
   207          self.assertIn("head", R._orphan_entries_problem({"body": 
{"entries_b64": [other]}}, pred))
   208          self.assertIn("range", R._orphan_entries_problem({"body": 
{"entries_b64": [b64, b64]}}, pred))
   209          self.assertIn("chain", R._orphan_entries_problem({"body": 
{"entries_b64": [b64]}}, dict(pred, prev_sha256="0" * 64)))
