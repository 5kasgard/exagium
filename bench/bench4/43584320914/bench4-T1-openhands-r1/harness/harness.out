   196          import base64
   197          self.propose("a.json", "plan", PLAN)
   198          self.run_cmd("ingest")
   199          chain, _ = R.load_chain(self.d)
   200          hidden = R.make_entry(chain, "verdict", {"by": "verifier-agent",
"plan": {"seq": 1, "sha256": chain[0][1]},
   201                                                   "outcome": "fail", 
"evidence": []})
   202          raw = R.canonical(hidden)
   203          pred = {"from_seq": 2, "to_seq": 2, "prev_sha256": chain[0][1], 
"head_sha256": hashlib.sha256(raw).hexdigest()}
   204          b64 = base64.b64encode(raw).decode()
   205          self.assertIsNone(R._orphan_entries_problem({"body": 
{"entries_b64": [b64]}}, pred))
