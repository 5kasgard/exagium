   431  def _git(a, *args):
   432      root = os.path.dirname(os.path.abspath(a.ledger))
   433      r = subprocess.run(["git", "-C", root, *args], capture_output=True)
   434      return r.stdout if r.returncode == 0 else None
   435  
   436  
   437  def _code_changed(a, c1, c2):
   438      """True/False if anything under record/ or .github/ differs between 
two commits; "unknown" without that history."""
   439      if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
   440          return "unknown (commit not in this clone)"
   441      root = os.path.dirname(os.path.abspath(a.ledger))
   442      r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, 
"--", "record", ".github"])
   443      return {0: False, 1: True}.get(r.returncode, "unknown")
   444  
