$ cd /workspace/record && python3 -c "
import os, shutil, tempfile, sys
from unittest.mock import patch
sys.path.insert(0, '.')
import record as R

print('=== Test 1: Missing .ots for range head (the bug scenario) ===')
d = tempfile.mkdtemp()
shutil.copytree('/workspace/ledger', d, dirs_exist_ok=True)

# Simulate the bug scenario: delete .ots file for a range head
# In a real scenario, 000002.sigstore.json attests the range ending at entry 2
# If 000002.ots is deleted, check-anchors should report it as missing

# Remove 000002.ots (the range head proof)
os.remove(os.path.join(d, 'anchors', '000002.ots'))
print('Removed 000002.ots')

chain, _ = R.load_chain(d)

# Mock check_sigstore to return valid ranges covering all entries
def mock_check_sigstore(bundle, digest, repo, workflow, ref):
    seq = int(os.path.basename(bundle)[:6])
    pred = R.range_predicate(chain, seq, seq)
    return 1234567890, pred, 'abc123'

import contextlib, io
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    with patch('record.check_sigstore', mock_check_sigstore):
        rc = R.main(['--ledger', d, 'check-anchors'])

# Check results
assert rc == 1, f'Expected exit code 1, got {rc}'
assert '000002.ots is missing' in err.getvalue(), 'Expected error message about 
missing .ots'
print(f'Exit code: {rc}')
print(f'Error message contains expected text: {\"000002.ots is missing\" in 
err.getvalue()}')

print()
print('=== Test 2: All .ots files present (existing behavior unchanged) ===')
d2 = tempfile.mkdtemp()
shutil.copytree('/workspace/ledger', d2, dirs_exist_ok=True)

out2, err2 = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out2), contextlib.redirect_stderr(err2):
    with patch('record.check_sigstore', mock_check_sigstore):
        rc2 = R.main(['--ledger', d2, 'check-anchors'])

# Should not have the missing .ots error (but may have other CantCheck errors)
assert '000002.ots is missing' not in err2.getvalue(), 'Should not report 
missing .ots when it exists'
print(f'Exit code: {rc2}')
print(f'No false positive for missing .ots: {\"000002.ots is missing\" not in 
err2.getvalue()}')

print()
print('=== All tests passed! ===')
"

