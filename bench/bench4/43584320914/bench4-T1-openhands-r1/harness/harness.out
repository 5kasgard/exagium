   202  def _refs(repo):
   203      """Every ref GitHub will name for this repo: branches, tags, every 
pull request's merge and head refs,
   204      and every ref in the activity log (which keeps deleted branches 
while the repo exists)."""
   205      api = f"https://api.github.com/repos/{repo}"
   206      refs = {"refs/heads/main"}
   207      refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
   208      refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
   209      refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
   210      activity = _pages(f"{api}/activity?per_page=100")
   211      refs.update(x["ref"] for x in activity if x.get("ref"))
   212      return sorted(refs), activity
