   446  def _orphan_entries_problem(o, pred):
   447      """The orphan must publish the hidden entries: canonical, 
consecutive from from_seq, chained from prev_sha256,
   448      ending at head_sha256. Returns a description of the first problem, 
or None."""
   449      try:
   450          raws = [base64.b64decode(x) for x in o["body"]["entries_b64"]]
   451          if not isinstance(pred.get("from_seq"), int) or len(raws) != 
pred.get("to_seq", -1) - pred["from_seq"] + 1:
   452              return "its entries don't match the attested range"
   453          prev = pred.get("prev_sha256")
   454          for i, raw in enumerate(raws):
   455              e = parse_canonical(raw, f"hidden entry {i + 1}")
   456              if not isinstance(e, dict) or e.get("seq") != 
pred["from_seq"] + i or e.get("prev") != prev:
   457                  return "its entries don't chain from the attested 
prev_sha256"
   458              if e.get("kind") not in KINDS:
   459                  return f"hidden entry {e.get('seq')} has an unknown 
kind"
   460              check_body(e["kind"], e.get("body"), f"hidden entry 
{e['seq']}")
   461              prev = hashlib.sha256(raw).hexdigest()
   462          if prev != pred.get("head_sha256"):
   463              return "its entries don't hash to the attested head"
   464      except Bad as ex:
   465          return f"its entries are malformed ({ex})"
   466      return None
