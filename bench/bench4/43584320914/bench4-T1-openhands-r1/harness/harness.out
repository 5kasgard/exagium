import os, shutil, tempfile, sys
from unittest.mock import patch
sys.path.insert(0, '.')
import record as R

# Copy the ledger to a temp directory
d = tempfile.mkdtemp()
shutil.copytree('/workspace/ledger', d, dirs_exist_ok=True)

# Remove one .ots file (e.g., 000002.ots)
ots_to_remove = os.path.join(d, 'anchors', '000002.ots')
os.remove(ots_to_remove)
print(f'Removed {ots_to_remove}')

# Get the chain first
chain, _ = R.load_chain(d)
print(f'Chain length: {len(chain)}')

# Create mock that returns valid range predicates
def mock_check_sigstore(bundle, digest, repo, workflow, ref):
    seq = int(os.path.basename(bundle)[:6])
    # Return a valid range: from_seq=seq to_seq=seq (each entry is its own 
range)
    # First we need to compute the correct range predicate
    pred = R.range_predicate(chain, seq, seq)
    return 1234567890, pred, 'abc123'

# Run check-anchors with mocked check_sigstore
import contextlib, io
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    with patch('record.check_sigstore', mock_check_sigstore):
        rc = R.main(['--ledger', d, 'check-anchors'])
print(f'rc={rc}')
print(f'stdout:\n{out.getvalue()}')
print(f'stderr:\n{err.getvalue()}')
"

