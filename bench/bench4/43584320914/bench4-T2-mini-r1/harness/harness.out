def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """
    Validate that an orphan's entries_b64 matches the attested range in pred.

    Returns None if the decoded entries are exactly the attested range.
    Otherwise returns a short problem string containing:
      - "range" when the count is wrong
      - "chain" when an entry's prev doesn't link
      - "head" when the last hash doesn't match head_sha256
    """
    entries_b64 = orphan["body"].get("entries_b64")
    if entries_b64 is None:
        return "missing entries_b64"

    # Decode all entries
    entries = []
    for i, e_b64 in enumerate(entries_b64):
        raw = base64.b64decode(e_b64)
        entry = parse_json(raw, f"orphan entry {i}")
        entries.append((entry, raw))

    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")

