            if not k.isascii():
                raise Bad(f"{where}: non-ASCII key {k!r}")
            _check_value(x, f"{where}.{k}")
        return
    raise Bad(f"{where}: unsupported type {type(v).__name__}")


def _no_dup_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise Bad(f"duplicate key {k!r}")
        d[k] = v
    return d


def _no_constants(c):
    raise Bad(f"{c} isn't JSON")


def parse_json(raw, where):
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=_no_dup_keys, 
parse_constant=_no_constants)
    except (UnicodeDecodeError, ValueError, RecursionError) as e:
        raise Bad(f"{where}: not valid UTF-8 JSON ({e})")


def parse_canonical(raw, where):
    """Parse stored bytes; they must be exactly the canonical form of what they 
contain."""
    obj = parse_json(raw, where)
    _check_value(obj, where)
    if canonical(obj) != raw:
        raise Bad(f"{where}: bytes aren't in canonical form")
    return obj


# ---------- schema ----------
def _need(d, key, typ, where):
    if key not in d or not isinstance(d[key], typ) or (typ is int and 
isinstance(d[key], bool)):
        raise Bad(f"{where}: needs {key} ({typ.__name__})")
    return d[key]


def _name(d, where):
    v = _need(d, "by", str, where)
    if not NAME.fullmatch(v):
        raise Bad(f"{where}: by must be a lowercase ASCII handle matching 
{NAME.pattern}")
    return v


def _check_digests(lst, where):
    if not isinstance(lst, list):
        raise Bad(f"{where}: must be a list")
    for i, x in enumerate(lst):
        if not isinstance(x, dict) or set(x) != {"name", "sha256"} or not 
isinstance(x["name"], str) \
                or not isinstance(x["sha256"], str) or not 
HEX64.fullmatch(x["sha256"]):
            raise Bad(f"{where}[{i}]: must be {{name, sha256}} with 64 lowercase
hex")


def check_body(kind, body, where):
    if not isinstance(body, dict):
        raise Bad(f"{where}: body must be an object")
    _name(body, where)
    if kind == "plan":
        allowed = {"by", "claim", "test", "decision_rule", "baseline", "inputs",
"verdict_due", "notes"}
        for k in ("claim", "test", "decision_rule"):
            if not _need(body, k, str, where).strip():
                raise Bad(f"{where}: {k} is empty")
        if "inputs" in body:
            _check_digests(body["inputs"], f"{where}.inputs")
        if "verdict_due" in body:
            try:
                ok = isinstance(body["verdict_due"], str) and 
len(body["verdict_due"]) == 10 and \
                    datetime.date.fromisoformat(body["verdict_due"]).isoformat()
== body["verdict_due"]
            except ValueError:
                ok = False
            if not ok:
                raise Bad(f"{where}: verdict_due must be a real date, 
YYYY-MM-DD")
    elif kind == "verdict":
        allowed = {"by", "plan", "outcome", "evidence", "notes"}
        p = _need(body, "plan", dict, where)
        if set(p) != {"seq", "sha256"} or not isinstance(p["seq"], int) or 
isinstance(p["seq"], bool) \
                or not isinstance(p["sha256"], str) or not 
HEX64.fullmatch(p["sha256"]):
            raise Bad(f"{where}: plan must be {{seq, sha256}}")
        if body.get("outcome") not in OUTCOMES:
            raise Bad(f"{where}: outcome must be one of {OUTCOMES}")
        _check_digests(_need(body, "evidence", list, where), 
f"{where}.evidence")
    else:  # orphan: explains a Rekor attestation by the writer that the ledger 
doesn't hold
        allowed = {"by", "log_index", "reason", "statement_b64", "entries_b64"}
        if _need(body, "log_index", int, where) < 0 or not _need(body, "reason",
str, where).strip():
            raise Bad(f"{where}: orphan needs log_index >= 0 and a reason")
        try:  # the orphaned attestation's exact signed statement; monitor 
checks it against Rekor's payload hash
            base64.b64decode(_need(body, "statement_b64", str, where), 
validate=True)
        except ValueError:
            raise Bad(f"{where}: statement_b64 must be base64")
        if "entries_b64" in body:
            entries_b64 = _need(body, "entries_b64", list, where)
            for i, e_b64 in enumerate(entries_b64):
                if not isinstance(e_b64, str):
                    raise Bad(f"{where}: entries_b64[{i}] must be a string")
                try:
                    raw = base64.b64decode(e_b64, validate=True)
                except ValueError:
                    raise Bad(f"{where}: entries_b64[{i}] must be base64")
                try:
                    parse_canonical(raw, f"{where}.entries_b64[{i}]")
                except Bad as ex:
                    raise Bad(f"{where}: entries_b64[{i}] {ex}")
    extra = set(body) - allowed
    if extra:
        raise Bad(f"{where}: unknown body fields {sorted(extra)}")


def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """
    Validate that an orphan's entries_b64 matches the attested range in pred.

    Returns None if the decoded entries are exactly the attested range.
    Otherwise returns a short problem string containing:
      - "range" when the count is wrong
      - "chain" when an entry's prev doesn't link
      - "head" when the last hash doesn't match head_sha256
    """
    entries_b64 = orphan["body"].get("entries_b64")
    if entries_b64 is None:
        return "missing entries_b64"

    # Decode all entries
    entries = []
    for i, e_b64 in enumerate(entries_b64):
        raw = base64.b64decode(e_b64)
        entry = parse_json(raw, f"orphan entry {i}")
        entries.append((entry, raw))

    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")

    # Check count
    expected_count = to_seq - from_seq + 1 if from_seq is not None and to_seq is
not None else 0
    if len(entries) != expected_count:
        return f"range count {len(entries)} != expected {expected_count}"

    # Check chain
    expected_prev = prev_sha256
    for i, (entry, raw) in enumerate(entries):
        actual_prev = entry.get("prev")
        if actual_prev != expected_prev:
            return f"chain broken at index {i}: prev {actual_prev!r} != expected
{expected_prev!r}"
        # Next expected prev is this entry's sha256
        expected_prev = hashlib.sha256(raw).hexdigest()

    # Check head
    if entries:
        last_hash = hashlib.sha256(entries[-1][1]).hexdigest()
        if last_hash != head_sha256:
            return f"head mismatch: last hash {last_hash} != pred head_sha256 
{head_sha256}"

    return None


# ---------- the chain ----------
def _listdir(ledger, sub, pattern, what):
    d = os.path.join(ledger, sub)
    if not os.path.exists(d):
        return []
    if os.path.islink(d) or not os.path.isdir(d):
        raise Bad(f"{sub}/ must be a plain directory")
    out = []
    for n in sorted(os.listdir(d)):
        p = os.path.join(d, n)
        if not pattern.fullmatch(n) or os.path.islink(p) or not 
os.path.isfile(p):
            raise Bad(f"{sub}/{n!r}: unexpected {what}")
        out.append(p)
    return out


def load_chain(ledger):
    """Return (list of (entry, sha256)), and dict seq->sha256 for fast 
lookup."""
    entries_dir = os.path.join(ledger, "entries")
    if not os.path.exists(entries_dir):
        raise Bad("entries/ directory missing")
    paths = _listdir(ledger, "entries", ENTRY_NAME, "entry file")
    chain = []
    for p in paths:
        raw = open(p, "rb").read()
        entry = parse_canonical(raw, f"entry {os.path.basename(p)}")
        if entry["kind"] not in KINDS:
            raise Bad(f"{p}: kind must be one of {KINDS}")
        if entry["kind"] == "verdict":
            if "plan" not in entry["body"]:
                raise Bad(f"{p}: verdict needs plan")
        h = hashlib.sha256(raw).hexdigest()
        chain.append((entry, h))
    # verify chain links
    for i, (entry, h) in enumerate(chain):
        seq = i + 1
        if entry["seq"] != seq:
            raise Bad(f"entry {seq}: seq field {entry['seq']} != position 
{seq}")
        expected_prev = chain[i - 1][1] if i > 0 else None
        if entry.get("prev") != expected_prev:
            raise Bad(f"entry {seq}: prev {entry.get('prev')!r} != 
{expected_prev!r}")
    return chain, {e["seq"]: h for e, h in chain}


def range_predicate(chain, from_seq, to_seq):
    """What the writer attests: the range of entries one run added, tied to the 
chain on both ends."""
    return {"from_seq": from_seq, "to_seq": to_seq,
            "prev_sha256": chain[from_seq - 2][1] if from_seq > 1 else None, 
"head_sha256": chain[to_seq - 1][1]}


def check_sigstore(bundle, digest, repo, workflow, ref):
    """Verify offline that a bundle is an attestation of this digest, signed by 
exactly this workflow on this ref.
    Returns (integrated_time, predicate). Wrong data is Bad; a missing library 
is CantCheck."""
    try:
        from sigstore.models import Bundle
        from sigstore.verify import Verifier, policy
        from sigstore.errors import Error as SigstoreError
    except ImportError as ex:
        raise CantCheck(f"sigstore-python isn't usable ({ex}); pip install 
sigstore==4.5.1 in a virtualenv")
    name = os.path.basename(bundle)
    raw = open(bundle, "rb").read()
    pol = policy.AllOf([policy.Identity(identity=identity(repo, workflow, ref), 
issuer=ISSUER),
                        policy.GitHubWorkflowRepository(repo), 
policy.GitHubWorkflowRef(ref)])
    try:
        b = Bundle.from_json(raw)
        ptype, payload = Verifier.production(offline=True).verify_dsse(b, pol)
    except SigstoreError as ex:   # verification errors and malformed bundles 
alike: the anchor is wrong
        raise Bad(f"anchors/{name}: {ex}")
    if ptype != "application/vnd.dsse+json":
        raise Bad(f"anchors/{name}: not a DSSE envelope")
    stmt = parse_json(payload, f"anchors/{name} statement")
    pred = stmt.get("predicate")
    if not isinstance(pred, dict):
        raise Bad(f"anchors/{name}: predicate missing")
    integrated = stmt.get("integratedTime")
    if not integrated:
        raise Bad(f"anchors/{name}: missing integratedTime")
    commit = pred.get("commit")
    if not isinstance(commit, str) or not HEX64.fullmatch(commit):
        raise Bad(f"anchors/{name}: predicate missing valid commit")
    return integrated, pred, commit


def identity(repo, workflow, ref):
    return f"https://github.com/{repo}/.github/workflows/{workflow}@{ref}"


def iso(ts):
    """Rekor's integratedTime (seconds since epoch) -> ISO 8601 UTC."""
    return datetime.datetime.fromtimestamp(int(ts), 
datetime.timezone.utc).isoformat().replace("+00:00", "Z")


# ---------- commands ----------
def cmd_ingest(a):
    """Move valid proposals from inbox/ into entries/ with the next sequence 
number."""
    chain, _ = load_chain(a.ledger)
    inbox = _listdir(a.ledger, "inbox", re.compile(r".*"), "file in inbox")
    for p in inbox:
        raw = open(p, "rb").read()
        proposal = parse_json(raw, f"inbox/{os.path.basename(p)}")
        kind = _need(proposal, "kind", str, "proposal")
        if kind not in KINDS:
            raise Bad(f"inbox/{os.path.basename(p)}: kind must be one of 
{KINDS}")
        body = _need(proposal, "body", dict, "proposal")
        check_body(kind, body, f"inbox/{os.path.basename(p)}")
        if kind == "verdict":
            plan_seq = body["plan"]["seq"]
            plan_sha = body["plan"]["sha256"]
            if not 1 <= plan_seq <= len(chain):
                raise Bad(f"inbox/{os.path.basename(p)}: verdict references plan
{plan_seq} but chain has {len(chain)} entries")
            if chain[plan_seq - 1][1] != plan_sha:
                raise Bad(f"inbox/{os.path.basename(p)}: verdict's plan hash 
doesn't match entry {plan_seq}")
            if chain[plan_seq - 1][0]["kind"] != "plan":
                raise Bad(f"inbox/{os.path.basename(p)}: verdict references 
entry {plan_seq} which is not a plan")
            # exactly one verdict per plan
            for e, _ in chain:
                if e["kind"] == "verdict" and e["body"]["plan"]["seq"] == 
plan_seq:
                    raise Bad(f"inbox/{os.path.basename(p)}: plan {plan_seq} 
already has a verdict")
            if e["body"]["by"] == body["by"]:
                raise Bad(f"inbox/{os.path.basename(p)}: verdict must come from 
someone else (not {body['by']})")
        seq = len(chain) + 1
        entry = {"seq": seq, "prev": chain[-1][1] if chain else None, "kind": 
kind, "body": body}
        raw_entry = canonical(entry)
        open(os.path.join(a.ledger, "entries", f"{seq:06d}.json"), 
"wb").write(raw_entry)
        chain.append((entry, hashlib.sha256(raw_entry).hexdigest()))
        os.remove(p)
    return 0


def cmd_verify(a):
    """Check the ledger: entries are valid, canonical, and hash-chain 
correctly."""
    chain, _ = load_chain(a.ledger)
    verdicts = [e for e, _ in chain if e["kind"] == "verdict"]
    plans = [e for e, _ in chain if e["kind"] == "plan"]
    open_plans = []
    overdue_plans = []
    today = datetime.date.today()
    for p in plans:
        has_verdict = any(v["body"]["plan"]["seq"] == p["seq"] for v in 
verdicts)
        if not has_verdict:
            open_plans.append(p["seq"])
            due = p["body"].get("verdict_due")
            if due and datetime.date.fromisoformat(due) < today:
                overdue_plans.append(p["seq"])
    print(json.dumps({"entries": len(chain), "verdicts": len(verdicts),
                      "open_plans": open_plans, "overdue_plans": overdue_plans,
                      "orphans_explained": sum(e["kind"] == "orphan" for e, _ in
chain)}, indent=1))
    return 0


def cmd_head(a):
    chain, _ = load_chain(a.ledger)
    if not chain:
        raise Bad("ledger is empty")
    print(json.dumps({"seq": len(chain), "sha256": chain[-1][1]}, indent=1))
    return 0


def cmd_check_anchors(a):
    """Every anchor must be right, and the writer's Sigstore ranges must cover 
entries 1..head with no gap or overlap.
    Checks every anchor even after a failure; exit 1 if anything was wrong, else
2 if anything couldn't be checked."""
    chain, _ = load_chain(a.ledger)
    rows, bad, cant, ranges = [], [], [], []
    for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in anchors"):
        n = os.path.basename(path)
        m = ANCHOR_NAME.fullmatch(n)
        seq = int(m.group(1))
        try:
            if not 1 <= seq <= len(chain):
                raise Bad(f"anchors/{n}: no entry {seq}")
            raw = open(os.path.join(a.ledger, "entries", f"{seq:06d}.json"), 
"rb").read()
            if m.group(2) == "ots":
                t = check_ots(path, raw, a.explorer)
                rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
            else:
                t, pred, commit = check_sigstore(path, chain[seq - 1][1], 
a.repo, a.workflow, a.ref)
                if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
                        or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
                    raise Bad(f"anchors/{n}: attested range {pred!r} doesn't 
match this chain")
                ranges.append((pred["from_seq"], seq, commit))
                rows.append({"anchor": n, "kind": "sigstore", "entries": 
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
                             "writer_commit": commit})
        except Bad as ex:
            bad.append(str(ex))
        except CantCheck as ex:
            cant.append(f"anchors/{n}: {ex}")
    covered, changes, prev_commit = 0, [], None
    for lo, hi, commit in sorted(ranges):
        if lo != covered + 1:
            bad.append(f"the writer's ranges {'overlap' if lo <= covered else 
'leave a gap'} at entry {min(lo, covered + 1)}")
        covered = max(covered, hi)
        if prev_commit:  # did the writer's code change between these two runs? 
(information: a stranger reads the diff)
            changes.append({"entries": f"{lo}-{hi}", "from_commit": prev_commit,
"to_commit": commit,
                            "writer_code_changed": _code_changed(a, prev_commit,
commit)})
        prev_commit = commit
    if covered < len(chain):
        bad.append(f"entries {covered + 1}-{len(chain)} were never attested by 
the writer")
    print(json.dumps({"anchors": rows, "entries": len(chain), 
"writer_attested_through": covered,
                      "writer_runs": changes, "wrong": bad, "could_not_check": 
cant}, indent=1))
    for x in bad:
        print(f"BAD: {x}", file=sys.stderr)
    for x in cant:
        print(f"CAN'T CHECK: {x}", file=sys.stderr)
    return 1 if bad else 2 if cant else 0


def check_ots(path, digest, explorers):
    """Verify an OpenTimestamps file against Bitcoin block headers via the given
explorers.
    Returns the block time (int seconds since epoch) if confirmed, None if 
pending, raises CantCheck if explorers fail."""
    try:
        import opentimestamps
        from opentimestamps.core.timestamp import Timestamp
        from opentimestamps.core.opentimestamps import OpenTimestampsFile
    except ImportError as ex:
        raise CantCheck(f"opentimestamps isn't usable ({ex}); pip install 
opentimestamps==1.1.0 in a virtualenv")
    ots = OpenTimestampsFile(open(path, "rb").read())
    results = ots.verify(digest)
    if not results:
        raise Bad(f"anchors/{os.path.basename(path)}: OTS doesn't commit to this
digest")
    confirmed = [r for r in results if r.attestation is not None]
    if confirmed:
        # pick the earliest confirmed attestation
        return min(int(r.attestation) for r in confirmed)
    return None  # pending


def _git(a, *args):
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def _code_changed(a, c1, c2):
    """True/False if record.py or the writer workflow differ between two 
commits; "unknown" without that history."""
    if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
        return "unknown (commit not in this clone)"
    root = os.path.dirname(os.path.abspath(a.ledger))
    r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, "--", 
"record/record.py", a.workflow])
    return {0: False, 1: True}.get(r.returncode, "unknown")


def _published_entry_hashes(a, rev):
    """sha256 of every version of every entry file ever committed in rev's 
history."""
    raw = _git(a, "log", rev, "--format=", "--raw", "--no-abbrev", "--", 
"ledger/entries")
    if raw is None:
        raise CantCheck(f"no git history for {rev} next to the ledger (run 
monitor in a full clone)")
    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if 
ln.startswith(":") and ln.split()[3].strip("0")}
    out = set()
    for b in blobs:
        data = _git(a, "cat-file", "blob", b)
        if data is not None:
            out.add(hashlib.sha256(data).hexdigest())
    return out


def _pages(url):
    """Follow GitHub's Link: rel="next" (works for page= and the cursor-paged 
activity API). The next link may name
    the repo by numeric id; keep the original /repos/owner/name path and take 
only the query from it."""
    import urllib.parse
    base = url.split("?")[0]
    out = []
    while url:
        body, hdrs = _get(url, headers=True)
        if body is None:
            raise CantCheck(f"404 from {url}")
        out.extend(json.loads(body))
        m = re.search(r'<([^>]+)>;\s*rel="next"', (hdrs.get("Link") if hdrs else
None) or "")
        url = f"{base}?{urllib.parse.urlsplit(m.group(1)).query}" if m else None
    return out


def _refs(repo):
    """Every ref GitHub will name for this repo: branches, tags, every pull 
request's merge and head refs,
    and every ref in the activity log (which keeps deleted branches while the 
repo exists)."""
    api = f"https://api.github.com/repos/{repo}"
    refs = {"refs/heads/main"}
    refs.update("refs/heads/" + x["name"] for x in 
_pages(f"{api}/branches?per_page=100"))
    refs.update("refs/tags/" + x["name"] for x in 
_pages(f"{api}/tags?per_page=100"))
    refs.update(f"refs/pull/{x['number']}/{k}" for x in 
_pages(f"{api}/pulls?state=all&per_page=100") for k in ("merge", "head"))
    activity = _pages(f"{api}/activity?per_page=100")
    refs.update(x["ref"] for x in activity if x.get("ref"))
    return sorted(refs), activity


def _get(url, headers=False):
    req = urllib.request.Request(url, headers={"Accept": "application/json", 
"User-Agent": "exagium-record"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            if headers:
                return resp.read(), resp.headers
            return resp.read()
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    except urllib.error.URLError:
        raise CantCheck(f"network error fetching {url}")


def cmd_monitor(a):
    """List every Rekor entry signed by the writer workflow on any ref GitHub 
names. Each must be an anchor in the
    ledger, or be explained by an orphan entry whose statement matches Rekor's 
payload hash and whose entries were
    never published on the ledger branch (so an orphan can't launder a deleted 
verdict). Any force push to the
    ledger branch is wrong. Entries are matched by Rekor log index, unique per 
attestation."""
    chain, _ = load_chain(a.ledger)
    current = {h for _, h in chain}
    known, bad = {}, []
    for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in anchors"):
        if path.endswith(".sigstore.json"):
            try:
                known[int(json.load(open(path))["verificationMaterial"]["tlogEnt
ries"][0]["logIndex"])] = os.path.basename(path)
            except (ValueError, KeyError, IndexError, TypeError) as ex:
                raise Bad(f"{os.path.basename(path)}: malformed bundle ({ex})")
    explained = {e["body"]["log_index"]: e for e, _ in chain if e["kind"] == 
"orphan"}
    if a.only_ref:
        refs, activity = [a.only_ref], []
    else:
        refs, activity = _refs(a.repo)
        for x in activity:
            if x.get("activity_type") == "force_push" and x.get("ref") == 
a.ledger_ref:
                bad.append(f"force push to {a.ledger_ref} at 
{x.get('timestamp')} (rewrites the ledger's history)")
    published = _published_entry_hashes(a, a.git_rev) if explained else set()
    seen, unknown, orphans = set(), [], []
    for ref in refs:
        uuids = _get("https://rekor.sigstore.dev/api/v1/index/retrieve", 
json.dumps({"subject": identity(a.repo, a.workflow, ref)}).encode())
        if uuids is None:
            raise CantCheck("Rekor's index returned 404")
        for u in json.loads(uuids):
            got = _get(f"https://rekor.sigstore.dev/api/v1/log/entries/{u}")
            if got is None:
                raise CantCheck(f"Rekor lists {u} but won't return it")
            v = next(iter(json.loads(got).values()))
            idx = int(v["logIndex"])
            seen.add(idx)
            row = {"ref": ref, "log_index": idx, "integrated": 
iso(v["integratedTime"]), "rekor_uuid": u}
            if idx in known:
                continue
            if idx not in explained:
                unknown.append(row)
                continue
            o = explained[idx]
            body = json.loads(base64.b64decode(v["body"]))
            stmt = base64.b64decode(o["body"]["statement_b64"])
            if body.get("kind") != "dsse" or 
body["spec"]["payloadHash"]["value"] != hashlib.sha256(stmt).hexdigest():
                bad.append(f"orphan entry {o['seq']}: its statement isn't the 
one Rekor holds for log index {idx}")
                continue
            pred = (parse_json(stmt, f"orphan entry {o['seq']} statement") or 
{}).get("predicate") or {}
            head = pred.get("head_sha256")
            if head in published and head not in current:
                bad.append(f"orphan entry {o['seq']}: the attested head {head} 
was published on {a.git_rev} and later removed")
                continue
            # Check that the orphan's entries_b64 matches the attested range
            problem = _orphan_entries_problem(o, pred)
            if problem:
                bad.append(f"orphan entry {o['seq']}: hidden entries problem: 
{problem}")
                continue
            orphans.append(dict(row, explained_by_entry=o["seq"], 
attested_range=f"{pred.get('from_seq')}-{pred.get('to_seq')}"))
    missing = sorted(n for idx, n in known.items() if idx not in seen) if not 
a.only_ref else []
    print(json.dumps({"refs_checked": refs, "rekor_entries": len(seen), 
"ledger_anchors": len(known),
                      "explained_orphans": orphans, "unexplained": unknown, 
"wrong": bad,
                      "ledger_anchors_not_found_in_rekor": missing if not 
a.only_ref else "not checked with --only-ref"}, indent=1))
    for x in bad:
        print(f"BAD: {x}", file=sys.stderr)
    return 1 if unknown or missing or bad else 0


def cmd_range(a):
    chain, _ = load_chain(a.ledger)
    if not 1 <= a.from_seq <= a.to_seq <= len(chain):
        raise Bad(f"no range {a.from_seq}-{a.to_seq} in a chain of 
{len(chain)}")
    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), 
sort_keys=True, separators=(",", ":")))
    return 0


def main(argv=None):
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser(description=__doc__, 
formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--ledger", default=os.path.join(here, "..", "ledger"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("ingest")
    sub.add_parser("verify")
    sub.add_parser("head")
    rp = sub.add_parser("range", help="print the writer's predicate for entries 
FROM..TO (used by CI)")
    rp.add_argument("from_seq", type=int)
    rp.add_argument("to_seq", type=int)
    for name in ("check-anchors", "monitor"):
        p = sub.add_parser(name)
        p.add_argument("--repo", default="5kasgard/exagium")
        p.add_argument("--workflow", default=".github/workflows/record.yml")
        if name == "check-anchors":
            p.add_argument("--ref", default="refs/heads/main")
            p.add_argument("--explorer", action="append", default=None,
                           help="esplora API base; default blockstream.info and 
mempool.space")
        else:
            p.add_argument("--only-ref", help="check this ref only (default: 
every ref GitHub names)")
            p.add_argument("--ledger-ref", default="refs/heads/main", help="the 
ledger's branch; a force push to it is wrong")
            p.add_argument("--git-rev", default="HEAD", help="the ledger 
branch's history in this clone (for orphan checks)")
    a = ap.parse_args(argv)
    if getattr(a, "explorer", "x") is None:
        a.explorer = ["https://blockstream.info/api", 
"https://mempool.space/api"]
    fn = {"ingest": cmd_ingest, "verify": cmd_verify, "head": cmd_head, "range":
cmd_range,
          "check-anchors": cmd_check_anchors, "monitor": cmd_monitor}[a.cmd]
    try:
        return fn(a)
    except Bad as ex:
        print(f"BAD: {ex}", file=sys.stderr)
        return 1
    except CantCheck as ex:
        print(f"CAN'T CHECK: {ex}", file=sys.stderr)
        return 2
    except Exception as ex:  # a failure is never reported as a verdict
        print(f"FAILURE: {type(ex).__name__}: {ex}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
EOF
