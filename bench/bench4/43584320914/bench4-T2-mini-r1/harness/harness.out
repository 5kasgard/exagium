def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
    """
    Validate that an orphan\\'s entries_b64 matches the attested range in pred.

    Returns None if the decoded entries are exactly the attested range.
    Otherwise returns a short problem string containing:
      - "range" when the count is wrong
      - "chain" when an entry\\'s prev doesn\\'t link
      - "head" when the last hash doesn\\'t match head_sha256
    """
    entries_b64 = orphan["body"].get("entries_b64")
    if entries_b64 is None:
        return "missing entries_b64"

    # Decode all entries
    entries = []
    for i, e_b64 in enumerate(entries_b64):
        raw = base64.b64decode(e_b64)
        entry = parse_json(raw, f"orphan entry {i}")
        entries.append((entry, raw))

    from_seq = pred.get("from_seq")
    to_seq = pred.get("to_seq")
    prev_sha256 = pred.get("prev_sha256")
    head_sha256 = pred.get("head_sha256")

    # Check count
    expected_count = to_seq - from_seq + 1 if from_seq is not None and to_seq is
not None else 0
    if len(entries) != expected_count:
        return f"range count {len(entries)} != expected {expected_count}"

    # Check chain
    expected_prev = prev_sha256
    for i, (entry, raw) in enumerate(entries):
        actual_prev = entry.get("prev")
        if actual_prev != expected_prev:
            return f"chain broken at index {i}: prev {actual_prev!r} != expected
{expected_prev!r}"
        # Next expected prev is this entry\\'s sha256
        expected_prev = hashlib.sha256(raw).hexdigest()

    # Check head
    if entries:
        last_hash = hashlib.sha256(entries[-1][1]).hexdigest()
        if last_hash != head_sha256:
            return f"head mismatch: last hash {last_hash} != pred head_sha256 
{head_sha256}"

    return None

'''

