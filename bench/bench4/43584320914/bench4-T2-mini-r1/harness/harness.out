    json.dump(plan, f)

# Ingest the plan
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print(f'Plan ingest rc={rc}')

# Now create an orphan with INVALID entries_b64 (wrong hash)
entry1_raw = open(os.path.join(d, 'entries', '000001.json'), 'rb').read()
entry1 = json.loads(entry1_raw)
sha1 = hashlib.sha256(entry1_raw).hexdigest()

# Create orphan with entries_b64 that has wrong head
orphan_body = {
    'by': 'owner',
    'log_index': 12345,
    'reason': 'run failed after attesting',
    'statement_b64': base64.b64encode(json.dumps({'predicate': {'from_seq': 1, 
'to_seq': 1, 'prev_sha256': None, 'head_sha256': '0'*64}}).encode()).decode(),
    'entries_b64': [base64.b64encode(entry1_raw).decode()]
}
with open(os.path.join(d, 'inbox', 'orphan.json'), 'w') as f:
    json.dump({'kind': 'orphan', 'body': orphan_body}, f)

# Ingest the orphan - this should succeed because ingest doesn't check the 
entries_b64 against the predicate
out, err = io.StringIO(), io.StringIO()
with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
    rc = R.main(['--ledger', d, 'ingest'])
print(f'Orphan ingest rc={rc}')
print(f'err={err.getvalue()}')

# But monitor should catch it
# Note: monitor requires network, so we can't test it fully here

shutil.rmtree(d)
