cd /workspace/record && python3 -c "
import record as R
import base64, hashlib, json

# Test 1: Valid entries_b64
entry1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'body': {'by': 'test', 
'claim': 'test', 'test': 'test', 'decision_rule': 'test'}}
raw1 = R.canonical(entry1)
sha1 = hashlib.sha256(raw1).hexdigest()

entry2 = {'seq': 2, 'prev': sha1, 'kind': 'verdict', 'body': {'by': 'test2', 
'plan': {'seq': 1, 'sha256': sha1}, 'outcome': 'pass', 'evidence': []}}
raw2 = R.canonical(entry2)
sha2 = hashlib.sha256(raw2).hexdigest()

entries_b64 = [base64.b64encode(raw1).decode(), base64.b64encode(raw2).decode()]
orphan = {'body': {'entries_b64': entries_b64}}
pred = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': sha2}

result = R._orphan_entries_problem(orphan, pred)
print(f'Test 1 (valid): {result}')
assert result is None, f'Expected None, got {result}'

# Test 2: Wrong count
orphan2 = {'body': {'entries_b64': [base64.b64encode(raw1).decode()]}}
result2 = R._orphan_entries_problem(orphan2, pred)
print(f'Test 2 (wrong count): {result2}')
assert 'range' in result2, f'Expected range error, got {result2}'

# Test 3: Broken chain
entry3 = {'seq': 2, 'prev': '0'*64, 'kind': 'verdict', 'body': {'by': 'test2', 
'plan': {'seq': 1, 'sha256': sha1}, 'outcome': 'pass', 'evidence': []}}
raw3 = R.canonical(entry3)
entries_b64_3 = [base64.b64encode(raw1).decode(), 
base64.b64encode(raw3).decode()]
orphan3 = {'body': {'entries_b64': entries_b64_3}}
result3 = R._orphan_entries_problem(orphan3, pred)
print(f'Test 3 (broken chain): {result3}')
assert 'chain' in result3, f'Expected chain error, got {result3}'

# Test 4: Wrong head
pred4 = {'from_seq': 1, 'to_seq': 2, 'prev_sha256': None, 'head_sha256': '0'*64}
result4 = R._orphan_entries_problem(orphan, pred4)
print(f'Test 4 (wrong head): {result4}')
assert 'head' in result4, f'Expected head error, got {result4}'

# Test 5: Missing entries_b64
orphan5 = {'body': {}}
result5 = R._orphan_entries_problem(orphan5, pred)
print(f'Test 5 (missing entries_b64): {result5}')
assert 'missing' in result5, f'Expected missing error, got {result5}'

print('All _orphan_entries_problem tests passed!')
"
