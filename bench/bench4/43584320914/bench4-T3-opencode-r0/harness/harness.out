 2 (max-pending-hours=50): rc={rc}')\n    assert rc == 1, f'Expected 1, got {rc}'\n\n    # Test with max-pending-hours=150 - should exit 0 (100 < 150)\n    rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '150'])\n    print(f'Test 3 (max-pending-hours=150): rc={rc}')\n    assert rc == 0, f'Expected 0, got {rc}'\n\n    print('All tests passed!')\nfinally:\n    R.check_sigstore = saved_check_sigstore\n    R.check_ots = saved_check_ots\n    import shutil\n    shutil.rmtree(d)\n\" 2>&1"},"output":"BAD: anchors/000001.ots: still pending 100 h\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000001.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000001.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-1\",\n   \"existed_by\": \"2026-11-10T06:17:43Z\",\n   \"writer_commit\": \"commit123\"\n  }\n ],\n \"entries\": 1,\n \"writer_attested_through\": 1,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_not_check\": []\n}\nTest 1 (no max-pending-hours): rc=0\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000001.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000001.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-1\",\n   \"existed_by\": \"2026-11-10T06:17:43Z\",\n   \"writer_commit\": \"commit123\"\n  }\n ],\n \"entries\": 1,\n \"writer_attested_through\": 1,\n \"writer_runs\": [],\n \"wrong\": [\n  \"anchors/000001.ots: still pending 100 h\"\n ],\n \"could_not_check\": []\n}\nTest 2 (max-pending-hours=50): rc=1\n{\n \"anchors\": [\n  {\n   \"anchor\": \"000001.ots\",\n   \"kind\": \"opentimestamps\",\n   \"existed_by\": \"pending\"\n  },\n  {\n   \"anchor\": \"000001.sigstore.json\",\n   \"kind\": \"sigstore\",\n   \"entries\": \"1-1\",\n   \"existed_by\": \"2026-11-10T06:17:43Z\",\n   \"writer_commit\": \"commit123\"\n  }\n ],\n \"entries\": 1,\n \"writer_attested_through\": 1,\n \"writer_runs\": [],\n \"wrong\": [],\n \"could_