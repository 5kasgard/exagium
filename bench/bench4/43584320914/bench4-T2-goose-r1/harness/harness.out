                "before": "def check_sigstore(bundle, digest, repo, workflow, ref):",
                "after": "def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Check that an orphan's entries_b64 matches the attested range.\n    Returns None if valid, otherwise a short problem string containing 'range', 'chain', or 'head'.\"\"\"\n    if \"entries_b64\" not in orphan[\"body\"]:\n        return \"orphan missing entries_b64\"\n    entries_b64 = orphan[\"body\"][\"entries_b64\"]\n    from_seq = pred[\"from_seq\"]\n    to_seq = pred[\"to_seq\"]\n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range count mismatch: expected {expected_count}, got {len(entries_b64)}\"\n\n    prev_sha256 = pred[\"prev_sha256\"]\n    head_sha256 = pred[\"head_sha256\"]\n    last_hash = None\n\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"entries_b64[{i}]: invalid base64\"\n        entry = parse_canonical(entry_raw, f\"orphan entry {i}\")\n        # Check entry structure\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"entries_b64[{i}]: invalid entry structure\"\n        # Check chain linkage\n        if entry[\"prev\"] != prev_sha256:\n            return f\"chain broken at index {i}: prev {entry['prev']!r} != expected {prev_sha256!r}\"\n        # Compute hash for next iteration\n        prev_sha256 = hashlib.sha256(entry_raw).hexdigest()\n        last_hash = prev_sha256\n\n    if last_hash != head_sha256:\n        return f\"head mismatch: last entry hash {last_hash!r} != attested head {head_sha256!r}\"\n\n    return None\n\n\ndef check_sigstore(bundle, digest, repo, workflow, ref):"
