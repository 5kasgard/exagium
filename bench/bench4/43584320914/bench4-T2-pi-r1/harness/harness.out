ode()]}}\nresult = R._orphan_entries_problem(orphan4, pred_bad)\nprint('Test 4 (wrong head):', result)\nassert result is not None and 'head' in result, 'Expected head error'\n\n# Test 5: Missing entries_b64\norphan5 = {'body': {}}\nresult = R._orphan_entries_problem(orphan5, pred)\nprint('Test 5 (missing entries_b64):', result)\nassert result is not None and 'range' in result, 'Expected range error'\n\nprint('All tests passed!')\n\""}}
