{"type":"tool_execution_end","toolCallId":"call-d79244f5-a429-436b-801e-50dffaae384a","toolName":"read","result":{"content":[{"type":"text","text":"    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that an orphan's entries_b64 matches the attested range.\n    Returns None if valid, otherwise a short problem string containing\n    'range', 'chain', or 'head' for the respective failure modes.\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\")\n    if not isinstance(entries_b64, list):\n        return \"range: missing or invalid entries_b64\"\n    \n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    if not isinstance(from_seq, int) or not isinstance(to_seq, int):\n        return \"range: invalid predicate\"\n    \n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    \n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    \n    last_sha = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} not valid base64\"\n        \n        try:\n            entry = parse_json(entry_raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} invalid ({ex})\"\n        \n        # Check it's a valid entry structure\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"chain: entry {i} malformed\"\n        \n\n[323 more lines in file. Use offset=340 to continue.]"}],"structuredContent":"    chain, verdict_of = load_chain(a.ledger)\n    today = datetime.date.today().isoformat()\n    plans = [e for e, _ in chain if e[\"kind\"] == \"plan\"]\n    open_ = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of]\n    overdue = [e[\"seq\"] for e in plans if e[\"seq\"] not in verdict_of and e[\"body\"].get(\"verdict_due\", \"9999-12-31\") < today]\n    print(json.dumps({\"entries\": len(chain), \"head_seq\": len(chain), \"head_sha256\": chain[-1][1] if chain else None,\n                      \"plans\": len(plans), \"verdicts\": len(verdict_of),\n                      \"orphans_explained\": sum(e[\"kind\"] == \"orphan\" for e, _ in chain),\n                      \"open_plans\": open_, \"overdue_plans\": overdue}, indent=1))\n    return 0\n\n\ndef cmd_head(a):\n    chain, _ = load_chain(a.ledger)\n    print(f\"{len(chain)} {chain[-1][1] if chain else '-'}\")\n    return 0\n\n\n# ---------- anchors ----------\ndef _get(url, data=None, timeout=20, headers=False):\n    req = urllib.request.Request(url, data=data, headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\",\n                                                          \"User-Agent\": \"exagium-record\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read()\n            return (body, r.headers) if headers else body\n    except urllib.error.HTTPError as ex:\n        if ex.code == 404:\n            return (None, None) if headers else None\n        raise CantCheck(f\"network: {url}: HTTP {ex.code}\")\n    except OSError as ex:\n        raise CantCheck(f\"network: {url}: {ex}\")\n\n\ndef identity(repo, workflow, ref):\n    return f\"https://github.com/{repo}/{workflow}@{ref}\"\n\n\ndef range_predicate(chain, from_seq, to_seq):\n    \"\"\"What the writer attests: the range of entries one run added, tied to the chain on both ends.\"\"\"\n    return {\"from_seq\": from_seq, \"to_seq\": to_seq,\n            \"prev_sha256\": chain[from_seq - 2][1] if from_seq > 1 else None, \"head_sha256\": chain[to_seq - 1][1]}\n\n\ndef _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:\n    \"\"\"Validate that an orphan's entries_b64 matches the attested range.\n    Returns None if valid, otherwise a short problem string containing\n    'range', 'chain', or 'head' for the respective failure modes.\"\"\"\n    entries_b64 = orphan[\"body\"].get(\"entries_b64\")\n    if not isinstance(entries_b64, list):\n        return \"range: missing or invalid entries_b64\"\n    \n    from_seq = pred.get(\"from_seq\")\n    to_seq = pred.get(\"to_seq\")\n    if not isinstance(from_seq, int) or not isinstance(to_seq, int):\n        return \"range: invalid predicate\"\n    \n    expected_count = to_seq - from_seq + 1\n    if len(entries_b64) != expected_count:\n        return f\"range: expected {expected_count} entries, got {len(entries_b64)}\"\n    \n    prev_sha256 = pred.get(\"prev_sha256\")\n    head_sha256 = pred.get(\"head_sha256\")\n    \n    last_sha = None\n    for i, entry_b64 in enumerate(entries_b64):\n        try:\n            entry_raw = base64.b64decode(entry_b64, validate=True)\n        except ValueError:\n            return f\"chain: entry {i} not valid base64\"\n        \n        try:\n            entry = parse_json(entry_raw, f\"orphan entry {i}\")\n        except Bad as ex:\n            return f\"chain: entry {i} invalid ({ex})\"\n        \n        # Check it's a valid entry structure\n        if not isinstance(entry, dict) or set(entry) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n            return f\"chain: entry {i} malformed\"\n        \n\n[323 more lines in file. Use offset=340 to continue.]"},"isError":false,"durationMs":2}
