$ cd /workspace/record && python3 -c "
import record as R
import tempfile
import os
import json
import datetime

d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))

PLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py 
...', 'decision_rule': 'Ir lower by > 2 SE'}

# Use ingest to create entries
with open(os.path.join(d, 'inbox', 'a.json'), 'w') as f:
    json.dump({'kind': 'plan', 'body': PLAN}, f)
with open(os.path.join(d, 'inbox', 'b.json'), 'w') as f:
    json.dump({'kind': 'plan', 'body': dict(PLAN, claim='second')}, f)

R.main(['--ledger', d, 'ingest'])
print('After ingest:')
print('entries:', os.listdir(os.path.join(d, 'entries')))
print('anchors:', os.listdir(os.path.join(d, 'anchors')))

# Now load chain
chain, _ = R.load_chain(d)
print('chain length:', len(chain))

# Create anchor files
os.makedirs(os.path.join(d, 'anchors'), exist_ok=True)
with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:
    f.write('{}')
with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:
    f.write(b'stub')

# Stub check_sigstore to return a fixed attestation time (72 hours ago)
old_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=72)).timestamp())
print('old_time:', old_time)
print('now:', int(R.datetime.datetime.now(R.datetime.timezone.utc).timestamp()))

sigstore_stub = lambda *a: (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')
ots_stub = lambda *a: None

saved_sig = R.check_sigstore
saved_ots = R.check_ots
R.check_sigstore = sigstore_stub
R.check_ots = ots_stub

try:
    rc = R.main(['--ledger', d, 'check-anchors'])
    print('rc without max-pending-hours:', rc)
    rc = R.main(['--ledger', d, 'check-anchors', '--max-pending-hours', '48'])
    print('rc with max-pending-hours=48:', rc)
finally:
    R.check_sigstore = saved_sig
    R.check_ots = saved_ots
"

