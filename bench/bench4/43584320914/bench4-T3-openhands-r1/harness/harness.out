$ cd /workspace/record && python3 -c "
import record as R
import tempfile
import os
import json

d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))
os.makedirs(os.path.join(d, 'entries'))
os.makedirs(os.path.join(d, 'anchors'))

PLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py 
...', 'decision_rule': 'Ir lower by > 2 SE'}

# Create two entries
import hashlib

def canonical(obj):
    return json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(',', 
':'), allow_nan=False).encode('utf-8')

e1 = {'seq': 1, 'prev': None, 'kind': 'plan', 'body': PLAN}
raw1 = canonical(e1)
with open(os.path.join(d, 'entries', '000001.json'), 'wb') as f:
    f.write(raw1)

e2 = {'seq': 2, 'prev': hashlib.sha256(raw1).hexdigest(), 'kind': 'plan', 
'body': dict(PLAN, claim='second')}
raw2 = canonical(e2)
with open(os.path.join(d, 'entries', '000002.json'), 'wb') as f:
    f.write(raw2)

