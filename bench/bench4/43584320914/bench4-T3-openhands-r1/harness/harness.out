   300      """Verify offline that a bundle is an attestation of this digest, 
signed by exactly this workflow on this ref.
   301      Returns (integrated_time, predicate). Wrong data is Bad; a missing 
library is CantCheck."""
   302      try:
   303          from sigstore.models import Bundle
   304          from sigstore.verify import Verifier, policy
   305          from sigstore.errors import Error as SigstoreError
   306      except ImportError as ex:
   307          raise CantCheck(f"sigstore-python isn't usable ({ex}); pip 
install sigstore==4.5.1 in a virtualenv")
