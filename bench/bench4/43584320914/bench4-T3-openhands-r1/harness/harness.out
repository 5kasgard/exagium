   409                               "writer_commit": commit})
   410          except Bad as ex:
   411              bad.append(str(ex))
   412          except CantCheck as ex:
   413              cant.append(f"anchors/{n}: {ex}")
   414      for lo, hi, commit in sorted(ranges):
