import record as R
import tempfile
import os
import json
import datetime
import io
import contextlib

d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))

PLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py 
...', 'decision_rule': 'Ir lower by > 2 SE'}

def run_cmd(*args):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(['--ledger', d, *args])
    return rc, out.getvalue(), err.getvalue()

def propose(name, kind, body):
    with open(os.path.join(d, 'inbox', name), 'w') as f:
        json.dump({'kind': kind, 'body': body}, f)

propose('a.json', 'plan', PLAN)
propose('b.json', 'plan', dict(PLAN, claim='second'))
print('ingest:', run_cmd('ingest'))

chain, _ = R.load_chain(d)
print('chain length:', len(chain))

os.makedirs(os.path.join(d, 'anchors'))
with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:
    f.write(b'stub')
with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:
    f.write('{}')

old_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=72)).timestamp())
sigstore_stub = lambda *a: (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')
ots_stub = lambda *a: None

saved_sig = R.check_sigstore
saved_ots = R.check_ots
R.check_sigstore = sigstore_stub
R.check_ots = ots_stub

try:
    rc, out, err = run_cmd('check-anchors')
    print('rc without max-pending-hours:', rc)
    print('out:', out)
    print('err:', err)
finally:
    R.check_sigstore = saved_sig
    R.check_ots = saved_ots
"

