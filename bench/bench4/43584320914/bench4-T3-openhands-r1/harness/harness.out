1][1], a.repo, a.workflow, a.ref)
   404                  if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
   405                          or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
   406                      raise Bad(f"anchors/{n}: attested range {pred!r} 
doesn't match this chain")
   407                  ranges.append((pred["from_seq"], seq, commit))
   408                  rows.append({"anchor": n, "kind": "sigstore", "entries":
