   445  def _code_changed(a, c1, c2):
   446      """True/False if anything under record/ or .github/ differs between 
two commits; "unknown" without that history."""
   447      if _git(a, "cat-file", "-e", f"{c1}^{{commit}}") is None or _git(a, 
"cat-file", "-e", f"{c2}^{{commit}}") is None:
   448          return "unknown (commit not in this clone)"
   449      root = os.path.dirname(os.path.abspath(a.ledger))
   450      r = subprocess.run(["git", "-C", root, "diff", "--quiet", c1, c2, 
"--", "record", ".github"])
   451      return {0: False, 1: True}.get(r.returncode, "unknown")
