   389      for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
   390          n = os.path.basename(path)
   391          m = ANCHOR_NAME.fullmatch(n)
   392          seq = int(m.group(1))
   393          if m.group(2) == "ots":
   394              stamped.add(seq)
   395          try:
   396              if not 1 <= seq <= len(chain):
   397                  raise Bad(f"anchors/{n}: no entry {seq}")
   398              raw = open(os.path.join(a.ledger, "entries", 
