    def test_max_pending_hours_catches_stuck_ots_proof(self):
            # Test that --max-pending-hours flags a pending OTS proof older than
the threshold
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            os.makedirs(os.path.join(self.d, "anchors"))
            # Create a stub .ots file (required for the check to proceed to 
check the pending status)
            open(os.path.join(self.d, "anchors", "000002.ots"), 
"wb").write(b"stub")
            # Stub check_sigstore to return a fixed attestation time (72 hours 
ago)
            old_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=72)).timestamp())
            sigstore_stub = lambda *a: (old_time, R.range_predicate(chain, 1, 
2), "c0ffee")
            # Stub check_ots to return None (pending)
            ots_stub = lambda *a: None
            stubs = {"check_sigstore": sigstore_stub, "check_ots": ots_stub}
            saved = {k: getattr(R, k) for k in stubs}
            try:
                for k, f in stubs.items():
                    setattr(R, k, f)
                # Without --max-pending-hours, pending is fine (exit 0)
                rc, _, _ = self.run_cmd("check-anchors")
                self.assertEqual(rc, 0)
                # With --max-pending-hours=48, should fail because 72 > 48
                rc, _, err = self.run_cmd("check-anchors", 
"--max-pending-hours", "48")
                self.assertEqual(rc, 1)
                self.assertIn("still pending 72 h", err)
                # With --max-pending-hours=72, should fail because 72 >= 72
                rc, _, err = self.run_cmd("check-anchors", 
"--max-pending-hours", "72")
                self.assertEqual(rc, 1)
                self.assertIn("still pending 72 h", err)
                # With --max-pending-hours=73, should pass because 72 < 73
                rc, _, _ = self.run_cmd("check-anchors", "--max-pending-hours", 
"73")
                self.assertEqual(rc, 0)
            finally:
                for k, f in saved.items():
                    setattr(R, k, f)

  new_str: 
    def test_max_pending_hours_catches_stuck_ots_proof(self):
            # Test that --max-pending-hours flags a pending OTS proof older than
the threshold
            self._two_entries()
            chain, _ = R.load_chain(self.d)
            os.makedirs(os.path.join(self.d, "anchors"))
            # Create stub .ots and .sigstore.json files (required for the check 
to proceed)
            open(os.path.join(self.d, "anchors", "000002.ots"), 
"wb").write(b"stub")
            open(os.path.join(self.d, "anchors", "000002.sigstore.json"), 
"w").write("{}")
            # Stub check_sigstore to return a fixed attestation time (72 hours 
ago)
            old_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=72)).timestamp())
            sigstore_stub = lambda *a: (old_time, R.range_predicate(chain, 1, 
2), "c0ffee")
            # Stub check_ots to return None (pending)
            ots_stub = lambda *a: None
            stubs = {"check_sigstore": sigstore_stub, "check_ots": ots_stub}
            saved = {k: getattr(R, k) for k in stubs}
            try:
                for k, f in stubs.items():
                    setattr(R, k, f)
                # Without --max-pending-hours, pending is fine (exit 0)
                rc, _, _ = self.run_cmd("check-anchors")
                self.assertEqual(rc, 0)
                # With --max-pending-hours=48, should fail because 72 > 48
                rc, _, err = self.run_cmd("check-anchors", 
"--max-pending-hours", "48")
                self.assertEqual(rc, 1)
                self.assertIn("still pending 72 h", err)
                # With --max-pending-hours=72, should fail because 72 >= 72
                rc, _, err = self.run_cmd("check-anchors", 
"--max-pending-hours", "72")
                self.assertEqual(rc, 1)
                self.assertIn("still pending 72 h", err)
                # With --max-pending-hours=73, should pass because 72 < 73
                rc, _, _ = self.run_cmd("check-anchors", "--max-pending-hours", 
"73")
                self.assertEqual(rc, 0)
            finally:
                for k, f in saved.items():
                    setattr(R, k, f)

