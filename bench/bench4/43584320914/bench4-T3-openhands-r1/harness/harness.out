   383  def cmd_check_anchors(a):
   384      """Every anchor must be right, the writer's Sigstore ranges must 
cover entries 1..head with no gap or overlap,
   385      and every range head must have its OpenTimestamps proof.
   386      Checks every anchor even after a failure; exit 1 if anything was 
wrong, else 2 if anything couldn't be checked."""
