known[int(json.load(open(path))["verificationMaterial"]["tlogEntries"][0]["logIn
dex"])] = os.path.basename(path)
   227              except (ValueError, KeyError, IndexError, TypeError) as ex:
   228                  raise Bad(f"{os.path.basename(path)}: malformed bundle 
({ex})")
   229      explained = {e["body"]["log_index"]: e for e, _ in chain if 
e["kind"] == "orphan"}
