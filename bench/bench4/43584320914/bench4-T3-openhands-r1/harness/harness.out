    def cmd_check_anchors(a):
        """Every anchor must be right, the writer's Sigstore ranges must cover 
entries 1..head with no gap or overlap,
        and every range head must have its OpenTimestamps proof.
        Checks every anchor even after a failure; exit 1 if anything was wrong, 
else 2 if anything couldn't be checked."""
        chain, _ = load_chain(a.ledger)
        rows, bad, cant, ranges, stamped = [], [], [], [], set()
        # Map from range head seq to its Sigstore attestation time (Unix 
timestamp)
        range_head_attest_time = {}
        # Track OTS results: seq -> (ots_proof_path, block_time_or_None)
        ots_results = {}
        for path in _listdir(a.ledger, "anchors", ANCHOR_NAME, "file in 
anchors"):
            n = os.path.basename(path)
            m = ANCHOR_NAME.fullmatch(n)
            seq = int(m.group(1))
            if m.group(2) == "ots":
                stamped.add(seq)
            try:
                if not 1 <= seq <= len(chain):
                    raise Bad(f"anchors/{n}: no entry {seq}")
                raw = open(os.path.join(a.ledger, "entries", f"{seq:06d}.json"),
"rb").read()
                if m.group(2) == "ots":
                    t = check_ots(path, raw, a.explorer)
                    rows.append({"anchor": n, "kind": "opentimestamps", 
"existed_by": iso(t) or "pending"})
                    # Track OTS result for this seq (range head)
                    ots_results[seq] = (path, t)
                else:
                    t, pred, commit = check_sigstore(path, chain[seq - 1][1], 
a.repo, a.workflow, a.ref)
                    if not isinstance(pred, dict) or not 
isinstance(pred.get("from_seq"), int) or pred.get("to_seq") != seq \
                            or not 1 <= pred["from_seq"] <= seq or pred != 
range_predicate(chain, pred["from_seq"], seq):
                        raise Bad(f"anchors/{n}: attested range {pred!r} doesn't
match this chain")
                    ranges.append((pred["from_seq"], seq, commit))
                    rows.append({"anchor": n, "kind": "sigstore", "entries": 
f"{pred['from_seq']}-{seq}", "existed_by": iso(t),
                                 "writer_commit": commit})
                    # Remember the attestation time for this range head (seq == 
pred["to_seq"])
                    range_head_attest_time[seq] = t
            except Bad as ex:
                bad.append(str(ex))
            except CantCheck as ex:
                cant.append(f"anchors/{n}: {ex}")
        for lo, hi, commit in sorted(ranges):
            # the writer stamps every range head before it attests, and a failed
stamp stops the run: a missing proof
            # was removed (found by Z, 2026-11-06)
            if hi not in stamped:
                bad.append(f"anchors/{hi:06d}.ots is missing, though the writer 
stamps every range head before attesting")
        # Check for stuck pending OTS proofs if --max-pending-hours is given
        if getattr(a, "max_pending_hours", None) is not None:
            now = int(datetime.datetime.now(datetime.timezone.utc).timestamp())
            max_seconds = a.max_pending_hours * 3600
            for lo, hi, commit in sorted(ranges):
                if hi not in stamped:
                    continue  # missing .ots file is already reported above
                # Check if this range head's OTS proof is still pending
                if hi in ots_results:
                    ots_path, ots_time = ots_results[hi]
                    if ots_time is None:  # pending
                        attest_time = range_head_attest_time.get(hi)
                        if attest_time is not None:
                            hours_pending = (now - attest_time) // 3600
                            if hours_pending >= a.max_pending_hours:
                                bad.append(f"anchors/{hi:06d}.ots: still pending
{hours_pending} h (attested {iso(attest_time)})")
        covered, changes, prev_commit = 0, [], None
        for lo, hi, commit in sorted(ranges):
            if lo != covered + 1:
                bad.append(f"the writer's ranges {'overlap' if lo <= covered 
else 'leave a gap'} at entry {min(lo, covered + 1)}")
            covered = max(covered, hi)
            if prev_commit:  # did the writer's code change between these two 
runs? (information: a stranger reads the diff)
                changes.append({"entries": f"{lo}-{hi}", "from_commit": 
prev_commit, "to_commit": commit,
                                "writer_code_changed": _code_changed(a, 
prev_commit, commit)})
            prev_commit = commit
        if covered < len(chain):
            bad.append(f"entries {covered + 1}-{len(chain)} were never attested 
by the writer")
        print(json.dumps({"anchors": rows, "entries": len(chain), 
"writer_attested_through": covered,
                          "writer_runs": changes, "wrong": bad, 
"could_not_check": cant}, indent=1))
        for x in bad:
            print(f"BAD: {x}", file=sys.stderr)
        for x in cant:
            print(f"CAN'T CHECK: {x}", file=sys.stderr)
        return 1 if bad else 2 if cant else 0

