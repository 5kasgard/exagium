$ cd /workspace/record && python3 -c "
import record as R
import tempfile
import os
import json
import datetime
import io
import contextlib

d = tempfile.mkdtemp()
os.makedirs(os.path.join(d, 'inbox'))

PLAN = {'by': 'proposer-agent', 'claim': 'mlp beats linear', 'test': 'count.py 
...', 'decision_rule': 'Ir lower by > 2 SE'}

def run_cmd(*args):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = R.main(['--ledger', d, *args])
    return rc, out.getvalue(), err.getvalue()

def propose(name, kind, body):
    with open(os.path.join(d, 'inbox', name), 'w') as f:
        json.dump({'kind': kind, 'body': body}, f)

# Create 4 entries (2 ranges)
propose('a.json', 'plan', PLAN)
propose('b.json', 'plan', dict(PLAN, claim='second'))
propose('c.json', 'plan', dict(PLAN, claim='third'))
propose('d.json', 'plan', dict(PLAN, claim='fourth'))
print('ingest:', run_cmd('ingest'))

chain, _ = R.load_chain(d)
print('chain length:', len(chain))

os.makedirs(os.path.join(d, 'anchors'))
# Range 1: entries 1-2 (attested 72 hours ago, pending OTS)
# Range 2: entries 3-4 (attested 1 hour ago, pending OTS)
with open(os.path.join(d, 'anchors', '000002.ots'), 'wb') as f:
    f.write(b'stub')
with open(os.path.join(d, 'anchors', '000002.sigstore.json'), 'w') as f:
    f.write('{}')
with open(os.path.join(d, 'anchors', '000004.ots'), 'wb') as f:
    f.write(b'stub')
with open(os.path.join(d, 'anchors', '000004.sigstore.json'), 'w') as f:
    f.write('{}')

old_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=72)).timestamp())
recent_time = int((R.datetime.datetime.now(R.datetime.timezone.utc) - 
R.datetime.timedelta(hours=1)).timestamp())

def sigstore_stub(path, *a):
    seq = int(os.path.basename(path).split('.')[0])
    if seq == 2:
        return (old_time, R.range_predicate(chain, 1, 2), 'c0ffee1')
    elif seq == 4:
        return (recent_time, R.range_predicate(chain, 3, 4), 'c0ffee2')
    return (old_time, R.range_predicate(chain, 1, 2), 'c0ffee')

ots_stub = lambda *a: None

saved_sig = R.check_sigstore
saved_ots = R.check_ots
R.check_sigstore = sigstore_stub
R.check_ots = ots_stub

try:
    # With --max-pending-hours=48, should fail because range 1 (72h) > 48
    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '48')
    print('Test - mixed ranges, max-pending-hours=48 (should fail for range 1): 
rc =', rc)
    if rc != 0:
        print('  err:', err)
    
    # With --max-pending-hours=72, should fail because range 1 (72h) >= 72
    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '72')
    print('Test - mixed ranges, max-pending-hours=72 (should fail for range 1): 
rc =', rc)
    if rc != 0:
        print('  err:', err)
    
    # With --max-pending-hours=73, should pass
    rc, out, err = run_cmd('check-anchors', '--max-pending-hours', '73')
    print('Test - mixed ranges, max-pending-hours=73 (should pass): rc =', rc)
    if rc != 0:
        print('  err:', err)
finally:
    R.check_sigstore = saved_sig
    R.check_ots = saved_ots
"

