+def _orphan_entries_problem(orphan: dict, pred: dict) -> str | None:
+    """Check that an orphan's hidden entries match the attested range.
+    
+    Returns None if the entries exactly match the attested range (count, chain, head).
+    Otherwise returns a short problem string containing:
+    - 'range' when the count is wrong
+    - 'chain' when an entry's prev doesn't link
+    - 'head' when the last hash doesn't match head_sha256
+    """
+    if "entries_b64" not in orphan["body"]:
+        return "missing entries_b64"
+    
+    entries_b64 = orphan["body"]["entries_b64"]
+    from_seq = pred.get("from_seq")
+    to_seq = pred.get("to_seq")
+    prev_sha256 = pred.get("prev_sha256")
+    head_sha256 = pred.get("head_sha256")
+    
+    if from_seq is None or to_seq is None:
+        return "predicate missing from_seq or to_seq"
+    
+    expected_count = to_seq - from_seq + 1
+    if len(entries_b64) != expected_count:
+        return f"range count mismatch: expected {expected_count}, got {len(entries_b64)}"
+    
+    if not entries_b64:
+        if head_sha256 is not None:
+            return "head mismatch on empty range"
+        return None
+    
+    prev = prev_sha256
+    for i, entry_b64 in enumerate(entries_b64):
+        try:
+            entry_bytes = base64.b64decode(entry_b64, validate=True)
+        except ValueError:
+            return f"entries_b64[{i}]: invalid base64"
+        
+        try:
+            entry = parse_json(entry_bytes, f"orphan entry {i}")
+        except Bad as e:
+            return f"entries_b64[{i}]: {e}"
+        
+        if not isinstance(entry, dict) or set(entry) != {"seq", "prev", "kind", "written_at", "body"}:
+            return f"entries_b64[{i}]: invalid entry structure"
+        
+        if entry.get("prev") != prev:
+            return f"chain break at index {i}: expected prev {prev}, got {entry.get('prev')}"
+        
+        prev = hashlib.sha256(entry_bytes).hexdigest()
+    
+    if prev != head_sha256:
+        return f"head mismatch: computed {prev}, expected {head_sha256}"
+    
+    return None
+
+
