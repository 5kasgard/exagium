s for different bytes\")\n   350\t    times = []\n   351\t    for msg, att in atts:\n   352\t        if not isinstance(att, BitcoinBlockHeaderAttestation):\n   353\t            continue\n   354\t        headers = set()\n   355\t        for base in explorers:\n   356\t            bh = _get(f\"{base}/block-height/{att.height}\")\n   357\t            if bh is None:  # 404: either the block doesn't exist (a forged height) or the explorer is behind\n   358\t                tip = _get(f\"{base}/blocks/tip/height\")\n   359\t                if tip is not None and att.height > int(tip):\n   360\t                    raise Bad(f\"{name}: claims block {att.height}, beyond the chain tip {int(tip)}\")\n   361\t                raise CantCheck(f\"{base}: no block at height {att.height}\")\n   362\t            bh = bh.decode().strip()\n   363\t            hdr = _get(f\"{base}/block/{bh}/header\")\n   364\t            if hdr is None:\n   365\t                raise CantCheck(f\"{base}: no header for block {bh}\")\n   366\t            hdr = bytes.fromhex(hdr.decode().strip())\n   367\t            if hashlib.sha256(hashlib.sha256(hdr).digest()).digest()[::-1].hex() != bh:\n   368\t                raise CantCheck(f\"{base}: header doesn't hash to block {bh} (explorer fault)\")\n   369\t            headers.add(hdr)\n   370\t        if len(headers) != 1:\n   371\t            raise CantCheck(f\"explorers disagree about block {att.height}\")\n   372\t        hdr = headers.pop()\n   373\t        if hdr[36:68] != msg:\n   374\t            raise Bad(f\"{name}: path doesn't reach block {att.height}'s merkle root\")\n   375\t        times.append(int.from_bytes(hdr[68:72], \"little\"))\n   376\t    return min(times) if times else None\n   377\t\n   378\t\n   379\tdef iso(t):\n   380\t    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\") if t else None\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind