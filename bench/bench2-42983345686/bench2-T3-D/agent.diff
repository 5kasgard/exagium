       raise CantCheck(f\"Rekor lists {u} but won't return it\")\n   554\t            v = next(iter(json.loads(got).values()))\n   555\t            idx = int(v[\"logIndex\"])\n   556\t            seen.add(idx)\n   557\t            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n   558\t            if idx in known:\n   559\t                continue\n   560\t            if idx not in explained:\n   561\t                unknown.append(row)\n   562\t                continue\n   563\t            o = explained[idx]\n   564\t            body = json.loads(base64.b64decode(v[\"body\"]))\n   565\t            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n   566\t            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n   567\t                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n   568\t                continue\n   569\t            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n   570\t            head = pred.get(\"head_sha256\")\n   571\t            problem = _orphan_entries_problem(o, pred)\n   572\t            if problem:\n   573\t                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n   574\t                continue\n   575\t            if head in published and head not in current:\n   576\t                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n   577\t                continue\n   578\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   579\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   580\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   581\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   582\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   583\t    for x in bad:\n   584\t        print(f\"BAD: {x}\", file=sys.stderr)\n   585\t    return 1 if unknown or missing or bad else 0\n   586\t\n   587\t\n   588\tdef cmd_range(a):\n   589\t    chain, _ = load_chain(a.ledger)\n   590\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   591\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   592\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   593\t    return 0\n   594\t\n   595\t\n   596\tdef main(argv=None):\n   597\t    here = os.path.dirname(os.path.abspath(__file__))\n   598\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   599\t    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n   600\t    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind":"FileEditorObservation"},"action_id":"7a7f33c1-3b59-4fbf-8f06-bee0c1c0b79f","extended_content":[],"kind":"ObservationEvent"}
