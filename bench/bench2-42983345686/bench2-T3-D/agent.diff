chain, pred[\"from_seq\"], seq):\n   406\t                    raise Bad(f\"anchors/{n}: attested range {pred!r} doesn't match this chain\")\n   407\t                ranges.append((pred[\"from_seq\"], seq, commit))\n   408\t                rows.append({\"anchor\": n, \"kind\": \"sigstore\", \"entries\": f\"{pred['from_seq']}-{seq}\", \"existed_by\": iso(t),\n   409\t                             \"writer_commit\": commit})\n   410\t        except Bad as ex:\n   411\t            bad.append(str(ex))\n   412\t        except CantCheck as ex:\n   413\t            cant.append(f\"anchors/{n}: {ex}\")\n   414\t    for lo, hi, commit in sorted(ranges):\n   415\t        # the writer stamps every range head before it attests, and a failed stamp stops the run: a missing proof\n   416\t        # was removed (found by Z, 2026-11-06)\n   417\t        if hi not in stamped:\n   418\t            bad.append(f\"anchors/{hi:06d}.ots is missing, though the writer stamps every range head before attesting\")\n   419\t    covered, changes, prev_commit = 0, [], None\n   420\t    for lo, hi, commit in sorted(ranges):\n   421\t        if lo != covered + 1:\n   422\t            bad.append(f\"the writer's ranges {'overlap' if lo <= covered else 'leave a gap'} at entry {min(lo, covered + 1)}\")\n   423\t        covered = max(covered, hi)\n   424\t        if prev_commit:  # did the writer's code change between these two runs? (information: a stranger reads the diff)\n   425\t            changes.append({\"entries\": f\"{lo}-{hi}\", \"from_commit\": prev_commit, \"to_commit\": commit,\n   426\t                            \"writer_code_changed\": _code_changed(a, prev_commit, commit)})\n   427\t        prev_commit = commit\n   428\t    if covered < len(chain):\n   429\t        bad.append(f\"entries {covered + 1}-{len(chain)} were never attested by the writer\")\n   430\t    print(json.dumps({\"anchors\": rows, \"entries\": len(chain), \"writer_attested_through\": covered,\n   431\t                     