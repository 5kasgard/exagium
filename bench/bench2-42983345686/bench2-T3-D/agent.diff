 \"writer_runs\": changes, \"wrong\": bad, \"could_not_check\": cant}, indent=1))\n   432\t    for x in bad:\n   433\t        print(f\"BAD: {x}\", file=sys.stderr)\n   434\t    for x in cant:\n   435\t        print(f\"CAN'T CHECK: {x}\", file=sys.stderr)\n   436\t    return 1 if bad else 2 if cant else 0\n   437\t\n   438\t\n   439\tdef _git(a, *args):\n   440\t    root = os.path.dirname(os.path.abspath(a.ledger))\n   441\t    r = subprocess.run([\"git\", \"-C\", root, *args], capture_output=True)\n   442\t    return r.stdout if r.returncode == 0 else None\n   443\t\n   444\t\n   445\tdef _code_changed(a, c1, c2):\n   446\t    \"\"\"True/False if anything under record/ or .github/ differs between two commits; \"unknown\" without that history.\"\"\"\n   447\t    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n   448\t        return \"unknown (commit not in this clone)\"\n   449\t    root = os.path.dirname(os.path.abspath(a.ledger))\n   450\t    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record\", \".github\"])\n   451\t    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n   452\t\n   453\t\n   454\tdef _orphan_entries_problem(o, pred):\n   455\t    \"\"\"The orphan must publish the hidden entries: canonical, consecutive from from_seq, chained from prev_sha256,\n   456\t    ending at head_sha256. Returns a description of the first problem, or None.\"\"\"\n   457\t    try:\n   458\t        raws = [base64.b64decode(x) for x in o[\"body\"][\"entries_b64\"]]\n   459\t        if not isinstance(pred.get(\"from_seq\"), int) or len(raws) != pred.get(\"to_seq\", -1) - pred[\"from_seq\"] + 1:\n   460\t            return \"its entries don't match the attested range\"\n   461\t        prev = pred.get(\"prev_sha256\")\n   462\t        for i, raw in enumerate(raws):\n   463\t            e = parse_canonical(raw, f\"hidden entry {i + 1}\")\n   464\t      