wn\" without that history.\"\"\"\n   434\t    if _git(a, \"cat-file\", \"-e\", f\"{c1}^{{commit}}\") is None or _git(a, \"cat-file\", \"-e\", f\"{c2}^{{commit}}\") is None:\n   435\t        return \"unknown (commit not in this clone)\"\n   436\t    root = os.path.dirname(os.path.abspath(a.ledger))\n   437\t    r = subprocess.run([\"git\", \"-C\", root, \"diff\", \"--quiet\", c1, c2, \"--\", \"record/record.py\", a.workflow])\n   438\t    return {0: False, 1: True}.get(r.returncode, \"unknown\")\n   439\t\n   440\t\n   441\tdef _published_entry_hashes(a, rev):\n   442\t    \"\"\"sha256 of every version of every entry file ever committed in rev's history.\"\"\"\n   443\t    raw = _git(a, \"log\", rev, \"--format=\", \"--raw\", \"--no-abbrev\", \"--\", \"ledger/entries\")\n   444\t    if raw is None:\n   445\t        raise CantCheck(f\"no git history for {rev} next to the ledger (run monitor in a full clone)\")\n   446\t    blobs = {ln.split()[3] for ln in raw.decode().splitlines() if ln.startswith(\":\") and ln.split()[3].strip(\"0\")}\n   447\t    out = set()\n   448\t    for b in blobs:\n   449\t        data = _git(a, \"cat-file\", \"blob\", b)\n   450\t        if data is not None:\n   451\t            out.add(hashlib.sha256(data).hexdigest())\n   452\t    return out\n   453\t\n   454\t\n   455\tdef _pages(url):\n   456\t    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n   457\t    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n   458\t    import urllib.parse\n   459\t    base = url.split(\"?\")[0]\n   460\t    out = []\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind":"FileEditorObservation"},"action_id":"413c5bd2-7e14-409b-9965-508eeb528020","extended_content":[],"kind":"ObservationEvent"}
