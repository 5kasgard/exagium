es Rekor's payload hash and whose entries were\n   487\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   488\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   489\t    chain, _ = load_chain(a.ledger)\n   490\t    current = {h for _, h in chain}\n   491\t    known, bad = {}, []\n   492\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   493\t        if path.endswith(\".sigstore.json\"):\n   494\t            try:\n   495\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   496\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   497\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   498\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   499\t    if a.only_ref:\n   500\t        refs, activity = [a.only_ref], []\n   501\t    else:\n   502\t        refs, activity = _refs(a.repo)\n   503\t        for x in activity:\n   504\t            if x.get(\"activity_type\") == \"force_push\" and x.get(\"ref\") == a.ledger_ref:\n   505\t                bad.append(f\"force push to {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   506\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   507\t    seen, unknown, orphans = set(), [], []\n   508\t    for ref in refs:\n   509\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n   510\t        if uuids is None:\n   511\t            raise CantCheck(\"Rekor's index returned 404\")\n   512\t        for u in json.loads(uuids):\n   513\t            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n   514\t            if got is None:\n   515\t                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n   516\t            v = next(iter(json.loads(got).values()))\n   517\t            idx = int(v[\"logIndex\"])\n   518\t            seen.add(idx)\n   519\t            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n   520\t            if idx in known:\n   521\t                continue\n   522\t            if idx not in explained:\n   523\t                unknown.append(row)\n   524\t                continue\n   525\t            o = explained[idx]\n   526\t            body = json.loads(base64.b64decode(v[\"body\"]))\n   527\t            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n   528\t            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n   529\t                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n   530\t                continue\n   531\t            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n   532\t            head = pred.get(\"head_sha256\")\n   533\t            if head in published and head not in current:\n   534\t                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n   535\t                continue\n   536\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   537\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   538\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   539\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   540\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   541\t    for x in bad:\n   542\t        print(f\"BAD: {x}\", file=sys.stderr)\n   543\t    return 1 if unknown or missing or bad else 0\n   544\t\n   545\t\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind":"FileEditorObservation"},"action_id":"ce9ef3b1-bf4e-462b-b1f0-4dfdd7d368a8","extended_content":[],"kind":"ObservationEvent"}
