d on {a.git_rev} and later removed\")\n   275\t                continue\n   276\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   277\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   278\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   279\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   280\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   281\t    for x in bad:\n   282\t        print(f\"BAD: {x}\", file=sys.stderr)\n   283\t    return 1 if unknown or missing or bad else 0\n   284\t\n   285\t\n   286\tdef cmd_range(a):\n   287\t    chain, _ = load_chain(a.ledger)\n   288\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   289\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   290\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   291\t    return 0\n   292\t\n   293\t\n   294\tdef main(argv=None):\n   295\t    here = os.path.dirname(os.path.abspath(__file__))\n   296\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   297\t    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n   298\t    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n   299\t    sub.add_parser(\"ingest\")\n   300\t    sub.add_parser(\"verify\")\n   301\t    sub.add_parser(\"head\")\n   302\t    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n   303\t    rp.add_argument(\"from_seq\", type=int)\n   304\t    rp.add_argument(\"to_seq\", type=int)\n   305\t    for name in (\"check-anchors\", \"monitor\"):\n   306\t        p = sub.add_parser(name)\n   307\t        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n   308\t        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n   309\t        if name == \"check-anchors\":\n   310\t            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n   311\t            p.add_argument(\"--explorer\", action=\"append\", default=None,\n   312\t                           help=\"esplora API base; default blockstream.info and mempool.space\")\n   313\t        else:\n   314\t            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n   315\t            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n   316\t            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n   317\t    a = ap.parse_args(argv)\n   318\t    if getattr(a, \"explorer\", \"x\") is None:\n   319\t        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n   320\t    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n   321\t          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n   322\t    try:\n   323\t        return fn(a)\n   324\t    except Bad as ex:\n   325\t        print(f\"BAD: {ex}\", file=sys.stderr)\n   326\t        return 1\n   327\t    except CantCheck as ex:\n   328\t        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n   329\t        return 2\n   330\t    except Exception as ex:  # a failure is never reported as a verdict\n   331\t        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n   332\t        return 3\n   333\t\n   334\t\n   335\tif __name__ == \"__main__\":\n   336\t    sys.exit(main())\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind":"FileEditorObservation"},"action_id":"8f88dfd7-071a-4261-9350-3a75965b347f","extended_content":[],"kind":"ObservationEvent"}
