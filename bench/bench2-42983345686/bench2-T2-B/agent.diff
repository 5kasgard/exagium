\t    d = {}\n    73\t    for k, v in pairs:\n    74\t        if k in d:\n    75\t            raise Bad(f\"duplicate key {k!r}\")\n    76\t        d[k] = v\n    77\t    return d\n    78\t\n    79\t\n    80\tdef _no_constants(c):\n    81\t    raise Bad(f\"{c} isn't JSON\")\n    82\t\n    83\t\n    84\tdef parse_json(raw, where):\n    85\t    try:\n    86\t        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    87\t    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n    88\t        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n    89\t\n    90\t\n    91\tdef parse_canonical(raw, where):\n    92\t    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    93\t    obj = parse_json(raw, where)\n    94\t    _check_value(obj, where)\n    95\t    if canonical(obj) != raw:\n    96\t        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    97\t    return obj\n    98\t\n    99\t\n   100\t# ---------- schema ----------\n   101\tdef _need(d, key, typ, where):\n   102\t    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n   103\t        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n   104\t    return d[key]\n   105\t\n   106\t\n   107\tdef _name(d, where):\n   108\t    v = _need(d, \"by\", str, where)\n   109\t    if not NAME.fullmatch(v):\n   110\t        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n   111\t    return v\n   112\t\n   113\t\n   114\tdef _check_digests(lst, where):\n   115\t    if not isinstance(lst, list):\n   116\t        raise Bad(f\"{where}: must be a list\")\n   117\t    for i, x in enumerate(lst):\n   118\t        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n   119\t                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n   120\t            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n   121\t\n   122\t\n   123\tdef check_body(kind, body, where):\n   124\t    if not isinstance(body, dict):\n   125\t        raise Bad(f\"{where}: body must be an object\")\n   126\t    _name(body, where)\n   127\t    if kind == \"plan\":\n   128\t        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n   129\t        for k in (\"claim\", \"test\", \"decision_rule\"):\n   130\t            if not _need(body, k, str, where).strip():\n   131\t                raise Bad(f\"{where}: {k} is empty\")\n   132\t        if \"inputs\" in body:\n   133\t            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n   134\t        if \"verdict_due\" in body:\n   135\t            try:\n   136\t                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n   137\t                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n   138\t            except ValueError:\n   139\t                ok = False\n   140\t            if not ok:\n   141\t                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n   142\t    elif kind == \"verdict\":\n   143\t        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n   144\t        p = _need(body, \"plan\", dict, where)\n   145\t        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n   146\t                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n   147\t            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n   148\t        if body.get(\"outcome\") not in OUTCOMES:\n   149\t            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n   150\t        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n   151\t    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n   152\t        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\"}\n   153\t        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n   154\t            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n   155\t        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n   156\t            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n   157\t        except ValueError:\n   158\t            raise Bad(f\"{where}: statement_b64 must be base64\")\n   159\t    extra = set(body) - allowed\n   160\t    if extra:\n   161\t        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n   162\t\n   163\t\n   164\t# ---------- the chain ----------\n   165\tdef _listdir(ledger, sub, pattern, what):\n   166\t    d = os.path.join(ledger, sub)\n   167\t    if not os.path.exists(d):\n   168\t        return []\n   169\t    if os.path.islink(d) or not os.path.isdir(d):\n   170\t        raise Bad(f\"{sub}/ must be a plain directory\")\n   171\t    out = []\n   172\t    for n in sorted(os.listdir(d)):\n   173\t        p = os.path.join(d, n)\n   174\t        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n   175\t            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n   176\t        out.append(p)\n   177\t    return out\n   178\t\n   179\t\n   180\tdef load_chain(ledger):\n   181\t    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n   182\t    chain, plans, verdict_of = [], {}, {}\n   183\t    for i, path in enumerate(_listdir(ledger, \"entries\", ENTRY_NAME, \"file in entries\"), start=1):\n   184\t        name = os.path.basename(path)\n   185\t        raw = open(path, \"rb\").read()\n   186\t        e = parse_canonical(raw, name)\n   187\t        if not isinstance(e, dict) or set(e) != {\"seq\", \"prev\", \"kind\", \"written_at\", \"body\"}:\n   188\t            raise Bad(f\"{name}: entry must have exactly seq, prev,<response clipped><NOTE>Due to the max output limit, only part of this file has been shown to you. You should retry this tool after you have searched inside the file with `grep -n` in order to find the line numbers of what you are looking for.</NOTE>  for b in blobs:\n   189\t        data = _git(a, \"cat-file\", \"blob\", b)\n   190\t        if data is not None:\n   191\t            out.add(hashlib.sha256(data).hexdigest())\n   192\t    return out\n   193\t\n   194\t\n   195\tdef _pages(url):\n   196\t    \"\"\"Follow GitHub's Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n   197\t    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n   198\t    import urllib.parse\n   199\t    base = url.split(\"?\")[0]\n   200\t    out = []\n   201\t    while url:\n   202\t        body, hdrs = _get(url, headers=True)\n   203\t        if body is None:\n   204\t            raise CantCheck(f\"404 from {url}\")\n   205\t        out.extend(json.loads(body))\n   206\t        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n   207\t        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n   208\t    return out\n   209\t\n   210\t\n   211\tdef _refs(repo):\n   212\t    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n   213\t    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n   214\t    api = f\"https://api.github.com/repos/{repo}\"\n   215\t    refs = {\"refs/heads/main\"}\n   216\t    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n   217\t    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n   218\t    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n   219\t    activity = _pages(f\"{api}/activity?per_page=100\")\n   220\t    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n   221\t    return sorted(refs), activity\n   222\t\n   223\t\n   224\tdef cmd_monitor(a):\n   225\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   226\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   227\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   228\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   229\t    chain, _ = load_chain(a.ledger)\n   230\t    current = {h for _, h in chain}\n   231\t    known, bad = {}, []\n   232\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   233\t        if path.endswith(\".sigstore.json\"):\n   234\t            try:\n   235\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   236\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   237\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   238\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   239\t    if a.only_ref:\n   240\t        refs, activity = [a.only_ref], []\n   241\t    else:\n   242\t        refs, activity = _refs(a.repo)\n   243\t        for x in activity:\n   244\t            if x.get(\"activity_type\") == \"force_push\" and x.get(\"ref\") == a.ledger_ref:\n   245\t                bad.append(f\"force push to {a.ledger_ref} at {x.get('timestamp')} (rewrites