\t    d = {}\n    73\t    for k, v in pairs:\n    74\t        if k in d:\n    75\t            raise Bad(f\"duplicate key {k!r}\")\n    76\t        d[k] = v\n    77\t    return d\n    78\t\n    79\t\n    80\tdef _no_constants(c):\n    81\t    raise Bad(f\"{c} isn't JSON\")\n    82\t\n    83\t\n    84\tdef parse_json(raw, where):\n    85\t    try:\n    86\t        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    87\t    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n    88\t        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n    89\t\n    90\t\n    91\tdef parse_canonical(raw, where):\n    92\t    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    93\t    obj = parse_json(raw, where)\n    94\t    _check_value(obj, where)\n    95\t    if canonical(obj) != raw:\n    96\t        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    97\t    return obj\n    98\t\n    99\t\n   100\t# ---------- schema ----------\n   101\tdef _need(d, key, typ, where):\n   102\t    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n   103\t        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n   104\t    return d[key]\n   105\t\n   106\t\n   107\tdef _name(d, where):\n   108\t    v = _need(d, \"by\", str, where)\n   109\t    if not NAME.fullmatch(v):\n   110\t        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n   111\t    return v\n   112\t\n   113\t\n   114\tdef _check_digests(lst, where):\n   115\t    if not isinstance(lst, list):\n   116\t        raise Bad(f\"{where}: must be a list\")\n   117\t    for i, x in enumerate(lst):\n   118\t        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n   119\t                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n   120\t            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n   121\t\n   122\t\n   123\tdef check_body(kind, body, where):\n   124\t    if not isinstance(body, dict):\n   125\t        raise Bad(f\"{where}: body must be an object\")\n   126\t    _name(body, where)\n   127\t    if kind == \"plan\":\n   128\t        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n   129\t        for k in (\"claim\", \"test\", \"decision_rule\"):\n   130\t            if not _need(body, k, str, where).strip():\n   131\t                raise Bad(f\"{where}: {k} is empty\")\n   132\t        if \"inputs\" in body:\n   133\t            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n   134\t        if \"verdict_due\" in body:\n   135\t            try:\n   136\t                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n   137\t                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n   138\t            except ValueError:\n   139\t                ok = False\n   140\t            if not ok:\n   141\t                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n   142\t    elif kind == \"verdict\":\n   143\t        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n   144\t        p = _need(body, \"plan\", dict, where)\n   145\t        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n   146\t                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n   147\t            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n   148\t        if body.get(\"outcome\") not in OUTCOMES:\n   149\t            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n   150\t        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n   151\t    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n   152\t        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n   153\t        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n   154\t            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n   155\t        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n   156\t            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n   157\t            ents = _need(body, \"entries_b64\", list, where)\n   158\t            if not ents:\n   159\t                raise ValueError\n   160\t            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n   161\t                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n   162\t        except (ValueError, TypeError):\n   163\t            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n   164\t    extra = set(body) - allowed\n   165\t    if extra:\n   166\t        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n   167\t\n   168\t\n   169\t# ---------- the chain ----------\n   170\tdef _listdir(ledger, sub, pattern, what):\n   171\t    d = os.path.join(ledger, sub)\n   172\t    if not os.path.exists(d):\n   173\t        return []\n   174\t    if os.path.islink(d) or not os.path.isdir(d):\n   175\t        raise Bad(f\"{sub}/ must be a plain directory\")\n   176\t    out = []\n   177\t    for n in sorted(os.listdir(d)):\n   178\t        p = os.path.join(d, n)\n   179\t        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n   180\t            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n   181\t        out.append(p)\n   182\t    return out\n   183\t\n   184\t\n   185\tdef load_chain(ledger):\n   186\t    \"\"\"Check the whole chain; return ([(entry, sha256)], {plan seq: verdict seq}). Raises Bad on any fault.\"\"\"\n   187\t    chain, plans, verdict_<response clipped><NOTE>Due to the max output limit, only part of this file has been shown to you. You should retry this tool after you have searched inside the file with `grep -n` in order to find the line numbers of what you are looking for.</NOTE>'s Link: rel=\"next\" (works for page= and the cursor-paged activity API). The next link may name\n   188\t    the repo by numeric id; keep the original /repos/owner/name path and take only the query from it.\"\"\"\n   189\t    import urllib.parse\n   190\t    base = url.split(\"?\")[0]\n   191\t    out = []\n   192\t    while url:\n   193\t        body, hdrs = _get(url, headers=True)\n   194\t        if body is None:\n   195\t            raise CantCheck(f\"404 from {url}\")\n   196\t        out.extend(json.loads(body))\n   197\t        m = re.search(r'<([^>]+)>;\\s*rel=\"next\"', (hdrs.get(\"Link\") if hdrs else None) or \"\")\n   198\t        url = f\"{base}?{urllib.parse.urlsplit(m.group(1)).query}\" if m else None\n   199\t    return out\n   200\t\n   201\t\n   202\tdef _refs(repo):\n   203\t    \"\"\"Every ref GitHub will name for this repo: branches, tags, every pull request's merge and head refs,\n   204\t    and every ref in the activity log (which keeps deleted branches while the repo exists).\"\"\"\n   205\t    api = f\"https://api.github.com/repos/{repo}\"\n   206\t    refs = {\"refs/heads/main\"}\n   207\t    refs.update(\"refs/heads/\" + x[\"name\"] for x in _pages(f\"{api}/branches?per_page=100\"))\n   208\t    refs.update(\"refs/tags/\" + x[\"name\"] for x in _pages(f\"{api}/tags?per_page=100\"))\n   209\t    refs.update(f\"refs/pull/{x['number']}/{k}\" for x in _pages(f\"{api}/pulls?state=all&per_page=100\") for k in (\"merge\", \"head\"))\n   210\t    activity = _pages(f\"{api}/activity?per_page=100\")\n   211\t    refs.update(x[\"ref\"] for x in activity if x.get(\"ref\"))\n   212\t    return sorted(refs), activity\n   213\t\n   214\t\n   215\tdef cmd_monitor(a):\n   216\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   217\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   218\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   219\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   220\t    chain, _ = load_chain(a.ledger)\n   221\t    current = {h for _, h in chain}\n   222\t    known, bad = {}, []\n   223\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   224\t        if path.endswith(\".sigstore.json\"):\n   225\t            try:\n   226\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   227\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   228\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   229\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   230\t    if a.only_ref:\n   231\t        refs, activity = [a.only_ref], []\n   232\t    else:\n   233\t        refs, activity = _refs(a.repo)\n   234\t        for x in activity:\n   235\t            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n   236\t                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   237\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   238\t    seen, unknown, orphans = set(), [], []\n   239\t    for ref in refs:\n   240\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/retrieve\", json.dumps({\"subject\": identity(a.repo, a.workflow, ref)}).encode())\n   241\t        if uuids is None:\n   242\t            raise CantCheck(\"Rekor's index returned 404\")\n   243\t        for u in json.loads(uuids):\n   244\t            got = _get(f\"https://rekor.sigstore.dev/api/v1/log/entries/{u}\")\n   245\t            if got is None:\n   246\t                raise CantCheck(f\"Rekor lists {u} but won't return it\")\n   247\t            v = next(iter(json.loads(got).values()))\n   248\t            idx = int(v[\"logIndex\"])\n   249\t            seen.add(idx)\n   250\t            row = {\"ref\": ref, \"log_index\": idx, \"integrated\": iso(v[\"integratedTime\"]), \"rekor_uuid\": u}\n   251\t            if idx in known:\n   252\t                continue\n   253\t            if idx not in explained:\n   254\t                unknown.append(row)\n   255\t                continue\n   256\t            o = explained[idx]\n   257\t            body = json.loads(base64.b64decode(v[\"body\"]))\n   258\t            stmt = base64.b64decode(o[\"body\"][\"statement_b64\"])\n   259\t            if body.get(\"kind\") != \"dsse\" or body[\"spec\"][\"payloadHash\"][\"value\"] != hashlib.sha256(stmt).hexdigest():\n   260\t                bad.append(f\"orphan entry {o['seq']}: its statement isn't the one Rekor holds for log index {idx}\")\n   261\t                continue\n   262\t            pred = (parse_json(stmt, f\"orphan entry {o['seq']} statement\") or {}).get(\"predicate\") or {}\n   263\t            head = pred.get(\"head_sha256\")\n   264\t            problem = _orphan_entries_problem(o, pred)\n   265\t            if problem:\n   266\t                bad.append(f\"orphan entry {o['seq']}: {problem}\")\n   267\t                continue\n   268\t            if head in published and head not in current:\n   269\t                bad.append(f\"orphan entry {o['seq']}: the attested head {head} was published on {a.git_rev} and later removed\")\n   270\t                continue\n   271\t            orphans.append(dict(row, explained_by_entry=o[\"seq\"], attested_range=f\"{pred.get('from_seq')}-{pred.get('to_seq')}\"))\n   272\t    missing = sorted(n for idx, n in known.items() if idx not in seen) if not a.only_ref else []\n   273\t    print(json.dumps({\"refs_checked\": refs, \"rekor_entries\": len(seen), \"ledger_anchors\": len(known),\n   274\t                      \"explained_orphans\": orphans, \"unexplained\": unknown, \"wrong\": bad,\n   275\t                      \"ledger_anchors_not_found_in_rekor\": missing if not a.only_ref else \"not checked with --only-ref\"}, indent=1))\n   276\t    for x in bad:\n   277\t        print(f\"BAD: {x}\", file=sys.stderr)\n   278\t    return 1 if unknown or missing or bad else 0\n   279\t\n   280\t\n   281\tdef cmd_range(a):\n   282\t    chain, _ = load_chain(a.ledger)\n   283\t    if not 1 <= a.from_seq <= a.to_seq <= len(chain):\n   284\t        raise Bad(f\"no range {a.from_seq}-{a.to_seq} in a chain of {len(chain)}\")\n   285\t    print(json.dumps(range_predicate(chain, a.from_seq, a.to_seq), sort_keys=True, separators=(\",\", \":\")))\n   286\t    return 0\n   287\t\n   288\t\n   289\tdef main(argv=None):\n   290\t    here = os.path.dirname(os.path.abspath(__file__))\n   291\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   292\t    ap.add_argument(\"--ledger\", default=os.path.join(here, \"..\", \"ledger\"))\n   293\t    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n   294\t    sub.add_parser(\"ingest\")\n   295\t    sub.add_parser(\"verify\")\n   296\t    sub.add_parser(\"head\")\n   297\t    rp = sub.add_parser(\"range\", help=\"print the writer's predicate for entries FROM..TO (used by CI)\")\n   298\t    rp.add_argument(\"from_seq\", type=int)\n   299\t    rp.add_argument(\"to_seq\", type=int)\n   300\t    for name in (\"check-anchors\", \"monitor\"):\n   301\t        p = sub.add_parser(name)\n   302\t        p.add_argument(\"--repo\", default=\"5kasgard/exagium\")\n   303\t        p.add_argument(\"--workflow\", default=\".github/workflows/record.yml\")\n   304\t        if name == \"check-anchors\":\n   305\t            p.add_argument(\"--ref\", default=\"refs/heads/main\")\n   306\t            p.add_argument(\"--explorer\", action=\"append\", default=None,\n   307\t                           help=\"esplora API base; default blockstream.info and mempool.space\")\n   308\t        else:\n   309\t            p.add_argument(\"--only-ref\", help=\"check this ref only (default: every ref GitHub names)\")\n   310\t            p.add_argument(\"--ledger-ref\", default=\"refs/heads/main\", help=\"the ledger's branch; a force push to it is wrong\")\n   311\t            p.add_argument(\"--git-rev\", default=\"HEAD\", help=\"the ledger branch's history in this clone (for orphan checks)\")\n   312\t    a = ap.parse_args(argv)\n   313\t    if getattr(a, \"explorer\", \"x\") is None:\n   314\t        a.explorer = [\"https://blockstream.info/api\", \"https://mempool.space/api\"]\n   315\t    fn = {\"ingest\": cmd_ingest, \"verify\": cmd_verify, \"head\": cmd_head, \"range\": cmd_range,\n   316\t          \"check-anchors\": cmd_check_anchors, \"monitor\": cmd_monitor}[a.cmd]\n   317\t    try:\n   318\t        return fn(a)\n   319\t    except Bad as ex:\n   320\t        print(f\"BAD: {ex}\", file=sys.stderr)\n   321\t        return 1\n   322\t    except CantCheck as ex:\n   323\t        print(f\"CAN'T CHECK: {ex}\", file=sys.stderr)\n   324\t        return 2\n   325\t    except Exception as ex:  # a failure is never reported as a verdict\n   326\t        print(f\"FAILURE: {type(ex).__name__}: {ex}\", file=sys.stderr)\n   327\t        return 3\n   328\t\n   329\t\n   330\tif __name__ == \"__main__\":\n   331\t    sys.exit(main())\n"}],"is_error":false,"command":"view","path":"/workspace/record/record.py","prev_exist":true,"kind":"FileEditorObservation"},"action_id":"95ed4b9a-d30e-41e3-a53