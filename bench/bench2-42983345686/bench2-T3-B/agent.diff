\t    d = {}\n    73\t    for k, v in pairs:\n    74\t        if k in d:\n    75\t            raise Bad(f\"duplicate key {k!r}\")\n    76\t        d[k] = v\n    77\t    return d\n    78\t\n    79\t\n    80\tdef _no_constants(c):\n    81\t    raise Bad(f\"{c} isn't JSON\")\n    82\t\n    83\t\n    84\tdef parse_json(raw, where):\n    85\t    try:\n    86\t        return json.loads(raw.decode(\"utf-8\"), object_pairs_hook=_no_dup_keys, parse_constant=_no_constants)\n    87\t    except (UnicodeDecodeError, ValueError, RecursionError) as e:\n    88\t        raise Bad(f\"{where}: not valid UTF-8 JSON ({e})\")\n    89\t\n    90\t\n    91\tdef parse_canonical(raw, where):\n    92\t    \"\"\"Parse stored bytes; they must be exactly the canonical form of what they contain.\"\"\"\n    93\t    obj = parse_json(raw, where)\n    94\t    _check_value(obj, where)\n    95\t    if canonical(obj) != raw:\n    96\t        raise Bad(f\"{where}: bytes aren't in canonical form\")\n    97\t    return obj\n    98\t\n    99\t\n   100\t# ---------- schema ----------\n   101\tdef _need(d, key, typ, where):\n   102\t    if key not in d or not isinstance(d[key], typ) or (typ is int and isinstance(d[key], bool)):\n   103\t        raise Bad(f\"{where}: needs {key} ({typ.__name__})\")\n   104\t    return d[key]\n   105\t\n   106\t\n   107\tdef _name(d, where):\n   108\t    v = _need(d, \"by\", str, where)\n   109\t    if not NAME.fullmatch(v):\n   110\t        raise Bad(f\"{where}: by must be a lowercase ASCII handle matching {NAME.pattern}\")\n   111\t    return v\n   112\t\n   113\t\n   114\tdef _check_digests(lst, where):\n   115\t    if not isinstance(lst, list):\n   116\t        raise Bad(f\"{where}: must be a list\")\n   117\t    for i, x in enumerate(lst):\n   118\t        if not isinstance(x, dict) or set(x) != {\"name\", \"sha256\"} or not isinstance(x[\"name\"], str) \\\n   119\t                or not isinstance(x[\"sha256\"], str) or not HEX64.fullmatch(x[\"sha256\"]):\n   120\t            raise Bad(f\"{where}[{i}]: must be {{name, sha256}} with 64 lowercase hex\")\n   121\t\n   122\t\n   123\tdef check_body(kind, body, where):\n   124\t    if not isinstance(body, dict):\n   125\t        raise Bad(f\"{where}: body must be an object\")\n   126\t    _name(body, where)\n   127\t    if kind == \"plan\":\n   128\t        allowed = {\"by\", \"claim\", \"test\", \"decision_rule\", \"baseline\", \"inputs\", \"verdict_due\", \"notes\"}\n   129\t        for k in (\"claim\", \"test\", \"decision_rule\"):\n   130\t            if not _need(body, k, str, where).strip():\n   131\t                raise Bad(f\"{where}: {k} is empty\")\n   132\t        if \"inputs\" in body:\n   133\t            _check_digests(body[\"inputs\"], f\"{where}.inputs\")\n   134\t        if \"verdict_due\" in body:\n   135\t            try:\n   136\t                ok = isinstance(body[\"verdict_due\"], str) and len(body[\"verdict_due\"]) == 10 and \\\n   137\t                    datetime.date.fromisoformat(body[\"verdict_due\"]).isoformat() == body[\"verdict_due\"]\n   138\t            except ValueError:\n   139\t                ok = False\n   140\t            if not ok:\n   141\t                raise Bad(f\"{where}: verdict_due must be a real date, YYYY-MM-DD\")\n   142\t    elif kind == \"verdict\":\n   143\t        allowed = {\"by\", \"plan\", \"outcome\", \"evidence\", \"notes\"}\n   144\t        p = _need(body, \"plan\", dict, where)\n   145\t        if set(p) != {\"seq\", \"sha256\"} or not isinstance(p[\"seq\"], int) or isinstance(p[\"seq\"], bool) \\\n   146\t                or not isinstance(p[\"sha256\"], str) or not HEX64.fullmatch(p[\"sha256\"]):\n   147\t            raise Bad(f\"{where}: plan must be {{seq, sha256}}\")\n   148\t        if body.get(\"outcome\") not in OUTCOMES:\n   149\t            raise Bad(f\"{where}: outcome must be one of {OUTCOMES}\")\n   150\t        _check_digests(_need(body, \"evidence\", list, where), f\"{where}.evidence\")\n   151\t    else:  # orphan: explains a Rekor attestation by the writer that the ledger doesn't hold\n   152\t        allowed = {\"by\", \"log_index\", \"reason\", \"statement_b64\", \"entries_b64\"}\n   153\t        if _need(body, \"log_index\", int, where) < 0 or not _need(body, \"reason\", str, where).strip():\n   154\t            raise Bad(f\"{where}: orphan needs log_index >= 0 and a reason\")\n   155\t        try:  # the orphaned attestation's exact signed statement; monitor checks it against Rekor's payload hash\n   156\t            base64.b64decode(_need(body, \"statement_b64\", str, where), validate=True)\n   157\t            ents = _need(body, \"entries_b64\", list, where)\n   158\t            if not ents:\n   159\t                raise ValueError\n   160\t            for x in ents:  # the orphaned run's entries, so what it attested is published, not just explained\n   161\t                base64.b64decode(x if isinstance(x, str) else None, validate=True)\n   162\t        except (ValueError, TypeError):\n   163\t            raise Bad(f\"{where}: statement_b64 must be base64, and entries_b64 a non-empty list of base64 entries\")\n   164\t    extra = set(body) - allowed\n   165\t    if extra:\n   166\t        raise Bad(f\"{where}: unknown body fields {sorted(extra)}\")\n   167\t\n   168\t\n   169\t# ---------- the chain ----------\n   170\tdef _listdir(ledger, sub, pattern, what):\n   171\t    d = os.path.join(ledger, sub)\n   172\t    if not os.path.exists(d):\n   173\t        return []\n   174\t    if os.path.islink(d) or not os.path.isdir(d):\n   175\t        raise Bad(f\"{sub}/ must be a plain directory\")\n   176\t    out = []\n   177\t    for n in sorted(os.listdir(d)):\n   178\t        p = os.path.join(d, n)\n   179\t        if not pattern.fullmatch(n) or os.path.islink(p) or not os.path.isfile(p):\n   180\t            raise Bad(f\"{sub}/{n!r}: unexpected {what}\")\n   181\t        out.append(p)\n   182\t    return out\n   183\t\n   184\t\n   185\tdef load_chain(ledger):\n  