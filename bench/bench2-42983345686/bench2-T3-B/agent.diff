tivity if x.get(\"ref\"))\n   212\t    return sorted(refs), activity\n   213\t\n   214\t\n   215\tdef cmd_monitor(a):\n   216\t    \"\"\"List every Rekor entry signed by the writer workflow on any ref GitHub names. Each must be an anchor in the\n   217\t    ledger, or be explained by an orphan entry whose statement matches Rekor's payload hash and whose entries were\n   218\t    never published on the ledger branch (so an orphan can't launder a deleted verdict). Any force push to the\n   219\t    ledger branch is wrong. Entries are matched by Rekor log index, unique per attestation.\"\"\"\n   220\t    chain, _ = load_chain(a.ledger)\n   221\t    current = {h for _, h in chain}\n   222\t    known, bad = {}, []\n   223\t    for path in _listdir(a.ledger, \"anchors\", ANCHOR_NAME, \"file in anchors\"):\n   224\t        if path.endswith(\".sigstore.json\"):\n   225\t            try:\n   226\t                known[int(json.load(open(path))[\"verificationMaterial\"][\"tlogEntries\"][0][\"logIndex\"])] = os.path.basename(path)\n   227\t            except (ValueError, KeyError, IndexError, TypeError) as ex:\n   228\t                raise Bad(f\"{os.path.basename(path)}: malformed bundle ({ex})\")\n   229\t    explained = {e[\"body\"][\"log_index\"]: e for e, _ in chain if e[\"kind\"] == \"orphan\"}\n   230\t    if a.only_ref:\n   231\t        refs, activity = [a.only_ref], []\n   232\t    else:\n   233\t        refs, activity = _refs(a.repo)\n   234\t        for x in activity:\n   235\t            if x.get(\"activity_type\") in (\"force_push\", \"branch_deletion\") and x.get(\"ref\") == a.ledger_ref:\n   236\t                bad.append(f\"{x['activity_type']} on {a.ledger_ref} at {x.get('timestamp')} (rewrites the ledger's history)\")\n   237\t    published = _published_entry_hashes(a, a.git_rev) if explained else set()\n   238\t    seen, unknown, orphans = set(), [], []\n   239\t    for ref in refs:\n   240\t        uuids = _get(\"https://rekor.sigstore.dev/api/v1/index/re