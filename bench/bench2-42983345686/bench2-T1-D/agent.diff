   202\t        raw = R.canonical(hidden)\n   203\t        pred = {\"from_seq\": 2, \"to_seq\": 2, \"prev_sha256\": chain[0][1], \"head_sha256\": hashlib.sha256(raw).hexdigest()}\n   204\t        b64 = base64.b64encode(raw).decode()\n   205\t        self.assertIsNone(R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, pred))\n   206\t        other = base64.b64encode(raw.replace(b'\"fail\"', b'\"pass\"')).decode()\n   207\t        self.assertIn(\"head\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [other]}}, pred))\n   208\t        self.assertIn(\"range\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64, b64]}}, pred))\n   209\t        self.assertIn(\"chain\", R._orphan_entries_problem({\"body\": {\"entries_b64\": [b64]}}, dict(pred, prev_sha256=\"0\" * 64)))\n   210\t\n   211\t    def test_range_predicate_ties_both_ends(self):\n   212\t        self._two_entries()\n   213\t        rc, out, _ = self.run_cmd(\"range\", \"2\", \"2\")\n   214\t        p = json.loads(out)\n   215\t        self.assertEqual((p[\"from_seq\"], p[\"to_seq\"], p[\"prev_sha256\"]), (2, 2, self.plan_ref(1)[\"sha256\"]))\n   216\t        self.assertEqual(self.run_cmd(\"range\", \"1\", \"3\")[0], 1)\n   217\t\n   218\t    def test_check_anchors_requires_the_writer_to_cover_every_entry(self):\n   219\t        # review 1: a hand-written entry passed every check. Now an entry no writer attestation covers is wrong.\n   220\t        self._two_entries()\n   221\t        rc, out, err = self.run_cmd(\"check-anchors\")\n   222\t        self.assertEqual(rc, 1)\n   223\t        self.assertIn(\"never attested by the writer\", err)\n   224\t\n   225\t    def test_unknown_files_and_fields_are_refused(self):\n   226\t        self._two_entries()\n   227\t        open(os.path.join(self.d, \"entries\", \"notes.txt\"), \"w\").write(\"x\")\n   228\t        self.assertEqual(self.run_cmd(\"verify\")[0], 1)\n   229\t        os.remove(os.path.join(self.d, \"entries\", \"notes.txt\"))\n  